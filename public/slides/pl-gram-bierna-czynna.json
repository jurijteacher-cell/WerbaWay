      "steps": [
        {
          "label": "1. dopełnienie (biernik) → podmiot (mianownik)",
          "text": "fasadę → fasada"
        },
        {
          "label": "2. być / zostać: ten sam czas i aspekt",
          "text": "odnowili (przeszły, dokonany) → została"
        },
        {
          "label": "3. imiesłów zgodny z podmiotem",
          "text": "odnowiona"
        },
        {
          "label": "4. wykonawca: przez + biernik, jeśli ważny",
          "text": "przez konserwatorów"
        }
      ],
      "result": "Konserwatorzy odnowili fasadę. → [[Fasada została odnowiona przez konserwatorów.]]"
    },
