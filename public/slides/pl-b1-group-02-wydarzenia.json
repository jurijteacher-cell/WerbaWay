          "w tysiąc dziewięćset [[osiemdziesiątym dziewiątym]] roku"
        ],
        [
          "w 1410 roku",
          "w tysiąc czterysta [[dziesiątym]] roku"
        ],
        [
          "w 2004 roku",
          "w dwa tysiące [[czwartym]] roku"
