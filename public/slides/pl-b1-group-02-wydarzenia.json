        "przykład"
      ],
      "rows": [
        [
          "Kiedy?",
          "dopełniacz",
          "[[jedenastego]] listopada"
        ],
        [
          "Jaki dziś dzień?",
          "mianownik",
          "Dziś jest [[jedenasty]] listopada."
        ],
        [
          "Kiedy masz urodziny?",
          "dopełniacz",
          "[[Dwudziestego piątego]] marca."
        ]
