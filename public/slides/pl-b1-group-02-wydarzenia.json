      "kind": "title",
      "title": "Daty i czas",
      "subtitle": "Kiedy? W którym roku? Jak długo?",
      "goal": "Po tej lekcji przeczytasz każdą datę i opowiesz historię krok po kroku."
    },
    {
      "id": "s2",
      "part": 1,
      "section": "teoria",
      "kind": "compare",
      "title": "Ile? czy który?",
      "left": {
        "head": "ile? — liczebnik główny",
        "rule": "liczy",
        "examples": [
          "[[trzy]] lata",
          "[[sto]] lat"
        ]
      },
      "right": {
        "head": "który? — liczebnik porządkowy",
        "rule": "wskazuje miejsce",
        "examples": [
          "[[trzeci]] rok",
          "[[pierwszy]] września"
        ]
      },
      "note": "Data to zawsze liczebnik porządkowy."
    },
