      "section": "teoria",
      "kind": "examples",
      "title": "Kolejność wydarzeń",
      "items": [
        {
          "tag": "zanim",
          "pl": "[[Zanim]] wybuchła wojna, Polska była wolna.",
          "uk": "До того як почалася війна, Польща була вільною."
        },
        {
          "tag": "po tym, jak",
          "pl": "[[Po tym, jak]] upadł mur, zmieniła się Europa.",
          "uk": "Після того як упав мур, змінилася Європа."
        },
        {
          "tag": "kiedy",
          "pl": "[[Kiedy]] wróciła niepodległość, ludzie świętowali.",
          "uk": "Коли повернулася незалежність, люди святкували."
        }
      ],
      "note": "Po „zanim” i „po tym, jak” zwykle stoi czasownik dokonany."
    },
