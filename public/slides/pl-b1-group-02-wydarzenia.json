      "section": "teoria",
      "kind": "compare",
      "title": "Miesiąc z dniem i bez dnia",
      "left": {
        "head": "z dniem",
        "rule": "dzień i miesiąc w dopełniaczu",
        "examples": [
          "[[trzeciego maja]]",
          "[[31 sierpnia]] 1980 roku"
        ]
      },
      "right": {
        "head": "bez dnia",
        "rule": "w + miejscownik",
        "examples": [
          "[[w maju]]",
          "[[w sierpniu]] 1980 roku"
        ]
      },
      "note": "Jest dzień — dopełniacz. Nie ma dnia — w + miejscownik."
    },
