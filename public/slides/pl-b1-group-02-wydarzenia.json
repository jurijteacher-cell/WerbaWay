        {
          "uk": "з 1795 по 1918",
          "wrong": "z 1795 po 1918",
          "right": "[[od]] 1795 [[do]] 1918",
          "why": "Granice okresu to od… do."
        },
        {
          "uk": "після війни",
          "wrong": "po wojny",
          "right": "po [[wojnie]]",
          "why": "Przyimek „po” łączy się z miejscownikiem."
        },
        {
          "uk": "під час війни",
          "wrong": "pod czas wojny",
          "right": "[[podczas]] wojny",
          "why": "„Podczas” to jedno słowo."
        }
      ]
    },
