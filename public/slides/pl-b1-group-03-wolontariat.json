{
  "lesson_id": "pl-b1-group-03-wolontariat",
  "exercise_type": "grammar-slides",
  "title": "Cel i prośba: żeby",
  "slides": [
    {
      "id": "s1",
      "part": 1,
      "section": "teoria",
      "kind": "title",
      "title": "Po co? Czego chcesz?",
      "subtitle": "Żeby, żebym, żebyś",
      "goal": "Po tej lekcji powiesz, po co coś robisz i o co prosisz innych."
    },
    {
      "id": "s2",
      "part": 1,
      "section": "teoria",
      "kind": "compare",
      "title": "Dwa zadania „żeby”",
      "left": {
        "head": "cel",
        "rule": "po co coś robię",
        "examples": [
          "Pomagam, [[żeby]] czuć się potrzebnym."
        ]
      },
      "right": {
        "head": "prośba, życzenie",
        "rule": "czego chcę od innych",
        "examples": [
          "Proszę, [[żebyś]] mi pomógł."
        ]
      },
      "note": "Pytania kontrolne: Po co? W jakim celu? Czego chcesz?"
    },
    {
      "id": "s3",
      "part": 1,
      "section": "teoria",
      "kind": "steps",
      "title": "Ten sam podmiot",
      "steps": [
        {
          "label": "czasownik",
          "text": "Zapisałam się,"
        },
        {
          "label": "żeby",
          "text": "żeby"
        },
        {
          "label": "bezokolicznik",
          "text": "poznać ludzi"
        }
      ],
      "result": "Zapisałam się, [[żeby]] [[poznać]] nowych ludzi.",
      "note": "Kto się zapisał? Ja. Kto pozna ludzi? Też ja."
    },
    {
      "id": "s4",
      "part": 1,
      "section": "teoria",
      "kind": "steps",
      "title": "Inny podmiot",
      "steps": [
        {
          "label": "czasownik",
          "text": "Mama chce,"
        },
        {
          "label": "żeby + osoba",
          "text": "żeby syn"
        },
        {
          "label": "forma przeszła",
          "text": "pomagał"
        }
      ],
      "result": "Mama chce, [[żeby]] syn [[pomagał]] w schronisku.",
      "note": "Forma przeszła, ale znaczenie — teraz albo w przyszłości."
    },
    {
      "id": "s5",
      "part": 1,
      "section": "teoria",
      "kind": "table",
      "reveal": "row",
      "title": "Osoba siedzi w „żeby”",
      "columns": [
        "osoba",
        "żeby + końcówka",
        "czasownik"
      ],
      "rows": [
        [
          "ja",
          "[[żebym]]",
          "poszedł / poszła"
        ],
        [
          "ty",
          "[[żebyś]]",
          "pomógł / pomogła"
        ],
        [
          "on, ona",
          "żeby",
          "przyszedł / przyszła"
        ],
        [
          "my",
          "[[żebyśmy]]",
          "wiedzieli / wiedziały"
        ],
        [
          "wy",
          "[[żebyście]]",
          "przyszli / przyszły"
        ],
        [
          "oni, one",
          "żeby",
          "pomagali / pomagały"
        ]
      ],
      "note": "Końcówka osobowa jest przy „żeby”, nie przy czasowniku."
    },
    {
      "id": "s6",
      "part": 1,
      "section": "teoria",
      "kind": "examples",
      "title": "Czasowniki, które wołają „żeby”",
      "items": [
        {
          "tag": "prosić",
          "pl": "Proszę, [[żeby]] Pan podpisał porozumienie.",
          "uk": "Прошу, щоб ви підписали угоду."
        },
        {
          "tag": "radzić",
          "pl": "Radzę ci, [[żebyś]] zapisał się wcześniej.",
          "uk": "Раджу тобі записатися раніше."
        },
        {
          "tag": "namawiać",
          "pl": "Namawiam cię, [[żebyś]] poszła z nami.",
          "uk": "Умовляю тебе піти з нами."
        },
        {
          "tag": "zależy mi",
          "pl": "Zależy mi, [[żebyście]] byli punktualni.",
          "uk": "Мені важливо, щоб ви були пунктуальні."
        }
      ],
      "note": "Chcę pomagać — chodzi o mnie. Chcę, żebyś pomagał — o kogoś innego."
    },
    {
      "id": "s7",
      "part": 1,
      "section": "teoria",
      "kind": "compare",
      "title": "Że czy żeby?",
      "left": {
        "head": "że",
        "rule": "informacja",
        "examples": [
          "Powiedział, [[że]] przyjdzie.",
          "Wiem, że…"
        ]
      },
      "right": {
        "head": "żeby",
        "rule": "prośba, cel, życzenie",
        "examples": [
          "Powiedział, [[żebym]] przyszedł.",
          "Chcę, żeby…"
        ]
      },
      "note": "Po „mówić” i „pisać” możliwe są oba — zmienia się sens."
    },
    {
      "id": "s8",
      "part": 1,
      "section": "wyjatki",
      "kind": "exceptions",
      "refers_to": "s6",
      "title": "Kiedy bez „żeby”",
      "items": [
        {
          "rule": "Ten sam podmiot po „chcieć”: bezokolicznik",
          "example": "Chcę [[pomagać]]. (nie: chcę, żebym pomagał)",
          "refers_to": "s6"
        },
        {
          "rule": "„Zależy mi” — staranniej z „na tym”",
          "example": "Zależy mi [[na tym]], żebyście byli punktualni.",
          "refers_to": "s6"
        },
        {
          "rule": "Prośba o rzecz: prosić o + biernik",
          "example": "Proszę [[o pomoc]].",
          "refers_to": "s6"
        }
      ]
    },
    {
      "id": "s9",
      "part": 2,
      "section": "teoria",
      "kind": "table",
      "reveal": "row",
      "title": "Aby, by, po to, żeby",
      "columns": [
        "słowo",
        "styl",
        "przykład"
      ],
      "rows": [
        [
          "żeby",
          "rozmowa",
          "Dzwonię, [[żeby]] zapytać."
        ],
        [
          "aby",
          "e-mail, urząd",
          "Prosimy, [[aby]] Państwo…"
        ],
        [
          "by",
          "krótko, w piśmie",
          "Przyszedł, [[by]] pomóc."
        ],
        [
          "po to, żeby",
          "mocny akcent",
          "Robię to [[po to, żeby]] pomóc."
        ]
      ],
      "note": "Znaczenie to samo, zmienia się styl."
    },
    {
      "id": "s10",
      "part": 2,
      "section": "teoria",
      "kind": "compare",
      "title": "W celu: mowa i pismo",
      "left": {
        "head": "w rozmowie",
        "rule": "żeby + bezokolicznik",
        "examples": [
          "[[żeby zebrać]] pieniądze"
        ]
      },
      "right": {
        "head": "w piśmie urzędowym",
        "rule": "w celu + dopełniacz",
        "examples": [
          "[[w celu zebrania]] pieniędzy",
          "w celu weryfikacji danych"
        ]
      },
      "note": "W celu + rzeczownik odczasownikowy w dopełniaczu."
    },
    {
      "id": "s11",
      "part": 2,
      "section": "teoria",
      "kind": "table",
      "reveal": "row",
      "title": "Dla kogo? Na co? Do czego?",
      "columns": [
        "pytanie",
        "przyimek",
        "przykład"
      ],
      "rows": [
        [
          "dla kogo?",
          "dla + dopełniacz",
          "[[dla dzieci]]"
        ],
        [
          "na co idą pieniądze?",
          "na + biernik",
          "[[na leczenie]]"
        ],
        [
          "do czego służy rzecz?",
          "do + dopełniacz",
          "maszyna [[do szycia]]"
        ]
      ],
      "note": "Zbiórka dla Ani na operację: „dla” — komu, „na” — po co."
    },
    {
      "id": "s12",
      "part": 2,
      "section": "teoria",
      "kind": "examples",
      "title": "Żeby nie",
      "items": [
        {
          "tag": "rada",
          "pl": "Zapisz godzinę, [[żeby nie]] zapomnieć.",
          "uk": "Запиши час, щоб не забути."
        },
        {
          "tag": "inny podmiot",
          "pl": "Zamknij furtkę, [[żeby]] psy [[nie]] uciekły.",
          "uk": "Зачини хвіртку, щоб собаки не втекли."
        },
        {
          "tag": "dopełniacz",
          "pl": "żeby nie zmarnować [[jedzenia]]",
          "uk": "щоб не змарнувати їжу"
        }
      ],
      "note": "Po „nie” biernik zmienia się w dopełniacz."
    },
    {
      "id": "s13",
      "part": 2,
      "section": "teoria",
      "kind": "compare",
      "title": "Bo czy żeby?",
      "left": {
        "head": "bo — przyczyna",
        "rule": "dlaczego? patrzy wstecz",
        "examples": [
          "Pomagam, [[bo]] kiedyś ktoś pomógł mi."
        ]
      },
      "right": {
        "head": "żeby — cel",
        "rule": "po co? patrzy do przodu",
        "examples": [
          "Pomagam, [[żeby]] inni nie byli sami."
        ]
      },
      "note": "W piśmie zamiast „bo”: ponieważ, dlatego że."
    },
    {
      "id": "s14",
      "part": 2,
      "section": "teoria",
      "kind": "examples",
      "title": "Żeby + strona bierna",
      "items": [
        {
          "tag": "paczki",
          "pl": "żeby paczki [[zostały dostarczone]] na czas",
          "uk": "щоб посилки доставили вчасно"
        },
        {
          "tag": "sprzęt",
          "pl": "żeby sprzęt [[został kupiony]] w tym roku",
          "uk": "щоб обладнання купили цього року"
        },
        {
          "tag": "nikt",
          "pl": "żeby nikt nie [[został pominięty]]",
          "uk": "щоб нікого не пропустили"
        }
      ],
      "note": "Imiesłów zgadza się z podmiotem: paczki dostarczone, sprzęt kupiony."
    },
    {
      "id": "s15",
      "part": 2,
      "section": "wyjatki",
      "kind": "exceptions",
      "refers_to": "s12",
      "title": "„Żeby” bez celu",
      "items": [
        {
          "rule": "„Nie żeby…” znaczy „to nie tak, że…”",
          "example": "[[Nie żeby]] mi się nie chciało — po prostu nie mam czasu.",
          "refers_to": "s12"
        },
        {
          "rule": "„Żeby tylko…” — życzenie, bez głównego zdania",
          "example": "[[Żeby tylko]] nie padało!",
          "refers_to": "s12"
        }
      ]
    },
    {
      "id": "s16",
