        },
        {
          "uk": "збирати на лікування",
          "wrong": "zbierać dla leczenia",
          "right": "zbierać [[na leczenie]]",
          "why": "Na co idą pieniądze — „na” + biernik."
        }
      ]
    },
    {
      "id": "s17",
      "part": 2,
      "section": "pulapki",
      "kind": "traps",
      "title": "Pułapki z ukraińskiego",
      "items": [
        {
          "uk": "займатися волонтерством",
