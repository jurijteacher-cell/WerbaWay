  "groups": ["Hobby i pasje", "Sport i ruch", "Umawiamy się", "Jak często?"],
  "comm_groups": ["Umawiamy się", "Jak często?"],
  "items": [
    { "id": "v01", "term": "pasja", "group": "Hobby i pasje", "part_of_speech": "rzeczownik, ż.", "definition": "To, co bardzo lubisz robić.", "example": "Fotografia to moja pasja od wielu lat.", "translation_uk": "пристрасть, захоплення" },
    { "id": "v02", "term": "hobby", "group": "Hobby i pasje", "part_of_speech": "rzeczownik, n., nieodmienny", "definition": "Zajęcie na wolny czas.", "example": "Jakie masz hobby?", "translation_uk": "хобі" },
    { "id": "v03", "term": "czas wolny", "group": "Hobby i pasje", "part_of_speech": "rzeczownik, m.", "definition": "Czas bez pracy i obowiązków.", "example": "W czasie wolnym chodzę na długie spacery.", "translation_uk": "вільний час" },
    { "id": "v04", "term": "ćwiczyć", "group": "Hobby i pasje", "part_of_speech": "czasownik", "definition": "Robić coś wiele razy, żeby robić to lepiej.", "example": "Ćwiczę grę na pianinie każdego ranka.", "translation_uk": "вправлятися, тренуватися" },
    { "id": "v05", "term": "rysować", "group": "Hobby i pasje", "part_of_speech": "czasownik", "definition": "Robić obrazki ołówkiem albo kredką.", "example": "Moja córka rysuje konie.", "translation_uk": "малювати" },
    { "id": "v06", "term": "fotografować", "group": "Hobby i pasje", "part_of_speech": "czasownik", "definition": "Robić zdjęcia.", "example": "Lubię fotografować stare budynki.", "translation_uk": "фотографувати" },
    { "id": "v07", "term": "gotować", "group": "Hobby i pasje", "part_of_speech": "czasownik", "definition": "Robić jedzenie, na przykład zupę albo obiad.", "example": "W niedzielę gotuję zupę pomidorową.", "translation_uk": "готувати (їжу)" },
    { "id": "v08", "term": "instrument", "group": "Hobby i pasje", "part_of_speech": "rzeczownik, m.", "definition": "Gitara, pianino albo perkusja: na nim grasz muzykę.", "example": "Na jakim instrumencie grasz?", "translation_uk": "(музичний) інструмент" },
    { "id": "v09", "term": "oglądać", "group": "Hobby i pasje", "part_of_speech": "czasownik", "definition": "Patrzeć na film, serial albo mecz.", "example": "Wieczorem oglądamy serial kryminalny.", "translation_uk": "дивитися (фільм, серіал, матч)" },
    { "id": "v10", "term": "pływać", "group": "Sport i ruch", "part_of_speech": "czasownik", "definition": "Poruszać się w wodzie.", "example": "Latem pływam w jeziorze.", "translation_uk": "плавати" },
    { "id": "v11", "term": "biegać", "group": "Sport i ruch", "part_of_speech": "czasownik", "definition": "Szybko poruszać się na nogach.", "example": "Biegam rano, zanim idę do pracy.", "translation_uk": "бігати" },
    { "id": "v12", "term": "jeździć na rowerze", "group": "Sport i ruch", "part_of_speech": "zwrot", "definition": "Poruszać się na rowerze.", "example": "Moje dzieci jeżdżą na rowerze do szkoły.", "translation_uk": "кататися на велосипеді" },
    { "id": "v13", "term": "siłownia", "group": "Sport i ruch", "part_of_speech": "rzeczownik, ż.", "definition": "Miejsce, gdzie ćwiczysz z ciężarami.", "example": "Po pracy idę na siłownię.", "translation_uk": "спортзал" },
    { "id": "v14", "term": "basen", "group": "Sport i ruch", "part_of_speech": "rzeczownik, m.", "definition": "Miejsce z wodą, gdzie pływasz.", "example": "Na basenie trzeba mieć czepek.", "translation_uk": "басейн" },
    { "id": "v15", "term": "trening", "group": "Sport i ruch", "part_of_speech": "rzeczownik, m.", "definition": "Zajęcia sportowe.", "example": "Trening zaczyna się o siódmej.", "translation_uk": "тренування" },
    { "id": "v16", "term": "mecz", "group": "Sport i ruch", "part_of_speech": "rzeczownik, m.", "definition": "Gra dwóch drużyn.", "example": "Oglądasz dzisiaj mecz?", "translation_uk": "матч" },
    { "id": "v17", "term": "mieć czas", "group": "Umawiamy się", "part_of_speech": "zwrot", "definition": "Być wolnym w danym momencie.", "example": "Masz czas w piątek wieczorem?", "translation_uk": "мати час" },
    { "id": "v18", "term": "pasować", "group": "Umawiamy się", "part_of_speech": "czasownik", "definition": "Być dobrym terminem albo planem dla kogoś.", "example": "Czy pasuje ci środa?", "translation_uk": "підходити (про час, план)" },
    { "id": "v19", "term": "spróbować", "group": "Umawiamy się", "part_of_speech": "czasownik", "definition": "Zrobić coś pierwszy raz i zobaczyć, jak jest.", "example": "Chcę spróbować jogi.", "translation_uk": "спробувати" },
    { "id": "v20", "term": "zaproponować", "group": "Umawiamy się", "part_of_speech": "czasownik", "definition": "Powiedzieć: zróbmy coś razem.", "example": "Mogę zaproponować kino?", "translation_uk": "запропонувати" },
    { "id": "v21", "term": "Do zobaczenia!", "group": "Umawiamy się", "part_of_speech": "zwrot", "definition": "Mówimy to na koniec rozmowy.", "example": "Do zobaczenia w poniedziałek!", "translation_uk": "До зустрічі!" },
    { "id": "v22", "term": "codziennie", "group": "Jak często?", "part_of_speech": "przysłówek", "definition": "Każdego dnia.", "example": "Codziennie czytam wiadomości.", "translation_uk": "щодня" },
    { "id": "v23", "term": "czasami", "group": "Jak często?", "part_of_speech": "przysłówek", "definition": "Nie często, ale od czasu do czasu.", "example": "Czasami gram w karty z dziadkiem.", "translation_uk": "іноді" },
    { "id": "v24", "term": "rzadko", "group": "Jak często?", "part_of_speech": "przysłówek", "definition": "Nie często.", "example": "Rzadko chodzę do teatru.", "translation_uk": "рідко" },
    { "id": "v25", "term": "dwa razy w tygodniu", "group": "Jak często?", "part_of_speech": "zwrot", "definition": "W dwa dni każdego tygodnia.", "example": "Mam angielski dwa razy w tygodniu.", "translation_uk": "двічі на тиждень" }
