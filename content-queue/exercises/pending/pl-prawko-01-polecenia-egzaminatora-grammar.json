   ],
   "exercise_type": "fill-in-blank",
   "title": "3. Gdzie wykonać polecenie?",
   "instruction": "Wpisz słowo z nawiasu we właściwej formie.",
   "items": [
    {
     "id": "g3-1",
     "text": "Na najbliższym ___ (skrzyżowanie) proszę skręcić w lewo.",
     "answer": "skrzyżowaniu",
     "grammar_point": "przyimki-miejsce"
    },
    {
     "id": "g3-2",
     "text": "Za ___ (światła) proszę zmienić pas na prawy.",
     "answer": "światłami",
     "grammar_point": "przyimki-miejsce"
    },
    {
     "id": "g3-3",
     "text": "Przed ___ (przejście) dla pieszych proszę zwolnić.",
     "answer": "przejściem",
     "grammar_point": "przyimki-miejsce"
    },
    {
     "id": "g3-4",
     "text": "Proszę zjechać z ronda ___ (drugi zjazd).",
     "answer": "drugim zjazdem",
     "grammar_point": "przyimki-miejsce"
    },
    {
     "id": "g3-5",
     "text": "Proszę jechać prosto do ___ (koniec) ulicy.",
     "answer": "końca",
     "grammar_point": "przyimki-miejsce"
    },
    {
     "id": "g3-6",
     "text": "Proszę zatrzymać się przy prawej ___ (krawędź) jezdni.",
     "answer": "krawędzi",
     "grammar_point": "przyimki-miejsce"
    }
   ]
  },
  {
   "block_id": "g4",
   "part": 1,
   "covers_slides": [
    "s6",
