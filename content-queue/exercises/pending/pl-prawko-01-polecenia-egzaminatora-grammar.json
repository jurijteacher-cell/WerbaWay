   ],
   "exercise_type": "fill-in-blank",
   "title": "5. Pułapki z ukraińskiego",
   "instruction": "Wybierz formę, którą powie Polak.",
   "items": [
    {
     "id": "g5-1",
     "text": "Na drugim skrzyżowaniu proszę ___ w lewo.",
     "options": [
      "powrócić",
      "skręcić"
     ],
     "answer": "skręcić",
     "explanation": "Powrócić = wrócić. Zmiana kierunku to skręcić.",
     "grammar_point": "kalki-uk"
    },
    {
     "id": "g5-2",
     "text": "Tu jest ślepa ulica, proszę ___.",
     "options": [
      "zawrócić",
      "się rozwrócić"
     ],
     "answer": "zawrócić",
     "explanation": "Zawrócić, bez „się”.",
     "grammar_point": "kalki-uk"
    },
    {
     "id": "g5-3",
     "text": "Od wczoraj mam ___!",
     "options": [
      "prawa",
      "prawo jazdy"
     ],
     "answer": "prawo jazdy",
     "explanation": "Dokument to prawo jazdy. „Prawa” to prawa człowieka.",
     "grammar_point": "kalki-uk"
    },
    {
     "id": "g5-4",
     "text": "Piesi przechodzą przez jezdnię na ___ dla pieszych.",
     "options": [
      "przejściu",
      "skrzyżowaniu"
     ],
     "answer": "przejściu",
     "explanation": "Miejsce dla pieszych to przejście. Skrzyżowanie to miejsce, gdzie krzyżują się drogi.",
     "grammar_point": "kalki-uk"
    },
    {
     "id": "g5-5",
     "text": "Trzy razy ___ egzamin, zanim w końcu zdałem.",
     "options": [
      "zdawałem",
      "zdałem"
     ],
     "answer": "zdawałem",
     "explanation": "Zdawać = podchodzić do egzaminu; zdać = mieć pozytywny wynik.",
     "grammar_point": "kalki-uk"
    },
    {
     "id": "g5-6",
     "text": "Proszę nie ___ na pasie dla autobusów.",
     "options": [
      "zatrzymać się",
      "zatrzymywać się"
     ],
     "answer": "zatrzymywać się",
     "explanation": "Zakaz: nie + niedokonany.",
     "grammar_point": "kalki-uk"
    }
   ]
  }
 ]
