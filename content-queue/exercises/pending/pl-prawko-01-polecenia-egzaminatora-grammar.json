   "exercise_type": "fill-in-blank",
   "title": "2. Polecenie czy zakaz?",
   "instruction": "Wybierz właściwą formę.",
   "items": [
    {
     "id": "g2-1",
     "text": "Na światłach proszę ___ w prawo.",
     "options": [
      "skręcać",
      "skręcić"
     ],
     "answer": "skręcić",
     "explanation": "Jedna konkretna czynność → dokonany.",
     "grammar_point": "aspekt-polecenia"
    },
    {
     "id": "g2-2",
     "text": "Proszę nie ___ tego ciągnika, tu jest linia ciągła.",
     "options": [
      "wyprzedzać",
      "wyprzedzić"
     ],
     "answer": "wyprzedzać",
     "explanation": "Zakaz: nie + niedokonany.",
     "grammar_point": "aspekt-polecenia"
    },
    {
     "id": "g2-3",
     "text": "Proszę ___ prosto aż do ronda.",
     "options": [
      "jechać",
      "pojechać"
     ],
     "answer": "jechać",
     "explanation": "Ruch ciągły na odcinku drogi → niedokonany.",
     "grammar_point": "aspekt-polecenia"
    },
    {
     "id": "g2-4",
     "text": "Za przystankiem proszę ___ się przy prawej krawędzi.",
     "options": [
      "zatrzymywać",
      "zatrzymać"
     ],
     "answer": "zatrzymać",
     "explanation": "Jedna czynność z końcem → dokonany.",
     "grammar_point": "aspekt-polecenia"
    },
    {
     "id": "g2-5",
     "text": "Proszę jeszcze nie ___ kierunkowskazu, skręcamy dopiero za mostem.",
     "options": [
      "włączać",
      "włączyć"
     ],
     "answer": "włączać",
     "explanation": "Zakaz: nie + niedokonany.",
     "grammar_point": "aspekt-polecenia"
    },
    {
     "id": "g2-6",
     "text": "Proszę ___ tyłem na tym miejscu.",
     "options": [
      "parkować",
      "zaparkować"
     ],
     "answer": "zaparkować",
     "explanation": "Jeden manewr do końca → dokonany.",
     "grammar_point": "aspekt-polecenia"
    }
   ]
  },
  {
   "block_id": "g3",
   "part": 1,
   "covers_slides": [
    "s5",
