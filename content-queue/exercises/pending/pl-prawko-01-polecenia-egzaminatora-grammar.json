   ],
   "exercise_type": "fill-in-blank",
   "title": "4. Język testu",
   "instruction": "Wybierz słowo, które pasuje do pytania z testu.",
   "items": [
    {
     "id": "g4-1",
     "text": "Czy w tej sytuacji ___ obowiązek zatrzymać się?",
     "options": [
      "masz",
      "jesteś"
     ],
     "answer": "masz",
     "explanation": "Mieć obowiązek: masz obowiązek.",
     "grammar_point": "modalne-test"
    },
    {
     "id": "g4-2",
     "text": "Na autostradzie nie ___ zawracać.",
     "options": [
      "wolno",
      "musisz"
     ],
     "answer": "wolno",
     "explanation": "Zakaz: nie wolno + bezokolicznik.",
     "grammar_point": "modalne-test"
    },
    {
     "id": "g4-3",
     "text": "W tej sytuacji ___ ustąpić pierwszeństwa pieszemu.",
     "options": [
      "należy",
      "wolno"
     ],
     "answer": "należy",
     "explanation": "Obowiązek: należy + bezokolicznik.",
     "grammar_point": "modalne-test"
    },
    {
     "id": "g4-4",
     "text": "Czy w tej sytuacji ___ prawo skręcić w lewo?",
     "options": [
      "masz",
      "możesz"
     ],
     "answer": "masz",
     "explanation": "Mieć prawo: masz prawo, a nie „możesz prawo”.",
     "grammar_point": "modalne-test"
    },
    {
     "id": "g4-5",
     "text": "Czy w tej sytuacji ___ zwolnić?",
     "options": [
      "powinieneś",
      "powinien"
     ],
     "answer": "powinieneś",
     "explanation": "Test mówi do Ciebie na „Ty”: powinieneś.",
     "grammar_point": "modalne-test"
    }
   ]
  },
  {
   "block_id": "g5",
   "part": 1,
   "covers_slides": [
