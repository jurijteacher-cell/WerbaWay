      "block_id": "h1",
      "exercise_type": "drag-and-drop",
      "title": "1. Słownictwo w nowych sytuacjach",
      "instruction": "Przeciągnij słowo w lukę. Dwa słowa w banku nie pasują nigdzie.",
      "bank": ["brakuje", "rat", "promocja", "używany", "odłożyliśmy", "nie ma sensu", "paragon", "gwarancja"],
      "items": [
        {
          "id": "h1-1",
          "text": "Na ten wyjazd ___ nam jeszcze jednej walizki.",
          "answer": "brakuje",
          "grammar_point": "slownictwo"
        },
        {
          "id": "h1-2",
          "text": "Komputer kupiłem na dwanaście ___.",
          "answer": "rat",
          "grammar_point": "slownictwo"
        },
        {
          "id": "h1-3",
          "text": "Ta ___ dotyczy tylko kawy ziarnistej.",
          "answer": "promocja",
          "grammar_point": "slownictwo"
        },
        {
          "id": "h1-4",
          "text": "Rower jest ___, ale jeździ lepiej niż nowy.",
          "answer": "używany",
          "grammar_point": "slownictwo"
        },
        {
          "id": "h1-5",
          "text": "Wyjazd do Gdańska ___ na kwiecień.",
          "answer": "odłożyliśmy",
          "grammar_point": "slownictwo"
        },
        {
          "id": "h1-6",
          "text": "Dzwonić do nich po dwudziestej ___.",
          "answer": "nie ma sensu",
          "grammar_point": "slownictwo"
        }
      ]
    },
    {
      "block_id": "h2",
      "exercise_type": "fill-in-blank",
      "title": "2. Pełna forma",
      "instruction": "Wpisz słowo z nawiasu w dopełniaczu.",
      "items": [
        {
          "id": "h2-1",
          "text": "W kuchni nie ma już ___ (cukier).",
          "answer": "cukru",
          "grammar_point": "przeczenie-dopelniacz"
        },
        {
          "id": "h2-2",
          "text": "Czekamy na nich od pół ___ (godzina).",
          "answer": "godziny",
          "grammar_point": "ilosc-dopelniacz"
        },
        {
          "id": "h2-3",
          "text": "Do ___ (praca) jadę rowerem przez park.",
          "answer": "pracy",
          "grammar_point": "przyimki-dopelniacz"
        },
        {
          "id": "h2-4",
          "text": "Bez ___ (parasol) nie wychodź, bo pada.",
          "answer": "parasola",
          "grammar_point": "przyimki-dopelniacz"
        },
        {
          "id": "h2-5",
          "text": "To prezent dla ___ (brat) na urodziny.",
          "answer": "brata",
          "grammar_point": "przyimki-dopelniacz"
        },
        {
          "id": "h2-6",
          "text": "Nie znalazłem ___ (klucze) w żadnej kieszeni.",
          "answer": "kluczy",
          "grammar_point": "dopelniacz-mnoga"
        },
        {
          "id": "h2-7",
          "text": "Kup trochę ___ (chleb) po drodze do domu.",
          "answer": "chleba",
          "grammar_point": "ilosc-dopelniacz"
        },
        {
          "id": "h2-8",
          "text": "Od ___ (sąsiad) dostaliśmy skrzynkę jabłek.",
          "answer": "sąsiada",
          "grammar_point": "przyimki-dopelniacz"
        }
      ]
    },
    {
      "block_id": "h3",
      "exercise_type": "sentence-building",
      "title": "3. Dokończ zdanie",
      "instruction": "Przeczytaj pierwsze zdanie i dokończ drugie.",
      "items": [
        {
          "id": "h3-1",
          "prompt": "Mam czas w czwartek. → W piątek niestety…",
          "answer": "W piątek niestety nie mam czasu.",
          "grammar_point": "przeczenie-dopelniacz"
        },
        {
          "id": "h3-2",
          "prompt": "Chciałem kupić bilety. → Niestety…",
          "answer": "Niestety nie kupiłem biletów.",
          "grammar_point": "przeczenie-dopelniacz"
        },
        {
          "id": "h3-3",
          "prompt": "Chcę nowe mieszkanie. → Od pół roku szukam…",
          "answer": "Od pół roku szukam nowego mieszkania.",
          "grammar_point": "czasowniki-z-dopelniaczem"
        },
        {
          "id": "h3-4",
          "prompt": "Lubię herbatę z cytryną. → A ja piję…",
          "answer": "A ja piję herbatę bez cytryny.",
          "grammar_point": "przyimki-dopelniacz"
        },
        {
          "id": "h3-5",
          "prompt": "Idę na dworzec. → Za godzinę wracam…",
          "answer": "Za godzinę wracam z dworca.",
          "grammar_point": "przyimki-dopelniacz"
        },
        {
          "id": "h3-6",
          "prompt": "W pudełku są dwa jajka. → Do ciasta trzeba…",
          "answer": "Do ciasta trzeba pięciu jajek.",
          "accept": ["Do ciasta trzeba pięciu jaj."],
          "grammar_point": "ilosc-dopelniacz"
        }
      ]
    }
  ]
