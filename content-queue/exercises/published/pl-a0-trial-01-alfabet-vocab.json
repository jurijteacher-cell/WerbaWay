{
  "lesson_id": "pl-a0-trial-01-alfabet",
  "exercise_type": "vocab-cards",
  "title": "Słownictwo: pierwsze 38 słów",
  "instruction": "Click a card to flip it. Say the word out loud BEFORE you look at the back. The front shows the Polish word and how to say it.",
  "estimated_minutes": 22,
  "card_language": "en",
  "groups": ["Powitania i pożegnania", "Słowa ratunkowe", "O mnie", "W kawiarni i w sklepie", "Znasz to już"],
  "items": [
    { "term": "cześć", "group": "Powitania i pożegnania", "part_of_speech": "wyrażenie", "pronunciation_en": "cheshch", "definition": "Informal hello AND goodbye. Friends, people your age, anyone who says it to you first.", "example": "Cześć! Jak masz na imię?", "translation_en": "hi / bye" },
    { "term": "dzień dobry", "group": "Powitania i pożegnania", "part_of_speech": "wyrażenie", "pronunciation_en": "jen DOH-bry", "definition": "The safe hello. Shops, offices, strangers, your teacher. Works all day until evening.", "example": "Dzień dobry! Poproszę kawę.", "translation_en": "good morning / good afternoon" },
    { "term": "dobry wieczór", "group": "Powitania i pożegnania", "part_of_speech": "wyrażenie", "pronunciation_en": "DOH-bry VYE-choor", "definition": "Evening hello, roughly after 6 p.m.", "example": "Dobry wieczór, tu Marek.", "translation_en": "good evening" },
    { "term": "dobranoc", "group": "Powitania i pożegnania", "part_of_speech": "wyrażenie", "pronunciation_en": "doh-BRA-nots", "definition": "Said only when someone is going to sleep. Not a goodbye at 9 p.m. in a bar.", "example": "Dobranoc, do jutra!", "translation_en": "good night" },
    { "term": "do widzenia", "group": "Powitania i pożegnania", "part_of_speech": "wyrażenie", "pronunciation_en": "doh vee-DZE-nya", "definition": "Formal goodbye. Leaving a shop, an office, a lesson.", "example": "Dziękuję i do widzenia.", "translation_en": "goodbye" },
    { "term": "na razie", "group": "Powitania i pożegnania", "part_of_speech": "wyrażenie", "pronunciation_en": "nah RAH-zhye", "definition": "Casual see you. Only with people you say cześć to.", "example": "Na razie, piszemy jutro.", "translation_en": "see you" },
    { "term": "miło mi", "group": "Powitania i pożegnania", "part_of_speech": "wyrażenie", "pronunciation_en": "MEE-woh mee", "definition": "Said once, when you meet someone for the first time.", "example": "Bardzo mi miło.", "translation_en": "nice to meet you" },

    { "term": "tak", "group": "Słowa ratunkowe", "part_of_speech": "partykuła", "pronunciation_en": "tahk", "definition": "Yes. Also used as a filler, like English so.", "example": "Tak, rozumiem.", "translation_en": "yes" },
    { "term": "nie", "group": "Słowa ratunkowe", "part_of_speech": "partykuła", "pronunciation_en": "nye", "definition": "No, and also not. One word for both jobs.", "example": "Nie, dziękuję.", "translation_en": "no / not" },
    { "term": "proszę", "group": "Słowa ratunkowe", "part_of_speech": "wyrażenie", "pronunciation_en": "PROH-sheh", "definition": "Please, here you are, you are welcome, come in, go ahead. One word, five jobs.", "example": "Proszę, to twoja kawa.", "translation_en": "please / here you are" },
    { "term": "dziękuję", "group": "Słowa ratunkowe", "part_of_speech": "czasownik", "pronunciation_en": "jen-KOO-yeh", "definition": "Thank you. Careful: if a waiter offers more and you say it, it means no.", "example": "Dziękuję bardzo!", "translation_en": "thank you" },
    { "term": "przepraszam", "group": "Słowa ratunkowe", "part_of_speech": "czasownik", "pronunciation_en": "psheh-PRAH-shahm", "definition": "Sorry AND excuse me. Use it to start any question to a stranger.", "example": "Przepraszam, gdzie jest stacja?", "translation_en": "sorry / excuse me" },
    { "term": "nie rozumiem", "group": "Słowa ratunkowe", "part_of_speech": "wyrażenie", "pronunciation_en": "nye ro-ZOO-myem", "definition": "I don't understand. Your most important sentence for the first year.", "example": "Przepraszam, nie rozumiem.", "translation_en": "I don't understand" },
    { "term": "nie wiem", "group": "Słowa ratunkowe", "part_of_speech": "wyrażenie", "pronunciation_en": "nye vyem", "definition": "I don't know. Different from nie rozumiem: this is about facts, not language.", "example": "Nie wiem, gdzie to jest.", "translation_en": "I don't know" },
    { "term": "powtórz, proszę", "group": "Słowa ratunkowe", "part_of_speech": "wyrażenie", "pronunciation_en": "POF-toosh PROH-sheh", "definition": "Repeat, please. Say this instead of switching to English.", "example": "Powtórz, proszę, wolniej.", "translation_en": "repeat, please" },

    { "term": "jestem", "group": "O mnie", "part_of_speech": "czasownik", "pronunciation_en": "YES-tem", "definition": "I am. Polish drops the word I, so this one word is a full sentence.", "example": "Jestem Tom.", "translation_en": "I am" },
    { "term": "mam na imię", "group": "O mnie", "part_of_speech": "wyrażenie", "pronunciation_en": "mahm nah EE-myeh", "definition": "My name is. Used with your first name only.", "example": "Mam na imię Anna.", "translation_en": "my name is" },
    { "term": "nazywam się", "group": "O mnie", "part_of_speech": "czasownik", "pronunciation_en": "nah-ZI-vahm sheh", "definition": "My name is, full name version. Offices, hotels, phone calls.", "example": "Nazywam się Tom Baker.", "translation_en": "my name is (full name)" },
    { "term": "mieszkam", "group": "O mnie", "part_of_speech": "czasownik", "pronunciation_en": "MYESH-kahm", "definition": "I live somewhere. Not the same as I live my life.", "example": "Mieszkam w Manchesterze.", "translation_en": "I live" },
    { "term": "z Anglii", "group": "O mnie", "part_of_speech": "wyrażenie", "pronunciation_en": "z AN-glee", "definition": "From England. Say z plus the country.", "example": "Jestem z Anglii.", "translation_en": "from England" },
    { "term": "mam ... lat", "group": "O mnie", "part_of_speech": "wyrażenie", "pronunciation_en": "mahm ... laht", "definition": "I am ... years old. Polish says I have years, not I am years.", "example": "Mam czterdzieści lat.", "translation_en": "I am ... years old" },
    { "term": "uczę się", "group": "O mnie", "part_of_speech": "czasownik", "pronunciation_en": "OO-cheh sheh", "definition": "I am learning. The się part never disappears.", "example": "Uczę się polskiego.", "translation_en": "I am learning" },
    { "term": "lubię", "group": "O mnie", "part_of_speech": "czasownik", "pronunciation_en": "LOO-byeh", "definition": "I like. Works for things, people and activities.", "example": "Lubię muzykę.", "translation_en": "I like" },
    { "term": "pracuję", "group": "O mnie", "part_of_speech": "czasownik", "pronunciation_en": "prah-TSOO-yeh", "definition": "I work. Notice: c is ts, so it is prah-TSOO-yeh, never prah-KOO-yeh.", "example": "Pracuję w biurze.", "translation_en": "I work" },
    { "term": "trochę", "group": "O mnie", "part_of_speech": "przysłówek", "pronunciation_en": "TROH-heh", "definition": "A little. Your honest answer to how much Polish do you speak.", "example": "Mówię trochę po polsku.", "translation_en": "a little" },

    { "term": "kawa", "group": "W kawiarni i w sklepie", "part_of_speech": "rzeczownik, ż.", "pronunciation_en": "KAH-vah", "definition": "Coffee. Watch the w: KAH-vah, not KAH-wah.", "example": "Poproszę dużą kawę.", "translation_en": "coffee" },
    { "term": "herbata", "group": "W kawiarni i w sklepie", "part_of_speech": "rzeczownik, ż.", "pronunciation_en": "her-BAH-tah", "definition": "Tea. From Latin herba, which is why it looks nothing like tea.", "example": "Herbata z cytryną, proszę.", "translation_en": "tea" },
    { "term": "woda", "group": "W kawiarni i w sklepie", "part_of_speech": "rzeczownik, ż.", "pronunciation_en": "VOH-dah", "definition": "Water. In a cafe they will ask gazowana or niegazowana: sparkling or still.", "example": "Poproszę wodę bez gazu.", "translation_en": "water" },
    { "term": "poproszę", "group": "W kawiarni i w sklepie", "part_of_speech": "czasownik", "pronunciation_en": "poh-PROH-sheh", "definition": "The ordering word. Say it plus any noun and you have ordered politely.", "example": "Poproszę rachunek.", "translation_en": "I would like" },
    { "term": "ile to kosztuje", "group": "W kawiarni i w sklepie", "part_of_speech": "wyrażenie", "pronunciation_en": "EE-leh toh kosh-TOO-yeh", "definition": "How much is it. Point at the thing while you say it.", "example": "Przepraszam, ile to kosztuje?", "translation_en": "how much is it" },
    { "term": "rachunek", "group": "W kawiarni i w sklepie", "part_of_speech": "rzeczownik, m.", "pronunciation_en": "rah-HOO-nek", "definition": "The bill in a restaurant. In a shop the receipt is paragon.", "example": "Rachunek, proszę.", "translation_en": "the bill" },
    { "term": "płacę kartą", "group": "W kawiarni i w sklepie", "part_of_speech": "wyrażenie", "pronunciation_en": "PWAH-tseh KAR-town", "definition": "I am paying by card. Two traps in three words: ł is w, and c is ts.", "example": "Płacę kartą, nie gotówką.", "translation_en": "I am paying by card" },
    { "term": "smacznego", "group": "W kawiarni i w sklepie", "part_of_speech": "wyrażenie", "pronunciation_en": "smahch-NEH-goh", "definition": "Enjoy your meal. Said to you by staff, and by you to people at your table.", "example": "Smacznego!", "translation_en": "enjoy your meal" },

    { "term": "restauracja", "group": "Znasz to już", "part_of_speech": "rzeczownik, ż.", "pronunciation_en": "res-tau-RAH-tsyah", "definition": "Restaurant. English -tion and -tion-like endings become -cja.", "example": "To dobra restauracja.", "translation_en": "restaurant" },
    { "term": "apteka", "group": "Znasz to już", "part_of_speech": "rzeczownik, ż.", "pronunciation_en": "ahp-TEH-kah", "definition": "Pharmacy. Same root as apothecary, not as pharmacy.", "example": "Apteka jest obok banku.", "translation_en": "pharmacy" },
    { "term": "stacja", "group": "Znasz to już", "part_of_speech": "rzeczownik, ż.", "pronunciation_en": "STAH-tsyah", "definition": "Station. The -cja ending again: station becomes stacja.", "example": "Stacja jest tam.", "translation_en": "station" },
    { "term": "uniwersytet", "group": "Znasz to już", "part_of_speech": "rzeczownik, m.", "pronunciation_en": "oo-nee-ver-SI-tet", "definition": "University. English -ity becomes Polish -ytet.", "example": "Studiuję na uniwersytecie.", "translation_en": "university" },
    { "term": "informacja", "group": "Znasz to już", "part_of_speech": "rzeczownik, ż.", "pronunciation_en": "een-for-MAH-tsyah", "definition": "Information, and also the information desk at a station or airport.", "example": "Informacja jest na dworcu.", "translation_en": "information" },
    { "term": "muzeum", "group": "Znasz to już", "part_of_speech": "rzeczownik, n.", "pronunciation_en": "moo-ZEH-oom", "definition": "Museum. Four syllables, stress on the second from the end: moo-ZEH-oom.", "example": "Muzeum jest zamknięte w poniedziałek.", "translation_en": "museum" }
  ]
}
