      "items": [
        {
          "id": "g1-1",
          "text": "___ mieszkania blisko biura zajęło mi dwa miesiące.",
          "answer": "Znalezienie",
          "options": [
            "Znalezienie",
            "Znaleźć"
          ]
        },
        {
          "id": "g1-2",
          "text": "Muszę ___ ten formularz do piątku.",
          "answer": "wypełnić",
          "options": [
            "wypełnienie",
            "wypełnić"
          ]
        },
        {
          "id": "g1-3",
          "text": "Na bramie wisi tablica: „___ tylko dla pracowników”.",
