    {
      "block_id": "g5",
      "exercise_type": "fill-in-blank",
      "title": "5. Historia Oleny",
      "instruction": "Utwórz rzeczownik od czasownika w nawiasie i postaw go w dobrym przypadku.",
      "items": [
        {
          "id": "g5-1",
          "text": "Przez trzy miesiące Olena była zajęta ___ (szukać) pracy.",
          "answer": "szukaniem",
          "explanation": "zająć się czym? — narzędnik."
        },
        {
          "id": "g5-2",
          "text": "Po ___ (wysłać) czterdziestu CV dostała wreszcie zaproszenie na rozmowę.",
          "answer": "wysłaniu",
          "explanation": "po + miejscownik."
        },
        {
          "id": "g5-3",
          "text": "Przed ___ (rozpocząć) rozmowy rekruterka podała jej szklankę wody.",
          "answer": "rozpoczęciem",
          "explanation": "przed + narzędnik."
        },
        {
          "id": "g5-4",
          "text": "Rekruterka zapytała o powód ___ (odejść) z poprzedniej firmy.",
          "answer": "odejścia",
          "explanation": "powód czego? — dopełniacz."
        },
        {
          "id": "g5-5",
          "text": "Tydzień później przyszedł mail z ___ (zaprosić) na drugi etap.",
          "answer": "zaproszeniem",
          "explanation": "z + narzędnik; s → sz jak w „zaproszony”."
        },
        {
          "id": "g5-6",
          "text": "Po ___ (przeczytać) umowy Olena poprosiła o jeden dzień do namysłu.",
          "answer": "przeczytaniu",
          "explanation": "po + miejscownik."
        }
      ]
    },
    {
      "block_id": "g6",
      "exercise_type": "fill-in-blank",
      "title": "6. Proces czy wynik?",
      "instruction": "Wybierz rzeczownik od czasownika niedokonanego albo dokonanego.",
      "items": [
        {
          "id": "g6-1",
          "text": "___ tego raportu zajęło mi cały dzień.",
          "answer": "Pisanie",
          "options": [
            "Pisanie",
            "Napisanie"
          ],
          "explanation": "Zajęło cały dzień — liczy się proces, więc niedokonany."
        },
        {
          "id": "g6-2",
          "text": "Po ___ raportu wyślij go do szefowej.",
          "answer": "napisaniu",
          "options": [
            "pisaniu",
            "napisaniu"
          ],
          "explanation": "Najpierw gotowy wynik, potem następna czynność — dokonany."
        },
        {
          "id": "g6-3",
          "text": "Codzienne ___ maili zabiera mi dwie godziny.",
          "answer": "sprawdzanie",
          "options": [
            "sprawdzanie",
            "sprawdzenie"
          ],
          "explanation": "Codziennie, wiele razy — powtarzanie, więc niedokonany."
        },
        {
          "id": "g6-4",
          "text": "Przed ___ umowy przeczytaj ją dwa razy.",
          "answer": "podpisaniem",
          "options": [
            "podpisywaniem",
            "podpisaniem"
          ],
          "explanation": "Jeden moment, jedna czynność — dokonany."
        },
        {
          "id": "g6-5",
          "text": "___ nowego systemu trwało pół roku.",
          "answer": "Wdrażanie",
          "options": [
            "Wdrażanie",
            "Wdrożenie"
          ],
          "explanation": "Trwało pół roku — proces, więc niedokonany."
        }
      ]
    },
    {
