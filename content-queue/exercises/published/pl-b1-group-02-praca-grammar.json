    {
      "block_id": "g8",
      "exercise_type": "fill-in-blank",
      "title": "8. Pułapki: przeczenie, wyjątki, kalki",
      "instruction": "Wybierz poprawną formę. Po odpowiedzi przeczytaj wyjaśnienie.",
      "items": [
        {
          "id": "g8-1",
          "text": "Kara za ___ składek na czas może być wysoka.",
          "answer": "niezapłacenie",
          "options": [
            "niezapłacenie",
            "nie zapłacenie"
