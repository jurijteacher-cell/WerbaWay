      "exercise_type": "drag-and-drop",
      "title": "6. Jeden dzień w mieście",
      "instruction": "Przeciągnij wyrażenie w lukę. Trzy wyrażenia w banku są błędne — nie pasują nigdzie.",
      "bank": ["na poczcie", "w kawiarni", "w nosidle", "po spacerze", "w tramwaju", "o dzieciach", "w poczcie", "o dzieci", "po spacer"],
      "items": [
        {
          "id": "g6-1",
          "text": "Rano byliśmy ___, bo trzeba było odebrać paczkę.",
          "answer": "na poczcie",
          "explanation": "Poczta idzie z na, więc forma w poczcie jest błędna.",
          "grammar_point": "kalki-uk"
        },
        {
          "id": "g6-2",
          "text": "Potem usiedliśmy ___ obok targu.",
          "answer": "w kawiarni",
          "explanation": "Kawiarnia kończy się na -nia, więc w miejscowniku ma jedno i.",
          "grammar_point": "miejscownik-rzeczownik"
        },
        {
          "id": "g6-3",
          "text": "Dziecko zasnęło ___ po dziesięciu minutach.",
          "answer": "w nosidle",
          "explanation": "Nosidło to rodzaj nijaki: ł przed -e zmienia się w l.",
          "grammar_point": "miejscownik-rzeczownik"
        },
        {
          "id": "g6-4",
          "text": "Wróciliśmy tramwajem dopiero ___.",
          "answer": "po spacerze",
          "explanation": "Po w znaczeniu „potem” żąda miejscownika, dlatego po spacer jest błędem.",
          "grammar_point": "kalki-uk"
        },
        {
          "id": "g6-5",
          "text": "Ktoś ustąpił nam miejsca ___.",
          "answer": "w tramwaju",
          "explanation": "Tramwaj ma miękkie zakończenie, więc bierze -u, nie -e.",
          "grammar_point": "miejscownik-rzeczownik"
        },
        {
          "id": "g6-6",
          "text": "Wieczorem długo rozmawialiśmy z sąsiadami ___.",
          "answer": "o dzieciach",
          "explanation": "Rozmawiać o kimś to miejscownik, a w liczbie mnogiej końcówka jest zawsze -ach.",
          "grammar_point": "kalki-uk"
        }
      ]
    }
