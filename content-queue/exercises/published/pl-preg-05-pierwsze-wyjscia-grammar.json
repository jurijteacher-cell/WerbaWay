        { "id": "g2-6", "left": "gazeta", "right": "w gazecie", "grammar_point": "miejscownik-rzeczownik" },
        { "id": "g2-7", "left": "miasto", "right": "w mieście", "grammar_point": "miejscownik-rzeczownik" },
        { "id": "g2-8", "left": "pociąg", "right": "w pociągu", "grammar_point": "miejscownik-rzeczownik" }
      ]
    },
    {
      "block_id": "g3",
      "part": 1,
      "covers_cards": [3, 6],
      "exercise_type": "fill-in-blank",
      "title": "3. Przymiotnik i rzeczownik razem",
      "instruction": "Wybierz wersję, w której oba słowa mają tę samą formę.",
      "items": [
        {
          "id": "g3-1",
          "text": "Mieszkamy ___ bez windy.",
          "options": ["w starym budynku", "w starej budynku"],
          "answer": "w starym budynku",
          "grammar_point": "miejscownik-przymiotnik"
        },
        {
          "id": "g3-2",
          "text": "Czekam ___, tam jest podjazd.",
          "options": ["przy drugim wejściu", "przy drugiej wejściu"],
          "answer": "przy drugim wejściu",
          "grammar_point": "miejscownik-przymiotnik"
        },
        {
          "id": "g3-3",
          "text": "Byłyśmy wczoraj ___ obok poczty.",
          "options": ["w nowej kawiarni", "w nowym kawiarni"],
          "answer": "w nowej kawiarni",
          "grammar_point": "miejscownik-przymiotnik"
        },
        {
          "id": "g3-4",
          "text": "Mała zasnęła ___ po dwóch minutach.",
          "options": ["w ciepłym kombinezonie", "w ciepłej kombinezonie"],
          "answer": "w ciepłym kombinezonie",
          "grammar_point": "miejscownik-przymiotnik"
        },
        {
          "id": "g3-5",
          "text": "Wysiądź ___ przed szkołą.",
          "options": ["na następnym przystanku", "na następnej przystanku"],
          "answer": "na następnym przystanku",
          "grammar_point": "miejscownik-przymiotnik"
        },
        {
          "id": "g3-6",
          "text": "Folia przeciwdeszczowa leży ___ pod wózkiem.",
          "options": ["w małym koszyku", "w małej koszyku"],
          "answer": "w małym koszyku",
          "grammar_point": "miejscownik-przymiotnik"
        }
      ]
    },
    {
      "block_id": "g4",
      "part": 2,
      "covers_cards": [8, 9],
      "exercise_type": "fill-in-blank",
      "title": "4. w czy na, o kogo czy o kim",
      "instruction": "Wybierz przyimek. Po poprawnej odpowiedzi przeczytaj wyjaśnienie.",
      "items": [
        {
          "id": "g4-1",
          "text": "Kupiłam znaczki ___ poczcie.",
          "options": ["na", "w"],
          "answer": "na",
          "explanation": "Poczta jest instytucją, a te po polsku często idą z na: na poczcie, na dworcu, na uczelni.",
          "grammar_point": "w-vs-na"
        },
        {
          "id": "g4-2",
          "text": "Jestem ___ sklepie, wychodzę za chwilę.",
          "options": ["w", "na"],
          "answer": "w",
          "explanation": "Jesteśmy w środku budynku, dlatego w sklepie, w kawiarni, w windzie.",
          "grammar_point": "w-vs-na"
        },
        {
          "id": "g4-3",
          "text": "Siedzieliśmy ___ ławce obok stawu.",
          "options": ["na", "w"],
          "answer": "na",
          "explanation": "Na powierzchni czegoś: na ławce, na krzesełku, na podłodze.",
          "grammar_point": "w-vs-na"
        },
        {
          "id": "g4-4",
          "text": "Starsza pani pytała ___ córkę.",
          "options": ["o", "na"],
          "answer": "o",
          "explanation": "Pytać o kogoś to biernik — o córkę. Forma zmienia się przy innym czasowniku: rozmawiać o córce.",
          "grammar_point": "o-kim-o-czym"
        },
        {
          "id": "g4-5",
          "text": "Przez godzinę rozmawiałyśmy ___ dzieciach.",
          "options": ["o", "na"],
          "answer": "o",
          "explanation": "Rozmawiać, myśleć i czytać — o kimś, czyli miejscownik. W liczbie mnogiej: o dzieciach.",
          "grammar_point": "o-kim-o-czym"
        },
        {
          "id": "g4-6",
          "text": "Byłam ___ dworcu i nie zdążyłam na pociąg.",
          "options": ["na", "w"],
          "answer": "na",
          "explanation": "Dworzec, podobnie jak poczta, łączy się z na, chociaż wchodzimy do środka.",
          "grammar_point": "w-vs-na"
        }
      ]
    },
    {
