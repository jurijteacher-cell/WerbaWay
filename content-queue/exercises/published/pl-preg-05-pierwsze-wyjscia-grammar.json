  "title": "Miejscownik: od rozpoznawania do opowiadania",
  "instruction": "Sześć bloków w dwóch częściach. Rób je po kolei — każdy dokłada jedną rzecz.",
  "estimated_minutes": 23,
  "blocks": [
    {
      "block_id": "g1",
      "part": 1,
