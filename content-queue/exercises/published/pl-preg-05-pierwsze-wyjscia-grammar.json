      "exercise_type": "fill-in-blank",
      "title": "1. Rozgrzewka: gdzie to jest?",
      "instruction": "Wybierz poprawną formę.",
      "items": [
        {
          "id": "g1-1",
          "text": "Czekam na Ciebie ___ obok apteki.",
          "options": ["w kawiarni", "w kawiarnie"],
          "answer": "w kawiarni",
          "grammar_point": "miejscownik-rzeczownik"
        },
        {
          "id": "g1-2",
          "text": "Dziecko zasnęło ___ pod drzewem.",
          "options": ["na ławce", "na ławki"],
          "answer": "na ławce",
          "grammar_point": "miejscownik-rzeczownik"
        },
        {
          "id": "g1-3",
          "text": "Spotkajmy się ___, przy przejściu dla pieszych.",
          "options": ["na ulicy", "na ulice"],
          "answer": "na ulicy",
          "grammar_point": "miejscownik-rzeczownik"
        },
        {
          "id": "g1-4",
          "text": "Zostawiłam torbę ___ i musiałam wracać.",
          "options": ["w windzie", "w windie"],
          "answer": "w windzie",
          "grammar_point": "miejscownik-rzeczownik"
        },
        {
          "id": "g1-5",
          "text": "Kupiłam te chusteczki ___ przy rynku.",
          "options": ["w aptece", "w apteke"],
          "answer": "w aptece",
          "grammar_point": "miejscownik-rzeczownik"
        },
        {
          "id": "g1-6",
          "text": "Stoję ___ i czekam na rachunek.",
          "options": ["przy kasie", "przy kasa"],
          "answer": "przy kasie",
          "grammar_point": "przyimki-miejscownik"
        }
      ]
    },
    {
      "block_id": "g2",
      "part": 1,
      "covers_cards": [4, 5],
      "exercise_type": "matching",
      "title": "2. Od mianownika do miejscownika",
      "instruction": "Połącz słowo z jego formą po przyimku.",
      "items": [
        { "id": "g2-1", "left": "park", "right": "w parku", "grammar_point": "miejscownik-rzeczownik" },
