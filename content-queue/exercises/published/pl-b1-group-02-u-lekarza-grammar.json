          "grammar_point": "dopelniacz-m-a-u",
          "options": [
            "okulisty",
            "okulista",
            "okulistę"
          ],
          "explanation": "Okulista to mężczyzna, ale kończy się na -a i odmienia się jak kobieta: do okulisty."
        },
        {
          "id": "g3-10",
          "text": "Na wizytę nie przyszła żadna ___.",
          "answer": "pacjentka",
          "grammar_point": "pulapka-przypadek",
          "options": [
            "pacjentka",
            "pacjentki"
