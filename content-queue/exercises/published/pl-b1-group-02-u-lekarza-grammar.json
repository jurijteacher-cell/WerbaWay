        {
          "id": "g3-8",
          "text": "Po upadku Ewa nie może ruszać ___.",
          "answer": "palcem",
          "grammar_point": "pulapka-przypadek",
          "options": [
            "palcem",
            "palca"
          ],
          "explanation": "Ruszać czym? — narzędnik: palcem. Nie każde zdanie z ciałem to dopełniacz."
