    {
      "block_id": "g3",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "2. -a, -u czy inny przypadek?",
      "instruction": "Wybierz poprawną wersję. Po błędzie przeczytaj wyjaśnienie.",
      "items": [
        {
          "id": "g3-1",
          "text": "Od wczoraj nie mam ___.",
          "answer": "apetytu",
          "grammar_point": "dopelniacz-m-a-u",
          "options": [
            "apetytu",
            "apetyta"
          ],
          "explanation": "Apetyt to rzecz abstrakcyjna — zwykle -u: apetytu."
        },
        {
          "id": "g3-2",
          "text": "Wieczorem zadzwoniłam do ___.",
          "answer": "lekarza",
          "grammar_point": "dopelniacz-m-a-u",
          "options": [
            "lekarza",
            "lekarzu"
          ],
          "explanation": "Do + dopełniacz. Osoba — końcówka -a: lekarza. „Lekarzu” to miejscownik albo wołacz."
        },
        {
          "id": "g3-3",
          "text": "Nie mogę zasnąć z powodu ___.",
          "answer": "kaszlu",
          "grammar_point": "dopelniacz-m-a-u",
          "options": [
            "kaszlu",
            "kaszla",
            "kaszelu"
          ],
          "explanation": "Kaszel → kaszlu: -u i znika „e”. Z powodu + dopełniacz."
        },
        {
          "id": "g3-4",
          "text": "Pielęgniarka wróciła z nocnego ___ o siódmej rano.",
          "answer": "dyżuru",
          "grammar_point": "dopelniacz-m-a-u",
          "options": [
            "dyżuru",
            "dyżura"
          ],
          "explanation": "Dyżur → dyżuru: rzecz abstrakcyjna, zwykle -u."
        },
        {
          "id": "g3-5",
          "text": "Do ___ jest dziesięć minut pieszo.",
          "answer": "szpitala",
          "grammar_point": "dopelniacz-m-a-u",
          "options": [
            "szpitala",
            "szpitalu"
          ],
          "explanation": "Szpital to rzecz, a jednak -a: szpitala. Dlatego mówimy „zwykle”, a nie „zawsze”."
        },
        {
          "id": "g3-6",
          "text": "Szukam ___ na suchy kaszel.",
          "answer": "syropu",
          "grammar_point": "dopelniacz-m-a-u",
          "options": [
            "syropu",
            "syropa"
          ],
          "explanation": "Syrop → syropu: substancja, zwykle -u."
        },
        {
          "id": "g3-7",
          "text": "Pani w rejestracji nie znalazła mojego ___.",
          "answer": "numeru",
          "grammar_point": "dopelniacz-m-a-u",
          "options": [
            "numeru",
            "numera"
          ],
          "explanation": "Numer → numeru. Ukraińskie „номера” podpowiada -a, ale po polsku -u."
