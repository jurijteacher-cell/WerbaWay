{
  "lesson_id": "pl-preg-r2-powtorka",
  "exercise_type": "fill-in-blank",
  "title": "Powtórka: zdjęcia, słowa, tryb rozkazujący i celownik",
  "instruction": "Sześć bloków. Bloki 1–2 to słowa (ze zdjęciami), bloki 3–6 to gramatyka i tekst. Kliknij odpowiedź i sprawdź.",
  "estimated_minutes": 25,
  "blocks": [
    {
      "block_id": "g1",
      "title": "1. Co widać na zdjęciu?",
      "exercise_type": "fill-in-blank",
      "instruction": "Popatrz na zdjęcie i wybierz słowo, które pasuje.",
      "items": [
        {
          "id": "g1-1",
          "text": "Dziecko jedzie ze szpitala do domu w ___.",
          "options": [
            "sali porodowej",
            "foteliku samochodowym",
            "izbie przyjęć"
          ],
          "answer": "foteliku samochodowym",
          "grammar_point": "slownictwo",
          "image_url": "https://images.unsplash.com/photo-1619719287848-883c8f26efbc?fm=jpg&q=80&w=900&fit=max",
          "image_alt": "Fotelik samochodowy dla dziecka w samochodzie",
          "image_credit": "Fot. Erik Mclean / Unsplash"
        },
        {
          "id": "g1-2",
          "text": "Torba jest już ___ i czeka przy drzwiach.",
          "options": [
            "podpisana",
            "spakowana",
            "urodzona"
          ],
          "answer": "spakowana",
          "grammar_point": "slownictwo",
          "image_url": "https://images.unsplash.com/photo-1574815963212-14443d0f94be?fm=jpg&q=80&w=900&fit=max",
          "image_alt": "Otwarta torba pełna ubrań na łóżku",
          "image_credit": "Fot. Compagnons / Unsplash"
        },
        {
          "id": "g1-3",
          "text": "Kobieta stoi spokojnie i głęboko ___ — tak jak w szkole rodzenia.",
          "options": [
            "oddycha",
            "przewija",
            "podpisuje"
          ],
          "answer": "oddycha",
          "grammar_point": "slownictwo",
          "image_url": "https://images.unsplash.com/photo-1710897869539-a48e3d69a8d7?fm=jpg&q=80&w=900&fit=max",
          "image_alt": "Kobieta w ciąży stoi z zamkniętymi oczami",
          "image_credit": "Fot. Jeferson Santu / Unsplash"
        },
        {
          "id": "g1-4",
          "text": "Po porodzie mama z dzieckiem leży dwa albo trzy dni na ___.",
          "options": [
            "izbie przyjęć",
            "poczekalni",
            "oddziale położniczym"
          ],
          "answer": "oddziale położniczym",
          "grammar_point": "slownictwo",
          "image_url": "https://images.unsplash.com/photo-1710698936989-500f359c6482?fm=jpg&q=80&w=900&fit=max",
          "image_alt": "Sala szpitalna z łóżkiem i fotelem",
          "image_credit": "Fot. Max Tcvetkov / Unsplash"
        },
        {
          "id": "g1-5",
          "text": "Mama ___ córkę — zmienia jej pieluchę.",
          "options": [
            "przewija",
            "kąpie",
            "usypia"
          ],
          "answer": "przewija",
          "grammar_point": "slownictwo",
          "image_url": "https://images.unsplash.com/photo-1756539526825-1e52381566a9?fm=jpg&q=80&w=900&fit=max",
          "image_alt": "Mama zmienia pieluchę dziecku na przewijaku",
          "image_credit": "Fot. Marius Muresan / Unsplash"
        },
        {
          "id": "g1-6",
          "text": "Ten ___ ma dopiero kilka dni i śpi prawie cały dzień.",
          "options": [
            "pediatra",
            "noworodek",
            "pępek"
          ],
          "answer": "noworodek",
          "grammar_point": "slownictwo",
          "image_url": "https://images.unsplash.com/photo-1582212742235-a2500f31cb39?fm=jpg&q=80&w=900&fit=max",
          "image_alt": "Noworodek śpi na białym prześcieradle",
          "image_credit": "Fot. hessam nabavi / Unsplash"
        },
        {
          "id": "g1-7",
          "text": "W urzędzie rodzice ___ urodzenie dziecka i podpisują dokumenty.",
          "options": [
            "zgłaszają",
            "przewijają",
            "oddychają"
          ],
          "answer": "zgłaszają",
          "grammar_point": "slownictwo",
          "image_url": "https://images.unsplash.com/photo-1664463760781-f159dfe3af30?fm=jpg&q=80&w=900&fit=max",
          "image_alt": "Para podpisuje dokument przy biurku",
          "image_credit": "Fot. Annika Wischnewsky / Unsplash"
        }
      ]
    },
    {
      "block_id": "g2",
      "title": "2. Słowa z dwóch lekcji",
      "exercise_type": "matching",
      "instruction": "Kliknij słowo po lewej, potem jego znaczenie po prawej.",
      "items": [
        {
          "id": "g2-1",
          "left": "skurcz",
          "right": "ból, który przychodzi i odchodzi, coraz częściej",
          "grammar_point": "slownictwo"
        },
        {
          "id": "g2-2",
          "left": "wody płodowe",
          "right": "kiedy odejdą, trzeba od razu jechać do szpitala",
          "grammar_point": "slownictwo"
        },
        {
          "id": "g2-3",
          "left": "wypis",
          "right": "dzień, w którym wracasz ze szpitala do domu",
          "grammar_point": "slownictwo"
        },
        {
          "id": "g2-4",
          "left": "połóg",
          "right": "sześć tygodni po porodzie",
          "grammar_point": "slownictwo"
        },
        {
          "id": "g2-5",
          "left": "nawał mleczny",
          "right": "nagle dużo mleka, zwykle około trzeciej doby",
          "grammar_point": "slownictwo"
        },
        {
          "id": "g2-6",
          "left": "wizyta patronażowa",
          "right": "położna przychodzi do was do domu",
          "grammar_point": "slownictwo"
        },
        {
          "id": "g2-7",
          "left": "akt urodzenia",
          "right": "dokument z urzędu stanu cywilnego",
          "grammar_point": "slownictwo"
        }
      ]
    },
    {
      "block_id": "g3",
      "title": "3. Weź, nie zapomnij, proszę zadzwonić",
      "exercise_type": "fill-in-blank",
      "instruction": "Wybierz formę polecenia, prośby albo rady.",
      "items": [
        {
          "id": "g3-1",
          "text": "Instruktorka: „___ spokojnie, nosem!”",
          "options": [
            "Oddychać",
            "Oddychaj",
            "Oddycha"
          ],
          "answer": "Oddychaj",
          "grammar_point": "tryb-rozkazujacy",
          "explanation": "Forma na ty: ona oddycha → oddychaj."
        },
        {
          "id": "g3-2",
          "text": "Tomku, ___ mi torbę z przedpokoju!",
          "options": [
            "podaj",
            "podać",
            "podajesz"
          ],
          "answer": "podaj",
          "grammar_point": "tryb-rozkazujacy"
        },
        {
          "id": "g3-3",
          "text": "Położna do Agaty i Tomka: „___ od razu, jeśli odejdą wody!”",
          "options": [
            "Przyjedź",
            "Przyjedźmy",
            "Przyjedźcie"
          ],
          "answer": "Przyjedźcie",
          "grammar_point": "tryb-rozkazujacy",
          "explanation": "Do dwóch osób — forma na wy: -cie."
        },
        {
          "id": "g3-4",
          "text": "Kochanie, ___ spokojny, wszystko jest gotowe.",
          "options": [
            "być",
            "jesteś",
            "bądź"
          ],
          "answer": "bądź",
          "grammar_point": "tryb-rozkazujacy",
          "explanation": "Być → bądź. Ta forma jest nieregularna."
        },
        {
          "id": "g3-5",
          "text": "Nie ___ tak szybko po porodzie!",
          "options": [
            "wstań",
            "wstawaj",
            "wstawać"
          ],
          "answer": "wstawaj",
          "grammar_point": "tryb-rozkazujacy",
          "explanation": "Zakaz: nie + forma niedokonana."
        },
        {
          "id": "g3-6",
          "text": "Tylko nie ___ dokumentów!",
          "options": [
            "zapomnij",
            "zapomnieć",
            "zapomniałaś"
          ],
          "answer": "zapomnij",
          "grammar_point": "tryb-rozkazujacy",
          "explanation": "Ostrzeżenie przed czymś, co może się zdarzyć przypadkiem: nie zapomnij, nie spóźnij się."
        },
        {
          "id": "g3-7",
          "text": "Rejestratorka: „___ usiąść i chwilę poczekać”.",
          "options": [
            "Usiądź",
            "Niech",
            "Proszę"
          ],
          "answer": "Proszę",
          "grammar_point": "tryb-rozkazujacy",
          "explanation": "Grzecznie: proszę + bezokolicznik."
        },
        {
          "id": "g3-8",
          "text": "Niech pan ___ na korytarzu, zaraz pana zawołamy.",
          "options": [
            "poczeka",
            "poczekaj",
            "czekać"
          ],
          "answer": "poczeka",
          "grammar_point": "tryb-rozkazujacy",
          "explanation": "Po niech — zwykła forma on / ona."
        },
        {
          "id": "g3-9",
          "text": "Jesteśmy zmęczeni. ___ krótką przerwę!",
          "options": [
            "Dawaj zrobimy",
            "Zróbmy",
            "Zrobić"
          ],
          "answer": "Zróbmy",
          "grammar_point": "tryb-rozkazujacy",
          "explanation": "Propozycja dla nas: forma -my. „Dawaj zrobimy” to kalka z ukraińskiego."
        }
      ]
    },
    {
      "block_id": "g4",
      "title": "4. Komu? Celownik",
      "exercise_type": "fill-in-blank",
      "instruction": "Wybierz formę, która odpowiada na pytanie komu.",
      "items": [
        {
          "id": "g4-1",
          "text": "Agata dziękuje ___ za pieluchy.",
          "options": [
            "siostrę",
            "siostry",
            "siostrze"
          ],
          "answer": "siostrze",
          "grammar_point": "celownik",
          "explanation": "Dziękować komu? Siostra → siostrze."
        },
        {
          "id": "g4-2",
          "text": "Podaj ___ ładowarkę, proszę.",
          "options": [
            "mi",
            "mnie",
            "ja"
          ],
          "answer": "mi",
          "grammar_point": "celownik",
          "explanation": "Krótka forma w środku zdania: podaj mi."
        },
        {
          "id": "g4-3",
          "text": "Mama ugotowała zupę ___.",
          "options": [
            "Tomka",
            "Tomkowi",
            "Tomku"
          ],
          "answer": "Tomkowi",
          "grammar_point": "celownik"
        },
        {
          "id": "g4-4",
          "text": "Położna pokazała ___, jak przystawiać córkę do piersi.",
          "options": [
            "Agacie",
            "Agatę",
            "Agaty"
          ],
          "answer": "Agacie",
          "grammar_point": "celownik",
          "explanation": "Agata → Agacie: t zmienia się w c."
        },
        {
          "id": "g4-5",
          "text": "Przynieś ___ ciepły kocyk.",
          "options": [
            "dziecko",
            "dziecka",
            "dziecku"
          ],
          "answer": "dziecku",
          "grammar_point": "celownik"
        },
        {
          "id": "g4-6",
          "text": "Zadzwoniłam do brata i powiedziałam ___ wszystko.",
          "options": [
            "bratowi",
            "bratu",
            "brata"
          ],
          "answer": "bratu",
          "grammar_point": "celownik",
          "explanation": "Brat to wyjątek: bratu, nie bratowi."
        },
        {
          "id": "g4-7",
          "text": "Pomóż ___ w nocy, jest bardzo zmęczona.",
          "options": [
            "ją",
            "jej",
            "niej"
          ],
          "answer": "jej",
          "grammar_point": "celownik",
          "explanation": "Pomagać komu? — jej."
        },
        {
          "id": "g4-8",
          "text": "Zadzwoń ___ wieczorem!",
          "options": [
            "mi",
            "do mnie",
            "mnie"
          ],
          "answer": "do mnie",
          "grammar_point": "celownik",
          "explanation": "Po polsku dzwoni się do kogoś: zadzwoń do mnie."
        },
        {
          "id": "g4-9",
          "text": "Babcia kupiła prezenty ___ i wnuczce.",
          "options": [
            "rodzicom",
            "rodziców",
            "rodzice"
          ],
          "answer": "rodzicom",
          "grammar_point": "celownik",
          "explanation": "Liczba mnoga zawsze -om."
        },
        {
          "id": "g4-10",
          "text": "Powiedz ___, że wracamy jutro.",
          "options": [
            "dla mamy",
            "mamę",
            "mamie"
          ],
          "answer": "mamie",
          "grammar_point": "celownik",
          "explanation": "Powiedzieć komu? Mamie. „Dla mamy” to kalka."
        }
      ]
    },
    {
      "block_id": "g5",
      "title": "5. Karteczki na lodówce — prawda czy fałsz?",
      "exercise_type": "true-false",
      "instruction": "Wróć do karteczek i zdecyduj.",
      "items": [
        {
          "id": "g5-1",
          "statement": "Torba do szpitala stoi w sypialni.",
          "answer": false,
          "grammar_point": "czytanie",
          "explanation": "Torba stoi w przedpokoju."
        },
        {
          "id": "g5-2",
          "statement": "Fotelik samochodowy jest już w samochodzie.",
          "answer": true,
          "grammar_point": "czytanie",
          "explanation": "Tak: fotelik jest już w bagażniku."
        },
        {
          "id": "g5-3",
          "statement": "Jeśli odejdą wody płodowe, Agata ma poczekać do rana.",
          "answer": false,
          "grammar_point": "czytanie",
          "explanation": "Nie: jeśli odejdą wody, trzeba przyjechać od razu, nawet w nocy."
        },
        {
          "id": "g5-4",
          "statement": "Mama Agaty prosi Tomka, żeby jeszcze nie zapraszał gości.",
          "answer": true,
          "grammar_point": "czytanie",
          "explanation": "Tak: Agacie i małej potrzebny jest spokój."
        },
        {
          "id": "g5-5",
          "statement": "Położna radzi codziennie czymś smarować pępek.",
          "answer": false,
          "grammar_point": "czytanie",
          "explanation": "Nie: pępek ma być czysty i suchy, niczym go nie smarujemy."
        },
        {
          "id": "g5-6",
          "statement": "Ania ma przywieźć pieluchy w sobotę.",
          "answer": true,
          "grammar_point": "czytanie",
          "explanation": "Tak: Agata prosi Anię o pieluchy na sobotę."
        },
        {
          "id": "g5-7",
          "statement": "Tomek zgłosił urodzenie córki w urzędzie stanu cywilnego.",
          "answer": true,
          "grammar_point": "czytanie",
          "explanation": "Tak: Tomek zgłosił urodzenie i mała ma akt urodzenia."
        }
      ]
    },
    {
      "block_id": "g6",
      "title": "6. Ułóż zdanie",
      "exercise_type": "sentence-building",
      "instruction": "Klikaj kawałki w dobrej kolejności.",
      "items": [
        {
