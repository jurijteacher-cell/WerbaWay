            "dziecku"
          ],
          "answer": "Przynieś dziecku ciepły kocyk.",
          "grammar_point": "celownik",
          "prompt": "Poproś o kocyk dla dziecka."
        },
        {
          "id": "g6-3",
          "words": [
            "tak szybko!",
            "wstawaj",
            "nie"
          ],
          "answer": "Nie wstawaj tak szybko!",
          "grammar_point": "tryb-rozkazujacy",
          "prompt": "Powiedz koleżance, żeby nie wstawała tak szybko."
        },
        {
          "id": "g6-4",
          "words": [
            "do pediatry",
            "zadzwonić",
            "proszę od razu"
          ],
          "answer": "Proszę od razu zadzwonić do pediatry.",
          "grammar_point": "tryb-rozkazujacy",
          "prompt": "Położna mówi pacjentce, co ma zrobić."
        },
        {
          "id": "g6-5",
          "words": [
            "za pomoc",
            "ci",
            "dziękuję"
          ],
          "answer": "Dziękuję ci za pomoc.",
          "grammar_point": "celownik",
          "prompt": "Podziękuj siostrze."
        }
      ]
    }
  ]
}
