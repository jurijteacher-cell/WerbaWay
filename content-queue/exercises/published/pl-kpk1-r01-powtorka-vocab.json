      "term": "Dzień dobry!",
      "group": "Powitania i pożegnania",
      "part_of_speech": "zwrot",
      "definition": "Oficjalne powitanie: do pani, do pana, w sekretariacie.",
      "example": "Dzień dobry, pani Ewo!",
      "translation_uk": "добрий день (офіційно)"
    },
    {
      "id": "v02",
      "term": "Cześć!",
      "group": "Powitania i pożegnania",
      "part_of_speech": "zwrot",
      "definition": "Nieoficjalne powitanie i pożegnanie: do kolegi, do koleżanki.",
      "example": "Cześć, Piotr! Do jutra!",
      "translation_uk": "привіт / бувай (неофіційно)"
    },
    {
