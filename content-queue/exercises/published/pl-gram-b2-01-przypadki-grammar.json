      "items": [
        { "id": "g4-1", "text": "W lipcu jedziemy ___.", "options": ["nad jezioro", "nad jeziorem"], "answer": "nad jezioro", "explanation": "Ruch, pytanie dokąd? — nad + biernik.", "grammar_point": "przypadki-przyimki" },
        { "id": "g4-2", "text": "Całe dzieciństwo spędziłem ___.", "options": ["nad jezioro", "nad jeziorem"], "answer": "nad jeziorem", "explanation": "Stan, pytanie gdzie? — nad + narzędnik.", "grammar_point": "przypadki-przyimki" },
        { "id": "g4-3", "text": "Dziś wieczorem idziemy ___.", "options": ["na wesele", "na weselu"], "answer": "na wesele", "explanation": "Ruch: na + biernik.", "grammar_point": "przypadki-przyimki" },
        { "id": "g4-4", "text": "Poznali się ___ u znajomych.", "options": ["na wesele", "na weselu"], "answer": "na weselu", "explanation": "Gdzie? — na + miejscownik.", "grammar_point": "przypadki-przyimki" },
        { "id": "g4-5", "text": "Piłka wpadła ___.", "options": ["pod samochód", "pod samochodem"], "answer": "pod samochód", "explanation": "Ruch: pod + biernik.", "grammar_point": "przypadki-przyimki" },
        { "id": "g4-6", "text": "Klucze leżą ___.", "options": ["pod wycieraczką", "pod wycieraczkę"], "answer": "pod wycieraczką", "explanation": "Stan: pod + narzędnik.", "grammar_point": "przypadki-przyimki" },
        { "id": "g4-7", "text": "Idę ___, zaraz wracam.", "options": ["do sklepu", "w sklepie"], "answer": "do sklepu", "explanation": "Ruch: do + dopełniacz.", "grammar_point": "przypadki-przyimki" },
        { "id": "g4-8", "text": "Czekam na ciebie ___.", "options": ["w kawiarni", "do kawiarni"], "answer": "w kawiarni", "explanation": "Stan: w + miejscownik.", "grammar_point": "przypadki-przyimki" }
      ]
    },
