      "title": "1. Jaki to przypadek?",
      "instruction": "Wybierz przypadek wyróżnionego słowa.",
      "items": [
        { "id": "g1-1", "text": "„Wysłałem prezent babci” — słowo „babci” to ___.", "options": ["mianownik", "dopełniacz", "celownik", "biernik", "narzędnik", "miejscownik"], "answer": "celownik", "explanation": "Wysłać komu? — babci. Odbiorca to celownik.", "grammar_point": "przypadki-funkcje" },
        { "id": "g1-2", "text": "„Nie widzę parasola” — słowo „parasola” to ___.", "options": ["mianownik", "dopełniacz", "celownik", "biernik", "narzędnik", "miejscownik"], "answer": "dopełniacz", "explanation": "Po negacji biernik zmienia się w dopełniacz.", "grammar_point": "przypadki-funkcje" },
        { "id": "g1-3", "text": "„Jeżdżę do pracy rowerem” — słowo „rowerem” to ___.", "options": ["mianownik", "dopełniacz", "celownik", "biernik", "narzędnik", "miejscownik"], "answer": "narzędnik", "explanation": "Czym jeżdżę? — narzędzie, środek transportu.", "grammar_point": "przypadki-funkcje" },
        { "id": "g1-4", "text": "„Spędziliśmy weekend w Gdańsku” — słowo „Gdańsku” to ___.", "options": ["mianownik", "dopełniacz", "celownik", "biernik", "narzędnik", "miejscownik"], "answer": "miejscownik", "explanation": "Gdzie? — w + miejscownik.", "grammar_point": "przypadki-funkcje" },
        { "id": "g1-5", "text": "„Znasz tę piosenkę?” — słowo „piosenkę” to ___.", "options": ["mianownik", "dopełniacz", "celownik", "biernik", "narzędnik", "miejscownik"], "answer": "biernik", "explanation": "Znać kogo? co? — obiekt działania.", "grammar_point": "przypadki-funkcje" },
        { "id": "g1-6", "text": "„Ten pan to mój sąsiad” — słowo „sąsiad” to ___.", "options": ["mianownik", "dopełniacz", "celownik", "biernik", "narzędnik", "miejscownik"], "answer": "mianownik", "explanation": "Po „to” stoi mianownik.", "grammar_point": "przypadki-funkcje" },
        { "id": "g1-7", "text": "„Jej mąż jest weterynarzem” — słowo „weterynarzem” to ___.", "options": ["mianownik", "dopełniacz", "celownik", "biernik", "narzędnik", "miejscownik"], "answer": "narzędnik", "explanation": "Być kim? — narzędnik.", "grammar_point": "przypadki-funkcje" },
        { "id": "g1-8", "text": "„Dziękuję koledze za pomoc” — słowo „koledze” to ___.", "options": ["mianownik", "dopełniacz", "celownik", "biernik", "narzędnik", "miejscownik"], "answer": "celownik", "explanation": "Dziękować komu? — celownik.", "grammar_point": "przypadki-funkcje" }
      ]
    },
    {
