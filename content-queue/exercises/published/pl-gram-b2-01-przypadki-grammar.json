        { "id": "g2-3", "prompt": "Piję kawę rano.", "answer": "Nie piję kawy rano.", "grammar_point": "przypadki-funkcje" },
        { "id": "g2-4", "prompt": "Oglądamy serial.", "answer": "Nie oglądamy serialu.", "grammar_point": "przypadki-funkcje" },
        { "id": "g2-5", "prompt": "W lodówce jest masło.", "answer": "W lodówce nie ma masła.", "grammar_point": "przypadki-funkcje" },
