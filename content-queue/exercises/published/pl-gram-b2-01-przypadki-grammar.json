        { "id": "g6-6", "text": "Zostawiłem portfel w ___ (samochód).", "answer": "samochodzie", "explanation": "Oboczność d → dzi i ó → o: samochód → samochodzie.", "grammar_point": "rzecz-lp-meski" },
        { "id": "g6-7", "text": "Co wiesz o tym ___ (człowiek)?", "answer": "człowieku", "explanation": "Po k miejscownik ma końcówkę -u.", "grammar_point": "rzecz-lp-meski" },
        { "id": "g6-8", "text": "Dałaś już jeść ___ (pies)?", "answer": "psu", "explanation": "Pies ma krótki celownik: psu.", "grammar_point": "rzecz-lp-meski" },
        { "id": "g6-9", "text": "Od dwóch lat pracuję w ___ (bank).", "answer": "banku", "explanation": "Po k miejscownik ma końcówkę -u.", "grammar_point": "rzecz-lp-meski" }
