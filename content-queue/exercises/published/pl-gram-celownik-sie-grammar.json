{
  "lesson_id": "pl-gram-celownik-sie",
  "exercise_type": "fill-in-blank",
  "title": "Celownik + się: zepsuł mi się telefon, chce mi się spać",
  "instruction": "Najpierw tekst, potem dwie części gramatyki — po każdej ćwiczenia.",
  "estimated_minutes": 30,
  "blocks": [
    {
      "block_id": "g0",
      "part": 1,
      "exercise_type": "true-false",
      "title": "0. Na start: co się stało w poniedziałek?",
      "instruction": "Prawda czy fałsz? Szukaj w tekście form z „mi się”, „mu się” — one dają odpowiedź.",
      "items": [
        {
          "id": "g0-1",
          "statement": "Budzik nie zadzwonił, bo w nocy rozładował się telefon.",
          "answer": true,
          "explanation": "„Rozładował mi się telefon i budzik nie zadzwonił”.",
          "grammar_point": "celownik-sie"
        },
        {
          "id": "g0-2",
          "statement": "Bohater specjalnie wylał kawę na dokumenty.",
          "answer": false,
          "explanation": "„Rozlała mi się” — stało się samo, przypadkiem, nie specjalnie.",
          "grammar_point": "sie-znaczenia"
        },
        {
          "id": "g0-3",
          "statement": "Bohater zgubił klucze na przystanku.",
          "answer": false,
          "explanation": "Zatrzasnęły mu się drzwi, a klucze zostały w środku.",
          "grammar_point": "celownik-sie"
        },
        {
          "id": "g0-4",
          "statement": "W tramwaju bohater źle się poczuł.",
          "answer": true,
          "explanation": "„Zrobiło mi się słabo” = źle się poczułem.",
          "grammar_point": "celownik-sie"
        },
        {
          "id": "g0-5",
          "statement": "Szefowi spóźnienie nie przeszkadzało.",
          "answer": false,
          "explanation": "„Bardzo mu się to nie podobało”.",
          "grammar_point": "celownik-sie"
        },
        {
          "id": "g0-6",
          "statement": "Koledze z IT udało się uratować pliki.",
          "answer": true,
          "explanation": "„Udało mu się uratować wszystkie pliki”.",
          "grammar_point": "celownik-sie"
        }
      ]
    },
    {
      "block_id": "g1",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "1. Komu? — mi, ci, mu, jej…",
      "instruction": "Wpisz zaimek albo rzeczownik w celowniku. Kogo to spotkało?",
      "items": [
        {
          "id": "g1-1",
          "text": "Wczoraj zepsuł ___ się telefon. (ja)",
          "answer": "mi",
          "explanation": "ja → mi",
          "grammar_point": "celownik-sie"
        },
        {
          "id": "g1-2",
          "text": "Czy ___ też rozładował się telefon? (ty)",
          "answer": "ci",
          "explanation": "ty → ci",
          "grammar_point": "celownik-sie"
        },
        {
          "id": "g1-3",
          "text": "Mój brat jest zły, bo zgubiły ___ się klucze. (on)",
          "answer": "mu",
          "explanation": "on → mu",
          "grammar_point": "celownik-sie"
        },
        {
          "id": "g1-4",
          "text": "Ania płacze, bo rozbił ___ się ulubiony kubek. (ona)",
          "answer": "jej",
          "explanation": "ona → jej",
          "grammar_point": "celownik-sie"
        },
        {
          "id": "g1-5",
          "text": "Na wakacjach zepsuł ___ się samochód i staliśmy dwa dni w Zakopanem. (my)",
          "answer": "nam",
          "explanation": "my → nam",
          "grammar_point": "celownik-sie"
        },
        {
          "id": "g1-6",
          "text": "Czy ___ też skończyły się pieniądze przed końcem miesiąca? (wy)",
          "answer": "wam",
          "explanation": "wy → wam",
          "grammar_point": "celownik-sie"
        },
        {
          "id": "g1-7",
          "text": "Sąsiedzi siedzą po ciemku, bo przepalił ___ się bezpiecznik. (oni)",
          "answer": "im",
          "explanation": "oni → im",
          "grammar_point": "celownik-sie"
        },
        {
          "id": "g1-8",
          "text": "Wczoraj ___ (mama) spaliło się ciasto.",
          "answer": "mamie",
          "explanation": "Komu? — mamie (jak „dziękuję mamie”).",
          "grammar_point": "celownik-sie"
        },
        {
          "id": "g1-9",
          "text": "Wczoraj ___ (sąsiad) zepsuła się pralka.",
          "answer": "sąsiadowi",
          "explanation": "Komu? — sąsiadowi (rodzaj męski: -owi).",
          "grammar_point": "celownik-sie"
        }
      ]
    },
    {
      "block_id": "g2",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "2. Czasownik zgadza się z rzeczą",
      "instruction": "Wpisz czasownik w czasie przeszłym. Zapytaj: CO się zepsuło? — z tym słowem zgadza się czasownik.",
      "items": [
        {
          "id": "g2-1",
          "text": "W nocy ___ mi się telefon. (rozładować się)",
          "answer": "rozładował",
          "explanation": "telefon (on) → rozładował",
          "grammar_point": "celownik-sie"
        },
        {
          "id": "g2-2",
          "text": "Rano ___ mi się kawa na stół. (rozlać się)",
          "answer": "rozlała",
          "explanation": "kawa (ona) → rozlała",
          "grammar_point": "celownik-sie"
        },
        {
          "id": "g2-3",
          "text": "Kiedy wychodziłem, ___ mi się drzwi. (zatrzasnąć się)",
          "answer": "zatrzasnęły",
          "explanation": "drzwi (one, l. mn.) → zatrzasnęły",
          "grammar_point": "celownik-sie"
        },
        {
          "id": "g2-4",
          "text": "Mamie ___ się mleko. (skończyć się)",
          "answer": "skończyło",
          "explanation": "mleko (ono) → skończyło",
          "grammar_point": "celownik-sie"
        },
        {
          "id": "g2-5",
          "text": "Bratu ___ się okulary. (zgubić się)",
          "answer": "zgubiły",
          "explanation": "okulary — tylko liczba mnoga → zgubiły",
          "grammar_point": "celownik-sie"
        },
        {
          "id": "g2-6",
          "text": "W restauracji ___ mi się guzik od marynarki. (urwać się)",
          "answer": "urwał",
          "explanation": "guzik (on) → urwał",
          "grammar_point": "celownik-sie"
        },
        {
          "id": "g2-7",
          "text": "Nam ___ się wszystkie pieniądze w pierwszym tygodniu. (skończyć się)",
          "answer": "skończyły",
          "explanation": "pieniądze (one) → skończyły. Czasownik zgadza się z rzeczą, nie z „nam”.",
          "grammar_point": "celownik-sie"
        },
        {
          "id": "g2-8",
          "text": "Jej ___ się obiad, bo rozmawiała przez telefon. (spalić się)",
          "answer": "spalił",
          "explanation": "obiad (on) → spalił. Ona rozmawiała, ale spalił się obiad.",
          "grammar_point": "celownik-sie"
        }
      ]
    },
    {
      "block_id": "g3",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "3. Moja wina czy samo się stało?",
      "instruction": "Zrobiłem to ja → zepsułem. Stało się samo → zepsuł mi się. Wybierz.",
      "items": [
        {
          "id": "g3-1",
          "text": "Ze złości rzuciłem telefonem o ścianę. Tak, ___ go — to moja wina.",
          "options": [
            "zepsułem",
            "zepsuł mi się"
          ],
          "answer": "zepsułem",
          "explanation": "Zrobiłem to sam → zwykła forma: zepsułem go.",
          "grammar_point": "sie-znaczenia"
        },
        {
          "id": "g3-2",
          "text": "Telefon leżał spokojnie na biurku i nagle ___. Nic z nim nie robiłem.",
          "options": [
            "zepsułem",
            "zepsuł mi się"
          ],
          "answer": "zepsuł mi się",
          "explanation": "Samo się stało → celownik + się.",
          "grammar_point": "sie-znaczenia"
        },
        {
          "id": "g3-3",
          "text": "Kubek stał na brzegu półki i ___, kiedy trzasnęły drzwi.",
          "options": [
            "rozbiłem",
            "rozbił mi się"
          ],
          "answer": "rozbił mi się",
          "explanation": "Nikt go nie rzucił → rozbił mi się.",
          "grammar_point": "sie-znaczenia"
        },
        {
          "id": "g3-4",
          "text": "Na imprezie chciałem pokazać sztuczkę i ___ szklankę gospodarza.",
          "options": [
            "rozbiłem",
            "rozbiła mi się"
          ],
          "answer": "rozbiłem",
          "explanation": "To ja to zrobiłem; „szklankę” to biernik — rzecz nie jest podmiotem.",
          "grammar_point": "sie-znaczenia"
        },
        {
          "id": "g3-5",
          "text": "Zapomniałem o garnku i ___ zupa.",
          "options": [
            "przypaliłem",
            "przypaliła mi się"
          ],
          "answer": "przypaliła mi się",
          "explanation": "„zupa” w mianowniku = podmiot → przypaliła mi się. Z „przypaliłem” byłoby: przypaliłem zupę.",
          "grammar_point": "sie-znaczenia"
        },
        {
          "id": "g3-6",
          "text": "Specjalnie ___ stare listy w kominku, żeby nikt ich nie przeczytał.",
          "options": [
            "spaliłem",
            "spaliły mi się"
          ],
          "answer": "spaliłem",
          "explanation": "„specjalnie” = to moja decyzja → spaliłem.",
          "grammar_point": "sie-znaczenia"
        },
        {
          "id": "g3-7",
          "text": "Pisałem dwie godziny, a potem ___ cały tekst, bo komputer się zawiesił.",
          "options": [
            "skasowałem",
            "skasował mi się"
          ],
          "answer": "skasował mi się",
          "explanation": "Winny jest komputer, nie ja → skasował mi się.",
          "grammar_point": "sie-znaczenia"
        }
      ]
    },
