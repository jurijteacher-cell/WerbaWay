        "s10"
      ],
      "exercise_type": "fill-in-blank",
      "title": "4. Do, od, przez, na",
      "instruction": "Wybierz przyimek albo słowo.",
      "items": [
        {
          "id": "g4-1",
          "text": "Dodaj pięć ___ siedmiu.",
          "options": [
            "do",
            "od",
            "przez"
          ],
          "answer": "do",
          "grammar_point": "dzialania"
        },
        {
          "id": "g4-2",
          "text": "Odejmij trzy ___ dwudziestu.",
          "options": [
            "do",
            "od",
            "przez"
          ],
          "answer": "od",
          "grammar_point": "dzialania"
        },
        {
          "id": "g4-3",
          "text": "Pomnóż długość ___ szerokość.",
          "options": [
            "przez",
            "na",
            "do"
          ],
          "answer": "przez",
          "grammar_point": "dzialania",
          "explanation": "Mnożymy przez, nie „na”."
        },
        {
          "id": "g4-4",
          "text": "Podziel wynik ___ dwa.",
          "options": [
            "przez",
            "na",
            "od"
          ],
          "answer": "przez",
          "grammar_point": "dzialania"
        },
        {
          "id": "g4-5",
          "text": "Podzielcie działkę ___ cztery równe części.",
          "options": [
            "na",
            "przez",
            "do"
          ],
          "answer": "na",
          "grammar_point": "dzialania",
          "explanation": "Tu dzielimy rzecz na części, więc na."
        },
        {
          "id": "g4-6",
          "text": "Wynik mnożenia to ___.",
          "options": [
            "iloczyn",
            "iloraz",
            "suma"
          ],
          "answer": "iloczyn",
          "grammar_point": "dzialania"
        },
        {
          "id": "g4-7",
          "text": "Wynik dzielenia to ___.",
          "options": [
            "iloraz",
            "różnica",
            "iloczyn"
          ],
          "answer": "iloraz",
          "grammar_point": "dzialania"
        },
        {
          "id": "g4-8",
          "text": "Dziesięć ___ cztery równa się sześć.",
          "options": [
            "minus",
            "plus",
            "razy"
          ],
          "answer": "minus",
          "grammar_point": "dzialania"
        }
      ]
    },
    {
      "block_id": "g5",
