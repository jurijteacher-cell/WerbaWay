          ],
          "answer": "Oblicz",
          "grammar_point": "polecenia"
        },
        {
          "id": "g6-2",
          "text": "___ wynik do dwóch miejsc po przecinku.",
          "options": [
            "Zaokrąglij",
            "Oblicz",
            "Narysuj"
          ],
          "answer": "Zaokrąglij",
          "grammar_point": "polecenia"
        },
        {
          "id": "g6-3",
          "text": "Kartka papieru ma kształt ___.",
          "options": [
            "prostokąta",
            "prostokątnika",
