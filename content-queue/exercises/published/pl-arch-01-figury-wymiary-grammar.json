          ],
          "answer": "okrąg",
          "grammar_point": "kalki-uk",
          "explanation": "Linia to okrąg (укр. коло). Koło to cała figura (укр. круг)."
        },
        {
          "id": "g6-5",
          "text": "Pokój ma czternaście ___.",
          "options": [
            "metrów kwadratowych",
