          ],
          "answer": "prostokąta",
          "grammar_point": "kalki-uk",
          "explanation": "Prostokąt, bez -nik."
        },
        {
          "id": "g6-4",
          "text": "Cyrklem rysujemy ___, czyli samą linię.",
