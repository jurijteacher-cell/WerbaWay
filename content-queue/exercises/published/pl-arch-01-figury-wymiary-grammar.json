      ],
      "exercise_type": "fill-in-blank",
      "title": "5. Jak to przeczytać?",
      "instruction": "Wybierz, jak przeczytać zapis.",
      "items": [
        {
          "id": "g5-1",
          "text": "5² — pięć do ___",
          "options": [
            "kwadratu",
            "kwadrat",
            "kwadratem"
          ],
          "answer": "kwadratu",
          "grammar_point": "wzory-na-glos"
        },
        {
          "id": "g5-2",
          "text": "a³ — a do ___",
          "options": [
            "sześcianu",
            "sześcian",
            "trzech"
          ],
          "answer": "sześcianu",
          "grammar_point": "wzory-na-glos"
        },
        {
          "id": "g5-3",
          "text": "√49 — pierwiastek z ___",
          "options": [
            "czterdziestu dziewięciu",
            "czterdzieści dziewięć",
            "czterdziestoma dziewięcioma"
          ],
          "answer": "czterdziestu dziewięciu",
          "grammar_point": "wzory-na-glos",
          "explanation": "Z + dopełniacz: z czterdziestu dziewięciu."
        },
        {
          "id": "g5-4",
          "text": "V we wzorze na objętość czytamy: ___",
          "options": [
            "fał",
            "we",
            "wu"
          ],
          "answer": "fał",
          "grammar_point": "wzory-na-glos"
        },
        {
          "id": "g5-5",
          "text": "h we wzorze na wysokość czytamy: ___",
          "options": [
            "ha",
            "asz",
            "en"
          ],
          "answer": "ha",
          "grammar_point": "wzory-na-glos"
        },
        {
          "id": "g5-6",
          "text": "P = πr²: Pole koła równa się pi er ___.",
          "options": [
            "kwadrat",
            "kwadratowy",
            "kwadratu"
          ],
          "answer": "kwadrat",
          "grammar_point": "wzory-na-glos"
        },
        {
          "id": "g5-7",
          "text": "≈ czytamy: w ___ równa się",
          "options": [
            "przybliżeniu",
            "przybliżenie",
            "przybliżony"
          ],
          "answer": "przybliżeniu",
          "grammar_point": "wzory-na-glos"
        },
        {
          "id": "g5-8",
          "text": "c² = a² + b² to twierdzenie ___.",
          "options": [
            "Pitagorasa",
            "Pitagoras",
            "Pitagorasem"
          ],
          "answer": "Pitagorasa",
          "grammar_point": "wzory-na-glos"
        }
      ]
    },
