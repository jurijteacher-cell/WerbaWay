      "exercise_type": "fill-in-blank",
      "title": "1. Metry czy metrów?",
      "instruction": "Wybierz poprawną formę.",
      "items": [
        {
          "id": "g1-1",
          "text": "Stół ma dwa ___ długości.",
          "options": [
            "metr",
            "metry",
            "metrów"
          ],
          "answer": "metry",
          "grammar_point": "liczebnik-jednostka"
        },
        {
          "id": "g1-2",
          "text": "Do uczelni mam tylko siedemset ___.",
          "options": [
            "metr",
            "metry",
            "metrów"
          ],
          "answer": "metrów",
          "grammar_point": "liczebnik-jednostka"
        },
        {
          "id": "g1-3",
          "text": "Klatka schodowa ma dwanaście ___ wysokości.",
          "options": [
            "metr",
            "metry",
            "metrów"
          ],
          "answer": "metrów",
          "grammar_point": "liczebnik-jednostka",
          "explanation": "12, 13, 14 kończą się na 2, 3, 4, ale mają formę metrów."
        },
        {
          "id": "g1-4",
          "text": "Kupiłem dwadzieścia dwa ___ listwy.",
          "options": [
            "metr",
            "metry",
            "metrów"
          ],
          "answer": "metry",
          "grammar_point": "liczebnik-jednostka",
          "explanation": "Ostatnia cyfra 2 → metry."
        },
        {
          "id": "g1-5",
          "text": "Korytarz ma dwadzieścia jeden ___.",
          "options": [
            "metr",
            "metry",
            "metrów"
          ],
          "answer": "metrów",
          "grammar_point": "liczebnik-jednostka",
          "explanation": "21, 31, 41… → zawsze metrów."
        },
        {
          "id": "g1-6",
          "text": "Kwadrat ma ___ przekątne.",
          "options": [
            "dwa",
            "dwie"
          ],
          "answer": "dwie",
          "grammar_point": "liczebnik-jednostka",
          "explanation": "Przekątna to rodzaj żeński: dwie przekątne."
        },
        {
          "id": "g1-7",
          "text": "Kąt prosty ma dziewięćdziesiąt ___.",
          "options": [
            "stopień",
            "stopnie",
            "stopni"
          ],
          "answer": "stopni",
          "grammar_point": "liczebnik-jednostka"
        },
        {
          "id": "g1-8",
          "text": "Ten kąt jest o trzy ___ większy.",
          "options": [
            "stopień",
            "stopnie",
            "stopni"
          ],
          "answer": "stopnie",
          "grammar_point": "liczebnik-jednostka"
        }
      ]
    },
    {
      "block_id": "g2",
      "part": 1,
      "covers_slides": [
        "s4",
        "s7"
      ],
      "exercise_type": "fill-in-blank",
      "title": "2. Pół, półtora i przecinek",
      "instruction": "Wybierz poprawną formę.",
      "items": [
        {
          "id": "g2-1",
          "text": "Okno ma półtora ___ szerokości.",
          "options": [
            "metr",
            "metra",
            "metrów"
          ],
          "answer": "metra",
          "grammar_point": "ulamki-przecinek"
        },
        {
          "id": "g2-2",
          "text": "Ściana ma dwa i pół ___ wysokości.",
          "options": [
            "metry",
            "metra",
            "metrów"
          ],
          "answer": "metra",
          "grammar_point": "ulamki-przecinek",
          "explanation": "Liczba z ułamkiem → dopełniacz liczby pojedynczej: metra."
        },
        {
          "id": "g2-3",
          "text": "Zostało nam tylko pół ___ taśmy.",
          "options": [
            "metr",
            "metra",
            "metrów"
          ],
          "answer": "metra",
          "grammar_point": "ulamki-przecinek"
        },
        {
          "id": "g2-4",
          "text": "Wykład trwał ___ godziny.",
          "options": [
            "półtora",
            "półtorej"
          ],
          "answer": "półtorej",
          "grammar_point": "ulamki-przecinek",
          "explanation": "Godzina to rodzaj żeński: półtorej godziny."
        },
        {
          "id": "g2-5",
          "text": "Rysunek zajmuje ___ kartki.",
          "options": [
            "trzy czwarte",
            "trzy czwarty",
            "trzech czwartych"
          ],
          "answer": "trzy czwarte",
          "grammar_point": "ulamki-przecinek"
        },
        {
          "id": "g2-6",
          "text": "Pole działki wynosi 12,5 ___ kwadratowego.",
          "options": [
            "metra",
            "metrów",
            "metry"
          ],
          "answer": "metra",
          "grammar_point": "ulamki-przecinek",
          "explanation": "Z przecinkiem: metra kwadratowego."
        }
      ]
    },
    {
      "block_id": "g3",
      "part": 1,
      "covers_slides": [
        "s5",
        "s6"
      ],
      "exercise_type": "fill-in-blank",
      "title": "3. Wymiary i porównania",
      "instruction": "Wybierz poprawną odpowiedź.",
      "items": [
        {
          "id": "g3-1",
          "text": "Pokój ma wymiary pięć ___ cztery metry.",
          "options": [
            "na",
            "przez",
            "i"
          ],
          "answer": "na",
          "grammar_point": "wymiary-porownanie"
        },
        {
          "id": "g3-2",
          "text": "Długość korytarza ___ dziewięć metrów.",
          "options": [
            "wynosi",
            "równa",
            "dorównuje"
          ],
          "answer": "wynosi",
          "grammar_point": "wymiary-porownanie"
        },
        {
          "id": "g3-3",
          "text": "Szukam mieszkania ___ powierzchni pięćdziesięciu metrów kwadratowych.",
          "options": [
            "o",
            "na",
            "z"
          ],
          "answer": "o",
          "grammar_point": "wymiary-porownanie"
        },
        {
          "id": "g3-4",
          "text": "Okno jest szerokie ___ półtora metra.",
          "options": [
            "na",
            "o",
            "w"
          ],
          "answer": "na",
          "grammar_point": "wymiary-porownanie"
        },
        {
          "id": "g3-5",
          "text": "Okno A jest ___ dwadzieścia centymetrów szersze niż okno B.",
          "options": [
            "na",
            "o",
            "przez"
          ],
          "answer": "o",
          "grammar_point": "wymiary-porownanie",
          "explanation": "Różnica: o + biernik. Po ukraińsku „на”, po polsku o."
        },
        {
          "id": "g3-6",
          "text": "Sala A jest dwa ___ większa niż sala B.",
          "options": [
            "razy",
            "raz",
            "razów"
          ],
          "answer": "razy",
          "grammar_point": "wymiary-porownanie"
        },
        {
          "id": "g3-7",
          "text": "Wieża jest cztery razy wyższa ___ dom.",
          "options": [
            "niż",
            "od",
            "jak"
          ],
          "answer": "niż",
          "grammar_point": "wymiary-porownanie",
          "explanation": "Niż + mianownik (dom). Od wymaga dopełniacza: od domu."
        },
        {
          "id": "g3-8",
          "text": "Wieża jest o trzydzieści metrów wyższa od ___.",
          "options": [
            "dom",
            "domu",
            "domem"
          ],
          "answer": "domu",
          "grammar_point": "wymiary-porownanie"
        }
      ]
    },
    {
      "block_id": "g4",
      "part": 2,
      "covers_slides": [
        "s8",
