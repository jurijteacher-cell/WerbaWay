          ],
          "answer": "powierzchnia",
          "grammar_point": "kalki-uk",
          "explanation": "Plac to майдан. Площа квартири — powierzchnia."
        },
        {
          "id": "g6-7",
          "text": "Dziesięć podzielić ___ dwa równa się pięć.",
