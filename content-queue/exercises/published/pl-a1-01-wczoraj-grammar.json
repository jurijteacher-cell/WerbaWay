{
  "lesson_id": "pl-a1-01-wczoraj",
  "exercise_type": "fill-in-blank",
  "title": "Czas przeszły i godziny: wszystko razem",
  "instruction": "Osiem bloków od najłatwiejszego do najtrudniejszego.",
  "estimated_minutes": 25,
  "blocks": [
    {
      "block_id": "g1",
      "exercise_type": "fill-in-blank",
      "title": "1. Teraz czy wczoraj?",
      "instruction": "Wybierz formę.",
      "items": [
        {
          "id": "g1-1",
          "text": "Wczoraj Kasia ___ do pracy autobusem.",
          "answer": "jechała",
          "options": [
            "jechała",
            "jedzie"
          ]
        },
        {
          "id": "g1-2",
          "text": "(ja) Teraz ___ obiad.",
          "answer": "jem",
          "options": [
            "jem",
            "jadłem"
          ]
        },
        {
          "id": "g1-3",
          "text": "W zeszły weekend ___ u babci. (my)",
          "answer": "byliśmy",
          "options": [
            "byliśmy",
            "jesteśmy"
          ]
        },
        {
          "id": "g1-4",
          "text": "Dwa dni temu Marek ___ nowy telefon.",
          "answer": "kupił",
          "options": [
            "kupił",
            "kupuje"
          ]
        },
        {
          "id": "g1-5",
          "text": "(ja) Codziennie ___ o siódmej.",
          "answer": "wstaję",
          "options": [
            "wstaję",
            "wstałem"
          ]
        }
      ]
    },
    {
      "block_id": "g2",
      "exercise_type": "matching",
      "title": "2. Forma „ja” — kobieta",
      "instruction": "Połącz bezokolicznik z formą, którą mówi kobieta.",
      "items": [
        {
          "id": "g2-1",
          "left": "czekać",
          "right": "czekałam"
        },
        {
          "id": "g2-2",
          "left": "dzwonić",
          "right": "dzwoniłam"
        },
        {
          "id": "g2-3",
          "left": "wracać",
          "right": "wracałam"
        },
        {
          "id": "g2-4",
          "left": "pytać",
          "right": "pytałam"
        },
        {
          "id": "g2-5",
          "left": "sprzątać",
          "right": "sprzątałam"
        },
        {
          "id": "g2-6",
          "left": "myć",
          "right": "myłam"
        }
      ]
    },
    {
      "block_id": "g3",
      "exercise_type": "sentence-building",
      "title": "3. Dziś → wczoraj",
      "instruction": "Napisz to samo zdanie o wczoraj.",
      "items": [
        {
          "id": "g3-1",
          "prompt": "Dziś pracuję w domu. (mężczyzna)",
          "answer": "Wczoraj pracowałem w domu."
        },
        {
          "id": "g3-2",
          "prompt": "Dziś gotuję zupę. (kobieta)",
          "answer": "Wczoraj gotowałam zupę."
        },
        {
          "id": "g3-3",
          "prompt": "Dziś Ewa czeka na autobus.",
          "answer": "Wczoraj Ewa czekała na autobus."
        },
        {
          "id": "g3-4",
          "prompt": "Dziś oni oglądają mecz.",
          "answer": "Wczoraj oni oglądali mecz."
        },
        {
          "id": "g3-5",
          "prompt": "Dziś jesteśmy w parku. (ja i mój brat)",
          "answer": "Wczoraj byliśmy w parku."
        }
      ]
    },
    {
      "block_id": "g4",
      "exercise_type": "sentence-building",
      "title": "4. Zmień osobę",
      "instruction": "Napisz zdanie dla nowej osoby.",
      "items": [
        {
          "id": "g4-1",
          "prompt": "Adam był w pracy. → Adam i Ola…",
          "answer": "Adam i Ola byli w pracy."
        },
        {
          "id": "g4-2",
          "prompt": "Kasia jadła lody. → Kasia i Magda…",
          "answer": "Kasia i Magda jadły lody."
        },
        {
          "id": "g4-3",
          "prompt": "Miałem czas. → (my, mężczyźni)",
          "answer": "Mieliśmy czas."
        },
        {
          "id": "g4-4",
          "prompt": "Chciała iść do domu. → (one)",
          "answer": "Chciały iść do domu."
        },
        {
          "id": "g4-5",
          "prompt": "Mogłeś przyjść. → (wy, kobiety i mężczyźni)",
          "answer": "Mogliście przyjść."
        }
      ]
    },
    {
      "block_id": "g5",
      "exercise_type": "fill-in-blank",
      "title": "5. Sobota Pawła",
      "instruction": "Wpisz czasownik w czasie przeszłym albo godzinę słowami.",
      "items": [
        {
          "id": "g5-1",
          "text": "W sobotę Paweł ___ (wstać) późno.",
          "answer": "wstał"
        },
        {
          "id": "g5-2",
          "text": "Śniadanie jadł dopiero o ___ (10:00).",
          "answer": "dziesiątej"
        },
        {
          "id": "g5-3",
          "text": "Potem ___ (pójść) na basen.",
          "answer": "poszedł"
        },
        {
          "id": "g5-4",
          "text": "Basen był otwarty do ___ (14:00).",
          "answer": "czternastej"
        },
        {
          "id": "g5-5",
          "text": "Po południu Paweł i jego dziewczyna ___ (oglądać) film.",
          "answer": "oglądali"
        },
        {
          "id": "g5-6",
          "text": "Film zaczął się o ___ (19:30, potocznie).",
          "answer": "wpół do ósmej"
        },
        {
          "id": "g5-7",
          "text": "Paweł ___ (być) bardzo zadowolony.",
          "answer": "był"
        }
      ]
    },
    {
      "block_id": "g6",
      "exercise_type": "fill-in-blank",
      "title": "6. Oficjalnie czy potocznie?",
      "instruction": "Kto mówi? Wybierz formę, która pasuje do sytuacji.",
      "items": [
        {
          "id": "g6-1",
          "text": "Komunikat na lotnisku: „Samolot z Londynu wylądował ___” (13:45).",
          "answer": "o trzynastej czterdzieści pięć",
          "options": [
            "o trzynastej czterdzieści pięć",
            "za kwadrans druga"
          ],
          "explanation": "Lotnisko, dworzec, radio — forma oficjalna."
        },
        {
          "id": "g6-2",
          "text": "Mama przez telefon: „Wróciłam do domu ___” (16:30).",
          "answer": "wpół do piątej",
          "options": [
            "wpół do piątej",
            "o szesnastej trzydzieści"
          ],
          "explanation": "Rodzina i znajomi — mówimy potocznie."
        },
        {
          "id": "g6-3",
          "text": "Pani w przychodni: „Lekarz przyjmował do ___” (18:00).",
          "answer": "osiemnastej",
          "options": [
            "osiemnastej",
            "szóstej"
          ],
          "explanation": "Przychodnia to instytucja — forma oficjalna."
        },
        {
          "id": "g6-4",
          "text": "Kolega: „Byłem w domu kwadrans po ___” (22:15).",
          "answer": "dziesiątej",
          "options": [
            "dziesiątej",
            "dwudziestej drugiej"
          ],
          "explanation": "„Kwadrans po” łączymy tylko z zegarem do dwunastu."
        }
      ]
    },
    {
      "block_id": "g7",
      "exercise_type": "drag-and-drop",
      "title": "7. Godziny potocznie",
      "instruction": "Przeciągnij godzinę w lukę. Dwie nie pasują.",
      "bank": [
        "wpół do drugiej",
        "za kwadrans czwarta"
      ],
      "items": [
        {
          "id": "g7-1",
          "text": "2:30 to ___.",
          "answer": "wpół do trzeciej"
        },
        {
          "id": "g7-2",
          "text": "4:45 to ___.",
          "answer": "za kwadrans piąta"
        },
        {
          "id": "g7-3",
          "text": "11:15 to ___.",
          "answer": "kwadrans po jedenastej"
        },
        {
          "id": "g7-4",
          "text": "8:40 to ___.",
          "answer": "za dwadzieścia dziewiąta"
        }
      ]
    },
    {
      "block_id": "g8",
      "exercise_type": "fill-in-blank",
      "title": "8. Pułapki",
      "instruction": "Wybierz poprawną formę. Po odpowiedzi przeczytaj wyjaśnienie.",
      "items": [
        {
          "id": "g8-1",
          "text": "(ja, mężczyzna) Wczoraj ___ do pracy pieszo.",
          "answer": "szedłem",
          "options": [
            "szedłem",
            "idłem"
          ],
          "explanation": "Iść jest nieregularne: szedłem, szłam, szli."
        },
        {
          "id": "g8-2",
          "text": "Czy ___ już obiad? (ty, mężczyzna)",
          "answer": "jadłeś",
          "options": [
            "jadłeś",
            "jedłeś"
          ],
          "explanation": "Jadł- w liczbie pojedynczej. Jedl- tylko w formie -li: jedli."
        },
        {
          "id": "g8-3",
          "text": "(my: Ola i Piotr) Wczoraj ___ do teatru.",
          "answer": "poszliśmy",
          "options": [
            "poszliśmy",
            "poszłyśmy"
          ],
          "explanation": "W grupie jest mężczyzna, więc -li-."
        },
        {
          "id": "g8-4",
          "text": "O której ___ z pracy? (ty, kobieta)",
          "answer": "wróciłaś",
          "options": [
            "wróciłaś",
            "wróciłeś"
          ],
          "explanation": "Kobieta: -łaś. Mężczyzna: -łeś."
        },
        {
          "id": "g8-5",
          "text": "(ja, kobieta) Nie ___ spać do drugiej w nocy.",
          "answer": "mogłam",
          "options": [
            "mogłam",
            "mogłem"
          ],
          "explanation": "Kobieta mówi o sobie: mogłam."
        },
        {
          "id": "g8-6",
          "text": "Koleżanki ___ na mnie pół godziny.",
          "answer": "czekały",
          "options": [
            "czekały",
            "czekali"
          ],
          "explanation": "Same kobiety, więc -ły."
        }
      ]
    }
  ]
