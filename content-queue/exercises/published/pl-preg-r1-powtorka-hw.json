          "grammar_point": "slownictwo"
        },
        {
          "id": "h1-3",
          "left": "umówić się",
          "right": "na wizytę kontrolną",
          "grammar_point": "slownictwo"
        },
        {
          "id": "h1-4",
          "left": "wypić",
          "right": "słodki roztwór glukozy",
