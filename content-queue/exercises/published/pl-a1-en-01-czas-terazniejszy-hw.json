{
  "lesson_id": "pl-a1-en-01-czas-terazniejszy",
  "exercise_type": "fill-in-blank",
  "title": "Praca domowa: czas teraźniejszy",
  "instruction": "Trzy ćwiczenia. 20 minut.",
  "instruction_uk": "Three exercises, 20 minutes. New verbs, new situations.",
  "estimated_minutes": 20,
  "blocks": [
    {
      "block_id": "h1",
      "exercise_type": "fill-in-blank",
      "title": "1. Napisz formę",
      "instruction": "Wpisz czasownik w dobrej formie.",
      "instruction_uk": "Person and dictionary form are in brackets.",
      "items": [
        {
          "id": "h1-1",
          "text": "W sobotę ___ całe mieszkanie. (ja, sprzątać)",
          "answer": "sprzątam",
          "grammar_point": "koniugacja-am-asz"
        },
        {
          "id": "h1-2",
          "text": "Często ___ do brata? (ty, dzwonić)",
          "answer": "dzwonisz",
          "grammar_point": "koniugacja-e-isz"
        },
        {
          "id": "h1-3",
          "text": "Moja babcia ___ obrazy. (ona, malować)",
          "answer": "maluje",
          "grammar_point": "koniugacja-e-esz",
          "explanation": "-ować → -uję: maluję, malujesz → ona maluje."
        },
        {
          "id": "h1-4",
          "text": "We wtorki ___ na basenie. (my, pływać)",
          "answer": "pływamy",
          "grammar_point": "koniugacja-am-asz"
        },
        {
          "id": "h1-5",
          "text": "___ w tenisa w niedzielę? (wy, grać)",
          "answer": "gracie",
          "grammar_point": "koniugacja-am-asz",
          "explanation": "gram, grasz → wy gracie."
        },
        {
          "id": "h1-6",
          "text": "Moi rodzice ___ małą kawiarnię. (oni, prowadzić)",
          "answer": "prowadzą",
          "grammar_point": "koniugacja-e-isz",
          "explanation": "prowadzę → prowadzą (-ę → -ą)."
        },
        {
          "id": "h1-7",
          "text": "Moje koleżanki ___ w parku. (one, biegać)",
          "answer": "biegają",
          "grammar_point": "koniugacja-am-asz"
        },
        {
          "id": "h1-8",
          "text": "Szef ___, że to dobry pomysł. (on, myśleć)",
          "answer": "myśli",
          "grammar_point": "koniugacja-e-isz",
          "explanation": "myśleć → myślę, myślisz → on myśli."
        }
      ]
    },
    {
      "block_id": "h2",
      "exercise_type": "fill-in-blank",
      "title": "2. Oni, one, pan, pani",
      "instruction": "Wybierz dobrą formę.",
      "instruction_uk": "Check who it is: a man in the group? pan or pani?",
      "items": [
        {
          "id": "h2-1",
          "text": "Babcia i dziadek? ___ w ogrodzie.",
          "answer": "Oni siedzą",
          "options": [
            "Oni siedzą",
            "One siedzą"
          ],
          "grammar_point": "oni-one",
          "explanation": "Dziadek is a man → oni."
        },
        {
          "id": "h2-2",
          "text": "Moje kuzynki? ___ do kina.",
          "answer": "One idą",
          "options": [
            "Oni idą",
            "One idą"
          ],
          "grammar_point": "oni-one",
          "explanation": "Kuzynki = women → one."
        },
        {
          "id": "h2-3",
          "text": "Psy sąsiada? ___ całą noc.",
          "answer": "One szczekają",
          "options": [
            "Oni szczekają",
            "One szczekają"
          ],
          "grammar_point": "oni-one",
          "explanation": "Animals → one."
        },
        {
          "id": "h2-4",
          "text": "Dyrektor i dwie sekretarki? ___ zebranie.",
          "answer": "Oni mają",
          "options": [
            "Oni mają",
            "One mają"
          ],
          "grammar_point": "oni-one",
          "explanation": "One man is enough → oni."
        },
        {
          "id": "h2-5",
          "text": "Pani ___ kartą czy gotówką?",
          "answer": "płaci",
          "options": [
            "płaci",
            "płacisz",
            "płacić"
          ],
          "grammar_point": "pan-pani",
          "explanation": "Pani → the ona form."
        },
        {
          "id": "h2-6",
          "text": "Czy pan ___ na następnym przystanku?",
          "answer": "wysiada",
          "options": [
            "wysiada",
            "wysiadasz",
            "wysiadam"
          ],
          "grammar_point": "pan-pani",
          "explanation": "Pan → the on form."
        }
      ]
    },
    {
      "block_id": "h3",
      "exercise_type": "sentence-building",
      "title": "3. Ułóż zdanie",
      "instruction": "Ułóż zdanie ze słów.",
      "instruction_uk": "Put the words in order.",
      "items": [
        {
          "id": "h3-1",
          "words": [
            "biegam",
            "w parku",
            "codziennie",
            "rano"
          ],
          "answer": "Codziennie rano biegam w parku.",
          "accept": [
            "Rano codziennie biegam w parku.",
            "Biegam codziennie rano w parku.",
            "Codziennie rano w parku biegam.",
            "Biegam w parku codziennie rano."
          ],
          "grammar_point": "osoby-koncowki"
        },
        {
          "id": "h3-2",
          "words": [
            "nie",
            "słuchają",
            "moi",
            "nigdy",
            "sąsiedzi",
            "głośnej muzyki"
          ],
          "answer": "Moi sąsiedzi nigdy nie słuchają głośnej muzyki.",
          "accept": [
            "Moi sąsiedzi nie słuchają nigdy głośnej muzyki.",
            "Nigdy moi sąsiedzi nie słuchają głośnej muzyki."
          ],
          "grammar_point": "osoby-koncowki"
        },
        {
          "id": "h3-3",
          "words": [
            "jeździ",
            "pani",
            "do Londynu",
            "często",
            "czy"
          ],
          "answer": "Czy pani często jeździ do Londynu?",
          "accept": [
            "Czy pani jeździ często do Londynu?",
            "Czy często pani jeździ do Londynu?",
            "Czy pani do Londynu często jeździ?"
          ],
          "grammar_point": "pan-pani"
        },
        {
          "id": "h3-4",
          "words": [
            "śpimy",
            "długo",
            "w weekend",
            "zwykle"
          ],
          "answer": "W weekend zwykle śpimy długo.",
          "accept": [
            "Zwykle w weekend śpimy długo.",
            "W weekend śpimy zwykle długo.",
            "W weekend zwykle długo śpimy.",
            "Zwykle śpimy długo w weekend."
          ],
          "grammar_point": "osoby-koncowki"
        }
      ]
    }
  ]
}
