          "options": [
            "że",
            "żeby"
          ],
          "explanation": "Informacja, gdzie jest obiad — „że”.",
          "grammar_point": "ze-vs-zeby"
        },
        {
          "id": "g4-5",
          "text": "Mama napisała, ___ wyjąć obiad z lodówki.",
          "answer": "żeby",
          "options": [
            "że",
            "żeby"
          ],
          "explanation": "Prośba mamy — „żeby” z bezokolicznikiem.",
          "grammar_point": "ze-vs-zeby"
        },
        {
          "id": "g4-6",
          "text": "Wiem, ___ to trudne, ale spróbuj.",
          "answer": "że",
          "options": [
            "że",
            "żeby"
          ],
          "explanation": "Po „wiedzieć” idzie informacja — „że”.",
          "grammar_point": "ze-vs-zeby"
        }
