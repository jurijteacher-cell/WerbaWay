          "options": [
            "wiedzieć",
            "wiedzieli"
          ],
          "grammar_point": "zeby-forma-osobowa"
        },
        {
          "id": "g1-5",
          "text": "Kupiliśmy duży stół, żeby goście ___ usiąść razem.",
          "answer": "mogli",
          "options": [
            "móc",
            "mogli"
          ],
          "grammar_point": "zeby-forma-osobowa"
        },
        {
          "id": "g1-6",
          "text": "Otwieram okno, żeby ___ pokój.",
          "answer": "przewietrzyć",
          "options": [
            "przewietrzyć",
            "przewietrzył"
          ],
          "grammar_point": "zeby-bezokolicznik"
        }
      ]
    },
