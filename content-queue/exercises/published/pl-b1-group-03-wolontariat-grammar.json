      "exercise_type": "fill-in-blank",
      "title": "1. Ten sam czy inny podmiot?",
      "instruction": "Wybierz bezokolicznik albo formę osobową.",
      "items": [
        {
          "id": "g1-1",
          "text": "Zapisałem się na kurs, żeby ___ pierwszej pomocy.",
          "answer": "nauczyć się",
          "options": [
            "nauczyć się",
            "nauczył się"
          ],
          "grammar_point": "zeby-bezokolicznik"
        },
        {
          "id": "g1-2",
          "text": "Zostawiam ci klucze, żebyś ___ podlać kwiaty.",
          "answer": "mógł",
          "options": [
            "móc",
            "mógł"
          ],
          "grammar_point": "zeby-forma-osobowa"
        },
        {
          "id": "g1-3",
          "text": "Sąsiadka wstaje o piątej, żeby ___ na pierwszy autobus.",
          "answer": "zdążyć",
          "options": [
            "zdążyć",
            "zdążyła"
          ],
          "grammar_point": "zeby-bezokolicznik"
        },
        {
          "id": "g1-4",
          "text": "Dyrektor powiesił ogłoszenie, żeby wszyscy ___ o zebraniu.",
