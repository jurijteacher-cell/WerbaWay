          ],
          "grammar_point": "czasowniki-z-zeby"
        },
        {
          "id": "g3-6",
          "text": "Babcia chce, ___ (ja) ją odwiedził w sobotę.",
          "answer": "żebym",
          "grammar_point": "zeby-koncowki"
        }
      ]
    },
    {
