          "id": "g8-2",
          "text": "Mama prosi, żebym ___ zakupy.",
          "answer": "zrobił",
          "options": [
            "zrobiłem",
            "zrobił",
            "zrobię"
          ],
          "explanation": "Końcówka -m jest już w „żebym”, więc czasownik zostaje bez niej: zrobił.",
