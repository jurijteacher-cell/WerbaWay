        },
        {
          "id": "g2-5",
          "left": "oni + zostać",
          "right": "żeby zostali",
          "grammar_point": "zeby-koncowki"
        },
        {
          "id": "g2-6",
          "left": "ona + odpocząć",
          "right": "żeby odpoczęła",
          "grammar_point": "zeby-koncowki"
