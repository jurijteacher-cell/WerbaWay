  "title": "Powtórka: zdjęcia, słowa, czasowniki modalne i aspekt",
  "instruction": "Sześć bloków. Bloki 1–2 to słowa (ze zdjęciami), bloki 3–6 to gramatyka i tekst. Kliknij odpowiedź i sprawdź.",
  "estimated_minutes": 25,
  "blocks": [
    {
      "block_id": "g1",
      "title": "1. Co widać na zdjęciu?",
      "exercise_type": "fill-in-blank",
      "instruction": "Popatrz na zdjęcie i wybierz słowo, które pasuje.",
      "items": [
        {
          "id": "g1-1",
          "text": "To jest ___: pielęgniarka bierze krew z żyły.",
          "options": [
            "badanie moczu",
            "pobranie krwi",
            "USG połówkowe"
          ],
          "answer": "pobranie krwi",
          "grammar_point": "slownictwo",
          "image_url": "https://images.unsplash.com/photo-1615461066159-fea0960485d5?fm=jpg&q=80&w=900&fit=max",
          "image_alt": "Pielęgniarka w rękawiczkach pobiera krew z ręki pacjenta",
          "image_credit": "Fot. Nguyễn Hiệp / Unsplash"
        },
        {
          "id": "g1-2",
          "text": "Pielęgniarka mierzy pacjentce ___.",
          "options": [
            "tętno dziecka",
            "wagę",
            "ciśnienie"
          ],
          "answer": "ciśnienie",
          "grammar_point": "slownictwo",
          "image_url": "https://images.unsplash.com/photo-1631815588090-d4bfec5b1ccb?fm=jpg&q=80&w=900&fit=max",
          "image_alt": "Pielęgniarka z mankietem na ramieniu pacjentki",
          "image_credit": "Fot. CDC / Unsplash"
        },
        {
          "id": "g1-3",
          "text": "Te krzesła stoją w ___. Tu czeka się na swoją kolej.",
          "options": [
            "poczekalni",
            "gabinecie",
            "laboratorium"
          ],
          "answer": "poczekalni",
          "grammar_point": "slownictwo",
          "image_url": "https://images.unsplash.com/photo-1581982231900-6a1a46b744c9?fm=jpg&q=80&w=900&fit=max",
          "image_alt": "Krzesła przy okienku w przychodni",
          "image_credit": "Fot. smallbox / Unsplash"
        },
        {
          "id": "g1-4",
          "text": "Probówki z krwią są już w ___. Wynik będzie za dwa dni.",
          "options": [
            "rejestracji",
            "laboratorium",
            "aptece"
          ],
          "answer": "laboratorium",
          "grammar_point": "slownictwo",
          "image_url": "https://images.unsplash.com/photo-1697192156499-d85cfe1452c0?fm=jpg&q=80&w=900&fit=max",
          "image_alt": "Ręka w rękawiczce przy probówkach z krwią",
          "image_credit": "Fot. Adrian Sulyok / Unsplash"
        },
        {
          "id": "g1-5",
          "text": "Na tym aparacie lekarz robi ___ i na ekranie widzi dziecko.",
          "options": [
            "morfologię",
            "USG",
            "wywiad"
          ],
          "answer": "USG",
          "grammar_point": "slownictwo",
          "image_url": "https://images.unsplash.com/photo-1691935071222-c008a4ccc2ca?fm=jpg&q=80&w=900&fit=max",
          "image_alt": "Aparat do USG w gabinecie",
          "image_credit": "Fot. Elen Sher / Unsplash"
        },
        {
          "id": "g1-6",
          "text": "Na kalendarzu są zaznaczone ___ wizyt kontrolnych.",
          "options": [
            "wyniki",
            "skierowania",
            "terminy"
          ],
          "answer": "terminy",
          "grammar_point": "slownictwo",
          "image_url": "https://images.unsplash.com/photo-1633526543814-9718c8922b7a?fm=jpg&q=80&w=900&fit=max",
          "image_alt": "Kalendarz z czerwonymi pinezkami przy kilku dniach",
          "image_credit": "Fot. Towfiqu barbhuiya / Unsplash"
        },
        {
          "id": "g1-7",
          "text": "Ta pani właśnie ___ coś w notesie.",
          "options": [
            "zapisze",
            "zapisuje",
            "zapisała"
          ],
          "answer": "zapisuje",
          "grammar_point": "aspekt",
          "image_url": "https://images.unsplash.com/photo-1752659503910-8cec3e760614?fm=jpg&q=80&w=900&fit=max",
          "image_alt": "Kobieta pisze w notesie",
          "image_credit": "Fot. Sweet Life / Unsplash",
          "explanation": "Właśnie, teraz — to proces. Czas teraźniejszy ma tylko forma niedokonana."
        }
      ]
    },
    {
      "block_id": "g2",
      "title": "2. Słowa z dwóch lekcji",
      "exercise_type": "matching",
      "instruction": "Kliknij słowo po lewej, potem jego znaczenie po prawej.",
      "items": [
        {
          "id": "g2-1",
          "left": "krzywa cukrowa",
          "right": "test, w którym pijesz bardzo słodki roztwór",
          "grammar_point": "slownictwo"
        },
        {
          "id": "g2-2",
          "left": "na czczo",
          "right": "rano bez śniadania, tylko woda",
          "grammar_point": "slownictwo"
        },
        {
          "id": "g2-3",
          "left": "skierowanie",
          "right": "papier od lekarza, z którym idziesz na badanie",
          "grammar_point": "slownictwo"
        },
        {
          "id": "g2-4",
          "left": "wywiad lekarski",
          "right": "pytania lekarza o zdrowie, leki i rodzinę",
          "grammar_point": "slownictwo"
        },
        {
          "id": "g2-5",
          "left": "przełożyć wizytę",
          "right": "zmienić termin na inny dzień",
          "grammar_point": "slownictwo"
        },
        {
          "id": "g2-6",
          "left": "odwołać wizytę",
          "right": "powiedzieć, że wizyty nie będzie",
          "grammar_point": "slownictwo"
        },
        {
          "id": "g2-7",
          "left": "obrzęk",
          "right": "noga jest większa, bo zebrała się w niej woda",
          "grammar_point": "slownictwo"
        },
        {
          "id": "g2-8",
          "left": "w normie",
          "right": "tak, jak powinno być",
          "grammar_point": "slownictwo"
        }
      ]
    },
    {
      "block_id": "g3",
      "title": "3. Musiałam, powinnam była, będę musiała",
      "exercise_type": "fill-in-blank",
      "instruction": "Wybierz formę, która pasuje do czasu i do osoby.",
      "items": [
        {
          "id": "g3-1",
          "text": "Na pierwszej wizycie ___ czekać w poczekalni prawie godzinę.",
          "options": [
            "muszę",
            "musiałam",
            "będę musiała"
          ],
          "answer": "musiałam",
          "grammar_point": "modalne-przeszly"
        },
        {
          "id": "g3-2",
          "text": "Zapomniałam wszystkich pytań! ___ zapisać je na kartce.",
          "options": [
            "Powinnam będę",
            "Będę mogła",
            "Powinnam była"
          ],
          "answer": "Powinnam była",
          "grammar_point": "modalne-przeszly",
          "explanation": "Rada o przeszłości: powinnam była + bezokolicznik."
        },
        {
          "id": "g3-3",
          "text": "W piątek mam krzywą cukrową, więc ___ przyjść na czczo.",
          "options": [
            "będę musiała",
            "musiałam",
            "mogłam"
          ],
          "answer": "będę musiała",
          "grammar_point": "modalne-przyszly"
        },
        {
          "id": "g3-4",
          "text": "Za miesiąc ___ zrobić kolejne badanie krwi.",
          "options": [
            "powinnam będę",
            "trzeba będzie",
            "trzeba było"
          ],
          "answer": "trzeba będzie",
          "grammar_point": "modalne-przyszly",
          "explanation": "Powinien nie ma czasu przyszłego. Mówimy: trzeba będzie + bezokolicznik."
        },
        {
          "id": "g3-5",
          "text": "Mąż nie ___ pójść ze mną na USG, bo był w pracy.",
          "options": [
            "mogła",
            "mogło",
            "mógł"
          ],
          "answer": "mógł",
          "grammar_point": "modalne-przeszly",
          "explanation": "Mąż to on: on mógł (ona mogła)."
        },
        {
          "id": "g3-6",
          "text": "Olena i Kasia ___ długo czekać na wyniki.",
          "options": [
            "musiały",
            "musieli",
            "musiała"
          ],
          "answer": "musiały",
          "grammar_point": "modalne-przeszly",
          "explanation": "Dwie kobiety: one musiały. Musieli — kiedy w grupie jest mężczyzna."
        },
        {
          "id": "g3-7",
          "text": "Kasia ___ wcześniej zadzwonić do rejestracji. Teraz nie ma już wolnych terminów.",
          "options": [
            "powinna będzie",
            "powinna była",
            "powinnam była"
          ],
          "answer": "powinna była",
          "grammar_point": "modalne-przeszly"
        },
        {
          "id": "g3-8",
          "text": "Po USG połówkowym ___ wreszcie spokojnie spać.",
          "options": [
            "będę mogę",
            "mogę będę",
            "będę mogła"
          ],
          "answer": "będę mogła",
          "grammar_point": "modalne-przyszly",
          "explanation": "Czas przyszły: będę + forma przeszła (mogła) — u kobiety."
        }
      ]
    },
    {
      "block_id": "g4",
      "title": "4. Robiłam czy zrobiłam?",
      "exercise_type": "fill-in-blank",
      "instruction": "Proces czy wynik? Regularnie czy jeden raz? Wybierz formę.",
      "items": [
        {
          "id": "g4-1",
          "text": "Badanie moczu ___ prawie przed każdą wizytą.",
          "options": [
            "zrobię",
            "robię",
            "zrobiłam"
          ],
          "answer": "robię",
          "grammar_point": "aspekt",
          "explanation": "Prawie przed każdą — to regularnie, więc forma niedokonana."
        },
        {
          "id": "g4-2",
          "text": "Wczoraj ___ wyniki morfologii z rejestracji.",
          "options": [
            "odbierałam",
            "odbieram",
            "odebrałam"
          ],
          "answer": "odebrałam",
          "grammar_point": "aspekt",
          "explanation": "Wczoraj, jeden raz, jest efekt — forma dokonana."
        },
        {
          "id": "g4-3",
          "text": "Przez dwie godziny ___ w laboratorium i czytałam książkę.",
          "options": [
            "siedziałam",
            "posiedzę",
            "usiadłam"
          ],
          "answer": "siedziałam",
          "grammar_point": "aspekt",
          "explanation": "Przez dwie godziny — czas trwania, czyli proces."
        },
        {
          "id": "g4-4",
          "text": "Jutro ___ do rejestracji, żeby przełożyć wizytę.",
          "options": [
            "chodzę",
            "pójdę",
            "chodziłam"
          ],
          "answer": "pójdę",
          "grammar_point": "aspekt",
          "explanation": "Jeden raz w przyszłości: pójdę. Chodzę — regularnie."
        },
        {
          "id": "g4-5",
          "text": "Co miesiąc ___ na wizytę kontrolną.",
          "options": [
            "idę",
            "pójdę",
            "chodzę"
          ],
          "answer": "chodzę",
          "grammar_point": "aspekt",
          "explanation": "Co miesiąc — regularnie, tam i z powrotem: chodzę."
        },
        {
          "id": "g4-6",
          "text": "Od tygodnia codziennie ___ ciśnienie i zapisuję wynik.",
          "options": [
            "mierzę",
            "zmierzę",
            "zmierzyłam"
          ],
          "answer": "mierzę",
          "grammar_point": "aspekt"
        },
        {
          "id": "g4-7",
          "text": "Trzy miesiące temu zaczęłam ___ dziennik ciąży.",
          "options": [
            "poprowadzić",
            "prowadzić",
            "prowadzę"
          ],
          "answer": "prowadzić",
          "grammar_point": "aspekt",
          "explanation": "Po zacząć, skończyć, przestać — tylko bezokolicznik niedokonany."
        },
        {
          "id": "g4-8",
          "text": "Jeszcze nie ___ skierowania na krzywą cukrową.",
          "options": [
            "dostałam",
            "dostawałam",
            "dostaję"
          ],
          "answer": "dostałam",
          "grammar_point": "aspekt",
          "explanation": "Jeszcze nie + forma dokonana: czekasz na efekt."
        },
        {
          "id": "g4-9",
          "text": "Wczoraj ___ badanie krwi.",
          "options": [
            "zdałam",
            "zrobiłam",
            "robiłam"
          ],
          "answer": "zrobiłam",
          "grammar_point": "kalki-uk",
          "explanation": "Po polsku badanie się robi. „Zdać badanie” to kalka z ukraińskiego."
        },
        {
          "id": "g4-10",
          "text": "Jutro ___ lekarza o wyniki.",
          "options": [
            "będę zapytać",
            "pytałam",
            "zapytam"
          ],
          "answer": "zapytam",
          "grammar_point": "aspekt",
          "explanation": "Forma dokonana już mówi o przyszłości. „Będę zapytać” nie istnieje."
        }
      ]
    },
    {
      "block_id": "g5",
      "title": "5. Czat mam — prawda czy fałsz?",
      "exercise_type": "true-false",
      "instruction": "Wróć do wiadomości z czatu i zdecyduj.",
      "items": [
        {
          "id": "g5-1",
          "statement": "Olena idzie jutro na pierwszą wizytę u ginekologa.",
          "answer": true,
          "grammar_point": "czytanie"
        },
        {
          "id": "g5-2",
          "statement": "Agata na pierwszej wizycie zadała lekarzowi wszystkie swoje pytania.",
          "answer": false,
          "grammar_point": "czytanie"
        },
        {
          "id": "g5-3",
          "statement": "Na krzywą cukrową trzeba przyjść po śniadaniu.",
          "answer": false,
          "grammar_point": "czytanie"
        },
        {
          "id": "g5-4",
          "statement": "Iryna odebrała już wynik krzywej cukrowej.",
          "answer": true,
          "grammar_point": "czytanie"
        },
        {
          "id": "g5-5",
          "statement": "Kasia chce przełożyć USG połówkowe, bo źle się czuje.",
          "answer": false,
          "grammar_point": "czytanie"
        },
        {
          "id": "g5-6",
          "statement": "Natalia codziennie mierzy ciśnienie.",
          "answer": true,
          "grammar_point": "czytanie"
        }
      ]
    },
    {
