    {
      "block_id": "g2",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "2. Powtórka: złote czy złotych? lata czy lat?",
      "instruction": "Wybierz dobrą formę.",
      "instruction_uk": "Review. Choose the right form — remember the 2-3-4 rule.",
      "items": [
        {
          "id": "g2-1",
          "text": "Sok — 12 zł: ___",
          "answer": "dwanaście złotych",
          "options": [
            "dwanaście złote",
            "dwanaście złotych"
          ],
          "explanation": "12, 13, 14 are -teen numbers → złotych.",
          "grammar_point": "liczebniki-2-3-4"
        },
        {
          "id": "g2-2",
          "text": "Sernik — 23 zł: ___",
          "answer": "dwadzieścia trzy złote",
          "options": [
            "dwadzieścia trzy złote",
            "dwadzieścia trzy złotych"
          ],
          "explanation": "The number ends in 3 → złote.",
          "grammar_point": "liczebniki-2-3-4"
        },
        {
          "id": "g2-3",
          "text": "Pączek — 7 zł: ___",
          "answer": "siedem złotych",
          "options": [
            "siedem złote",
            "siedem złotych"
          ],
          "explanation": "7 → złotych. Only 2, 3, 4 at the end take złote.",
          "grammar_point": "liczebniki-2-3-4"
        },
        {
          "id": "g2-4",
          "text": "Woda — 4 zł: ___",
          "answer": "cztery złote",
          "options": [
            "cztery złotych",
            "cztery złote"
          ],
          "explanation": "4 → złote.",
          "grammar_point": "liczebniki-2-3-4"
        },
        {
          "id": "g2-5",
          "text": "Mój brat ma ___.",
          "answer": "trzydzieści cztery lata",
          "options": [
            "trzydzieści cztery lata",
            "trzydzieści cztery lat"
          ],
          "explanation": "The number ends in 4 → lata.",
          "grammar_point": "liczebniki-2-3-4"
        },
        {
          "id": "g2-6",
          "text": "Mój tata ma ___.",
          "answer": "sześćdziesiąt jeden lat",
          "options": [
            "sześćdziesiąt jeden lata",
            "sześćdziesiąt jeden lat",
            "sześćdziesiąt jeden rok"
          ],
          "explanation": "21, 31, 41, 61… → lat. Rok is only for 1 year: mam rok.",
          "grammar_point": "liczebniki-2-3-4"
        }
      ]
    },
    {
      "block_id": "g3",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "3. Powtórka: z czy bez z?",
      "instruction": "Wybierz dobrą formę.",
      "instruction_uk": "Review of narzędnik. z = together with. No z = a tool or transport.",
      "items": [
        {
          "id": "g3-1",
          "text": "Piję herbatę ___. (cytryna)",
          "answer": "z cytryną",
          "options": [
            "z cytryną",
            "cytryną",
            "z cytryna"
          ],
          "explanation": "Tea together with lemon → z + narzędnik: z cytryną.",
          "grammar_point": "narzednik-z"
        },
        {
          "id": "g3-2",
          "text": "Mogę zapłacić ___? (karta)",
          "answer": "kartą",
          "options": [
            "z kartą",
            "kartą",
            "karta"
          ],
          "explanation": "The card is a tool → narzędnik without z: kartą.",
          "grammar_point": "narzednik-narzedzie"
        },
        {
          "id": "g3-3",
          "text": "Jem kanapkę ___. (ser)",
          "answer": "z serem",
          "options": [
            "serem",
            "z ser",
            "z serem"
          ],
          "explanation": "A sandwich together with cheese → z serem.",
          "grammar_point": "narzednik-z"
        },
        {
          "id": "g3-4",
          "text": "Do pracy jeżdżę ___. (rower)",
          "answer": "rowerem",
          "options": [
            "rowerem",
            "z rowerem",
            "rower"
          ],
          "explanation": "Transport → no z: rowerem.",
          "grammar_point": "narzednik-narzedzie"
        },
        {
          "id": "g3-5",
          "text": "Mieszkam ___. (siostra)",
          "answer": "z siostrą",
          "options": [
            "siostrą",
            "z siostrą",
            "z siostra"
          ],
          "explanation": "Together with my sister → z siostrą.",
          "grammar_point": "narzednik-z"
        },
        {
          "id": "g3-6",
          "text": "Jestem ___. (programista)",
          "answer": "programistą",
          "options": [
            "programistem",
            "z programistą",
            "programistą"
          ],
          "explanation": "Men's words in -a take -ą: programista → programistą.",
          "grammar_point": "narzednik-kim"
        }
      ]
    },
    {
