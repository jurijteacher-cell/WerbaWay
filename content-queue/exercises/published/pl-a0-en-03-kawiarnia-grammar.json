    {
      "block_id": "g6",
      "part": 2,
      "exercise_type": "fill-in-blank",
      "title": "6. Kawa czy kawę?",
      "instruction": "Wybierz dobrą formę.",
      "instruction_uk": "To jest… → dictionary form. Poproszę, mam, lubię, chcę, piję, jem… → biernik.",
      "items": [
        {
          "id": "g6-1",
          "text": "Poproszę ___ z mlekiem.",
          "answer": "kawę",
          "options": [
            "kawa",
            "kawę"
          ],
          "explanation": "Poproszę + biernik: kawa → kawę.",
          "grammar_point": "biernik-a-e"
        },
        {
          "id": "g6-2",
          "text": "To jest ___ z cytryną.",
          "answer": "herbata",
          "options": [
            "herbatę",
            "herbata"
          ],
          "explanation": "To jest… shows something → dictionary form: herbata.",
          "grammar_point": "biernik-to-jest"
        },
        {
          "id": "g6-3",
          "text": "Chcę ___ i ciastko.",
          "answer": "sok",
          "options": [
            "sok",
            "soka",
            "soku"
          ],
          "explanation": "A he-thing does not change: sok → sok.",
          "grammar_point": "biernik-m-nieżywotny"
        },
        {
          "id": "g6-4",
          "text": "Mam ___ i siostrę.",
          "answer": "brata",
          "options": [
            "brat",
            "brata"
          ],
          "explanation": "A he-person or animal takes -a: brat → brata.",
          "grammar_point": "biernik-m-zywotny"
        },
        {
          "id": "g6-5",
          "text": "Lubię ___ z cukrem.",
          "answer": "herbatę",
          "options": [
            "herbatę",
            "herbata",
            "herbatą"
          ],
          "explanation": "Lubię + biernik: herbatę. herbatą is narzędnik (with).",
          "grammar_point": "biernik-a-e"
        },
        {
          "id": "g6-6",
          "text": "Rano piję ___.",
          "answer": "mleko",
          "options": [
            "mleko",
            "mlekę",
            "mlekiem"
          ],
          "explanation": "An it-word (-o) does not change: mleko → mleko.",
          "grammar_point": "biernik-nijaki"
        },
        {
          "id": "g6-7",
          "text": "Tu jest ___. Jest bardzo dobra!",
          "answer": "zupa",
          "options": [
            "zupa",
            "zupę"
          ],
          "explanation": "Tu jest… = here is → dictionary form: zupa.",
          "grammar_point": "biernik-to-jest"
        },
        {
          "id": "g6-8",
          "text": "Mam ___. On jest czarny.",
          "answer": "kota",
          "options": [
            "kot",
            "kota",
            "kotem"
          ],
          "explanation": "An animal is like a person: kot → kota.",
          "grammar_point": "biernik-m-zywotny"
        }
      ]
    },
    {
      "block_id": "g7",
