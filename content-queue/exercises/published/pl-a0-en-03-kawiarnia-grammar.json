          "answer": "zupę",
          "grammar_point": "biernik-a-e"
        },
        {
          "id": "g7-3",
          "text": "Jem ___ z serem. (kanapka)",
          "answer": "kanapkę",
          "grammar_point": "biernik-a-e"
        },
        {
          "id": "g7-4",
          "text": "Kocham ___. (mama)",
          "answer": "mamę",
          "grammar_point": "biernik-a-e"
        },
        {
          "id": "g7-5",
          "text": "Mam ___. Ma na imię Adam. (syn)",
          "answer": "syna",
