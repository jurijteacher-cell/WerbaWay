      "title": "5. Z rosyjskiego na polski",
      "instruction": "Przetłumacz na polski.",
      "items": [
        {
          "id": "h5-1",
          "prompt": "Кто-то стучит в дверь.",
          "answer": "Ktoś puka do drzwi.",
          "accept": [
