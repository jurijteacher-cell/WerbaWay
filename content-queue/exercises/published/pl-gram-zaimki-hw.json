            "Gdziekolwiek pojedziesz — zawsze tęsknisz za domem.",
            "Gdziekolwiek pojedziesz. zawsze będziesz tęsknić za domem.",
            "Gdziekolwiek pojedziesz. zawsze będziesz tęsknił za domem.",
            "Gdziekolwiek pojedziesz. zawsze tęsknisz za domem."
          ],
          "grammar_point": "kalki-ru"
        },
        {
          "id": "h4-6",
          "prompt": "Szukamy kogoś nowy do pracy.",
          "answer": "Szukamy kogoś nowego do pracy.",
          "grammar_point": "kalki-ru"
        }
      ]
    },
    {
