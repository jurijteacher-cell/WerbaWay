{
  "lesson_id": "pl-gram-zaimki",
  "exercise_type": "fill-in-blank",
  "title": "Praca domowa: ktoś, coś, nikt, nic",
  "instruction": "Pięć bloków. Zrób wszystko bez notatek z lekcji, potem sprawdź się.",
  "estimated_minutes": 25,
  "blocks": [
    {
      "block_id": "h1",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "1. Kogoś, czegoś, jakiejś…",
      "instruction": "Wpisz słowo z nawiasu w dobrym przypadku.",
      "items": [
        {
          "id": "h1-1",
          "text": "Słyszę ___ za ścianą. (ktoś)",
          "answer": "kogoś",
          "explanation": "słyszeć kogo? — kogoś.",
          "grammar_point": "zaimki-nieokreslone"
        },
        {
          "id": "h1-2",
          "text": "Od rana myślę o ___ z pracy. (ktoś)",
          "answer": "kimś",
          "explanation": "myśleć o kim? — o kimś.",
          "grammar_point": "zaimki-nieokreslone"
        },
        {
          "id": "h1-3",
          "text": "Wyślij tę wiadomość ___ z działu kadr. (ktoś)",
          "answer": "komuś",
          "explanation": "wysłać komu? — komuś.",
          "grammar_point": "zaimki-nieokreslone"
        },
        {
          "id": "h1-4",
          "text": "W tej zupie brakuje ___. (coś)",
          "answer": "czegoś",
          "explanation": "brakować + dopełniacz: czegoś.",
          "grammar_point": "zaimki-nieokreslone"
        },
        {
          "id": "h1-5",
          "text": "Dzwoniła do ciebie ___ pani z banku. (jakiś)",
          "answer": "jakaś",
          "explanation": "pani (ona) → jakaś.",
          "grammar_point": "zaimki-nieokreslone"
        },
        {
          "id": "h1-6",
          "text": "Zapisałem numer na ___ kartce. (jakiś)",
          "answer": "jakiejś",
          "explanation": "na + miejscownik: na jakiejś kartce.",
          "grammar_point": "zaimki-nieokreslone"
        }
      ]
    },
    {
      "block_id": "h2",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "2. -ś, -kolwiek czy byle?",
      "instruction": "Wybierz.",
      "items": [
        {
          "id": "h2-1",
          "text": "___ wybierzesz, będzie dobrze.",
          "answer": "Cokolwiek",
          "options": [
            "Coś",
            "Cokolwiek"
          ],
          "explanation": "Что бы ты ни выбрал → cokolwiek.",
          "grammar_point": "zaimki-nieokreslone"
        },
        {
          "id": "h2-2",
          "text": "Moja babcia ___ uczyła w szkole.",
          "answer": "kiedyś",
          "options": [
            "kiedyś",
            "kiedykolwiek"
          ],
          "explanation": "Когда-то → kiedyś.",
          "grammar_point": "zaimki-nieokreslone"
        },
        {
          "id": "h2-3",
          "text": "Nie parkuj ___ — tu wszędzie dają mandaty.",
          "answer": "byle gdzie",
          "options": [
            "gdzieś",
            "byle gdzie"
          ],
          "explanation": "Где попало → byle gdzie.",
          "grammar_point": "zaimki-nieokreslone"
        },
        {
          "id": "h2-4",
          "text": "Portfel musiał mi ___ wypaść.",
          "answer": "gdzieś",
          "options": [
            "gdzieś",
            "gdziekolwiek"
          ],
          "explanation": "Где-то (konkretne miejsce, nie wiem jakie) → gdzieś.",
          "grammar_point": "zaimki-nieokreslone"
        },
        {
          "id": "h2-5",
          "text": "___ będziesz w Krakowie, odwiedź mnie.",
          "answer": "Kiedykolwiek",
          "options": [
            "Kiedyś",
            "Kiedykolwiek"
          ],
          "explanation": "Когда бы ты ни был → kiedykolwiek.",
          "grammar_point": "zaimki-nieokreslone"
        },
        {
          "id": "h2-6",
          "text": "To ważna umowa — nie podpisuj jej ___.",
          "answer": "byle jak",
          "options": [
            "jakoś",
            "byle jak"
          ],
          "explanation": "Кое-как → byle jak.",
          "grammar_point": "zaimki-nieokreslone"
        }
      ]
    },
    {
      "block_id": "h3",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "3. Nikt, nic, żaden",
      "instruction": "Wpisz polskie słowo w dobrym przypadku.",
      "items": [
        {
          "id": "h3-1",
          "text": "Na przyjęciu nie było ___ znajomego. (ни одного)",
          "answer": "żadnego",
          "accept": [
            "ani jednego"
          ],
          "grammar_point": "negacja-podwojna"
        },
        {
          "id": "h3-2",
          "text": "Od tygodnia ___ do mnie nie dzwoni. (никто)",
          "answer": "nikt",
          "grammar_point": "negacja-podwojna"
        },
        {
          "id": "h3-3",
          "text": "Nie ufam ___ w tej firmie. (никому)",
          "answer": "nikomu",
          "grammar_point": "negacja-podwojna"
        },
        {
          "id": "h3-4",
          "text": "W lodówce nie ma ___. (ничего)",
          "answer": "nic",
          "accept": [
            "niczego"
          ],
          "explanation": "nic albo niczego — obie formy poprawne.",
          "grammar_point": "negacja-podwojna"
        },
        {
          "id": "h3-5",
          "text": "Nie mogę ___ znaleźć okularów. (нигде)",
          "answer": "nigdzie",
          "grammar_point": "negacja-podwojna"
        },
        {
          "id": "h3-6",
          "text": "Nie rozmawiam o polityce z ___. (ни с кем)",
          "answer": "nikim",
          "grammar_point": "negacja-podwojna"
        }
      ]
    },
    {
      "block_id": "h4",
      "part": 1,
      "exercise_type": "sentence-building",
      "title": "4. Popraw kalkę",
