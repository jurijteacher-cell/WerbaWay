          "right": "wyprowadzaj"
        },
        {
          "id": "g2-3",
          "left": "uczyć",
          "right": "ucz"
        },
        {
          "id": "g2-4",
          "left": "karmić",
          "right": "karm"
        },
        {
          "id": "g2-5",
          "left": "czesać",
