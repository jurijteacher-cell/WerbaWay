        },
        {
          "id": "g2-6",
          "left": "dzwonić",
          "right": "dzwoń"
        }
      ]
    },
    {
      "block_id": "g3",
      "exercise_type": "sentence-building",
      "title": "3. Przekształcenia: musisz → rozkaz",
      "instruction": "Powiedz to samo krócej, w trybie rozkazującym.",
      "items": [
        {
          "id": "g3-1",
          "prompt": "Musisz kupić smycz.",
          "answer": "Kup smycz."
        },
        {
          "id": "g3-2",
          "prompt": "Musisz zaszczepić psa.",
          "answer": "Zaszczep psa."
        },
        {
          "id": "g3-3",
          "prompt": "Musicie ustalić zasady.",
          "answer": "Ustalcie zasady."
        },
        {
          "id": "g3-4",
          "prompt": "Musimy wyjść z psem.",
          "answer": "Wyjdźmy z psem."
        },
        {
          "id": "g3-5",
          "prompt": "Musisz być cierpliwy.",
          "answer": "Bądź cierpliwy."
        }
      ]
    },
    {
      "block_id": "g4",
      "exercise_type": "sentence-building",
      "title": "4. Przekształcenia: rada → zakaz",
      "instruction": "Zamień radę na zakaz. Pamiętaj o formie niedokonanej i dopełniaczu.",
      "items": [
        {
          "id": "g4-1",
          "prompt": "Karm psa przy stole.",
          "answer": "Nie karm psa przy stole."
        },
        {
          "id": "g4-2",
          "prompt": "Daj mu słodycze.",
          "answer": "Nie dawaj mu słodyczy."
        },
        {
          "id": "g4-3",
          "prompt": "Zostaw go samego na cały dzień.",
          "answer": "Nie zostawiaj go samego na cały dzień."
        },
        {
          "id": "g4-4",
          "prompt": "Kupcie psa z ogłoszenia.",
          "answer": "Nie kupujcie psa z ogłoszenia."
        },
        {
          "id": "g4-5",
          "prompt": "Krzycz na niego.",
          "answer": "Nie krzycz na niego."
        }
      ]
    },
    {
      "block_id": "g5",
      "exercise_type": "fill-in-blank",
      "title": "5. Kartka dla opiekuna",
      "instruction": "Wpisz czasownik w trybie rozkazującym (ty).",
      "items": [
        {
          "id": "g5-1",
          "text": "Rano ___ (wyjść) z Reksem o siódmej.",
          "answer": "wyjdź"
        },
        {
          "id": "g5-2",
          "text": "___ (dać) mu pół miski karmy.",
          "answer": "Daj"
        },
        {
          "id": "g5-3",
          "text": "Nie ___ (dawać) mu kości z kurczaka!",
          "answer": "dawaj"
        },
        {
          "id": "g5-4",
          "text": "Po spacerze ___ (wytrzeć) mu łapy.",
          "answer": "wytrzyj"
        },
        {
          "id": "g5-5",
          "text": "Jeśli coś się stanie, ___ (zadzwonić) do mnie albo do weterynarza.",
          "answer": "zadzwoń"
        },
        {
          "id": "g5-6",
          "text": "I ___ (nie martwić się) — on tylko głośno szczeka!",
          "answer": "nie martw się"
        }
      ]
    },
    {
      "block_id": "g6",
      "exercise_type": "fill-in-blank",
      "title": "6. Kto mówi i do kogo?",
      "instruction": "Wybierz zdanie, które pasuje do sytuacji.",
      "items": [
        {
          "id": "g6-1",
          "text": "W schronisku, do pracownika: ___",
          "answer": "Proszę mi pokazać tego psa.",
          "options": [
            "Proszę mi pokazać tego psa.",
            "Pokaż mi tego psa."
          ],
          "explanation": "Do obcej osoby — proszę + bezokolicznik."
        },
        {
          "id": "g6-2",
          "text": "Do męża: ___",
          "answer": "Weź, proszę, psa na spacer.",
          "options": [
            "Weź, proszę, psa na spacer.",
            "Niech pan weźmie psa na spacer."
          ],
          "explanation": "Do bliskiej osoby — ty + proszę."
        },
        {
          "id": "g6-3",
          "text": "Do psa: ___",
          "answer": "Siad!",
          "options": [
            "Siad!",
            "Proszę usiąść."
          ],
          "explanation": "Pies zna krótkie komendy, nie grzeczne formy."
        },
        {
          "id": "g6-4",
          "text": "Weterynarz do klienta: ___",
          "answer": "Niech pan przytrzyma psa.",
          "options": [
            "Niech pan przytrzyma psa.",
            "Przytrzymaj psa."
          ],
          "explanation": "Lekarz do klienta — forma pan / pani."
        }
      ]
    },
    {
      "block_id": "g7",
      "exercise_type": "drag-and-drop",
      "title": "7. Nieregularne w praktyce",
      "instruction": "Przeciągnij formę w lukę. Dwie formy nie pasują.",
      "bank": [
        "Idź",
        "Będź"
      ],
      "items": [
        {
          "id": "g7-1",
          "text": "___ cierpliwy, on dopiero przyjechał!",
          "answer": "Bądź"
        },
        {
          "id": "g7-2",
          "text": "___ smycz z szafy, wychodzimy!",
          "answer": "Weź"
        },
        {
          "id": "g7-3",
          "text": "___ tutaj, Reks, do mnie!",
          "answer": "Chodź"
        },
        {
          "id": "g7-4",
          "text": "___ w domu, dziś nie idziesz z nami!",
          "answer": "Zostań"
        }
      ]
    },
    {
      "block_id": "g8",
      "exercise_type": "fill-in-blank",
      "title": "8. Pułapki",
      "instruction": "Wybierz poprawną formę. Po odpowiedzi przeczytaj wyjaśnienie.",
      "items": [
        {
          "id": "g8-1",
          "text": "Burek, nie ___ tego, to śmieci!",
          "answer": "jedz",
          "options": [
            "jedz",
            "jedź"
          ],
          "explanation": "Jedz — od jeść. Jedź — od jechać."
        },
        {
          "id": "g8-2",
          "text": "Nie ___ się, to tylko burza.",
          "answer": "bój",
          "options": [
            "bój",
            "boisz"
          ],
          "explanation": "Rozkaz od „bać się”: bój się."
        },
        {
          "id": "g8-3",
          "text": "___ do parku, jest ładna pogoda!",
          "answer": "Chodźmy",
          "options": [
