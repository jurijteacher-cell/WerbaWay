{
  "lesson_id": "pl-b1-group-03-pies",
  "exercise_type": "fill-in-blank",
  "title": "Tryb rozkazujący: wszystko razem",
  "instruction": "Osiem bloków od najłatwiejszego do najtrudniejszego.",
  "estimated_minutes": 25,
  "blocks": [
    {
      "block_id": "g1",
      "exercise_type": "fill-in-blank",
      "title": "1. Rozgrzewka: rozkaz czy informacja?",
      "instruction": "Wybierz formę.",
      "items": [
        {
          "id": "g1-1",
          "text": "Kasia codziennie ___ psa o siódmej.",
          "answer": "wyprowadza",
          "options": [
            "wyprowadza",
            "wyprowadzaj"
          ]
        },
        {
          "id": "g1-2",
          "text": "Marek, ___ psa, zanim zacznie padać!",
          "answer": "wyprowadź",
          "options": [
            "wyprowadź",
            "wyprowadza"
          ]
        },
        {
          "id": "g1-3",
          "text": "Nasz pies zawsze ___ przy drzwiach.",
          "answer": "czeka",
          "options": [
            "czeka",
            "czekaj"
          ]
        },
        {
          "id": "g1-4",
          "text": "Reks, ___!",
          "answer": "czekaj",
          "options": [
            "czekaj",
            "czeka"
          ]
        },
        {
          "id": "g1-5",
          "text": "Proszę ___ psa na smyczy.",
          "answer": "trzymać",
          "options": [
            "trzymać",
            "trzyma"
          ]
        }
      ]
    },
    {
