{
  "lesson_id": "pl-preg-06-wizyta-po-pologu",
  "exercise_type": "fill-in-blank",
  "title": "Praca domowa: narzędnik poza gabinetem",
  "instruction": "Trzy bloki. Zdania są nowe — ta sama gramatyka w zupełnie innych sytuacjach.",
  "estimated_minutes": 18,
  "blocks": [
    {
      "block_id": "h1",
      "exercise_type": "drag-and-drop",
      "title": "1. Słownictwo w nowych sytuacjach",
      "instruction": "Przeciągnij słowo w lukę. Dwa słowa w banku nie pasują nigdzie.",
      "bank": ["termin", "przerwę", "ulgę", "przyzwyczaiłem się", "zastąpię", "kondycja", "niania", "recepta"],
      "items": [
        {
          "id": "h1-1",
          "text": "Najbliższy wolny ___ u dentysty jest za trzy tygodnie.",
          "answer": "termin",
          "grammar_point": "slownictwo"
        },
        {
          "id": "h1-2",
          "text": "Po dwóch godzinach nauki robimy krótką ___ na herbatę.",
          "answer": "przerwę",
          "grammar_point": "slownictwo"
        },
        {
          "id": "h1-3",
          "text": "Kiedy remont wreszcie się skończył, poczuliśmy ogromną ___.",
          "answer": "ulgę",
          "grammar_point": "slownictwo"
        },
        {
          "id": "h1-4",
          "text": "W nowej firmie ___ do innych godzin pracy po miesiącu.",
          "answer": "przyzwyczaiłem się",
          "grammar_point": "slownictwo"
        },
        {
          "id": "h1-5",
          "text": "Kolega jedzie na urlop, więc ___ go w czwartek i w piątek.",
          "answer": "zastąpię",
          "grammar_point": "slownictwo"
        },
        {
          "id": "h1-6",
          "text": "Po trzech tygodniach biegania moja ___ wyraźnie się poprawiła.",
          "answer": "kondycja",
          "grammar_point": "slownictwo"
        }
      ]
    },
    {
      "block_id": "h2",
      "exercise_type": "fill-in-blank",
      "title": "2. Pełna forma",
      "instruction": "Wpisz słowo z nawiasu w narzędniku.",
      "items": [
        {
          "id": "h2-1",
          "text": "Mój brat jest ___ (kucharz) w hotelu nad morzem.",
          "answer": "kucharzem",
          "grammar_point": "byc-kims"
        },
        {
          "id": "h2-2",
          "text": "Do Krakowa pojechaliśmy nocnym ___ (pociąg).",
          "answer": "pociągiem",
          "grammar_point": "narzednik-rzeczownik"
        },
        {
          "id": "h2-3",
          "text": "Sąsiad od lat interesuje się ___ (historia) naszego miasta.",
          "answer": "historią",
          "grammar_point": "czasowniki-z-narzednikiem"
        },
        {
          "id": "h2-4",
          "text": "Zupę jem zawsze ___ (łyżka), a nie widelcem.",
          "answer": "łyżką",
          "grammar_point": "narzednik-rzeczownik"
        },
        {
          "id": "h2-5",
          "text": "Spotkajmy się przed ___ (kino) o siódmej.",
          "answer": "kinem",
          "grammar_point": "przyimki-narzednik"
        },
        {
          "id": "h2-6",
          "text": "Nad ___ (rzeka) było zimno i bardzo wietrznie.",
          "answer": "rzeką",
          "grammar_point": "przyimki-narzednik"
        },
        {
          "id": "h2-7",
          "text": "Na kemping pojechaliśmy z ___ (przyjaciele) ze studiów.",
          "answer": "przyjaciółmi",
          "grammar_point": "narzednik-mnoga"
        },
        {
          "id": "h2-8",
          "text": "W weekend zajmuję się ___ (ogród) i nic więcej nie planuję.",
          "answer": "ogrodem",
          "grammar_point": "czasowniki-z-narzednikiem"
        }
      ]
    },
    {
      "block_id": "h3",
      "exercise_type": "sentence-building",
      "title": "3. Dokończ zdanie",
      "instruction": "Przeczytaj pierwsze zdanie i dokończ drugie.",
      "items": [
        {
          "id": "h3-1",
          "prompt": "To jest nasz nowy trener. → On jest…",
          "answer": "On jest naszym nowym trenerem.",
          "grammar_point": "byc-kims"
        },
        {
          "id": "h3-2",
          "prompt": "Lubię fotografię. → Interesuję się…",
          "answer": "Interesuję się fotografią.",
          "grammar_point": "czasowniki-z-narzednikiem"
        },
        {
          "id": "h3-3",
          "prompt": "Mam dużo pracy przy remoncie. → Cały weekend zajmuję się…",
          "answer": "Cały weekend zajmuję się remontem.",
          "grammar_point": "czasowniki-z-narzednikiem"
        },
        {
          "id": "h3-4",
          "prompt": "Mam dwóch braci. → Często rozmawiam o tym…",
          "answer": "Często rozmawiam o tym z braćmi.",
          "grammar_point": "narzednik-mnoga"
        },
        {
          "id": "h3-5",
          "prompt": "Płot jest wysoki. (za) → Pies siedzi…",
          "answer": "Pies siedzi za wysokim płotem.",
          "grammar_point": "narzednik-przymiotnik"
        },
        {
          "id": "h3-6",
          "prompt": "Woda jest zimna. (pod) → Myję ręce…",
          "answer": "Myję ręce pod zimną wodą.",
          "grammar_point": "narzednik-przymiotnik"
        }
      ]
    }
  ]
}
