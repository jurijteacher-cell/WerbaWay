      "instruction": "Wybierz poprawną odpowiedź.",
      "items": [
        {"id": "g3-1", "text": "Czy ___ ci ta zupa?", "options": ["smakuje", "smakują"], "answer": "smakuje", "grammar_point": "celownik-bezosobowe", "explanation": "Zupa — jedna rzecz, więc smakuje."},
        {"id": "g3-2", "text": "Dzieciom bardzo ___ naleśniki.", "options": ["smakuje", "smakują"], "answer": "smakują", "grammar_point": "celownik-bezosobowe", "explanation": "Czasownik zgadza się z jedzeniem: naleśniki smakują."},
        {"id": "g3-3", "text": "Mamo, czy ___ smakuje sałatka?", "options": ["ty", "cię", "ci"], "answer": "ci", "grammar_point": "celownik-bezosobowe", "explanation": "Komu smakuje? — tobie, krótko: ci."},
        {"id": "g3-4", "text": "Coś ___ picia?", "options": ["do", "dla", "na"], "answer": "do", "grammar_point": "dla-do-na"},
