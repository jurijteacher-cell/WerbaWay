      "items": [
        {"id": "g1-1", "text": "Poproszę ___ pomidorową.", "options": ["zupa", "zupę"], "answer": "zupę", "grammar_point": "biernik-zamawianie"},
        {"id": "g1-2", "text": "Poproszę jeszcze jedną ___.", "options": ["herbata", "herbatę", "herbaty"], "answer": "herbatę", "grammar_point": "biernik-zamawianie"},
        {"id": "g1-3", "text": "Na deser biorę ___.", "options": ["szarlotka", "szarlotkę"], "answer": "szarlotkę", "grammar_point": "biernik-zamawianie"},
        {"id": "g1-4", "text": "Zamawiam sałatkę i ___ pomarańczowy.", "options": ["sok", "soku"], "answer": "sok", "grammar_point": "biernik-zamawianie", "explanation": "Sok to rodzaj męski — w bierniku bez zmian."},
        {"id": "g1-5", "text": "Poproszę kawę ___.", "options": ["czarna", "czarną"], "answer": "czarną", "grammar_point": "biernik-zamawianie", "explanation": "Przymiotnik też się zmienia: czarna kawa → czarną kawę."},
        {"id": "g1-6", "text": "Na obiad zamówimy ___ ziemniaczane.", "options": ["placki", "placków"], "answer": "placki", "grammar_point": "biernik-zamawianie", "explanation": "Liczba mnoga rzeczy — w bierniku bez zmian."},
        {"id": "g1-7", "text": "Dzień dobry, poproszę ___ z różą.", "options": ["pączek", "pączka"], "answer": "pączka", "grammar_point": "biernik-zamawianie", "explanation": "Wiele nazw jedzenia rodzaju męskiego ma w bierniku -a: pączka, banana, ogórka."},
        {"id": "g1-8", "text": "Poproszę ___ i masło.", "options": ["chleb", "chleba"], "answer": "chleb", "grammar_point": "biernik-zamawianie", "explanation": "Chleb, ser, sok — w bierniku bez zmian. Chleba byłoby po trochę albo kawałek."}
      ]
