        {"id": "g3-6", "text": "Ta zupa jest pyszna, bardzo mi ___.", "options": ["się podoba", "smakuje"], "answer": "smakuje", "grammar_point": "kalki-uk", "explanation": "O jedzeniu mówimy smakować. Podobać się — o tym, co widzisz."},
        {"id": "g3-7", "text": "Marchewka, kapusta i cebula to ___.", "options": ["owoce", "warzywa"], "answer": "warzywa", "grammar_point": "kalki-uk", "explanation": "Warzywa to овочі, owoce to фрукти."},
        {"id": "g3-8", "text": "Przepraszam, gdzie jest nasz ___? Czekamy na rachunek.", "options": ["oficjant", "kelner"], "answer": "kelner", "grammar_point": "kalki-uk", "explanation": "Po polsku: kelner, kelnerka."}
