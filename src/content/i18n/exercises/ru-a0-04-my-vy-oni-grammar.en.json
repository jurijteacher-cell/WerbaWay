  "7cb2ec9add36": "Вы",
  "5cdb5caac526": "Ты",
  "34c523702e2c": "Мы",
  "46a96a915203": "Two people → вы, even if they are friends.",
  "abf906102708": "(An older man in a café.) ___ лю́бите чай?",
  "b2e166fff178": "Они́",
  "fc2d5f968e52": "An unknown older person → вы.",
