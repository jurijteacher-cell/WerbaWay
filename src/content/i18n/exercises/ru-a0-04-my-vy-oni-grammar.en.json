  "e364d304420d": "живите",
  "88bce34e489c": "жива́ете",
  "2ee7e07f9908": "вы + жить → живёте.",
  "ecef7554bde4": "Роди́тели ___ в Ри́ге.",
  "b6abf6e0c36c": "жива́ют",
  "78cc4d1d11d7": "Parents = они → живут.",
  "44f1dbc8b9bd": "Где вы ___?",
  "0ed083c26f4b": "живёшь",
