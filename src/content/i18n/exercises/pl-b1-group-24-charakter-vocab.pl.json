{
  "d3faedbdfac3": "to, jak ktoś wygląda z zewnątrz",
  "0a1657df7a57": "jak wysoka jest osoba",
  "ed118acef14b": "chudy, ale zdrowo",
  "e71c8bd4f23e": "niski i delikatny",
  "b4772cdebc03": "o szerokich ramionach",
  "15850bc373ac": "taki, kto regularnie trenuje",
  "9dfc7b86b810": "dość gruby, mocno zbudowany",
  "211390976033": "taki, kto dba o siebie",
  "582c7b8a537a": "włosy, które same się kręcą",
  "a184e8dda857": "włosy sięgające ramion",
  "56190efd9c57": "o białych albo szarych włosach",
  "caa3751a1fe5": "bez włosów na głowie",
  "da5bf4cb63df": "włosy nad górną wargą",
  "a2c390403c4e": "zarost na dolnej części twarzy",
  "dfd8d1a44e7b": "małe brązowe plamki na skórze",
  "f00282d15263": "linie na skórze z wiekiem",
  "db29c7d4b4cc": "taki, kto nie kłamie",
  "b08530f8366b": "taki, kto chętnie pomaga",
  "4da500a3c413": "taki, kto umie czekać",
  "cc31dbe6040e": "taki, kto przychodzi na czas",
  "298d337bdd57": "taki, kto pracuje dokładnie",
  "9ed4f950e5f7": "taki, kto lubi ludzi",
  "44c0ba383b21": "taki, kto nie karze za błędy",
  "35f293759221": "spokojny w trudnej sytuacji",
  "b9edc138fedd": "taki, kto nie zmienia decyzji",
  "bc100b05dde4": "taki, kto nie chce nic robić",
  "d5889caa9fa3": "taki, kto uważa się za lepszego",
  "36a74975245c": "taki, kto szybko się złości",
  "e77dbff70454": "taki, kto nie lubi wydawać pieniędzy",
  "d38c77d935ba": "taki, kto boi się uwagi innych",
  "8f55301eb67b": "zwracający uwagę na szczegóły",
  "08e849dc371b": "taki jak ktoś inny",
  "86a8cc59a2d1": "wyglądać jak ktoś znany",
  "cfb8152cc445": "robić wrażenie kogoś; mieć na pozór tyle lat",
  "2950eebf1786": "podobać się od pierwszej chwili",
  "a34cdf687158": "umieć żartować i rozumieć żarty",
  "61538a9428c4": "dobrze się z kimś rozmawiać",
  "38f36a69308b": "w pierwszej chwili, na pozór"
}
