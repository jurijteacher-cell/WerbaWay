  "b34ccc53485a": "dolna część kręgosłupa",
  "71e4eff7309d": "jedna kość kręgosłupa",
  "86335ed14b95": "miękka część między kręgami",
  "9dc6244085e5": "normalny kształt kręgosłupa",
  "d86fef163d7e": "podnoszenie ciała na drążku",
