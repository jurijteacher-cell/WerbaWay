  "8e4a89d76f82": "najpierw zrób to, potem podnieś",
  "a868e1ab8574": "ból dolnej części pleców",
  "e785d59945d8": "łopatki do siebie",
  "00770129db03": "<i>Zwiedzić</i> = oglądać miasto.",
  "f5e6905ed8f2": "duży mięsień z boku pleców",
