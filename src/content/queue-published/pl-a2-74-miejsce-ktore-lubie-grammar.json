          "options": [
            "który",
            "które",
            "którego"
          ],
          "grammar_point": "ktory-podstawy",
          "explanation": "Kościół — męski; co stoi? → mianownik: który."
        },
        {
          "id": "g2-3",
          "text": "Zakopane to miasto, ___ znam od dziecka.",
