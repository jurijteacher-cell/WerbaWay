            "które",
            "których"
          ],
          "grammar_point": "ktory-podstawy",
          "explanation": "Mężczyźni w liczbie mnogiej, mianownik: którzy."
        },
        {
          "id": "g2-7",
          "text": "Kupiłam ser, ___ robią górale.",
