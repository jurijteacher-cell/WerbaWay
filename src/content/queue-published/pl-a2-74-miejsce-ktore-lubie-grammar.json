            "która",
            "które",
            "który"
          ],
          "grammar_point": "ktory-podstawy",
          "explanation": "Ulica — rodzaj żeński; kto/co jest pełne? → mianownik: która."
        },
        {
          "id": "g2-2",
          "text": "To jest kościół, ___ stoi na początku Krupówek.",
