{
  "lesson_id": "pl-b1-group-03-pies",
  "exercise_type": "fill-in-blank",
  "title": "Praca domowa: słowa lekcji i tryb rozkazujący na nowym materiale",
  "instruction": "Trzy bloki. Gramatykę ćwiczysz w kuchni, na siłowni i w podróży — nie z psem.",
  "estimated_minutes": 30,
  "blocks": [
    {
      "block_id": "h1",
      "exercise_type": "drag-and-drop",
      "title": "1. Słowa z lekcji w nowych zdaniach",
      "instruction": "Przeciągnij słowo w lukę. Dwa słowa są zbędne.",
      "bank": [
        "obroża",
        "schronisko"
      ],
      "items": [
        {
          "id": "h1-1",
          "text": "Ten ___ ma dopiero osiem tygodni.",
          "answer": "szczeniak"
        },
        {
          "id": "h1-2",
          "text": "Nasz pies nosi ___, bo gryzie inne psy.",
          "answer": "kaganiec"
        },
        {
          "id": "h1-3",
          "text": "Po spacerze w lesie znalazłam na psie ___.",
          "answer": "kleszcza"
        },
        {
          "id": "h1-4",
          "text": "Ten pies nie ma ___, ale jest piękny i mądry.",
          "answer": "rodowodu"
        },
        {
          "id": "h1-5",
          "text": "Sąsiedzi ___ się, że pies wyje w nocy.",
          "answer": "skarżą"
        },
        {
          "id": "h1-6",
          "text": "Kupiliśmy duże ___, bo pies lubi spać wyciągnięty.",
          "answer": "legowisko"
        }
      ]
    },
    {
      "block_id": "h2",
      "exercise_type": "fill-in-blank",
      "title": "2. Pełna forma: kuchnia, siłownia, podróż",
      "instruction": "Wpisz czasownik w trybie rozkazującym.",
      "items": [
        {
          "id": "h2-1",
          "text": "(ty, kroić) ___ cebulę w kostkę.",
          "answer": "Krój"
        },
        {
          "id": "h2-2",
          "text": "(ty, mieszać) ___ zupę co pięć minut.",
          "answer": "Mieszaj"
        },
        {
          "id": "h2-3",
          "text": "(wy, piec) ___ ciasto przez czterdzieści minut.",
          "answer": "Pieczcie"
        },
        {
          "id": "h2-4",
          "text": "(ty, nie solić) ___ za dużo!",
          "answer": "Nie sól"
        },
        {
          "id": "h2-5",
          "text": "(my, obierać) ___ ziemniaki razem.",
          "answer": "Obierajmy"
        },
        {
          "id": "h2-6",
          "text": "(ty, oddychać) ___ spokojnie i powoli.",
          "answer": "Oddychaj"
        },
        {
          "id": "h2-7",
          "text": "(wy, ćwiczyć) ___ trzy razy w tygodniu.",
          "answer": "Ćwiczcie"
        },
        {
          "id": "h2-8",
          "text": "(ty, zapiąć) ___ pasy, ruszamy!",
          "answer": "Zapnij"
        },
        {
          "id": "h2-9",
          "text": "Niech pan ___ (sprawdzić) paszport przed wyjazdem.",
          "answer": "sprawdzi"
        },
        {
          "id": "h2-10",
          "text": "Proszę ___ (zabrać) wszystkie rzeczy z pociągu.",
          "answer": "zabrać"
        }
      ]
    },
    {
      "block_id": "h3",
      "exercise_type": "sentence-building",
      "title": "3. Przekształcenia",
      "instruction": "Powiedz to samo w trybie rozkazującym.",
      "items": [
        {
          "id": "h3-1",
          "prompt": "Musisz odpisać na maila.",
          "answer": "Odpisz na maila."
        },
        {
          "id": "h3-2",
          "prompt": "Musicie wysłać zdjęcia.",
          "answer": "Wyślijcie zdjęcia."
        },
        {
          "id": "h3-3",
          "prompt": "Nie możesz tu parkować.",
          "answer": "Nie parkuj tutaj."
        },
        {
          "id": "h3-4",
          "prompt": "Chcę, żeby pan podpisał dokument.",
          "answer": "Niech pan podpisze dokument."
        },
        {
          "id": "h3-5",
          "prompt": "Proponuję, żebyśmy zamówili pizzę.",
          "answer": "Zamówmy pizzę."
        },
        {
          "id": "h3-6",
          "prompt": "Nie powinieneś kłamać.",
          "answer": "Nie kłam."
        }
      ]
    }
  ]
}