          "grammar_point": "ktory-podstawy",
          "explanation": "Co ma? — mianownik męski: który."
        },
        {
          "id": "g3-2",
          "text": "Pokażę ci kawiarnię, ___ bardzo lubię.",
          "answer": "którą",
          "grammar_point": "ktory-podstawy",
          "explanation": "Lubię co? — biernik żeński: którą."
        },
        {
          "id": "g3-3",
          "text": "To przewodnik, ___ poznaliśmy w karczmie.",
          "answer": "którego",
          "grammar_point": "ktory-podstawy",
          "explanation": "Poznaliśmy kogo? Mężczyzna → którego."
        },
        {
          "id": "g3-4",
          "text": "To są koledzy, ___ pojechali z nami.",
          "answer": "którzy",
          "grammar_point": "ktory-podstawy",
          "explanation": "Mężczyźni, mianownik: którzy."
        },
        {
          "id": "g3-5",
          "text": "Gdzie są zdjęcia, ___ zrobiłaś na Gubałówce?",
          "answer": "które",
          "grammar_point": "ktory-podstawy",
          "explanation": "Zdjęcia — liczba mnoga: które."
        },
        {
          "id": "g3-6",
          "text": "Zakopane to miasto, ___ znam od dziecka.",
          "answer": "które",
          "grammar_point": "ktory-podstawy",
          "explanation": "Miasto — nijaki: które."
        }
      ]
