     "answer": "którym",
     "explanation": "W czym? — miejscownik: w którym.",
     "grammar_point": "ktory-przypadki"
    },
    {
     "id": "g3-5",
     "text": "To jest pan, ___ dałem bilet.",
     "options": [
      "któremu",
      "którego"
     ],
     "answer": "któremu",
     "explanation": "Dać komu? — celownik: któremu.",
     "grammar_point": "ktory-przypadki"
    },
    {
     "id": "g3-6",
     "text": "Trasa, ___ jechaliśmy, była bardzo malownicza.",
     "options": [
      "którą",
      "której"
     ],
     "answer": "którą",
     "explanation": "Jechać czym? trasą — narzędnik: którą.",
     "grammar_point": "ktory-przypadki"
    }
   ]
