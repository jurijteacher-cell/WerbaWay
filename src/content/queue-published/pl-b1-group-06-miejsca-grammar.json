   "exercise_type": "fill-in-blank",
   "title": "1. Który, która czy które?",
   "instruction": "Rodzaj bierzemy od rzeczownika przed przecinkiem. Wybierz formę.",
   "covers_slides": [
    "s2",
    "s3"
   ],
   "items": [
    {
     "id": "g1-1",
     "text": "To kanał, ___ ma pięć pochylni.",
     "options": [
      "który",
      "która",
      "które"
     ],
     "answer": "który",
     "explanation": "Kanał — rodzaj męski.",
     "grammar_point": "ktory-mianownik"
    },
    {
     "id": "g1-2",
     "text": "Zalipie to wieś, ___ słynie z kwiatów.",
     "options": [
      "który",
      "która",
      "które"
     ],
     "answer": "która",
     "explanation": "Wieś — rodzaj żeński.",
     "grammar_point": "ktory-zgoda"
    },
    {
     "id": "g1-3",
     "text": "Hańcza to jezioro, ___ ma ponad sto metrów głębokości.",
     "options": [
      "który",
      "która",
      "które"
     ],
     "answer": "które",
     "explanation": "Jezioro — rodzaj nijaki.",
     "grammar_point": "ktory-zgoda"
    },
    {
     "id": "g1-4",
     "text": "To przewodniczka, ___ zna każdy korytarz kopalni.",
     "options": [
      "który",
      "która",
      "które"
     ],
     "answer": "która",
     "explanation": "Przewodniczka — rodzaj żeński.",
     "grammar_point": "ktory-mianownik"
    },
    {
     "id": "g1-5",
     "text": "Krzywy Las to miejsce, ___ wygląda jak z bajki.",
     "options": [
      "który",
      "która",
      "które"
     ],
     "answer": "które",
     "explanation": "Rodzaj od słowa „miejsce” — nijaki.",
     "grammar_point": "ktory-zgoda"
    },
    {
     "id": "g1-6",
     "text": "Znam przewodnika, ___ pracuje w Wieliczce.",
     "options": [
      "który",
      "którego",
      "które"
     ],
     "answer": "który",
     "explanation": "W drugim zdaniu on pracuje — mianownik.",
     "grammar_point": "ktory-mianownik"
    }
   ]
  },
