{
  "lesson_id": "pl-a2-68-powtorka-ludzie-i-zdrowie",
  "exercise_type": "fill-in-blank",
  "title": "Powtórka M3: kogo, jaki, rada, komu",
  "instruction": "Cztery bloki — po jednym na każdy temat z mapy. Na lekcji robimy bloki 1–3, blok 4 — jeśli zostanie czas albo w domu.",
  "estimated_minutes": 18,
  "blocks": [
    {
      "block_id": "g1",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "1. Kogo? Jaki?",
      "instruction": "Wpisz słowa z nawiasu w dobrej formie.",
      "items": [
        {
          "id": "g1-1",
          "text": "Na peronie czekam na ___. (mój brat)",
          "answer": "mojego brata",
          "grammar_point": "biernik-osobowy",
          "explanation": "Czekać na kogo? — biernik osoby: mojego brata."
        },
        {
          "id": "g1-2",
          "text": "Znasz ___? (ten wysoki pan)",
          "answer": "tego wysokiego pana",
          "grammar_point": "biernik-osobowy",
          "explanation": "Znać kogo? — osoba męska: tego wysokiego pana."
        },
        {
          "id": "g1-3",
          "text": "Mama wróciła do domu bez ___. (ulubiony szalik)",
          "answer": "ulubionego szalika",
          "grammar_point": "przymiotnik-przypadki",
          "explanation": "Bez + dopełniacz: ulubionego szalika."
        },
        {
          "id": "g1-4",
          "text": "Klucze są w ___. (mała kieszeń)",
          "answer": "małej kieszeni",
          "grammar_point": "przymiotnik-przypadki",
          "explanation": "W + miejscownik, rodzaj żeński: w małej kieszeni."
        },
        {
          "id": "g1-5",
          "text": "Pani Agnieszka przyszła do biura z ___. (nowy pies)",
          "answer": "nowym psem",
          "grammar_point": "przymiotnik-przypadki",
          "explanation": "Z + narzędnik: z nowym psem."
        },
        {
          "id": "g1-6",
          "text": "W sobotę odwiedzamy ___. (starszy kuzyn)",
          "answer": "starszego kuzyna",
          "grammar_point": "biernik-osobowy",
          "explanation": "Odwiedzać kogo? — starszego kuzyna."
        }
      ]
    },
    {
      "block_id": "g2",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "2. Rada, zakaz, prośba",
      "instruction": "Wybierz dobrą formę.",
      "items": [
        {
          "id": "g2-1",
          "text": "Masz gorączkę? ___ dziś w łóżku!",
          "answer": "Zostań",
          "options": [
            "Zostań",
            "Zostajesz",
            "Zostać"
          ],
          "grammar_point": "rozkaznik-pelny",
          "explanation": "Rada dla kolegi — tryb rozkazujący na ty: zostań."
        },
        {
          "id": "g2-2",
          "text": "W szpitalu nie ___ palić.",
          "answer": "wolno",
          "options": [
            "wolno",
            "musisz",
            "powinno"
          ],
          "grammar_point": "modalne-obowiazek",
          "explanation": "Zakaz: nie wolno. Nie musisz = nie masz obowiązku."
        },
        {
          "id": "g2-3",
          "text": "Jutro jest święto, więc nie ___ iść do pracy.",
          "answer": "musisz",
          "options": [
            "musisz",
            "wolno ci",
            "warto"
          ],
          "grammar_point": "modalne-obowiazek",
          "explanation": "Nie masz obowiązku — nie musisz."
        },
        {
          "id": "g2-4",
          "text": "Mamo, ___ się, wszystko jest dobrze!",
          "answer": "nie martw",
          "options": [
            "nie martw",
            "nie martwisz",
            "nie martwić"
          ],
          "grammar_point": "rozkaznik-pelny",
          "explanation": "Prośba na ty: nie martw się."
        },
        {
          "id": "g2-5",
          "text": "Pani Halino, ___ Pani usiądzie, lekarka zaraz przyjdzie.",
          "answer": "niech",
          "options": [
            "niech",
            "proszę",
            "trzeba"
          ],
          "grammar_point": "rozkaznik-pelny",
          "explanation": "Niech + forma on / ona: niech Pani usiądzie. Ale: proszę usiąść."
        },
        {
          "id": "g2-6",
          "text": "Olena dużo pracuje. ___ czasem kończyć pracę o czwartej.",
          "answer": "Powinna",
          "options": [
            "Powinna",
            "Powinien",
            "Powinnam"
          ],
          "grammar_point": "modalne-obowiazek",
          "explanation": "Olena — ona: powinna."
        }
      ]
    },
    {
      "block_id": "g3",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "3. Komu? Jest mi zimno",
      "instruction": "Wpisz słowo z nawiasu w dobrej formie. Uważaj na „boli”.",
      "items": [
        {
          "id": "g3-1",
          "text": "Olena zrobiła ___ herbatę z miodem. (chora mama)",
          "answer": "chorej mamie",
          "grammar_point": "celownik-osoby",
          "explanation": "Komu? — rodzaj żeński: chorej mamie."
        },
        {
          "id": "g3-2",
          "text": "Dziękuję ___ za pomoc! (pani doktor)",
          "answer": "pani doktor",
          "grammar_point": "celownik-osoby",
          "explanation": "Pani → pani, doktor o kobiecie się nie zmienia."
        },
        {
          "id": "g3-3",
          "text": "Mama dała ___ sernik z Krakowa. (tata)",
          "answer": "tacie",
          "grammar_point": "celownik-osoby",
          "explanation": "Tata → tacie (jak żeński)."
        },
        {
          "id": "g3-4",
          "text": "Zamknij okno, jest ___ zimno. (ja)",
          "answer": "mi",
          "grammar_point": "celownik-bezosobowe",
          "explanation": "Jest komu zimno? — mi."
        },
        {
          "id": "g3-5",
          "text": "Tomek nie przyszedł, bo boli ___ głowa. (on)",
          "answer": "go",
          "grammar_point": "celownik-bezosobowe",
          "explanation": "Boli kogo? — biernik: go. Ale: jest mu zimno."
        },
        {
          "id": "g3-6",
          "text": "Pokażę ___ zdjęcia z Krakowa. (koleżanki)",
          "answer": "koleżankom",
          "grammar_point": "celownik-osoby",
          "explanation": "Liczba mnoga w celowniku — zawsze -om: koleżankom."
        }
      ]
    },
    {
      "block_id": "g4",
      "part": 2,
      "exercise_type": "sentence-building",
      "title": "4. Popraw błąd",
      "instruction": "W każdym zdaniu jest jeden błąd. Napisz całe zdanie poprawnie.",
      "items": [
        {
          "id": "g4-1",
          "prompt": "Znam jego od roku.",
          "answer": "Znam go od roku.",
          "accept": [
            "Od roku go znam."
          ],
          "grammar_point": "biernik-osobowy",
          "explanation": "W środku zdania — krótka forma: go."
        },
        {
          "id": "g4-2",
          "prompt": "Kasia ma długi włosy.",
          "answer": "Kasia ma długie włosy.",
          "grammar_point": "przymiotnik-przypadki",
          "explanation": "Włosy — liczba mnoga: długie włosy."
        },
        {
          "id": "g4-3",
          "prompt": "Nie musisz tu palić, to szpital!",
          "answer": "Nie wolno tu palić, to szpital!",
          "accept": [
            "Tu nie wolno palić, to szpital!"
          ],
          "grammar_point": "modalne-obowiazek",
          "explanation": "Zakaz to nie wolno. Nie musisz = nie masz obowiązku."
        },
        {
          "id": "g4-4",
          "prompt": "Pomagam mój brat w lekcjach.",
          "answer": "Pomagam mojemu bratu w lekcjach.",
          "accept": [
            "W lekcjach pomagam mojemu bratu."
          ],
          "grammar_point": "celownik-osoby",
          "explanation": "Pomagać komu? — mojemu bratu."
        },
        {
          "id": "g4-5",
          "prompt": "Nie zadzwoń do mnie po dwudziestej drugiej!",
          "answer": "Nie dzwoń do mnie po dwudziestej drugiej!",
          "grammar_point": "rozkaznik-pelny",
          "explanation": "Po nie — forma niedokonana: nie dzwoń."
        }
      ]
    }
  ]
}
