        },
        {
          "id": "el2-2",
          "answer": "a) aby",
          "options": [
            "a) aby",
            "b) że",
            "c) bo"
          ],
          "explanation": "Po „piszę” podajemy cel: „aby podziękować”. „Że” i „bo” nie łączą się z bezokolicznikiem.",
          "grammar_point": "rejestr-formalny"
        },
        {
