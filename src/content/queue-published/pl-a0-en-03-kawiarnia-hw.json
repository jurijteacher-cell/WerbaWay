      "exercise_type": "fill-in-blank",
      "title": "1. Dobra forma",
      "instruction": "Wpisz słowo z nawiasu w dobrej formie.",
      "instruction_uk": "Write the word in brackets in the right form.",
      "items": [
        {
          "id": "h1-1",
          "text": "W kiosku kupuję ___. (gazeta)",
          "answer": "gazetę",
          "grammar_point": "biernik-a-e"
        },
        {
          "id": "h1-2",
          "text": "Wieczorem jem ___. (pizza)",
          "answer": "pizzę",
          "grammar_point": "biernik-a-e"
        },
        {
          "id": "h1-3",
          "text": "Mam ___. Mieszka w Londynie. (siostra)",
          "answer": "siostrę",
          "grammar_point": "biernik-a-e"
        },
        {
          "id": "h1-4",
          "text": "Kocham ___! (Polska)",
          "answer": "Polskę",
          "grammar_point": "biernik-a-e"
        },
        {
          "id": "h1-5",
          "text": "Dziecko chce ___. (czekolada)",
          "answer": "czekoladę",
          "grammar_point": "biernik-a-e"
        },
        {
          "id": "h1-6",
          "text": "Znam ___ z pracy. (Piotr)",
          "answer": "Piotra",
          "explanation": "A he-person takes -a: Piotr → Piotra.",
          "grammar_point": "biernik-m-zywotny"
        },
        {
          "id": "h1-7",
          "text": "Mamy ___ i dwa koty. (pies)",
          "answer": "psa",
          "grammar_point": "biernik-m-zywotny"
        }
      ]
    },
    {
      "block_id": "h2",
      "exercise_type": "sentence-building",
