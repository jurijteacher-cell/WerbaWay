      "items": [
        {
          "uk": "ł = українське «л»",
          "wrong": "łóżko jak «лужко»",
          "right": "[[ł]]óżko jak «вужко»",
          "why": "Ł brzmi jak krótkie w, jak ukraińskie в w słowie „вовк”."
        },
        {
          "uk": "ó = українське «о»",
          "wrong": "Kraków jak «Краков»",
          "right": "Krak[[ó]]w jak «Кракув»",
          "why": "Ó zawsze brzmi jak u."
        },
        {
          "uk": "si = «сі», ci = «ці»",
          "wrong": "ciemno jak «ці-емно»",
          "right": "[[ci]]emno = ćemno",
          "why": "Przed samogłoską ci to jedna głoska ć, i tylko zmiękcza."
