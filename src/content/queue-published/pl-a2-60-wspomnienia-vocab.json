  "items": [
    {
      "id": "v01",
      "term": "wspomnienie",
      "group": "Wspomnienia",
      "part_of_speech": "rzeczownik, n.",
      "definition": "To, co pamiętamy z przeszłości.",
      "example": "Z tym parkiem mam same dobre wspomnienia.",
      "translation_uk": "спогад"
    },
    {
      "id": "v02",
      "term": "wspominać (kogo? co?)",
      "group": "Wspomnienia",
      "part_of_speech": "czasownik, ndk.",
      "definition": "Z sentymentem myśleć albo mówić o przeszłości.",
      "example": "Dziadek chętnie wspomina swoje lata w wojsku.",
      "translation_uk": "згадувати (з теплом)"
    },
    {
      "id": "v03",
      "term": "pamiętać (kogo? co?) · pamiętać o (czym?)",
      "group": "Wspomnienia",
      "part_of_speech": "czasownik, ndk.",
      "definition": "Mieć coś w pamięci · nie zapomnieć o czymś.",
      "example": "Pamiętasz naszą pierwszą nauczycielkę? Pamiętaj o lekarstwach!",
      "translation_uk": "пам'ятати · не забути про"
    },
    {
      "id": "v04",
      "term": "dzieciństwo",
      "group": "Wspomnienia",
      "part_of_speech": "rzeczownik, n.",
      "definition": "Czas, kiedy jesteśmy dziećmi.",
      "example": "Moja siostra spędziła całe dzieciństwo nad morzem.",
      "translation_uk": "дитинство"
    },
    {
      "id": "v05",
      "term": "młodość",
      "group": "Wspomnienia",
      "part_of_speech": "rzeczownik, ż.",
      "definition": "Czas, kiedy jesteśmy młodzi.",
      "example": "W młodości tata grał na gitarze w zespole rockowym.",
      "translation_uk": "молодість"
    },
    {
      "id": "v06",
      "term": "czarno-białe zdjęcie",
      "group": "Wspomnienia",
      "part_of_speech": "rzeczownik, n.",
      "definition": "Stare zdjęcie bez kolorów.",
      "example": "W albumie są jeszcze czarno-białe zdjęcia prababci.",
      "translation_uk": "чорно-біле фото"
    },
    {
      "id": "v07",
      "term": "tęsknić (za kim? za czym?)",
      "group": "Wspomnienia",
      "part_of_speech": "czasownik, ndk.",
      "definition": "Chcieć znowu być z kimś albo gdzieś.",
      "example": "Na studiach w Warszawie bardzo tęskniłam za domem.",
      "translation_uk": "сумувати (за ким? за чим?)"
    },
    {
      "id": "v08",
      "term": "podwórko · na podwórku",
      "group": "Miejsca z dzieciństwa",
      "part_of_speech": "rzeczownik, n.",
      "definition": "Miejsce za domem albo między blokami, gdzie bawią się dzieci.",
      "example": "Latem graliśmy na podwórku w piłkę do zmroku.",
      "translation_uk": "подвір'я · на подвір'ї"
    },
    {
      "id": "v09",
      "term": "wieś · na wsi",
      "group": "Miejsca z dzieciństwa",
      "part_of_speech": "rzeczownik, ż.",
      "definition": "Małe miejsce poza miastem, z polami i domami.",
      "example": "Moi teściowie mieszkają na wsi pod Rzeszowem.",
      "translation_uk": "село · на селі"
    },
    {
      "id": "v10",
      "term": "działka · na działce",
      "group": "Miejsca z dzieciństwa",
      "part_of_speech": "rzeczownik, ż.",
      "definition": "Mały ogród za miastem, często z małym domkiem.",
      "example": "W sobotę cała rodzina pracowała na działce.",
      "translation_uk": "дача, садова ділянка"
    },
    {
      "id": "v11",
      "term": "kamienica",
      "group": "Miejsca z dzieciństwa",
      "part_of_speech": "rzeczownik, ż.",
      "definition": "Stary dom w mieście, zwykle z kilkoma piętrami.",
      "example": "Moja ciocia mieszka w pięknej kamienicy w centrum Łodzi.",
      "translation_uk": "кам'яниця"
    },
    {
      "id": "v12",
      "term": "strych · na strychu",
      "group": "Miejsca z dzieciństwa",
      "part_of_speech": "rzeczownik, m.",
      "definition": "Pomieszczenie pod dachem domu.",
      "example": "Stare zabawki leżą u nas na strychu.",
      "translation_uk": "горище · на горищі"
    },
    {
      "id": "v13",
      "term": "szkoła podstawowa",
      "group": "Miejsca z dzieciństwa",
      "part_of_speech": "rzeczownik, ż.",
      "definition": "Pierwsza szkoła dla dzieci.",
      "example": "Mój syn chodzi do szkoły podstawowej obok parku.",
      "translation_uk": "початкова школа"
    },
    {
      "id": "v14",
      "term": "sąsiad / sąsiadka",
      "group": "Miejsca z dzieciństwa",
      "part_of_speech": "rzeczownik, m. / ż.",
      "definition": "Osoba, która mieszka obok.",
      "example": "Nasza sąsiadka zawsze piekła nam pierniki na święta.",
      "translation_uk": "сусід / сусідка"
    },
    {
      "id": "v15",
      "term": "Kiedy byłem mały / byłam mała, …",
      "group": "Opowiadam o przeszłości",
      "part_of_speech": "wyrażenie",
      "definition": "Tak zaczynamy opowieść o dzieciństwie.",
      "example": "Kiedy byłam mała, bałam się dużych psów.",
      "translation_uk": "Коли я був малим / була малою, …"
    },
    {
      "id": "v16",
      "term": "Pamiętam, że…",
      "group": "Opowiadam o przeszłości",
      "part_of_speech": "wyrażenie",
      "definition": "Mówię, co mam w pamięci.",
      "example": "Pamiętam, że zimą zawsze było dużo śniegu.",
      "translation_uk": "Пам'ятаю, що…"
    },
    {
      "id": "v17",
      "term": "Pewnego dnia…",
      "group": "Opowiadam o przeszłości",
      "part_of_speech": "wyrażenie",
      "definition": "Jeden raz w przeszłości — początek historii.",
      "example": "Pewnego dnia na nasze podwórko przyszedł mały kot.",
      "translation_uk": "Одного дня…"
    },
    {
      "id": "v18",
      "term": "dawno temu",
      "group": "Opowiadam o przeszłości",
      "part_of_speech": "przysłówek",
      "definition": "Wiele lat wcześniej.",
      "example": "To było dawno temu, jeszcze przed moimi studiami.",
      "translation_uk": "давно, колись"
    },
    {
      "id": "v19",
      "term": "Opowiedz mi o (kim? o czym?)",
      "group": "Opowiadam o przeszłości",
      "part_of_speech": "wyrażenie",
      "definition": "Proszę kogoś, żeby mówił o czymś.",
      "example": "Opowiedz mi o swojej pierwszej pracy!",
      "translation_uk": "Розкажи мені про…"
    },
    {
      "id": "v20",
      "term": "Jak dziś pamiętam…",
      "group": "Opowiadam o przeszłości",
      "part_of_speech": "wyrażenie",
      "definition": "Pamiętam to bardzo dokładnie.",
      "example": "Jak dziś pamiętam mój pierwszy dzień w Polsce.",
      "translation_uk": "Пам'ятаю, ніби це було вчора…"
    },
    {
      "id": "v21",
      "term": "Ale to były czasy!",
      "group": "Opowiadam o przeszłości",
      "part_of_speech": "wyrażenie",
      "definition": "Mówimy z sentymentem o dobrym czasie w przeszłości.",
      "example": "Wakacje bez telefonu i bez internetu… Ale to były czasy!",
      "translation_uk": "Оце були часи!"
    }
