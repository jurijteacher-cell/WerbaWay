      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "2. Jaki? Jakiego? Jakim?",
      "instruction": "Wpisz przymiotnik z nawiasu w dobrej formie.",
      "items": [
        {
          "id": "g2-1",
          "text": "Zostawiłam w tramwaju ___ torbę. (czarna)",
          "answer": "czarną",
          "grammar_point": "przymiotnik-przypadki",
          "explanation": "Zostawić co? — biernik, rodzaj żeński: czarną torbę."
        },
        {
          "id": "g2-2",
          "text": "Nie wychodzę zimą bez ___ szalika. (ciepły)",
          "answer": "ciepłego",
          "grammar_point": "przymiotnik-przypadki",
          "explanation": "Bez + dopełniacz. Rodzaj męski: ciepłego szalika."
        },
        {
          "id": "g2-3",
          "text": "Szukam pana w ___ płaszczu. (szary)",
          "answer": "szarym",
          "grammar_point": "przymiotnik-przypadki",
          "explanation": "W + miejscownik. Rodzaj męski: w szarym płaszczu."
        },
        {
          "id": "g2-4",
          "text": "To ta torba z ___ paskiem. (długi)",
          "answer": "długim",
          "grammar_point": "przymiotnik-przypadki",
          "explanation": "Z + narzędnik. Po -g piszemy -im: z długim paskiem."
        },
        {
          "id": "g2-5",
          "text": "Klucze są w ___ kieszeni. (mała)",
          "answer": "małej",
          "grammar_point": "przymiotnik-przypadki",
          "explanation": "W + miejscownik. Rodzaj żeński: w małej kieszeni."
        },
        {
          "id": "g2-6",
          "text": "Na zdjęciu jest dziewczynka z ___ psem. (biały)",
          "answer": "białym",
          "grammar_point": "przymiotnik-przypadki",
          "explanation": "Z + narzędnik: z białym psem."
        },
        {
          "id": "g2-7",
          "text": "Idziemy dziś do ___ muzeum. (nowe)",
          "answer": "nowego",
          "grammar_point": "przymiotnik-przypadki",
          "explanation": "Do + dopełniacz. Muzeum się nie odmienia, ale przymiotnik — tak: do nowego muzeum."
        },
        {
          "id": "g2-8",
          "text": "Kasia przyszła na imprezę w ___ sukience. (czerwona)",
          "answer": "czerwonej",
          "grammar_point": "przymiotnik-przypadki",
          "explanation": "W + miejscownik: w czerwonej sukience."
        }
      ]
    },
