          "grammar_point": "kalki-ru"
        }
      ]
    },
    {
      "block_id": "h5",
      "exercise_type": "sentence-building",
      "title": "5. Z rosyjskiego na polski",
      "instruction": "Przetłumacz na polski.",
      "items": [
        {
          "id": "h5-1",
          "prompt": "Мне снился странный сон.",
          "answer": "Śnił mi się dziwny sen.",
