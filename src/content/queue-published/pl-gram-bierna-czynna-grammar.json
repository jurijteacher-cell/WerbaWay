        {
          "id": "g0-5",
          "statement": "Tekst mówi, kto zbudował kamienicę.",
          "answer": false,
          "explanation": "„Została zbudowana w 1903 roku” — wykonawcy nie ma, bo nie jest ważny.",
          "grammar_point": "bierna-wykonawca"
        },
        {
          "id": "g0-6",
          "statement": "Nazwę kawiarni wybrał nowy właściciel.",
          "answer": false,
          "explanation": "„Nazwa została wybrana przez internautów.”",
          "grammar_point": "bierna-wykonawca"
        }
      ]
    },
