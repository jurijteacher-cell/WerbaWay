        {
          "id": "g0-4",
          "statement": "Dach jest jeszcze wymieniany.",
          "answer": false,
          "explanation": "„Dach został już wymieniony” — to zdarzenie zakończone, nie proces.",
          "grammar_point": "bierna-byc-zostac"
