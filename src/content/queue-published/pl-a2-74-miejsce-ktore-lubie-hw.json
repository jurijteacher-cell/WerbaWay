{
  "lesson_id": "pl-a2-74-miejsce-ktore-lubie",
  "exercise_type": "fill-in-blank",
  "title": "Praca domowa: który, która, które",
  "instruction": "Trzy bloki ćwiczeń. Potem napisz o swoim ulubionym miejscu — zadanie jest na stronie lekcji.",
  "estimated_minutes": 20,
  "blocks": [
    {
      "block_id": "h1",
      "exercise_type": "fill-in-blank",
      "title": "1. Wpisz formę",
      "instruction": "Wpisz który, która, które, którzy, którego, których…",
      "items": [
        {
          "id": "h1-1",
          "text": "Kraków to miasto, ___ jest pełne zabytków.",
          "answer": "które",
          "grammar_point": "ktory-podstawy",
          "explanation": "Miasto — nijaki, mianownik: które."
        },
        {
          "id": "h1-2",
          "text": "Mam sąsiada, ___ ma trzy psy.",
          "answer": "który",
          "grammar_point": "ktory-podstawy",
          "explanation": "Kto ma? — mianownik: który."
        },
        {
          "id": "h1-3",
          "text": "To jest książka, ___ teraz czytam.",
          "answer": "którą",
          "grammar_point": "ktory-podstawy",
          "explanation": "Czytam co? — biernik żeński: którą."
        },
        {
          "id": "h1-4",
          "text": "Pozdrów kolegów, ___ poznałam na wycieczce!",
          "answer": "których",
          "grammar_point": "ktory-podstawy",
          "explanation": "Poznałam kogo? Mężczyźni → których."
        },
        {
          "id": "h1-5",
          "text": "Gdzie jest torba, ___ kupiłeś w Zakopanem?",
          "answer": "którą",
          "grammar_point": "ktory-podstawy",
          "explanation": "Kupiłeś co? — biernik żeński: którą."
        },
        {
          "id": "h1-6",
          "text": "Lubię ludzi, ___ dużo się śmieją.",
          "answer": "którzy",
          "grammar_point": "ktory-podstawy",
          "explanation": "Ludzie — osoby, mianownik: którzy."
        }
      ]
    },
    {
      "block_id": "h2",
      "exercise_type": "fill-in-blank",
      "title": "2. Wybierz formę",
      "instruction": "Wybierz dobrą formę.",
      "items": [
        {
          "id": "h2-1",
          "text": "To jest przewodnik, ___ wszyscy polecają.",
          "answer": "którego",
          "options": [
            "którego",
            "który",
            "którym"
          ],
          "grammar_point": "ktory-podstawy",
          "explanation": "Polecają kogo? — którego."
        },
        {
          "id": "h2-2",
          "text": "___ szlak jest najłatwiejszy?",
          "answer": "Który",
          "options": [
            "Który",
            "Którego",
            "Które"
          ],
          "grammar_point": "ktory-podstawy",
          "explanation": "Szlak — męski, mianownik: który?"
        },
        {
          "id": "h2-3",
          "text": "Mieszkamy w pensjonacie, ___ ma duży ogród.",
          "answer": "który",
          "options": [
            "który",
            "które",
            "którym"
          ],
          "grammar_point": "ktory-podstawy",
          "explanation": "Co ma ogród? — mianownik: który."
        },
        {
          "id": "h2-4",
          "text": "To są góry, ___ widać z okna.",
          "answer": "które",
          "options": [
            "które",
            "którzy",
            "której"
          ],
          "grammar_point": "ktory-podstawy",
          "explanation": "Góry — nie osoby: które."
        },
        {
          "id": "h2-5",
          "text": "To jest ulica, na ___ mieszka moja babcia.",
          "answer": "której",
          "options": [
            "której",
            "którą",
            "która"
          ],
          "grammar_point": "miejscownik-pelny",
          "explanation": "Na + miejscownik żeński: na której."
        },
        {
          "id": "h2-6",
          "text": "Znasz dziewczynę, ___ siedzi obok Tomka?",
          "answer": "która",
          "options": [
            "która",
            "którą",
            "które"
          ],
          "grammar_point": "ktory-podstawy",
          "explanation": "Kto siedzi? — mianownik: która."
        }
      ]
    },
    {
      "block_id": "h3",
      "exercise_type": "sentence-building",
      "title": "3. Popraw błąd",
      "instruction": "W każdym zdaniu jest jeden błąd. Napisz całe zdanie poprawnie.",
      "items": [
        {
          "id": "h3-1",
          "prompt": "To jest kawiarnia, który lubię.",
          "answer": "To jest kawiarnia, którą lubię.",
          "grammar_point": "ktory-podstawy",
          "explanation": "Lubię co? Kawiarnia — biernik: którą."
        },
        {
          "id": "h3-2",
          "prompt": "Mam brata, która mieszka w Warszawie.",
          "answer": "Mam brata, który mieszka w Warszawie.",
          "grammar_point": "ktory-podstawy",
          "explanation": "Brat — męski: który."
        },
        {
          "id": "h3-3",
          "prompt": "Poznaliśmy górali, które grali w karczmie.",
          "answer": "Poznaliśmy górali, którzy grali w karczmie.",
          "grammar_point": "ktory-podstawy",
          "explanation": "Mężczyźni: którzy."
        },
        {
          "id": "h3-4",
          "prompt": "Zdjęcie, który zrobiłam, jest na stole.",
          "answer": "Zdjęcie, które zrobiłam, jest na stole.",
          "grammar_point": "ktory-podstawy",
          "explanation": "Zdjęcie — nijaki: które."
        },
        {
          "id": "h3-5",
          "prompt": "To jest pan, co prowadzi karczmę.",
          "answer": "To jest pan, który prowadzi karczmę.",
          "grammar_point": "kalki-uk",
          "explanation": "W piśmie: który, nie „co”."
        }
      ]
    }
  ]
}
