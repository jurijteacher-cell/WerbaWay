      "term": "delegacja (= wyjazd służbowy)",
      "group": "W delegacji",
      "part_of_speech": "rzeczownik, ż.",
      "definition": "Wyjazd w sprawach pracy.",
      "example": "Mąż jest w delegacji w Berlinie do piątku.",
      "translation_uk": "відрядження"
    },
    {
      "id": "v02",
      "term": "nocleg",
      "group": "W delegacji",
      "part_of_speech": "rzeczownik, m.",
      "definition": "Miejsce, gdzie śpimy w podróży.",
      "example": "Nocleg w schronisku kosztuje osiemdziesiąt złotych.",
      "translation_uk": "ночівля, житло (в поїздці)"
    },
    {
      "id": "v03",
      "term": "bilet w obie strony",
      "group": "W delegacji",
      "part_of_speech": "rzeczownik, m.",
      "definition": "Bilet tam i z powrotem.",
      "example": "Kupiłem bilet w obie strony do Gdańska.",
      "translation_uk": "квиток туди й назад"
