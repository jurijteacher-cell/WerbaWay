          "options": [
            "na",
            "o"
          ],
          "explanation": "Zależeć komuś NA czymś (miejscownik)."
        },
        {
          "id": "g2-2",
          "text": "Ciągle myślę ___ tym kredycie.",
          "answer": "o",
          "grammar_point": "przyimek-wybor",
          "options": [
            "na",
            "o"
          ],
          "explanation": "Myśleć O kimś, o czymś (miejscownik)."
        },
        {
          "id": "g2-3",
          "text": "Dziękuję ___ pomoc z formularzem.",
          "answer": "za",
          "grammar_point": "przyimek-wybor",
          "options": [
            "za",
            "o"
          ],
          "explanation": "Dziękować ZA coś (biernik)."
        },
        {
          "id": "g2-4",
          "text": "Od roku korzystam ___ aplikacji banku.",
          "answer": "z",
