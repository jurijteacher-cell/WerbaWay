        {
          "id": "h1-5",
          "text": "Ta poduszka jest ___ (wygodna) niż stara.",
          "answer": "wygodniejsza",
          "grammar_point": "stopien-wyzszy-przymiotnik",
          "accept": [
            "bardziej wygodna"
          ]
        },
        {
          "id": "h1-6",
          "text": "Po tygodniu ćwiczeń czuję się dużo ___ (dobrze).",
          "answer": "lepiej",
          "grammar_point": "stopien-wyzszy-nieregularny"
        },
        {
          "id": "h1-7",
          "text": "___ usiądziesz do komputera, ustaw krzesło. (przed czynnością)",
          "answer": "Zanim",
          "grammar_point": "zanim"
        },
        {
          "id": "h1-8",
          "text": "Wchodź po schodach, ___ poczujesz pracę ud. (do momentu)",
          "answer": "aż",
          "grammar_point": "az-dopoki"
