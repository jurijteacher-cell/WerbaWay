      "title": "1. Wpisz dobrą formę",
      "instruction": "Wpisz słowo z nawiasu w stopniu wyższym albo spójnik.",
      "items": [
        {
          "id": "h1-1",
          "text": "Na basenie płyń trochę ___ (wolno), ale dłużej.",
          "answer": "wolniej",
          "grammar_point": "stopien-wyzszy-przyslowek"
        },
        {
          "id": "h1-2",
          "text": "Monitor ustaw ___ (wysoko), na wysokości oczu.",
          "answer": "wyżej",
          "grammar_point": "stopien-wyzszy-nieregularny"
        },
        {
          "id": "h1-3",
          "text": "Jeśli plecak jest za ciężki, spakuj ___ (mało) rzeczy.",
          "answer": "mniej",
          "grammar_point": "stopien-wyzszy-nieregularny"
        },
        {
          "id": "h1-4",
          "text": "Dziecko noś ___ (blisko) siebie.",
          "answer": "bliżej",
          "grammar_point": "stopien-wyzszy-nieregularny"
