{
  "lesson_id": "pl-b1-group-r2-powtorka",
  "exercise_type": "fill-in-blank",
  "title": "Powtórka bloku 2: ćwiczenia mieszane",
  "instruction": "Pięć bloków. W każdym zdaniu spotykają się tematy z lekcji 9–12.",
  "estimated_minutes": 30,
  "blocks": [
    {
      "block_id": "g1",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "1. Wybierz formę",
      "instruction": "Wybierz poprawną formę. Patrz na całe zdanie.",
      "items": [
        {
          "id": "g1-1",
          "text": "Ten serial jest ___ niż film, który oglądaliśmy wczoraj.",
          "answer": "ciekawszy",
          "options": [
            "ciekawszy",
            "ciekawy",
            "najciekawszy"
          ],
          "grammar_point": "stopniowanie",
          "explanation": "Niż = porównanie dwóch rzeczy → stopień wyższy: ciekawszy."
        },
        {
          "id": "g1-2",
          "text": "To restauracja, w ___ jadłam najlepsze pierogi w życiu.",
          "answer": "której",
          "options": [
            "której",
            "którą",
            "który"
          ],
          "grammar_point": "ktory-przypadki",
          "explanation": "Restauracja (ż.), w + miejscownik → w której."
        },
        {
          "id": "g1-3",
          "text": "Na koncert przyszło ___ moich kolegów.",
          "answer": "pięciu",
          "options": [
            "pięciu",
            "pięć",
            "pięcioro"
          ],
          "grammar_point": "mn-mianownik-mos",
          "explanation": "Koledzy (mężczyźni) → forma męskoosobowa: pięciu kolegów przyszło."
        },
        {
          "id": "g1-4",
          "text": "Babci nie ___ hummus, ale zjadła go z grzeczności.",
          "answer": "smakował",
          "options": [
            "smakował",
            "smakowała",
            "smakowali"
          ],
          "grammar_point": "celownik-bezosobowe",
          "explanation": "Co smakował? — hummus (m.) → smakował. Babci = komu?"
        },
        {
          "id": "g1-5",
          "text": "Im więcej śpię, ___ gorzej się czuję.",
          "answer": "tym",
          "options": [
            "tym",
            "to",
            "niż"
          ],
          "grammar_point": "porownania",
          "explanation": "Para zawsze razem: im…, tym…"
        },
        {
          "id": "g1-6",
          "text": "W tym hotelu są pokoje, z ___ widać jezioro.",
          "answer": "których",
          "options": [
            "których",
            "które",
            "którymi"
          ],
          "grammar_point": "ktory-przypadki",
          "explanation": "Pokoje (lm.), z + dopełniacz → z których."
        },
        {
          "id": "g1-7",
          "text": "Mają ___ dzieci: syna i córkę.",
          "answer": "dwoje",
          "options": [
            "dwoje",
            "dwa",
            "dwóch"
          ],
          "grammar_point": "liczebniki-zbiorowe",
          "explanation": "Dzieci → liczebnik zbiorowy: dwoje dzieci."
        },
        {
          "id": "g1-8",
          "text": "Kupiłam ___ nowy telefon, bo stary się zepsuł.",
          "answer": "mamie",
          "options": [
            "mamie",
            "mamę",
            "mamy"
          ],
          "grammar_point": "celownik-osoby",
          "explanation": "Kupić komu? — celownik: mamie."
        }
      ]
    },
    {
      "block_id": "g2",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "2. Wpisz formę",
      "instruction": "Wpisz słowa z nawiasu w dobrej formie.",
      "items": [
        {
          "id": "g2-1",
          "text": "Kraków jest ___ od Lublina. (duży)",
          "answer": "większy",
          "grammar_point": "stopniowanie",
          "explanation": "Duży — większy — największy (forma nieregularna)."
        },
        {
          "id": "g2-2",
          "text": "Kupiłam w końcu tę książkę, o ___ mówiłeś. (który)",
          "answer": "której",
          "grammar_point": "ktory-przypadki",
          "explanation": "Książka (ż.), mówić o + miejscownik → o której."
        },
        {
          "id": "g2-3",
          "text": "___ studentów było na wykładzie? (ile / ilu)",
          "answer": "Ilu",
          "grammar_point": "mn-mianownik-mos",
          "explanation": "Studenci (mężczyźni albo grupa mieszana) → ilu."
        },
        {
          "id": "g2-4",
          "text": "Nie chce ___ się dzisiaj gotować. (ja)",
          "answer": "mi",
          "grammar_point": "celownik-bezosobowe",
          "explanation": "Chce się komu? — mi."
        },
        {
          "id": "g2-5",
          "text": "Ten film podoba się ___. (moi rodzice)",
          "answer": "moim rodzicom",
          "grammar_point": "celownik-osoby",
          "explanation": "Podobać się komu? — celownik lm.: moim rodzicom."
        },
        {
          "id": "g2-6",
          "text": "Coraz ___ ludzi ogląda seriale w internecie. (dużo)",
          "answer": "więcej",
          "grammar_point": "porownania",
          "explanation": "Dużo — więcej — najwięcej; coraz + stopień wyższy."
        },
        {
          "id": "g2-7",
          "text": "Przyjechało do nas ___ przyjaciół z Ukrainy: dwie kobiety i jeden mężczyzna. (3 — liczebnik zbiorowy)",
          "answer": "troje",
          "grammar_point": "liczebniki-zbiorowe",
          "explanation": "Grupa mieszana (kobiety i mężczyzna) → troje przyjaciół."
        },
        {
          "id": "g2-8",
          "text": "Pokażę ci miasto, ___ się urodziłam. (w + który)",
          "answer": "w którym",
          "accept": [
            "gdzie"
          ],
          "grammar_point": "ktory-przypadki",
          "explanation": "Miasto (n.), w + miejscownik → w którym (albo: gdzie)."
        }
      ]
    },
    {
      "block_id": "g3",
      "part": 2,
      "exercise_type": "sentence-building",
      "title": "3. Popraw błąd",
      "instruction": "W każdym zdaniu jest jeden błąd. Napisz całe zdanie poprawnie.",
      "items": [
        {
          "id": "g3-1",
          "prompt": "Ten film jest bardziej lepszy niż książka.",
          "answer": "Ten film jest lepszy niż książka.",
          "accept": [
            "Ten film jest lepszy od książki."
          ],
          "grammar_point": "stopniowanie",
          "explanation": "Lepszy to już stopień wyższy — bez „bardziej”."
        },
        {
          "id": "g3-2",
          "prompt": "To jest kolega, którego dałam książkę.",
          "answer": "To jest kolega, któremu dałam książkę.",
          "grammar_point": "ktory-przypadki",
          "explanation": "Dać komu? — celownik: któremu."
        },
        {
          "id": "g3-3",
          "prompt": "Pięć chłopaków grało w piłkę.",
          "answer": "Pięciu chłopaków grało w piłkę.",
          "accept": [
            "Pięciu chłopców grało w piłkę."
          ],
          "grammar_point": "mn-mianownik-mos",
          "explanation": "Chłopcy → forma męskoosobowa: pięciu."
        },
        {
          "id": "g3-4",
          "prompt": "Ja smakuje ta zupa.",
          "answer": "Smakuje mi ta zupa.",
          "accept": [
            "Ta zupa mi smakuje.",
            "Ta zupa smakuje mi.",
            "Mnie smakuje ta zupa."
          ],
          "grammar_point": "celownik-bezosobowe",
          "explanation": "Smakuje komu? — mi (celownik), nie „ja”."
        },
        {
          "id": "g3-5",
          "prompt": "Jestem zimno, zamknij okno.",
          "answer": "Jest mi zimno, zamknij okno.",
          "accept": [
            "Zimno mi, zamknij okno."
          ],
          "grammar_point": "celownik-bezosobowe",
          "explanation": "Po polsku: jest mi zimno (komu?), nie „jestem zimno”."
        },
        {
          "id": "g3-6",
          "prompt": "Im dłużej mieszkam w Polsce, to lepiej mówię po polsku.",
          "answer": "Im dłużej mieszkam w Polsce, tym lepiej mówię po polsku.",
          "grammar_point": "porownania",
          "explanation": "Im…, tym… — nie „to”."
        }
      ]
    },
    {
      "block_id": "g4",
      "part": 2,
      "exercise_type": "sentence-building",
      "title": "4. Ułóż zdanie",
      "instruction": "Ułóż zdanie z kafelków.",
      "items": [
        {
          "id": "g4-1",
          "words": [
            "podoba",
            "najbardziej",
            "ten serial",
            "mi",
            "się"
          ],
          "answer": "Ten serial podoba mi się najbardziej.",
          "accept": [
            "Najbardziej podoba mi się ten serial.",
            "Ten serial najbardziej mi się podoba."
          ],
          "grammar_point": "enklityki-zaimki",
          "explanation": "Mi stoi przed się: podoba mi się."
        },
        {
          "id": "g4-2",
          "words": [
            "rozmawialiśmy",
            "to jest film,",
            "wczoraj",
            "o którym"
          ],
          "answer": "To jest film, o którym wczoraj rozmawialiśmy.",
          "accept": [
            "To jest film, o którym rozmawialiśmy wczoraj."
          ],
          "grammar_point": "ktory-przypadki",
          "explanation": "Rozmawiać o czym? — o którym (miejscownik)."
        },
        {
          "id": "g4-3",
          "words": [
            "siedmiu",
            "na urodziny",
            "kolegów",
            "przyszło"
          ],
          "answer": "Na urodziny przyszło siedmiu kolegów.",
          "accept": [
            "Siedmiu kolegów przyszło na urodziny."
          ],
          "grammar_point": "mn-mianownik-mos",
          "explanation": "Siedmiu kolegów + czasownik w 3 os. lp. n.: przyszło."
        },
        {
          "id": "g4-4",
          "words": [
            "smakuje",
            "coraz",
            "polska kuchnia",
            "mi",
            "bardziej"
          ],
          "answer": "Polska kuchnia smakuje mi coraz bardziej.",
          "accept": [
            "Polska kuchnia coraz bardziej mi smakuje.",
            "Coraz bardziej smakuje mi polska kuchnia."
          ],
          "grammar_point": "celownik-bezosobowe",
          "explanation": "Coraz bardziej = z każdym dniem więcej."
        },
        {
          "id": "g4-5",
          "words": [
            "niż",
            "tańszy",
            "pociąg",
            "samolot",
            "jest"
          ],
          "answer": "Pociąg jest tańszy niż samolot.",
          "grammar_point": "stopniowanie",
          "explanation": "Tani — tańszy; niż + mianownik."
        }
      ]
    },
    {
      "block_id": "g5",
      "part": 2,
      "exercise_type": "drag-and-drop",
      "title": "5. Czat klasy: wycieczka",
      "instruction": "Klasa Maksyma wybiera miejsce na wycieczkę. Przeciągnij słowa w luki. Cztery słowa w banku nie pasują nigdzie.",
      "bank": [
        "która",
        "której",
        "najtańsza",
        "najtańszy",
        "nam",
        "nas",
        "trzech",
        "troje",
        "bardziej",
        "więcej"
      ],
      "items": [
        {
          "id": "g5-1",
          "text": "Głosujemy na trasę, ___ podoba się większości.",
          "answer": "która",
          "grammar_point": "ktory-przypadki",
          "explanation": "Trasa podoba się — mianownik: która."
        },
        {
          "id": "g5-2",
          "text": "Gdańsk to ___ opcja: nocleg kosztuje tam tylko 90 złotych.",
          "answer": "najtańsza",
          "grammar_point": "stopniowanie",
          "explanation": "Opcja (ż.) → najtańsza."
        },
        {
          "id": "g5-3",
          "text": "Pani wychowawczyni obiecała ___ wolny dzień po wycieczce.",
          "answer": "nam",
          "grammar_point": "celownik-osoby",
          "explanation": "Obiecać komu? — nam."
        },
        {
          "id": "g5-4",
          "text": "Z nami jedzie ___ nauczycieli: pan Adam, pan Marek i pan Tomasz.",
          "answer": "trzech",
          "grammar_point": "mn-mianownik-mos",
          "explanation": "Sami mężczyźni → trzech nauczycieli. Troje — dla grup mieszanych i dzieci."
        },
        {
          "id": "g5-5",
          "text": "Ola chce zobaczyć morze ___ niż góry.",
          "answer": "bardziej",
          "grammar_point": "porownania",
          "explanation": "Chcieć bardziej (intensywność), nie „więcej”."
        },
        {
          "id": "g5-6",
          "text": "To ta pani, od ___ kupiliśmy bilety na pociąg.",
          "answer": "której",
          "grammar_point": "ktory-przypadki",
          "explanation": "Od + dopełniacz → od której."
        }
      ]
    }
  ]
}
