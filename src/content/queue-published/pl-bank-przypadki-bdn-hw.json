      "exercise_type": "fill-in-blank",
      "title": "1. Jaki przypadek?",
      "instruction": "Wpisz właściwą formę.",
      "items": [
        {
          "id": "h1-1",
          "text": "Na urodziny chcę dostać ___. (bluzka)",
          "answer": "bluzkę",
          "grammar_point": "biernik"
        },
        {
          "id": "h1-2",
          "text": "Co rano karmię ___. (papuga)",
          "answer": "papugę",
          "grammar_point": "biernik"
        },
        {
          "id": "h1-3",
          "text": "W lodówce nie ma ___. (masło)",
          "answer": "masła",
          "grammar_point": "dopelniacz",
          "explanation": "nie ma + dopełniacz"
        },
        {
          "id": "h1-4",
          "text": "Moja ciocia jest ___. (księgowa)",
          "answer": "księgową",
          "grammar_point": "narzednik",
          "explanation": "Księgowa odmienia się jak przymiotnik: -ą"
        },
        {
          "id": "h1-5",
          "text": "Lecę do Gdańska ___. (samolot)",
          "answer": "samolotem",
          "grammar_point": "narzednik"
        },
        {
          "id": "h1-6",
          "text": "Robię kanapki z ___. (szynka)",
          "answer": "szynką",
          "grammar_point": "narzednik"
        },
        {
          "id": "h1-7",
          "text": "Dzwonię do ___. (hydraulik)",
          "answer": "hydraulika",
          "grammar_point": "dopelniacz"
        },
        {
          "id": "h1-8",
          "text": "Czekam na ___. (listonosz)",
          "answer": "listonosza",
          "grammar_point": "biernik",
          "explanation": "czekać na + biernik; osoba (on) → -a"
        }
      ]
    },
    {
