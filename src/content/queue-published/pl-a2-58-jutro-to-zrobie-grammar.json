          "grammar_point": "czas-przyszly-dk",
          "explanation": "Po „będę” nie ma dokonanego. Wynik — napiszę; proces — będę pisać."
        },
        {
          "id": "g5-2",
          "prompt": "Weźmę ze sobą aparat.",
