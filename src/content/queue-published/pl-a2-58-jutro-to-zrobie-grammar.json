          ],
          "grammar_point": "czas-przyszly-dk",
          "explanation": "Ja: przyjadę — z a."
        },
        {
          "id": "g5-4",
          "prompt": "Zadzwonię tobie wieczorem.",
          "answer": "Zadzwonię do ciebie wieczorem.",
          "accept": [
