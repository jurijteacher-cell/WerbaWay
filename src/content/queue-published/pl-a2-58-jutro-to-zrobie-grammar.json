          ],
          "grammar_point": "czas-przyszly-dk",
          "explanation": "Dzwonić do kogo? — do ciebie."
        },
        {
          "id": "g5-5",
          "prompt": "Powiedzę ci prawdę.",
          "answer": "Powiem ci prawdę.",
          "grammar_point": "czas-przyszly-dk",
          "explanation": "Ja: powiem."
        },
        {
          "id": "g5-6",
          "prompt": "Właśnie spakuję prezenty, nie przeszkadzaj.",
          "answer": "Właśnie pakuję prezenty, nie przeszkadzaj.",
          "grammar_point": "czas-przyszly-dk",
          "explanation": "„Właśnie”, teraz — niedokonany: pakuję."
        }
      ]
