    {
      "block_id": "g2",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "2. Wynik czy proces?",
      "instruction": "Wybierz poprawną formę: dokonany (wynik) czy „będę” + niedokonany (proces, powtarzanie).",
      "items": [
        {
          "id": "g2-1",
          "text": "W sobotę cały dzień ___ do egzaminu.",
          "answer": "będę się uczyć",
          "options": [
            "będę się uczyć",
            "nauczę się"
          ],
          "grammar_point": "czas-przyszly-bede",
          "explanation": "„Cały dzień” — proces: będę się uczyć."
        },
        {
          "id": "g2-2",
          "text": "Nie martw się, jutro ___ ten list i od razu go wyślę.",
          "answer": "napiszę",
          "options": [
            "napiszę",
            "będę pisać"
          ],
          "grammar_point": "czas-przyszly-dk",
          "explanation": "Wynik (list będzie gotowy) — dokonany: napiszę."
        },
        {
          "id": "g2-3",
          "text": "Właśnie ___ zupę, nie mogę teraz rozmawiać.",
          "answer": "gotuję",
          "options": [
            "gotuję",
            "ugotuję"
          ],
          "grammar_point": "czas-przyszly-dk",
          "explanation": "„Właśnie”, teraz — niedokonany w teraźniejszym. Dokonany nie ma teraźniejszości."
        },
        {
          "id": "g2-4",
          "text": "Od września ___ na kurs tańca co czwartek.",
          "answer": "będę chodzić",
          "options": [
            "będę chodzić",
            "pójdę"
          ],
          "grammar_point": "czas-przyszly-bede",
          "explanation": "„Co czwartek” — regularnie w przyszłości: będę chodzić."
        },
        {
          "id": "g2-5",
          "text": "Kup chleb! — Dobrze, ___ po pracy.",
          "answer": "kupię",
          "options": [
            "kupię",
            "będę kupować"
          ],
          "grammar_point": "czas-przyszly-dk",
          "explanation": "Jedna akcja z wynikiem — kupię."
        },
        {
          "id": "g2-6",
          "text": "Babcia ___ do nas w piątek pociągiem.",
          "answer": "przyjedzie",
          "options": [
            "przyjedzie",
            "będzie przyjeżdżać"
          ],
          "grammar_point": "czas-przyszly-dk",
          "explanation": "Jeden przyjazd — przyjedzie."
        },
        {
          "id": "g2-7",
          "text": "W przyszłym tygodniu codziennie ___ do pracy rowerem.",
          "answer": "będę jeździć",
          "options": [
            "będę jeździć",
            "pojadę"
          ],
          "grammar_point": "czas-przyszly-bede",
          "explanation": "„Codziennie” — będę jeździć."
        }
      ]
    },
    {
      "block_id": "g3",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "3. Formy przyszłe",
      "instruction": "Wpisz czasownik dokonany w czasie przyszłym. W nawiasie: bezokolicznik i osoba.",
      "items": [
        {
          "id": "g3-1",
          "text": "Na plażę ___ duży ręcznik. (wziąć, ja)",
          "answer": "wezmę",
          "grammar_point": "czas-przyszly-dk",
          "explanation": "Ja: wezmę — bez ź. Ty: weźmiesz."
        },
        {
          "id": "g3-2",
          "text": "Do Lublina ___ samochodem. (pojechać, my)",
          "answer": "pojedziemy",
          "grammar_point": "czas-przyszly-dk",
          "explanation": "Ja pojadę, ale my pojedziemy — z e."
        },
        {
          "id": "g3-3",
          "text": "Kiedy ___ do Polski? (przyjechać, ty)",
          "answer": "przyjedziesz",
          "grammar_point": "czas-przyszly-dk",
          "explanation": "Ty: przyjedziesz. Ja: przyjadę."
        },
        {
          "id": "g3-4",
          "text": "Wszystko ___ mamie wieczorem. (powiedzieć, ja)",
          "answer": "powiem",
          "grammar_point": "czas-przyszly-dk",
          "explanation": "Ja: powiem, nie „powiedzę”."
        },
        {
          "id": "g3-5",
          "text": "Goście ___ cały tort, zobaczysz! (zjeść, oni)",
          "answer": "zjedzą",
          "grammar_point": "czas-przyszly-dk",
          "explanation": "Oni: zjedzą."
        },
        {
          "id": "g3-6",
          "text": "W sobotę ___ o dziewiątej, nie wcześniej. (wstać, ja)",
          "answer": "wstanę",
          "grammar_point": "czas-przyszly-dk",
          "explanation": "Ja: wstanę."
        },
        {
          "id": "g3-7",
          "text": "Jutro córka ___ do lekarza. (pójść, ona)",
          "answer": "pójdzie",
          "grammar_point": "czas-przyszly-dk",
          "explanation": "Ona: pójdzie."
        },
        {
          "id": "g3-8",
          "text": "___ ci znać po egzaminie. (dać, ja)",
          "answer": "Dam",
          "grammar_point": "czas-przyszly-dk",
          "explanation": "Dać: dam, dasz, da… dadzą."
        }
      ]
    },
    {
      "block_id": "g4",
      "part": 2,
      "exercise_type": "fill-in-blank",
      "title": "4. Wczoraj, teraz czy jutro?",
      "instruction": "Wybierz poprawną formę.",
      "items": [
        {
          "id": "g4-1",
          "text": "Wczoraj ___ do mamy, a jutro zadzwonię do taty.",
          "answer": "zadzwoniłam",
          "options": [
            "zadzwoniłam",
            "zadzwonię",
            "dzwonię"
