{
  "lesson_id": "pl-trener-04-nogi-i-posladki",
  "exercise_type": "fill-in-blank",
  "title": "Praca domowa: trening nóg w domu",
  "instruction": "Trzy bloki. Zrób je przed napisaniem e-maila.",
  "estimated_minutes": 25,
  "blocks": [
    {
      "block_id": "h1",
      "exercise_type": "fill-in-blank",
      "title": "1. Wpisz dobrą formę",
      "instruction": "Wpisz słowa z nawiasu w dobrej formie, z przyimkiem, jeśli trzeba.",
      "items": [
        {
          "id": "h1-1",
          "text": "W domu możesz robić przysiady z ___ (plecak) pełnym książek.",
          "answer": "plecakiem",
          "grammar_point": "z-narzednik"
        },
        {
          "id": "h1-2",
          "text": "Usiądź ___ (krzesło) i wstań bez pomocy rąk.",
          "answer": "na krześle",
          "grammar_point": "gdzie-dokad-na"
        },
        {
          "id": "h1-3",
          "text": "Wejdź ___ (pierwszy stopień) schodów.",
          "answer": "na pierwszy stopień",
          "grammar_point": "gdzie-dokad-na",
          "accept": [
            "na 1. stopień"
          ]
        },
        {
          "id": "h1-4",
          "text": "Trzymaj butelkę wody obiema ___ (dłonie).",
          "answer": "dłońmi",
          "grammar_point": "narzednik-koncowki",
          "explanation": "dłoń → dłońmi (wyjątek: nie *dłoniami)."
        },
        {
          "id": "h1-5",
          "text": "Podłóż ręcznik pod ___ (stopa).",
          "answer": "stopę",
          "grammar_point": "gdzie-dokad-za-pod-przed",
          "explanation": "Ruch do celu → pod + biernik."
        },
        {
          "id": "h1-6",
          "text": "Zejdź powoli ___ (stopień).",
          "answer": "ze stopnia",
          "grammar_point": "skad-z-od"
        },
        {
          "id": "h1-7",
          "text": "Krzesło stoi za ___ (ty), jakbyś miał na nim usiąść.",
          "answer": "tobą",
          "grammar_point": "przyimki-miejsca-narzednik"
        }
      ]
    },
    {
      "block_id": "h2",
      "exercise_type": "sentence-building",
      "title": "2. Ułóż polecenia",
      "instruction": "Klikaj fragmenty w dobrej kolejności.",
      "items": [
        {
          "id": "h2-1",
          "words": [
            "na schodach",
            "wspięcia na palce",
            "rób"
          ],
          "answer": "Rób wspięcia na palce na schodach.",
          "grammar_point": "gdzie-dokad-na",
          "accept": [
            "Na schodach rób wspięcia na palce."
          ]
        },
        {
          "id": "h2-2",
          "words": [
            "przed klatką piersiową",
            "trzymaj",
            "butelkę"
          ],
          "answer": "Trzymaj butelkę przed klatką piersiową.",
          "grammar_point": "przyimki-miejsca-narzednik",
          "accept": [
            "Przed klatką piersiową trzymaj butelkę."
          ]
        },
        {
          "id": "h2-3",
          "words": [
            "z plecakiem",
            "przysiady",
            "rób"
          ],
          "answer": "Rób przysiady z plecakiem.",
          "grammar_point": "z-narzednik",
          "accept": [
            "Przysiady rób z plecakiem.",
            "Z plecakiem rób przysiady."
          ]
        },
        {
          "id": "h2-4",
          "words": [
            "ze stopnia",
            "schodź",
            "tyłem"
          ],
          "answer": "Schodź ze stopnia tyłem.",
          "grammar_point": "skad-z-od",
          "accept": [
            "Schodź tyłem ze stopnia.",
            "Tyłem schodź ze stopnia."
          ]
        },
        {
          "id": "h2-5",
          "words": [
            "pod kolano",
            "ręcznik",
            "podłóż"
          ],
          "answer": "Podłóż ręcznik pod kolano.",
          "grammar_point": "gdzie-dokad-za-pod-przed",
          "accept": [
            "Pod kolano podłóż ręcznik."
          ]
        }
      ]
    },
    {
      "block_id": "h3",
      "exercise_type": "sentence-building",
      "title": "3. Popraw błąd",
      "instruction": "W każdym zdaniu jest jeden błąd. Napisz całe zdanie poprawnie.",
      "items": [
        {
          "id": "h3-1",
          "prompt": "Rób unoszenie bioder z gantelą na brzuchu.",
          "answer": "Rób unoszenie bioder z hantlą na brzuchu.",
          "grammar_point": "kalki-uk",
          "accept": [
            "Rób unoszenie bioder z hantlem na brzuchu."
          ],
          "explanation": "Укр. «гантеля» → hantla albo hantel."
        },
        {
          "id": "h3-2",
          "prompt": "Stań na noski i trzymaj dwie sekundy.",
          "answer": "Stań na palcach i trzymaj dwie sekundy.",
          "grammar_point": "kalki-uk",
          "accept": [
            "Wspnij się na palce i trzymaj dwie sekundy."
          ]
        },
        {
          "id": "h3-3",
          "prompt": "Moja siostra robi wypady z gumą.",
          "answer": "Moja siostra robi wykroki z gumą.",
          "grammar_point": "kalki-uk",
          "accept": [
            "Moja siostra robi z gumą wykroki."
          ]
        },
        {
          "id": "h3-4",
          "prompt": "Wejdź powoli na stopniu.",
          "answer": "Wejdź powoli na stopień.",
          "grammar_point": "gdzie-dokad-na",
          "accept": [
            "Wejdź na stopień powoli."
          ]
        },
        {
          "id": "h3-5",
          "prompt": "Trzymaj butelki przed siebie.",
          "answer": "Trzymaj butelki przed sobą.",
          "grammar_point": "gdzie-dokad-za-pod-przed",
          "explanation": "Pozycja (gdzie?) → przed sobą."
        },
        {
          "id": "h3-6",
          "prompt": "Zeskocz z stopnia.",
          "answer": "Zeskocz ze stopnia.",
          "grammar_point": "skad-z-od"
        }
      ]
    }
  ]
