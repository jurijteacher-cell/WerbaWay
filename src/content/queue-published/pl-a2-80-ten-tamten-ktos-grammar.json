        },
        {
          "id": "g5-5",
          "prompt": "Te panowie są z Gdańska.",
          "answer": "Ci panowie są z Gdańska.",
          "grammar_point": "kalki-uk",
          "explanation": "Panowie — mężczyźni → ci."
        },
        {
          "id": "g5-6",
          "prompt": "Widzę ta szafkę przy drzwiach.",
          "answer": "Widzę tę szafkę przy drzwiach.",
          "grammar_point": "kalki-uk",
          "explanation": "Widzę + biernik, ż. → tę szafkę."
        }
      ]
    }
