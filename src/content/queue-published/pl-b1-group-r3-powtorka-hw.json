{
  "lesson_id": "pl-b1-group-r3-powtorka",
  "exercise_type": "fill-in-blank",
  "title": "Praca domowa: powtórka bloku 3",
  "instruction": "Trzy bloki ćwiczeń. Potem napisz nową wersję swojego tekstu — zadanie jest na stronie lekcji.",
  "estimated_minutes": 20,
  "blocks": [
    {
      "block_id": "h1",
      "exercise_type": "fill-in-blank",
      "title": "1. Wpisz formę",
      "instruction": "Wpisz słowa z nawiasu w dobrej formie.",
      "items": [
        {
          "id": "h1-1",
          "text": "___ o paszportach! Bez nich nie wejdziemy do samolotu. (nie zapomnieć, wy)",
          "answer": "Nie zapomnijcie",
          "accept": [
            "Nie zapominajcie"
          ],
          "grammar_point": "rozkazujacy-aspekt",
          "explanation": "Ostrzeżenie przed błędem → często dokonany: nie zapomnijcie!"
        },
        {
          "id": "h1-2",
          "text": "Gdyby jutro ___ ładna pogoda, pojechalibyśmy nad jezioro. (być)",
          "answer": "była",
          "grammar_point": "warunek-nierealny",
          "explanation": "Gdyby + forma na -ł: była (pogoda — ż.)."
        },
        {
          "id": "h1-3",
          "text": "Żeby dostać kartę pobytu, ___ złożyć wniosek w urzędzie wojewódzkim. (konieczność, bezosobowo)",
          "answer": "trzeba",
          "accept": [
            "należy"
          ],
          "grammar_point": "modalne",
          "explanation": "Bez osoby: trzeba / należy + bezokolicznik."
        },
        {
          "id": "h1-4",
          "text": "Dzieci, ___ ręce przed obiadem! (umyć, wy)",
          "answer": "umyjcie",
          "grammar_point": "rozkazujacy",
          "explanation": "Umyć → umyj → umyjcie."
        },
        {
          "id": "h1-5",
          "text": "Sąsiadka poprosiła nas, ___ ciszej po dwudziestej drugiej. (żeby + być, my)",
          "answer": "żebyśmy byli",
          "accept": [
            "żebyśmy były"
          ],
          "grammar_point": "zeby-zyczenie",
          "explanation": "Prośba do nas → żebyśmy byli / były."
        },
        {
          "id": "h1-6",
          "text": "— ___ zapłacić kartą? — zapytał grzecznie klient. (móc, ja — tryb przypuszczający)",
          "answer": "Czy mógłbym",
          "accept": [
            "Mógłbym"
          ],
          "grammar_point": "warunkowy-prosby",
          "explanation": "Grzeczne pytanie → tryb przypuszczający: czy mógłbym…?"
        }
      ]
    },
    {
      "block_id": "h2",
      "exercise_type": "sentence-building",
      "title": "2. Popraw błąd",
      "instruction": "W każdym zdaniu jest jeden błąd. Napisz całe zdanie poprawnie.",
      "items": [
        {
          "id": "h2-1",
          "prompt": "Jeśli będę mieć czas, zadzwoniłbym do ciebie.",
          "answer": "Jeśli będę mieć czas, zadzwonię do ciebie.",
          "accept": [
            "Jeśli będę miał czas, zadzwonię do ciebie.",
            "Jeśli będę miała czas, zadzwonię do ciebie.",
            "Gdybym miał czas, zadzwoniłbym do ciebie."
          ],
          "grammar_point": "warunek-realny",
          "explanation": "Jeśli + przyszłość → w drugiej części też przyszłość: zadzwonię."
        },
        {
          "id": "h2-2",
          "prompt": "Powinieneś iść do lekarza wczoraj.",
          "answer": "Powinieneś był iść do lekarza wczoraj.",
          "accept": [
            "Wczoraj powinieneś był iść do lekarza.",
            "Powinieneś był pójść do lekarza wczoraj.",
            "Wczoraj powinieneś był pójść do lekarza."
          ],
          "grammar_point": "modalne",
          "explanation": "Rada o przeszłości → powinieneś był."
        },
        {
          "id": "h2-3",
          "prompt": "Przyszedłem, żeby ty mi pomógł.",
          "answer": "Przyszedłem, żebyś mi pomógł.",
          "grammar_point": "zeby-cel",
          "explanation": "Żeby + ty → żebyś (końcówka osoby przy „żeby”)."
        },
        {
          "id": "h2-4",
          "prompt": "Proszę, pan siada.",
          "answer": "Proszę usiąść.",
          "accept": [
            "Niech pan siada.",
            "Proszę siadać.",
            "Niech pan usiądzie.",
            "Proszę, niech pan usiądzie."
          ],
          "grammar_point": "rozkazujacy",
          "explanation": "Do pana / pani: proszę + bezokolicznik albo niech pan…"
        },
        {
          "id": "h2-5",
          "prompt": "Nie wolno ci się martwić, wszystko będzie dobrze.",
          "answer": "Nie musisz się martwić, wszystko będzie dobrze.",
          "accept": [
            "Nie martw się, wszystko będzie dobrze."
          ],
          "grammar_point": "modalne",
          "explanation": "Pocieszamy, nie zabraniamy → nie musisz / nie martw się."
        }
      ]
    },
    {
      "block_id": "h3",
      "exercise_type": "fill-in-blank",
      "title": "3. Wybierz formę",
      "instruction": "Wybierz poprawną formę.",
      "items": [
        {
          "id": "h3-1",
          "text": "Gdybyście przyszli wcześniej, ___ tort.",
          "answer": "zjedlibyście",
          "options": [
            "zjedlibyście",
            "zjecie",
            "zjedliście"
          ],
          "grammar_point": "przypuszczajacy-formy",
          "explanation": "Gdyby… → tryb przypuszczający: zjedlibyście."
        },
        {
          "id": "h3-2",
          "text": "Mama zawsze prosi, ___ nie wracać późno.",
          "answer": "żeby",
          "options": [
            "jeżeli",
            "że",
            "żeby"
          ],
          "grammar_point": "zeby-zyczenie",
          "explanation": "Prośba → żeby."
        },
        {
          "id": "h3-3",
          "text": "Regulamin muzeum: nie ___ robić zdjęć z fleszem.",
          "answer": "wolno",
          "options": [
            "umie",
            "wolno",
            "potrafi"
          ],
          "grammar_point": "modalne",
          "explanation": "Regulamin = zakaz → nie wolno."
        },
        {
          "id": "h3-4",
          "text": "___ się, proszę! Pociąg zaraz odjedzie!",
          "answer": "Pospiesz",
          "options": [
            "Pospiesz",
            "Pospieszy",
            "Pospieszać"
          ],
          "grammar_point": "rozkazujacy",
          "explanation": "Ty → pospiesz się."
        },
        {
          "id": "h3-5",
          "text": "Jeśli jutro ___ ładna pogoda, pójdziemy w góry.",
          "answer": "będzie",
          "options": [
            "byłaby",
            "była",
            "będzie"
          ],
          "grammar_point": "warunek-realny",
          "explanation": "Jeśli + realna przyszłość → będzie."
        }
      ]
    }
  ]
}
