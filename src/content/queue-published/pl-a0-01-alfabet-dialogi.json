          "a": "d1k3"
        },
        {
          "id": "d1m3",
          "s": "m",
          "pl": "En, o, wu, a, ka.",
          "tr": "Ен, о, ву, а, ка — N-O-W-A-K.",
          "a": "d1m3"
        },
        {
          "id": "d1k4",
          "s": "k",
          "pl": "Dziękuję!",
          "tr": "Дякую!",
          "a": "d1k4"
        },
        {
          "id": "d1m4",
          "s": "m",
          "pl": "Proszę.",
          "tr": "Прошу.",
          "a": "d1m4"
        }
      ]
    },
    {
      "id": "d2",
      "t": "W sklepie",
      "lines": [
        {
          "id": "d2k1",
          "s": "k",
          "pl": "Dzień dobry. Poproszę chleb.",
          "tr": "Доброго дня. Будь ласка, хліб.",
          "a": "d2k1"
        },
        {
          "id": "d2m1",
          "s": "m",
          "pl": "Proszę. Pięć złotych.",
          "tr": "Прошу. П'ять злотих.",
