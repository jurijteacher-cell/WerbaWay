          "a": "d1k2"
        },
        {
          "id": "d1m2",
          "s": "m",
          "pl": "Nazywam się Marek Nowak.",
          "tr": "Мене звати Марек Новак.",
          "a": "d1m2"
        },
        {
          "id": "d1k3",
          "s": "k",
          "pl": "Przepraszam, jak to się pisze?",
