        },
        {
          "id": "g2-7",
          "text": "Nie daję swojego numeru ___ — tylko znajomym.",
          "answer": "byle komu",
          "options": [
            "komuś",
            "byle komu"
          ],
          "explanation": "Кому попало → byle komu.",
          "grammar_point": "zaimki-nieokreslone"
        },
        {
          "id": "g2-8",
          "text": "To nie jest ___ — to najlepszy chirurg w mieście.",
          "answer": "byle kto",
          "options": [
            "ktoś",
            "byle kto"
          ],
          "explanation": "Nie byle kto = не кто попало, важная персона.",
          "grammar_point": "zaimki-nieokreslone"
        }
      ]
    },
