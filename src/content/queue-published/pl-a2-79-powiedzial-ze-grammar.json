        }
      ]
    },
    {
      "block_id": "g2",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "2. Że, czy czy słowo pytające?",
      "instruction": "Wybierz słowo, które pasuje.",
      "items": [
        {
          "id": "g2-1",
          "text": "Pan Piotr powiedział, ___ jest zadowolony z mojej pracy.",
          "answer": "że",
          "options": [
            "że",
            "czy",
            "co"
          ],
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Informacja → powiedział, że…"
        },
        {
          "id": "g2-2",
          "text": "Zapytał, ___ chciałabym prowadzić nowy projekt.",
          "answer": "czy",
          "options": [
            "czy",
            "że",
            "co"
          ],
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Pytanie tak / nie → zapytał, czy…"
        },
        {
          "id": "g2-3",
          "text": "„Kiedy możesz zacząć?” → Zapytał, ___ mogę zacząć.",
          "answer": "kiedy",
          "options": [
            "kiedy",
            "czy",
            "że"
          ],
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Pytanie ze słowem → to samo słowo: kiedy."
        },
        {
          "id": "g2-4",
          "text": "Mama zapytała, ___ razy w miesiącu jeżdżę do Gdańska.",
          "answer": "ile",
          "options": [
            "ile",
            "czy",
            "że"
          ],
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "„Ile razy…?” → zapytała, ile razy…"
        },
        {
          "id": "g2-5",
          "text": "Kasia mówi, ___ powinnam się zgodzić.",
          "answer": "że",
          "options": [
            "że",
            "czy",
            "żeby"
          ],
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Informacja → mówi, że…"
        },
        {
          "id": "g2-6",
          "text": "„Gdzie jest twoje biuro?” → Tomek zapytał, ___ jest moje biuro.",
          "answer": "gdzie",
          "options": [
            "gdzie",
            "czy",
            "że"
          ],
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Pytanie ze słowem → gdzie."
        },
        {
          "id": "g2-7",
          "text": "Nie wiem, ___ dam radę.",
          "answer": "czy",
          "options": [
            "czy",
            "że",
            "co"
          ],
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Nie wiem + pytanie tak / nie → czy."
        }
      ]
    },
    {
      "block_id": "g3",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "3. Kto mówi? Zmień osobę",
      "instruction": "Wpisz czasownik w dobrej osobie. Czas się nie zmienia.",
      "items": [
        {
          "id": "g3-1",
          "text": "„Jestem zmęczona.” → Kasia powiedziała, że ___ zmęczona.",
          "answer": "jest",
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Ja → ona: jestem → jest."
        },
        {
          "id": "g3-2",
          "text": "„Dostaniesz podwyżkę.” (pan Piotr do Oleny) → Pan Piotr powiedział Olenie, że ___ podwyżkę.",
          "answer": "dostanie",
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Ty → ona: dostaniesz → dostanie."
        },
        {
          "id": "g3-3",
          "text": "„Zadzwonię jutro.” → Tomek powiedział, że ___ jutro.",
          "answer": "zadzwoni",
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Ja → on: zadzwonię → zadzwoni."
        },
        {
          "id": "g3-4",
          "text": "„Czy masz czas?” (Kasia do mnie) → Kasia zapytała, czy ___ czas.",
          "answer": "mam",
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Ty → ja: masz → mam."
        },
        {
          "id": "g3-5",
          "text": "„Gdzie mieszkasz?” (sąsiad do mnie) → Sąsiad zapytał, gdzie ___.",
          "answer": "mieszkam",
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Ty → ja: mieszkasz → mieszkam."
        },
        {
          "id": "g3-6",
          "text": "„Muszę się zastanowić.” (ja) → Powiedziałam, że ___ się zastanowić.",
          "answer": "muszę",
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Ja → ja: bez zmiany."
        },
        {
          "id": "g3-7",
          "text": "„Lubię pociągi.” → Olena mówi, że ___ pociągi.",
          "answer": "lubi",
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Ja → ona: lubię → lubi."
        },
        {
          "id": "g3-8",
          "text": "„Kiedy wracasz?” (mama do mnie) → Mama zapytała, kiedy ___.",
          "answer": "wracam",
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Ty → ja: wracasz → wracam."
        }
      ]
    },
    {
      "block_id": "g4",
      "part": 2,
      "exercise_type": "fill-in-blank",
      "title": "4. Zaimki i czasowniki mówienia",
      "instruction": "Wybierz dobrą formę.",
      "items": [
        {
          "id": "g4-1",
          "text": "„Pomogę ci.” (Tomek do mnie) → Tomek powiedział, że ___ pomoże.",
          "answer": "mi",
          "options": [
            "mi",
            "ci",
            "mu"
          ],
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Ci (do mnie) → mi."
        },
        {
          "id": "g4-2",
          "text": "„To mój pokój.” → Kasia powiedziała, że to ___ pokój.",
          "answer": "jej",
          "options": [
            "jej",
            "mój",
            "jego"
          ],
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Mój (Kasi) → jej."
        },
        {
          "id": "g4-3",
          "text": "Pan Piotr ___ mi zadzwonić do klienta.",
          "answer": "kazał",
          "options": [
            "kazał",
            "powiedział",
            "zapytał"
          ],
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Kazać komu + bezokolicznik."
        },
        {
          "id": "g4-4",
          "text": "Klient poprosił ___ szybką odpowiedź.",
          "answer": "o",
          "options": [
            "o",
            "na",
            "za"
          ],
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Poprosić o + biernik."
        },
        {
          "id": "g4-5",
          "text": "Mama zapytała ___, czy jestem zdrowa.",
          "answer": "mnie",
          "options": [
            "mnie",
            "u mnie",
            "mi"
          ],
          "grammar_point": "kalki-uk",
          "explanation": "Zapytać kogo? — biernik: mnie (nie „u mnie”)."
        },
        {
          "id": "g4-6",
          "text": "Tomek ___, że przyjdzie na urodziny.",
          "answer": "obiecał",
          "options": [
            "obiecał",
            "zapytał",
            "kazał"
          ],
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Obiecać, że…"
        }
      ]
    },
    {
      "block_id": "g5",
      "part": 2,
      "exercise_type": "sentence-building",
      "title": "5. Popraw błąd",
      "instruction": "W każdym zdaniu jest jeden błąd. Napisz całe zdanie poprawnie.",
      "items": [
        {
          "id": "g5-1",
          "prompt": "Zapytał, że mogę zacząć w maju.",
          "answer": "Zapytał, czy mogę zacząć w maju.",
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Pytanie tak / nie → czy."
        },
        {
          "id": "g5-2",
          "prompt": "Mama zapytała u mnie, czy jestem zdrowa.",
          "answer": "Mama zapytała mnie, czy jestem zdrowa.",
          "grammar_point": "kalki-uk",
          "explanation": "Zapytać kogo? — mnie."
        },
        {
          "id": "g5-3",
          "prompt": "Szef zapytał, co chcę prowadzić projekt.",
          "answer": "Szef zapytał, czy chcę prowadzić projekt.",
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Pytanie tak / nie → czy, nie „co”."
        },
        {
          "id": "g5-4",
          "prompt": "Pan Piotr kazał mi, że zadzwonię do klienta.",
          "answer": "Pan Piotr kazał mi zadzwonić do klienta.",
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Kazać + bezokolicznik."
        },
        {
          "id": "g5-5",
          "prompt": "Klient poprosił na odpowiedź do piątku.",
          "answer": "Klient poprosił o odpowiedź do piątku.",
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Poprosić o + biernik."
        },
        {
          "id": "g5-6",
          "prompt": "Nie wiem, że on przyjdzie.",
          "answer": "Nie wiem, czy on przyjdzie.",
          "accept": [
            "Nie wiem, czy przyjdzie."
          ],
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Nie wiem + pytanie → czy."
        }
      ]
    }
  ]
}
