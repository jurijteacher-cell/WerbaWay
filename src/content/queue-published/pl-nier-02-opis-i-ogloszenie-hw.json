{
  "lesson_id": "pl-nier-02-opis-i-ogloszenie",
  "exercise_type": "fill-in-blank",
  "title": "Praca domowa: dom pod Poznaniem",
  "instruction": "Pięć krótkich ćwiczeń. Możesz przerwać i wrócić później.",
  "estimated_minutes": 25,
  "blocks": [
    {
      "block_id": "h1",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "1. Które słowo pasuje?",
      "instruction": "Wybierz słowo.",
      "items": [
        {
          "id": "h1-1",
          "text": "Pan Tomasz kupuje mieszkanie i nie ma czasu na remont. Chce, żeby było ___.",
          "answer": "do zamieszkania",
          "grammar_point": "slownictwo",
          "options": [
            "do remontu",
            "do zamieszkania",
            "w stanie deweloperskim"
          ]
        },
        {
          "id": "h1-2",
          "text": "Klient ma opony i rowery i pyta, gdzie może je trzymać poza mieszkaniem. Odpowiadasz: w ___.",
          "answer": "komórce lokatorskiej",
          "grammar_point": "slownictwo",
          "options": [
            "garderobie",
            "komórce lokatorskiej",
            "przedpokoju"
          ]
        },
        {
          "id": "h1-3",
          "text": "Wszyscy właściciele mieszkań w jednym budynku tworzą wspólnotę ___.",
          "answer": "mieszkaniową",
          "grammar_point": "slownictwo",
          "options": [
            "mieszkaniową",
            "lokatorską",
            "administracyjną"
          ]
        },
        {
          "id": "h1-4",
          "text": "Budynek z betonowych płyt z lat siedemdziesiątych nazywamy potocznie: ___.",
          "answer": "wielka płyta",
          "grammar_point": "slownictwo",
          "options": [
            "kamienica",
            "deweloper",
            "wielka płyta"
          ]
        },
        {
          "id": "h1-5",
          "text": "Klientka nie chce przechodnich pokoi i pyta o ___ mieszkania.",
          "answer": "rozkład",
          "grammar_point": "slownictwo",
          "options": [
            "budżet",
            "rozkład",
            "metraż"
          ]
        },
        {
          "id": "h1-6",
          "text": "Klient nie odebrał telefonu. Pani Joanna prosi: „Proszę do niego ___ po piętnastej.”",
          "answer": "oddzwonić",
          "grammar_point": "slownictwo",
          "options": [
            "przedzwonić",
            "dodzwonić",
            "oddzwonić"
          ]
        }
      ]
    },
    {
      "block_id": "h2",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "2. Imiesłowy",
      "instruction": "Wpisz imiesłów bierny albo czynny od czasownika z nawiasu.",
      "items": [
        {
          "id": "h2-1",
          "text": "Dom ___ w 2015 roku ma nowoczesną instalację. (wybudować)",
          "answer": "wybudowany",
          "grammar_point": "imieslow-bierny"
        },
        {
          "id": "h2-2",
          "text": "Działka ___ z lasem jest bardzo cicha. (sąsiadować)",
          "answer": "sąsiadująca",
          "grammar_point": "imieslow-czynny"
        },
        {
          "id": "h2-3",
          "text": "Brama jest ___ na noc. (zamknąć)",
          "answer": "zamknięta",
          "grammar_point": "imieslow-bierny",
          "explanation": "Zamknąć → zamknięty."
        },
        {
          "id": "h2-4",
          "text": "Dach jest już ___. (ocieplić)",
          "answer": "ocieplony",
          "grammar_point": "imieslow-bierny"
        },
        {
          "id": "h2-5",
          "text": "Taras ___ na ogród jest zadaszony. (wychodzić)",
          "answer": "wychodzący",
          "grammar_point": "imieslow-czynny"
        },
        {
          "id": "h2-6",
          "text": "Ogród jest ___ drewnianym płotem. (ogrodzić)",
          "answer": "ogrodzony",
          "grammar_point": "imieslow-bierny"
        },
        {
          "id": "h2-7",
          "text": "Kominek ___ w salonie ogrzewa cały dół domu. (znajdować się)",
          "answer": "znajdujący się",
          "grammar_point": "imieslow-czynny"
        }
      ]
    },
    {
      "block_id": "h3",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "3. Stopniowanie i porównania",
      "instruction": "Wpisz brakującą formę.",
      "items": [
        {
          "id": "h3-1",
          "text": "Dom jest ___ niż mieszkanie: ma 128 m² zamiast 64. (duży)",
          "answer": "większy",
          "grammar_point": "stopniowanie"
        },
        {
          "id": "h3-2",
          "text": "Ten dom jest ___ od sąsiedniego. (nowy)",
          "answer": "nowszy",
          "grammar_point": "stopniowanie"
        },
        {
          "id": "h3-3",
          "text": "___ dalej od centrum, tym ciszej.",
          "answer": "Im",
          "grammar_point": "porownania"
        },
        {
          "id": "h3-4",
          "text": "W domu jest ___ światła niż w mieszkaniu. (dużo)",
          "answer": "więcej",
          "grammar_point": "stopniowanie"
        },
        {
          "id": "h3-5",
          "text": "Dom jest o dwieście tysięcy ___ niż mieszkanie. (drogi)",
          "answer": "droższy",
          "grammar_point": "stopniowanie"
        },
        {
          "id": "h3-6",
          "text": "Najbliższy przystanek jest ___ niż sklep. (daleko)",
          "answer": "dalej",
          "grammar_point": "stopniowanie"
        }
      ]
    },
    {
      "block_id": "h4",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "4. Liczby",
      "instruction": "Wpisz rzeczownik z nawiasu w poprawnej formie.",
      "items": [
        {
          "id": "h4-1",
          "text": "Dom ma 6 ___. (pokój)",
          "answer": "pokoi",
          "grammar_point": "liczebniki-skladnia"
        },
        {
          "id": "h4-2",
          "text": "Powierzchnia domu to sto dwadzieścia osiem ___ kwadratowych. (metr)",
          "answer": "metrów",
          "grammar_point": "liczebniki-skladnia"
        },
        {
          "id": "h4-3",
          "text": "Cena: milion sto dziewięćdziesiąt ___ złotych. (tysiąc)",
          "answer": "tysięcy",
          "grammar_point": "liczebniki-skladnia"
        },
        {
          "id": "h4-4",
          "text": "W ogrodzie rosną 23 ___. (drzewo)",
          "answer": "drzewa",
          "grammar_point": "liczebniki-skladnia",
          "explanation": "23 → końcówka 3 → mianownik l. mn."
        },
        {
          "id": "h4-5",
          "text": "Do sklepu jest 3 ___. (kilometr)",
          "answer": "kilometry",
          "grammar_point": "liczebniki-skladnia"
        },
        {
          "id": "h4-6",
          "text": "Rata kredytu to 4 ___ złotych miesięcznie. (tysiąc)",
          "answer": "tysiące",
          "grammar_point": "liczebniki-skladnia",
          "explanation": "Cztery tysiące złotych."
        }
      ]
    },
    {
      "block_id": "h5",
      "part": 1,
      "exercise_type": "sentence-building",
      "title": "5. Krócej, z imiesłowem",
      "instruction": "Zamień zdanie ze „który” na krótsze, z imiesłowem.",
      "items": [
        {
          "id": "h5-1",
          "prompt": "Zamień: Kupili dom, który został wybudowany z cegły.",
          "answer": "Kupili dom wybudowany z cegły.",
          "grammar_point": "imieslow-bierny",
          "accept": [
            "Kupili wybudowany z cegły dom.",
            "Kupili dom, wybudowany z cegły."
          ]
        },
        {
          "id": "h5-2",
          "prompt": "Zamień: To jest salon, który jest połączony z kuchnią.",
          "answer": "To jest salon połączony z kuchnią.",
          "grammar_point": "imieslow-bierny",
          "accept": [
            "To salon połączony z kuchnią.",
            "To jest salon, połączony z kuchnią."
          ]
        },
        {
          "id": "h5-3",
          "prompt": "Zamień: Mamy ofertę, która jest sprzedawana na wyłączność.",
          "answer": "Mamy ofertę sprzedawaną na wyłączność.",
          "grammar_point": "imieslow-bierny",
          "accept": [
            "Mamy ofertę, sprzedawaną na wyłączność."
          ]
        },
        {
          "id": "h5-4",
          "prompt": "Zamień: Szukam domu z ogrodem, który graniczy z lasem.",
          "answer": "Szukam domu z ogrodem graniczącym z lasem.",
          "grammar_point": "imieslow-czynny",
          "accept": [
            "Szukam domu z ogrodem, graniczącym z lasem."
          ]
        },
        {
          "id": "h5-5",
          "prompt": "Zamień: W ogrodzie stoi altana, która została zbudowana z drewna.",
          "answer": "W ogrodzie stoi altana zbudowana z drewna.",
          "grammar_point": "imieslow-bierny",
          "accept": [
            "W ogrodzie stoi altana, zbudowana z drewna.",
            "W ogrodzie stoi zbudowana z drewna altana."
          ]
        }
      ]
    }
  ]
}