  {
   "block_id": "h2",
   "title": "2. Pełna forma",
   "exercise_type": "fill-in-blank",
   "instruction": "Wpisz słowo w dobrej formie. W nawiasie jest podpowiedź.",
   "items": [
    {
     "id": "h2-1",
     "text": "Iryna nie ma już ___ (cierpliwość) do tego sklepu.",
     "answer": "cierpliwości",
     "grammar_point": "przeczenie-dopelniacz"
    },
    {
     "id": "h2-2",
     "text": "Za ten kubek zapłaciłam cztery ___ (złoty).",
     "answer": "złote",
     "grammar_point": "liczebniki"
    },
    {
     "id": "h2-3",
     "text": "Bilet do muzeum kosztuje sześć ___ (złoty).",
     "answer": "złotych",
     "grammar_point": "liczebniki"
    },
    {
     "id": "h2-4",
     "text": "Paweł szuka ___ (tani rower) dla córki.",
     "answer": "taniego roweru",
     "grammar_point": "czasowniki-z-dopelniaczem"
    },
    {
     "id": "h2-5",
     "text": "Wieczorem zadzwonię ___ (do + babcia).",
     "answer": "do babci",
     "grammar_point": "przyimki-dopelniacz"
    },
    {
     "id": "h2-6",
     "text": "Lena podziękowała ___ (sąsiad) za pomoc.",
     "answer": "sąsiadowi",
     "grammar_point": "celownik"
    },
    {
     "id": "h2-7",
     "text": "W ___ (nasza piwnica) leży stary fotel.",
     "answer": "naszej piwnicy",
     "grammar_point": "miejscownik"
    },
    {
     "id": "h2-8",
     "text": "Idziemy na pocztę ___ (z + syn).",
     "answer": "z synem",
     "grammar_point": "narzednik"
    }
   ]
  },
  {
   "block_id": "h3",
   "title": "3. Rower Pawła",
   "exercise_type": "fill-in-blank",
   "instruction": "Przeczytaj historię i wybierz formę, która pasuje.",
   "items": [
    {
     "id": "h3-1",
     "text": "Paweł napisał ogłoszenie o starym rowerze syna, ale nikt nie odpowiedział, bo nie dodał ___.",
