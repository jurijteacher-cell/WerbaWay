      "zdjęcia",
      "zdjęcie",
      "zdjęciem"
     ],
     "answer": "zdjęcia",
     "grammar_point": "przeczenie-dopelniacz"
    },
    {
     "id": "h3-2",
     "text": "Po tygodniu zadzwoniła pani z ___ osiedla.",
     "options": [
      "sąsiedniego",
      "sąsiednie",
      "sąsiednim"
     ],
     "answer": "sąsiedniego",
     "grammar_point": "przyimki-dopelniacz"
    },
    {
     "id": "h3-3",
     "text": "Chciała kupić rower dla ___.",
     "options": [
      "wnuczka",
      "wnuczkowi",
      "wnuczkiem"
     ],
     "answer": "wnuczka",
     "grammar_point": "przyimki-dopelniacz"
    },
    {
     "id": "h3-4",
     "text": "Zapytała, czy cena jest do ___.",
     "options": [
      "negocjacji",
      "negocjacje",
      "negocjacjami"
     ],
     "answer": "negocjacji",
     "grammar_point": "przyimki-dopelniacz"
    },
    {
     "id": "h3-5",
     "text": "Paweł obniżył cenę o dziesięć ___.",
     "options": [
      "złote",
      "złotych",
      "złotym"
     ],
     "answer": "złotych",
     "grammar_point": "liczebniki"
    },
    {
     "id": "h3-6",
     "text": "W sobotę spotkali się przed ___, a pani zapłaciła gotówką.",
     "options": [
      "garażu",
      "garażem",
      "garaż"
     ],
     "answer": "garażem",
     "grammar_point": "narzednik"
    },
    {
     "id": "h3-7",
     "text": "Wieczorem Paweł powiedział ___: „Teraz kupimy ci nowy rower!”.",
     "options": [
      "synowi",
      "syna",
      "synem"
     ],
     "answer": "synowi",
     "grammar_point": "celownik"
    }
   ]
  }
 ]
