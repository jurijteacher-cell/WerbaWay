          "answer": "góry",
          "grammar_point": "wolec-niz-od",
          "explanation": "Po niż ten sam przypadek: morze — góry."
        },
        {
          "id": "g1-8",
          "text": "Wolę morze od ___.",
          "options": [
            "gór",
            "góry"
          ],
          "answer": "gór",
          "grammar_point": "wolec-niz-od",
          "explanation": "Od + dopełniacz: od gór."
        }
      ]
    },
