          "answer": "c) Piszę, aby",
          "options": [
            "b) Piszę, że",
            "c) Piszę, aby",
            "a) Piszę, bo"
          ],
          "explanation": "Po „aby” używamy bezokolicznika: „aby zapytać”. Po „bo” i „że” potrzebne jest całe zdanie.",
          "grammar_point": "rejestr-formalny"
        },
