      "exercise_type": "drag-and-drop",
      "title": "7. Kartka na lodówce",
      "instruction": "Przeciągnij właściwą formę w lukę. Dwa słowa nie pasują nigdzie — to bezokoliczniki.",
      "bank": ["weź", "nie zapomnij", "zamknij", "wyłącz", "napisz", "wziąć", "zamykać"],
      "items": [
        { "id": "g7-1", "text": "___ dowód osobisty i kartę ciąży.", "answer": "weź" },
        { "id": "g7-2", "text": "___ o ładowarce, leży przy łóżku.", "answer": "nie zapomnij" },
        { "id": "g7-3", "text": "___ okno w kuchni, zapowiadali deszcz.", "answer": "zamknij" },
        { "id": "g7-4", "text": "___ żelazko z gniazdka przed wyjściem.", "answer": "wyłącz" },
        { "id": "g7-5", "text": "___ mi wiadomość, kiedy dojedziesz.", "answer": "napisz" }
