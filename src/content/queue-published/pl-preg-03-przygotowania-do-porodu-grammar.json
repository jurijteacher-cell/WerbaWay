  "title": "Tryb rozkazujący: od formy do rozmowy",
  "instruction": "Osiem bloków ułożonych od najłatwiejszego do najtrudniejszego. Przechodź po kolei — każdy dokłada jedną rzecz.",
  "estimated_minutes": 25,
  "blocks": [
    {
      "block_id": "g1",
      "exercise_type": "fill-in-blank",
      "title": "1. Rozgrzewka: do kogo mówimy?",
      "instruction": "Wybierz formę, która pasuje do osoby w zdaniu.",
      "items": [
        {
          "id": "g1-1",
          "text": "Aniu, ___ spokojnie i licz do czterech.",
          "options": ["oddychaj", "oddychajcie"],
          "answer": "oddychaj",
          "explanation": "Mówimy do jednej osoby, więc forma na ty."
        },
        {
          "id": "g1-2",
          "text": "Dziewczyny, ___ teraz wygodną pozycję.",
          "options": ["znajdź", "znajdźcie"],
          "answer": "znajdźcie",
          "explanation": "Zwracamy się do grupy, więc końcówka -cie."
        },
        {
          "id": "g1-3",
          "text": "___ krótką przerwę, wszyscy jesteśmy zmęczeni.",
          "options": ["Zrób", "Zróbmy"],
          "answer": "Zróbmy",
          "explanation": "Propozycja dla całej grupy razem: forma na my."
        },
        {
          "id": "g1-4",
          "text": "Niech pani ___ na tym krześle.",
          "options": ["usiądzie", "usiądź"],
          "answer": "usiądzie",
          "explanation": "Po niech stoi zwykła forma on / ona, nie rozkazująca."
        },
        {
          "id": "g1-5",
          "text": "Proszę ___ po prawej stronie korytarza.",
          "options": ["czekać", "czekaj"],
          "answer": "czekać",
          "explanation": "Po proszę zawsze bezokolicznik."
        },
        {
          "id": "g1-6",
          "text": "Tato, ___ torbę do bagażnika.",
          "options": ["włóż", "włóżcie"],
          "answer": "włóż",
          "explanation": "Jedna osoba, więc forma na ty."
        }
      ]
    },
    {
      "block_id": "g2",
      "exercise_type": "matching",
      "title": "2. Bezokolicznik i rozkaz",
      "instruction": "Połącz czasownik z jego formą rozkazującą dla ty.",
      "items": [
        { "id": "g2-1", "left": "oddychać", "right": "oddychaj" },
        { "id": "g2-2", "left": "wziąć", "right": "weź" },
