        },
        {
          "id": "g5-6",
          "text": "___ ładowarkę zawsze w bocznej kieszeni.",
          "options": ["Trzymaj", "Potrzymaj"],
          "answer": "Trzymaj",
          "explanation": "Zawsze to zwyczaj, nie jednorazowa czynność."
        }
      ]
    },
    {
      "block_id": "g6",
      "exercise_type": "fill-in-blank",
      "title": "6. Instrukcja od położnej",
      "instruction": "Siedem zdań, jedna instrukcja. Wstaw formę rozkazującą czasownika z nawiasu.",
      "items": [
        { "id": "g6-1", "text": "___ (spakować) torbę w trzydziestym szóstym tygodniu.", "answer": "Spakuj" },
        { "id": "g6-2", "text": "___ (postawić) ją przy drzwiach i nie chowaj do szafy.", "answer": "Postaw" },
        { "id": "g6-3", "text": "Dokumenty ___ (trzymać) osobno, w jednym miejscu.", "answer": "trzymaj" },
        { "id": "g6-4", "text": "___ (zadzwonić) do nas, kiedy skurcze będą regularne.", "answer": "Zadzwoń" },
        { "id": "g6-5", "text": "___ (przyjechać) spokojnie, nikt się nie spieszy.", "answer": "Przyjedź" },
        { "id": "g6-6", "text": "Nie ___ (jeść) dużego posiłku przed wyjazdem.", "answer": "jedz" },
        { "id": "g6-7", "text": "___ (być) w kontakcie z osobą towarzyszącą.", "answer": "Bądź" }
      ]
    },
    {
