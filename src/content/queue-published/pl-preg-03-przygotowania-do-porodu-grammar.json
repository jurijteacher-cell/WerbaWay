      "title": "3. Zbuduj formę",
      "instruction": "Zrób formę rozkazującą dla ty od podanej formy on / ona.",
      "items": [
        { "id": "g3-1", "text": "ona pisze → ___", "answer": "pisz" },
        { "id": "g3-2", "text": "on czeka → ___", "answer": "czekaj" },
        { "id": "g3-3", "text": "ona myje → ___", "answer": "myj" },
