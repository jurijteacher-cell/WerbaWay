{
  "lesson_id": "pl-a1-en-02-rodzaj-przymiotniki",
  "exercise_type": "fill-in-blank",
  "title": "Praca domowa: rodzaj i przymiotniki",
  "instruction": "Trzy ćwiczenia. 20 minut.",
  "instruction_uk": "Three exercises, 20 minutes. New words, new situations.",
  "estimated_minutes": 20,
  "blocks": [
    {
      "block_id": "h1",
      "exercise_type": "fill-in-blank",
      "title": "1. Napisz formę",
      "instruction": "Wpisz przymiotnik w dobrej formie.",
      "instruction_uk": "The adjective in brackets is in the „on” form.",
      "items": [
        {
          "id": "h1-1",
          "text": "Twój samochód jest bardzo ___. (szybki)",
          "answer": "szybki",
          "grammar_point": "przymiotnik-i"
        },
        {
          "id": "h1-2",
          "text": "Ulica przy dworcu jest ___. (krótki)",
          "answer": "krótka",
          "grammar_point": "przymiotnik-i"
        },
        {
          "id": "h1-3",
          "text": "Moje miasto jest małe, ale ___. (ładny)",
          "answer": "ładne",
          "grammar_point": "przymiotnik-zgoda"
        },
        {
          "id": "h1-4",
          "text": "Herbata jest już ___. (zimny)",
          "answer": "zimna",
          "grammar_point": "przymiotnik-zgoda"
        },
        {
          "id": "h1-5",
          "text": "To zdjęcie jest trochę ___. (brzydki)",
          "answer": "brzydkie",
          "grammar_point": "przymiotnik-i",
          "explanation": "zdjęcie → ono → brzydkie."
        },
        {
          "id": "h1-6",
          "text": "Moja babcia jest bardzo ___. (energiczny)",
          "answer": "energiczna",
          "grammar_point": "przymiotnik-zgoda"
        },
        {
          "id": "h1-7",
          "text": "Egzamin jest ___, ale uczę się codziennie. (trudny)",
          "answer": "trudny",
          "grammar_point": "przymiotnik-zgoda"
        },
        {
          "id": "h1-8",
          "text": "Ta radość jest ___! (wielki)",
          "answer": "wielka",
          "grammar_point": "rodzaj-wyjatki",
          "explanation": "radość → ona → wielka."
        }
      ]
    },
    {
      "block_id": "h2",
      "exercise_type": "fill-in-blank",
      "title": "2. Mój, moja, moje",
      "instruction": "Wybierz dobrą formę.",
      "instruction_uk": "Check the ending of the noun — and remember the exceptions.",
      "items": [
        {
          "id": "h2-1",
          "text": "To jest ___. Jest za domem.",
          "answer": "mój ogród",
          "options": [
            "mój ogród",
            "moja ogród",
            "moje ogród"
          ],
          "grammar_point": "rodzaj-rzeczownika"
        },
        {
          "id": "h2-2",
          "text": "Tu jest ___. Pracuję tu od rana.",
          "answer": "moje biuro",
          "options": [
            "moje biuro",
            "mój biuro",
            "moja biuro"
          ],
          "grammar_point": "rodzaj-rzeczownika"
        },
        {
          "id": "h2-3",
          "text": "To jest ___. Jest blisko domu.",
          "answer": "moja szkoła",
          "options": [
            "moja szkoła",
            "mój szkoła",
            "moje szkoła"
          ],
          "grammar_point": "rodzaj-rzeczownika"
        },
        {
          "id": "h2-4",
          "text": "To jest ___. Czyta go cały świat.",
          "answer": "mój ulubiony poeta",
          "options": [
            "mój ulubiony poeta",
            "moja ulubiona poeta"
          ],
          "grammar_point": "rodzaj-wyjatki",
          "explanation": "poeta is a man → on."
        },
        {
          "id": "h2-5",
          "text": "Gdzie jest ___? Nie widzę jej.",
          "answer": "moja rzecz",
          "options": [
            "moja rzecz",
            "mój rzecz",
            "moje rzecz"
          ],
          "grammar_point": "rodzaj-wyjatki",
          "explanation": "rzecz is ona, like noc."
        },
        {
          "id": "h2-6",
          "text": "To jest ___ handlowe w mieście.",
          "answer": "nowe centrum",
          "options": [
            "nowe centrum",
            "nowy centrum",
            "nowa centrum"
          ],
          "grammar_point": "rodzaj-wyjatki",
          "explanation": "-um → ono."
        }
      ]
    },
    {
      "block_id": "h3",
      "exercise_type": "sentence-building",
      "title": "3. Ułóż zdanie",
      "instruction": "Ułóż zdanie ze słów.",
