        {
          "id": "h3-4",
          "words": [
            "pan",
            "zadowolony",
            "jest",
            "czy",
            "z hotelu"
          ],
          "answer": "Czy pan jest zadowolony z hotelu?",
          "accept": [
            "Czy pan jest z hotelu zadowolony?",
            "Pan jest zadowolony z hotelu?",
            "Czy jest pan zadowolony z hotelu?"
          ],
          "grammar_point": "byc-przymiotnik"
        }
      ]
    }
  ]
