  "exercise_type": "fill-in-blank",
  "title": "Praca domowa: rodzaj, liczba i przymiotnik",
  "instruction": "Pięć krótkich ćwiczeń. Możesz przerwać i wrócić później.",
  "estimated_minutes": 20,
  "blocks": [
    {
      "block_id": "h1",
      "exercise_type": "fill-in-blank",
      "title": "1. Które słowo pasuje?",
      "instruction": "Wybierz słowo.",
      "items": [
        {
          "id": "h1-1",
          "text": "Pan Nowak chce kupić dom, więc jest ___.",
          "answer": "kupujący",
          "grammar_point": "slownictwo",
          "options": [
            "najemca",
            "kupujący",
            "właściciel"
          ]
        },
        {
          "id": "h1-2",
          "text": "Pan i pani Nowakowie są razem od dwudziestu lat. To są ___.",
          "answer": "małżonkowie",
          "grammar_point": "slownictwo",
          "options": [
            "małżonkowie",
            "sąsiedzi",
            "rodzice"
          ]
        },
        {
          "id": "h1-3",
          "text": "Dom ma duży ___ z widokiem na ogród.",
          "answer": "taras",
          "grammar_point": "slownictwo",
          "options": [
            "strych",
            "garaż",
            "taras"
          ]
        },
        {
          "id": "h1-4",
          "text": "Klient sprawdza każdy punkt umowy i zadaje dużo pytań. To bardzo ___ klient.",
          "answer": "wymagający",
          "grammar_point": "slownictwo",
          "options": [
            "uczciwy",
            "wilgotny",
            "wymagający"
          ]
        },
        {
          "id": "h1-5",
          "text": "Agent mówi o wszystkich wadach domu i nie oszukuje. Jest ___.",
          "answer": "uczciwy",
          "grammar_point": "slownictwo",
          "options": [
            "przestronny",
            "uczciwy",
            "wilgotny"
          ]
        },
        {
          "id": "h1-6",
          "text": "W tym domu są duże pokoje i dużo miejsca. Dom jest ___.",
          "answer": "przestronny",
          "grammar_point": "slownictwo",
          "options": [
            "zdecydowany",
            "przestronny",
            "wilgotny"
          ]
        }
      ]
    },
    {
      "block_id": "h2",
      "exercise_type": "fill-in-blank",
      "title": "2. Ten, ta, to",
      "instruction": "Wybierz ten, ta albo to.",
      "items": [
        {
          "id": "h2-1",
          "text": "___ taras jest duży.",
          "answer": "ten",
          "grammar_point": "rodzaj-rzeczownika",
          "options": [
            "to",
            "ta",
            "ten"
          ]
        },
        {
          "id": "h2-2",
          "text": "___ kuchnia ma okno.",
          "answer": "ta",
          "grammar_point": "rodzaj-rzeczownika",
          "options": [
            "to",
            "ta",
            "ten"
          ]
        },
        {
          "id": "h2-3",
          "text": "___ piętro jest ostatnie.",
          "answer": "to",
          "grammar_point": "rodzaj-rzeczownika",
          "options": [
            "to",
            "ta",
            "ten"
          ]
        },
        {
          "id": "h2-4",
          "text": "___ nieruchomość jest w Komornikach.",
          "answer": "ta",
          "grammar_point": "rodzaj-rzeczownika",
          "options": [
            "to",
            "ta",
            "ten"
          ],
          "explanation": "-ość: żeński."
        },
        {
          "id": "h2-5",
          "text": "___ kolega z biura jest agentem.",
          "answer": "ten",
          "grammar_point": "rodzaj-rzeczownika",
          "options": [
            "to",
            "ta",
            "ten"
          ],
          "explanation": "Kolega: -a, ale mężczyzna."
        },
        {
          "id": "h2-6",
          "text": "___ ogłoszenie jest na portalu.",
          "answer": "to",
          "grammar_point": "rodzaj-rzeczownika",
          "options": [
            "to",
            "ta",
            "ten"
          ]
        }
      ]
    },
    {
      "block_id": "h3",
      "exercise_type": "fill-in-blank",
      "title": "3. Liczba mnoga rzeczowników",
      "instruction": "Wpisz rzeczownik w liczbie mnogiej.",
      "items": [
        {
          "id": "h3-1",
          "text": "W domu są cztery ___. (pokój)",
          "answer": "pokoje",
          "grammar_point": "liczba-mnoga-mianownik"
        },
        {
          "id": "h3-2",
          "text": "Na tej ulicy stoją trzy ___. (dom)",
          "answer": "domy",
          "grammar_point": "liczba-mnoga-mianownik"
        },
        {
          "id": "h3-3",
          "text": "Na stole leżą trzy ___. (dokument)",
          "answer": "dokumenty",
          "grammar_point": "liczba-mnoga-mianownik"
        },
        {
          "id": "h3-4",
          "text": "Dom ma dwa ___. (garaż)",
          "answer": "garaże",
          "grammar_point": "liczba-mnoga-mianownik",
          "explanation": "garaż → garaże (po -ż piszemy -e)."
        },
        {
          "id": "h3-5",
          "text": "W domu są dwie ___. (łazienka)",
          "answer": "łazienki",
          "grammar_point": "liczba-mnoga-mianownik"
        },
        {
          "id": "h3-6",
          "text": "Agent pokazuje dwie ___. (oferta)",
          "answer": "oferty",
          "grammar_point": "liczba-mnoga-mianownik"
        },
        {
          "id": "h3-7",
          "text": "W kuchni są dwa ___. (okno)",
          "answer": "okna",
          "grammar_point": "liczba-mnoga-mianownik"
        }
      ]
    },
    {
      "block_id": "h4",
      "exercise_type": "fill-in-blank",
      "title": "4. Przymiotnik w liczbie mnogiej",
      "instruction": "Wpisz przymiotnik w liczbie mnogiej. W nawiasie jest forma męska.",
      "items": [
        {
          "id": "h4-1",
          "text": "Pan Nowak i pani Nowak są ___. (zadowolony)",
          "answer": "zadowoleni",
          "grammar_point": "mn-mianownik-mos"
        },
        {
          "id": "h4-2",
          "text": "Pokoje są ___ i jasne. (przestronny)",
          "answer": "przestronne",
          "grammar_point": "mn-mianownik-mos"
        },
        {
          "id": "h4-3",
          "text": "Ci sąsiedzi są ___. (uczciwy)",
          "answer": "uczciwi",
          "grammar_point": "mn-mianownik-mos"
        },
        {
          "id": "h4-4",
          "text": "Te panie są ___. (zdecydowany)",
          "answer": "zdecydowane",
          "grammar_point": "mn-mianownik-mos"
        },
        {
          "id": "h4-5",
          "text": "Dzieci są ___. (cichy)",
          "answer": "ciche",
          "grammar_point": "mn-mianownik-mos",
          "explanation": "Dzieci: grupa niemęskoosobowa."
        },
        {
          "id": "h4-6",
          "text": "Rodzice są ___. (wymagający)",
          "answer": "wymagający",
          "grammar_point": "mn-mianownik-mos"
        }
      ]
    },
    {
      "block_id": "h5",
      "exercise_type": "sentence-building",
      "title": "5. Popraw błąd",
      "instruction": "W każdym zdaniu jest jeden błąd. Napisz całe zdanie poprawnie.",
      "items": [
        {
          "id": "h5-1",
          "prompt": "Ta dom jest w Komornikach.",
          "answer": "Ten dom jest w Komornikach.",
          "grammar_point": "rodzaj-rzeczownika",
          "explanation": "Dom kończy się na spółgłoskę: męski → ten."
        },
        {
          "id": "h5-2",
          "prompt": "Państwo Nowakowie są zdecydowane.",
          "answer": "Państwo Nowakowie są zdecydowani.",
          "grammar_point": "mn-mianownik-mos",
          "explanation": "Państwo (kobieta i mężczyzna): forma męskoosobowa."
        },
        {
          "id": "h5-3",
          "prompt": "Dzieci są zmęczeni.",
          "answer": "Dzieci są zmęczone.",
          "grammar_point": "mn-mianownik-mos",
          "explanation": "Dzieci: forma niemęskoosobowa."
        },
        {
          "id": "h5-4",
          "prompt": "Te sąsiedzi są uczciwi.",
          "answer": "Ci sąsiedzi są uczciwi.",
          "grammar_point": "mn-mianownik-mos",
          "explanation": "Sąsiedzi to mężczyźni: ci."
        },
        {
          "id": "h5-5",
          "prompt": "Ta piętro jest ostatnie.",
          "answer": "To piętro jest ostatnie.",
          "grammar_point": "kalki-uk",
          "explanation": "Ukr. «поверх» jest męski, a pol. piętro jest nijakie: to piętro."
        }
      ]
    }
  ]
}
