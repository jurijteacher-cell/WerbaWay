      "exercise_type": "true-false",
      "title": "Czytanie: prawda czy fałsz?",
      "instruction": "Przeczytaj tekst „Lord jedzie do Zalesia”. Zdecyduj, czy zdania są prawdziwe, czy fałszywe.",
      "items": [
        {
          "id": "e1-1",
          "statement": "Lord został adoptowany w dniu, w którym Maksym przyjechał do schroniska.",
          "answer": false,
          "explanation": "Lord został adoptowany w środę, a Maksym przyjechał w sobotę."
        },
        {
          "id": "e1-2",
          "statement": "Taras codziennie jeździ skodą do pracy.",
          "answer": false,
          "explanation": "Do pracy dojeżdża trolejbusem, skodą jeżdżą tylko w weekendy."
        },
        {
          "id": "e1-3",
          "statement": "Bartek przyjechał do Zalesia, kiedy mógł już pracować zdalnie.",
          "answer": true,
          "explanation": "Kiedy szef zgodził się, żeby pracował zdalnie, spakował laptop i przyjechał."
        },
        {
          "id": "e1-4",
          "statement": "W nowej formie pracy Bartek ma płatny urlop.",
          "answer": false,
          "explanation": "Nie ma płatnego urlopu, a kiedy choruje, zwykle nie zarabia."
        },
        {
          "id": "e1-5",
          "statement": "W Zalesiu znowu działa sklep.",
          "answer": false,
          "explanation": "Sklepu nadal nie ma — Bartek robi babci zakupy w miasteczku."
        },
        {
          "id": "e1-6",
          "statement": "Bartek poprosił Maksyma o pomoc.",
          "answer": true,
          "explanation": "Poprosił, żeby Maksym pomógł mu zrobić psu budę."
        }
      ]
    },
    {
      "block_id": "e2",
      "exam_skill": "sluchanie",
      "exercise_type": "multiple-choice",
      "source": "teacher:e2-rozmowa",
      "max_plays": 2,
      "title": "Słuchanie: rozmowa z rekruterką",
      "instruction": "Nauczyciel przeczyta rozmowę Oleny z rekruterką. Usłyszysz ją dwa razy. Najpierw przeczytaj pytania, potem wybierz poprawną odpowiedź.",
      "items": [
        {
          "id": "e2-1",
          "question": "Ile dni w tygodniu trzeba pracować w biurze?",
          "options": [
            "dwa",
            "trzy",
            "ani jednego"
          ],
          "answer": "dwa",
          "explanation": "W poniedziałki i w czwartki w biurze, pozostałe trzy dni z domu."
        },
        {
          "id": "e2-2",
          "question": "Jaką umowę Olena dostanie na początek?",
          "options": [
            "umowę o pracę na okres próbny",
            "umowę zlecenia na trzy miesiące",
            "umowę o pracę na czas nieokreślony"
          ],
          "answer": "umowę o pracę na okres próbny",
          "explanation": "Na początek umowa o pracę na okres próbny, potem na czas nieokreślony."
        },
        {
          "id": "e2-3",
          "question": "Co firma da Olenie pierwszego dnia?",
          "options": [
            "laptop i słuchawki",
            "nowy telefon",
            "kartę parkingową"
          ],
          "answer": "laptop i słuchawki",
          "explanation": "Laptop i słuchawki zostaną przekazane pierwszego dnia."
        },
        {
          "id": "e2-4",
          "question": "Za co firma płaci część rachunku?",
          "options": [
            "za internet",
            "za benzynę",
            "za prąd"
          ],
          "answer": "za internet",
          "explanation": "Firma płaci część rachunku za internet."
        },
        {
          "id": "e2-5",
          "question": "Co Olena ma wziąć na rozmowę kwalifikacyjną?",
          "options": [
            "dowód osobisty i dyplom",
            "dyplom i dwa zdjęcia",
            "CV i list motywacyjny"
          ],
          "answer": "dowód osobisty i dyplom",
          "explanation": "Proszę wziąć dowód osobisty i dyplom."
        }
      ]
    },
    {
