        {
          "id": "g4-2",
          "text": "Deklarację trzeba złożyć ___.",
          "answer": "do 25. dnia miesiąca",
          "grammar_point": "kalki-uk",
          "options": [
            "do 25. dnia miesiąca",
            "do 25. liczby"
          ],
          "explanation": "До 25 числа = do 25. dnia miesiąca / do dwudziestego piątego."
        },
        {
          "id": "g4-3",
          "text": "Spotkanie z klientem mamy ___.",
          "answer": "piątego maja",
          "grammar_point": "data-kiedy",
          "options": [
            "piątego maja",
            "piąty maja"
          ],
          "explanation": "Kiedy? → dopełniacz: piątego maja."
        },
        {
          "id": "g4-4",
          "text": "Dzisiaj jest ___.",
          "answer": "dwudziesty kwietnia",
          "grammar_point": "data-kiedy",
          "options": [
            "dwudziesty kwietnia",
            "dwudziestego kwietnia"
          ],
          "explanation": "Jaki dziś dzień? → mianownik: dwudziesty kwietnia."
        },
        {
          "id": "g4-5",
          "text": "Towar policzono ___.",
          "answer": "zgodnie z zamówieniem",
          "grammar_point": "kalki-uk",
          "options": [
            "zgodnie z zamówieniem",
            "odpowiednio do zamówienia"
