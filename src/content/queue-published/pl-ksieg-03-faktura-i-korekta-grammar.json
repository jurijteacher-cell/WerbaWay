        {
          "id": "g4-8",
          "text": "W ___ zaksięgowałam ponad sto faktur.",
          "answer": "kwietniu",
          "grammar_point": "wyjatki-miejscownik",
          "options": [
            "kwietniu",
            "kwietnia"
          ],
          "explanation": "W + miesiąc → miejscownik: w kwietniu."
        }
