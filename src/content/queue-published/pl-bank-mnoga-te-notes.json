      "cards": [
        {
          "kind": "note",
          "wide": true,
          "text": "У множині слово стає на склад довшим, і голосна в останньому складі часто змінюється. Такі пари вчи разом: [[stół — stoły]]."
        },
        {
          "kind": "table",
          "title": "Чергування в чоловічому роді",
          "wide": true,
          "columns": [
            "Зміна",
            "Однина",
            "Множина"
          ],
          "rows": [
            [
              "ó → o",
              "stół, pokój, nóż",
              "st[[o]]ły, pok[[o]]je, n[[o]]że"
            ],
            [
              "ą → ę",
              "ząb, gołąb",
              "z[[ę]]by, goł[[ę]]bie"
            ],
            [
              "e зникає",
              "pies, ołówek, sen",
              "psy, ołówki, sny"
            ]
          ]
        },
        {
          "kind": "list",
          "title": "Винятки — запам'ятай",
          "items": [
            "ręka → [[ręce]]",
            "rok → [[lata]]",
            "dzień → [[dni]], tydzień → [[tygodnie]]",
            "dziecko → [[dzieci]], oko → [[oczy]], ucho → [[uszy]]",
            "rzecz → [[rzeczy]], mysz → [[myszy]]"
          ]
        },
        {
          "kind": "table",
          "title": "Тільки множина",
          "wide": true,
          "columns": [
            "Słowo",
            "Українською",
            "Приклад"
          ],
          "rows": [
            [
              "drzwi",
              "двері",
              "Te drzwi [[są]] otwarte."
            ],
            [
              "okulary",
              "окуляри",
              "Gdzie [[są]] moje okulary?"
            ],
            [
              "spodnie",
              "штани",
              "Te spodnie [[są]] za długie."
            ],
            [
              "urodziny",
              "день народження",
              "Moje urodziny [[są]] w maju."
            ],
            [
              "wakacje",
              "канікули, відпустка",
