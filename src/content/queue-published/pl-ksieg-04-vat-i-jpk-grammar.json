          ]
        },
        {
          "id": "g5-3",
          "prompt": "Klient zapłacił dwie tysiące złotych.",
          "answer": "Klient zapłacił dwa tysiące złotych.",
          "grammar_point": "dwa-tysiace"
        },
        {
          "id": "g5-4",
          "prompt": "VAT do zapłaty stanowi 900 złotych.",
          "answer": "VAT do zapłaty wynosi 900 złotych.",
          "grammar_point": "wynosic",
          "accept": [
            "VAT do zapłaty wynosi dziewięćset złotych."
          ]
        },
        {
          "id": "g5-5",
          "prompt": "Za spóźnioną płatność trzeba zapłacić procenty.",
          "answer": "Za spóźnioną płatność trzeba zapłacić odsetki.",
          "grammar_point": "odsetki",
          "accept": [
            "Za spóźnioną płatność trzeba zapłacić odsetki za zwłokę."
          ]
        },
        {
          "id": "g5-6",
          "prompt": "W marcu przyszło dwadzieścia jedna faktura.",
          "answer": "W marcu przyszło dwadzieścia jeden faktur.",
          "grammar_point": "21-jeden",
          "accept": [
            "W marcu przyszło 21 faktur."
          ]
        },
        {
          "id": "g5-7",
          "prompt": "Ten miesiąc był bardziej drogi niż poprzedni.",
          "answer": "Ten miesiąc był droższy niż poprzedni.",
          "grammar_point": "stopien-wyzszy",
          "accept": [
            "Ten miesiąc był droższy od poprzedniego."
          ]
        }
      ]
    }
  ]
