        },
        {
          "id": "g1-3",
          "left": "mikrorachunek podatkowy",
          "right": "rachunek do podatków, tworzony z NIP-u",
          "grammar_point": "slownictwo"
        },
        {
          "id": "g1-4",
          "left": "JPK_V7M",
          "right": "ewidencja i deklaracja VAT co miesiąc",
