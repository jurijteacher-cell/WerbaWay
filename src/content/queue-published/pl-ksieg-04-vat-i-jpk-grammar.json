        },
        {
          "id": "g1-5",
          "left": "zwolnienie z VAT",
          "right": "mała firma nie dolicza VAT-u do cen",
          "grammar_point": "slownictwo"
        },
        {
          "id": "g1-6",
          "left": "odsetki za zwłokę",
          "right": "kara za podatek zapłacony po terminie",
