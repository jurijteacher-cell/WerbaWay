{
  "lesson_id": "pl-telc-b1-02-mieszkanie",
  "exercise_type": "fill-in-blank",
  "title": "Praca domowa: mieszkanie i miejscownik",
  "instruction": "Trzy krótkie ćwiczenia. Możesz przerwać i wrócić później.",
  "estimated_minutes": 20,
  "blocks": [
    {
      "block_id": "h1",
      "exercise_type": "fill-in-blank",
      "title": "1. Które słowo pasuje?",
      "instruction": "Wybierz słowo.",
      "items": [
        {
          "id": "h1-1",
          "text": "Co miesiąc płacę właścicielowi ___ — tysiąc osiemset złotych.",
          "answer": "czynsz",
          "grammar_point": "slownictwo",
          "options": [
            "czynsz",
            "kaucję",
            "umowę"
          ]
        },
        {
          "id": "h1-2",
          "text": "W łazience znowu leci woda. Muszę zadzwonić po ___.",
          "answer": "hydraulika",
          "grammar_point": "slownictwo",
          "options": [
            "hydraulika",
            "lokatora",
            "sąsiada"
          ]
        },
        {
          "id": "h1-3",
          "text": "Nasz blok nie ma ___, więc codziennie chodzę pieszo na szóste piętro.",
          "answer": "windy",
          "grammar_point": "slownictwo",
          "options": [
            "windy",
            "piwnicy",
            "klatki"
          ]
        },
        {
          "id": "h1-4",
          "text": "Po dwudziestej drugiej zaczyna się ___ — nie wolno hałasować.",
          "answer": "cisza nocna",
          "grammar_point": "slownictwo",
          "options": [
            "cisza nocna",
            "regulamin",
            "tablica ogłoszeń"
          ]
        },
        {
          "id": "h1-5",
          "text": "Właścicielka oddała mi ___, bo mieszkanie było czyste.",
          "answer": "kaucję",
          "grammar_point": "slownictwo",
          "options": [
            "kaucję",
            "czynsz",
            "awarię"
          ]
        },
        {
          "id": "h1-6",
          "text": "Lampa nie świeci, bo ___ jest zepsute.",
          "answer": "gniazdko",
          "grammar_point": "slownictwo",
          "options": [
            "gniazdko",
            "podwórko",
            "piętro"
          ]
        }
      ]
    },
    {
      "block_id": "h2",
      "exercise_type": "fill-in-blank",
      "title": "2. Wpisz miejscownik",
      "instruction": "Wpisz słowa z nawiasu we właściwej formie.",
      "items": [
        {
          "id": "h2-1",
          "text": "Mój pies najbardziej lubi spać na ___ (kanapa).",
          "answer": "kanapie",
          "grammar_point": "miejscownik-f"
        },
        {
          "id": "h2-2",
          "text": "Brat pracuje w ___ (szpital) na nocnej zmianie.",
          "answer": "szpitalu",
          "grammar_point": "miejscownik-m-n"
        },
        {
          "id": "h2-3",
          "text": "Spotkajmy się w ___ (kawiarnia) na rogu.",
          "answer": "kawiarni",
          "grammar_point": "miejscownik-f"
        },
        {
          "id": "h2-4",
          "text": "Na ___ (lotnisko) zawsze jest tłok.",
          "answer": "lotnisku",
          "grammar_point": "miejscownik-m-n"
        },
        {
          "id": "h2-5",
          "text": "Na zebraniu mówiliśmy o ___ (nowy parking).",
          "answer": "nowym parkingu",
          "grammar_point": "miejscownik-przymiotnik"
        },
        {
          "id": "h2-6",
          "text": "Moja szefowa mieszka w ___ (Poznań).",
          "answer": "Poznaniu",
          "grammar_point": "miejscownik-m-n"
        },
        {
          "id": "h2-7",
          "text": "Na ___ (ostatnie piętro) jest piękny widok.",
          "answer": "ostatnim piętrze",
          "grammar_point": "miejscownik-przymiotnik"
        },
        {
          "id": "h2-8",
          "text": "W ___ (wszystkie szkoły) zaczynają się ferie.",
          "answer": "wszystkich szkołach",
          "grammar_point": "miejscownik-l-mn"
        }
      ]
    },
    {
      "block_id": "h3",
      "exercise_type": "sentence-building",
      "title": "3. Dokąd → gdzie",
      "instruction": "Napisz nowe zdanie: zacznij od słów w nawiasie.",
      "items": [
        {
          "id": "h3-1",
          "prompt": "Idę do apteki. → (Już jestem …)",
          "answer": "Już jestem w aptece.",
          "grammar_point": "gdzie-dokad",
          "accept": [
            "Jestem już w aptece."
          ]
        },
        {
          "id": "h3-2",
          "prompt": "Jedziemy na lotnisko. → (Już jesteśmy …)",
          "answer": "Już jesteśmy na lotnisku.",
          "grammar_point": "gdzie-dokad",
          "accept": [
            "Jesteśmy już na lotnisku."
          ]
        },
        {
          "id": "h3-3",
          "prompt": "Kładę paszport do szuflady. → (Paszport leży …)",
          "answer": "Paszport leży w szufladzie.",
          "grammar_point": "gdzie-dokad"
        },
        {
          "id": "h3-4",
          "prompt": "Wychodzę na podwórko. → (Już jestem …)",
          "answer": "Już jestem na podwórku.",
          "grammar_point": "gdzie-dokad",
          "accept": [
            "Jestem już na podwórku."
          ]
        },
        {
          "id": "h3-5",
          "prompt": "Przeprowadzamy się do Gdyni. → (Od maja mieszkamy …)",
          "answer": "Od maja mieszkamy w Gdyni.",
          "grammar_point": "gdzie-dokad",
          "accept": [
            "W Gdyni mieszkamy od maja."
          ]
        }
      ]
    }
  ]
}
