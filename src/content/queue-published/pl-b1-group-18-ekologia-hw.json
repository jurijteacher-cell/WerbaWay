{
  "lesson_id": "pl-b1-group-18-ekologia",
  "exercise_type": "fill-in-blank",
  "title": "Praca domowa: mimo, chociaż i jednak w nowych zdaniach",
  "instruction": "Trzy bloki. Zrób je przed napisaniem e-maila.",
  "estimated_minutes": 25,
  "blocks": [
    {
      "block_id": "h1",
      "exercise_type": "fill-in-blank",
      "title": "1. Mimo + dopełniacz",
      "instruction": "Wpisz słowo z nawiasu w dopełniaczu.",
      "items": [
        {
          "id": "h1-1",
          "text": "Mimo ___ (późna godzina) w parku było dużo ludzi.",
          "answer": "późnej godziny",
          "grammar_point": "mimo-dopelniacz"
        },
        {
          "id": "h1-2",
          "text": "Pomimo ___ (remont) apteka jest otwarta.",
          "answer": "remontu",
          "grammar_point": "mimo-dopelniacz"
        },
        {
          "id": "h1-3",
          "text": "Mimo ___ (problemy) z kręgosłupem babcia sama robi zakupy.",
          "answer": "problemów",
          "grammar_point": "mimo-dopelniacz"
        },
        {
          "id": "h1-4",
          "text": "Mimo ___ (mróz) dzieci bawiły się na dworze.",
          "answer": "mrozu",
          "grammar_point": "mimo-dopelniacz"
        },
        {
          "id": "h1-5",
          "text": "Pomimo ___ (prośba) nauczyciela uczniowie dalej rozmawiali.",
          "answer": "prośby",
          "grammar_point": "mimo-dopelniacz"
        },
        {
          "id": "h1-6",
          "text": "Mimo ___ (duży hałas) dziecko spało jak suseł.",
          "answer": "dużego hałasu",
          "grammar_point": "mimo-dopelniacz"
        }
      ]
    },
    {
      "block_id": "h2",
      "exercise_type": "sentence-building",
      "title": "2. Ułóż zdania",
      "instruction": "Klikaj słowa w dobrej kolejności.",
      "items": [
        {
          "id": "h2-1",
          "words": [
            "mimo",
            "deszczu",
            "poszliśmy",
            "do",
            "parku"
          ],
          "answer": "Mimo deszczu poszliśmy do parku.",
          "grammar_point": "mimo-dopelniacz",
          "accept": [
            "Poszliśmy do parku mimo deszczu."
          ]
        },
        {
          "id": "h2-2",
          "words": [
            "mimo",
            "to",
            "nie",
            "zrezygnował"
          ],
          "answer": "Mimo to nie zrezygnował.",
          "grammar_point": "natomiast-jednak"
        },
        {
          "id": "h2-3",
          "words": [
            "za",
            "to",
            "jest",
            "tańszy"
          ],
          "answer": "Za to jest tańszy.",
          "grammar_point": "natomiast-jednak"
        },
        {
          "id": "h2-4",
          "words": [
            "ja",
            "jeżdżę",
            "autobusem,",
            "a",
            "ona",
            "rowerem"
          ],
          "answer": "Ja jeżdżę autobusem, a ona rowerem.",
          "grammar_point": "a-ale-i"
        },
        {
          "id": "h2-5",
          "words": [
            "jest",
            "jednak",
            "bardzo",
            "wygodny"
          ],
          "answer": "Jest jednak bardzo wygodny.",
          "grammar_point": "natomiast-jednak",
          "accept": [
            "Jednak jest bardzo wygodny."
          ]
        }
      ]
    },
    {
      "block_id": "h3",
      "exercise_type": "sentence-building",
      "title": "3. Popraw błąd",
      "instruction": "W każdym zdaniu jest jeden błąd. Napisz całe zdanie poprawnie.",
      "items": [
        {
          "id": "h3-1",
          "prompt": "Chociaż była chora, ale poszła do pracy.",
          "answer": "Chociaż była chora, poszła do pracy.",
          "grammar_point": "kalki-uk",
          "accept": [
            "Była chora, ale poszła do pracy.",
            "Poszła do pracy, chociaż była chora.",
            "Mimo że była chora, poszła do pracy."
          ],
          "explanation": "Po „chociaż” bez „ale”."
        },
        {
          "id": "h3-2",
          "prompt": "Mimo zimno otworzyła okno.",
          "answer": "Mimo zimna otworzyła okno.",
          "grammar_point": "mimo-dopelniacz",
          "accept": [
            "Otworzyła okno mimo zimna."
          ],
          "explanation": "Mimo + dopełniacz: zimna."
        },
        {
          "id": "h3-3",
          "prompt": "Nie patrząc na to, że był zmęczony, prowadził całą noc.",
          "answer": "Mimo że był zmęczony, prowadził całą noc.",
          "grammar_point": "kalki-uk",
          "accept": [
            "Chociaż był zmęczony, prowadził całą noc.",
            "Pomimo że był zmęczony, prowadził całą noc.",
            "Prowadził całą noc, mimo że był zmęczony.",
            "Prowadził całą noc, chociaż był zmęczony.",
            "Choć był zmęczony, prowadził całą noc."
          ],
          "explanation": "Калька «не дивлячись на те, що» → mimo że / chociaż."
        },
        {
          "id": "h3-4",
          "prompt": "Zostałam w domu z powodu, że padało.",
          "answer": "Zostałam w domu, ponieważ padało.",
          "grammar_point": "przyczyna-skutek",
          "accept": [
            "Zostałam w domu, bo padało.",
            "Zostałam w domu z powodu deszczu.",
            "Zostałam w domu, dlatego że padało.",
            "Zostałam w domu, dlatego, że padało."
          ],
          "explanation": "Z całym zdaniem: ponieważ / bo (lekcja o wsi)."
        },
        {
          "id": "h3-5",
          "prompt": "Poprosiłam syna, że wyniósł śmieci.",
          "answer": "Poprosiłam syna, żeby wyniósł śmieci.",
          "grammar_point": "zeby-cel",
          "explanation": "Prośba → żeby."
        },
        {
          "id": "h3-6",
          "prompt": "Mimo że deszczu, mecz się odbył.",
          "answer": "Mimo deszczu mecz się odbył.",
          "grammar_point": "chociaz-mimo-ze",
          "accept": [
            "Mecz się odbył mimo deszczu.",
            "Mimo że padało, mecz się odbył.",
            "Chociaż padało, mecz się odbył."
          ],
          "explanation": "Rzeczownik → mimo (bez „że”)."
        }
      ]
    }
  ]
}
