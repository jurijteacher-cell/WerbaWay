  "title": "Praca domowa: czasowniki z przyimkami",
  "instruction": "Pięć bloków. Zrób wszystko bez notatek z lekcji, potem sprawdź się.",
  "estimated_minutes": 25,
  "blocks": [
    {
      "block_id": "h1",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "1. Za kim? Na kogo? Do kogo?",
      "instruction": "Wybierz poprawną wersję.",
      "items": [
        {
          "id": "h1-1",
          "text": "W wakacje babcia opiekuje się ___.",
          "answer": "wnukami",
          "options": [
            "wnukami",
            "o wnukach"
          ],
          "explanation": "Заботиться о → opiekować się + narzędnik, bez „o”.",
          "grammar_point": "rekcja"
        },
        {
          "id": "h1-2",
          "text": "Moja córka strasznie tęskni ___.",
          "answer": "za kotem",
          "options": [
            "za kotem",
            "po kocie"
          ],
          "explanation": "Tęsknić za + narzędnik.",
          "grammar_point": "rekcja"
        },
        {
          "id": "h1-3",
          "text": "To film o dziewczynie, która zakochała się ___.",
          "answer": "w wampirze",
          "options": [
            "w wampirze",
            "w wampira"
          ],
          "explanation": "Zakochać się w + miejscownik.",
          "grammar_point": "rekcja"
        },
        {
          "id": "h1-4",
          "text": "Spokojnie, poczekam ___ w kawiarni.",
          "answer": "na ciebie",
          "options": [
            "na ciebie",
            "ciebie"
          ],
          "explanation": "Czekać na + biernik.",
          "grammar_point": "rekcja"
        },
        {
          "id": "h1-5",
          "text": "Brat ma pretensje, że nie zadzwoniłem ___ w urodziny.",
          "answer": "do niego",
          "options": [
            "do niego",
            "mu"
          ],
          "explanation": "Dzwonić do + dopełniacz.",
          "grammar_point": "rekcja"
        },
        {
          "id": "h1-6",
          "text": "Musisz się przyzwyczaić ___.",
          "answer": "do nowego szefa",
          "options": [
            "do nowego szefa",
            "nowemu szefowi"
          ],
          "explanation": "Przyzwyczaić się do + dopełniacz.",
          "grammar_point": "rekcja"
        }
      ]
    },
    {
      "block_id": "h2",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "2. O co? O czym? Komu?",
      "instruction": "Wpisz słowo z nawiasu w dobrym przypadku.",
      "items": [
        {
          "id": "h2-1",
          "text": "Dzieci kłóciły się o ___. (czerwona kredka)",
          "answer": "czerwoną kredkę",
          "explanation": "Kłócić się o + biernik.",
          "grammar_point": "rekcja"
        },
        {
          "id": "h2-2",
          "text": "Pamiętaj o ___ u dentysty! (wizyta)",
          "answer": "wizycie",
          "explanation": "Pamiętać o + miejscownik.",
          "grammar_point": "rekcja"
        },
        {
          "id": "h2-3",
          "text": "Klient pytał o ___. (nasza oferta)",
          "answer": "naszą ofertę",
          "explanation": "Pytać o + biernik.",
          "grammar_point": "rekcja"
        },
        {
          "id": "h2-4",
          "text": "W tym zespole szef dba o ___. (dobra atmosfera)",
          "answer": "dobrą atmosferę",
          "explanation": "Dbać o + biernik.",
          "grammar_point": "rekcja"
        },
        {
          "id": "h2-5",
          "text": "Ona nie chce wyjść za ___. (on)",
          "answer": "niego",
          "explanation": "Wyjść za + biernik: za niego.",
          "grammar_point": "rekcja"
        },
        {
          "id": "h2-6",
          "text": "Pogratulowałem ___ awansu. (ona)",
          "answer": "jej",
          "explanation": "Gratulować komu? → jej.",
          "grammar_point": "rekcja"
        },
        {
          "id": "h2-7",
          "text": "Przeprosiłeś już ___? (oni)",
          "answer": "ich",
          "explanation": "Przepraszać kogo? → ich (biernik).",
          "grammar_point": "rekcja"
        }
      ]
    },
    {
