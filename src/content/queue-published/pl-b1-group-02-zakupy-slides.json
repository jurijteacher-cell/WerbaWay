          "text": "kupił"
        },
        {
          "label": "cząstka",
          "text": "by"
        },
        {
          "label": "końcówka osobowa",
          "text": "m"
        }
      ],
      "result": "[[kupił]] + [[by]] + [[m]] → kupiłbym",
      "note": "Podstawą jest zawsze forma przeszła, nie bezokolicznik."
    },
    {
      "id": "s4",
