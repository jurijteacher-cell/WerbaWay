        "końcówka",
        "przykład"
      ],
      "rows": [
        [
          "ja",
          "[[-bym]]",
          "kupiłbym / kupiłabym"
        ],
        [
          "ty",
          "[[-byś]]",
          "kupiłbyś / kupiłabyś"
        ],
        [
          "on, ona, ono",
          "-by",
          "kupiłby / kupiłaby"
