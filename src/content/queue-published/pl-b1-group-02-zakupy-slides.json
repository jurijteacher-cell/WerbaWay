          "kupilibyście"
        ],
        [
          "oni, one",
          "-by",
          "kupiliby / kupiłyby"
        ]
      ],
      "note": "Trzecia osoba nie ma końcówki: samo „by”."
    },
    {
      "id": "s5",
      "part": 1,
      "section": "teoria",
      "kind": "table",
      "reveal": "row",
      "title": "Rodzaj i liczba",
      "columns": [
        "kto?",
        "forma",
        "przykład"
      ],
      "rows": [
        [
          "on",
          "kupił[[by]]",
          "On kupiłby buty."
        ],
        [
          "ona",
          "kupiła[[by]]",
          "Ona kupiłaby buty."
        ],
        [
          "chłopaki, grupa mieszana",
          "poszli[[by]]",
          "Oni poszliby do kina."
        ],
        [
          "dziewczyny",
          "poszły[[by]]",
          "One poszłyby do kina."
        ]
      ],
      "note": "Męskoosobowy, gdy w grupie jest choć jeden mężczyzna."
    },
    {
      "id": "s6",
      "part": 1,
      "section": "teoria",
      "kind": "examples",
      "title": "Ruchome „by”",
      "items": [
        {
          "tag": "przy czasowniku",
          "pl": "[[Kupiłbym]] to od razu.",
          "uk": "Я б купив це одразу."
        },
        {
          "tag": "po słowie",
          "pl": "Chętnie [[bym]] to kupił.",
          "uk": "Я б охоче це купив."
        },
        {
          "tag": "po przeczeniu",
          "pl": "Nigdy [[byśmy]] tam nie weszli.",
          "uk": "Ми б ніколи туди не зайшли."
        }
      ],
      "note": "Znaczenie takie samo, zmienia się akcent."
    },
    {
      "id": "s7",
      "part": 1,
      "section": "teoria",
      "kind": "examples",
      "title": "Grzecznie w sklepie",
      "items": [
        {
          "tag": "prośba",
          "pl": "[[Chciałbym]] zapłacić kartą.",
          "uk": "Я хотів би заплатити карткою."
        },
        {
          "tag": "pytanie",
          "pl": "Czy [[mógłby]] pan sprawdzić cenę?",
          "uk": "Чи не могли б ви перевірити ціну?"
        },
        {
          "tag": "wybór",
          "pl": "[[Wolałbym]] zwrot pieniędzy.",
          "uk": "Я б волів повернення грошей."
        }
      ],
      "note": "„Chcę” brzmi w sklepie ostro. „Chciałbym” to standard."
    },
    {
      "id": "s8",
      "part": 1,
      "section": "wyjatki",
      "kind": "exceptions",
      "refers_to": "s4",
      "title": "Zmiana samogłoski w liczbie mnogiej",
      "items": [
        {
          "rule": "chciałbym → chcielibyśmy",
          "example": "[[Chcielibyśmy]] zobaczyć większy rozmiar.",
          "refers_to": "s4"
        },
        {
          "rule": "mógłbym → moglibyśmy",
          "example": "[[Moglibyśmy]] przyjść jutro?",
          "refers_to": "s4"
        },
        {
          "rule": "wziąłbym → wzięlibyśmy",
          "example": "[[Wzięlibyśmy]] dwa opakowania.",
          "refers_to": "s4"
        }
      ]
    },
    {
      "id": "s9",
      "part": 2,
      "section": "teoria",
      "kind": "steps",
      "title": "Gdyby — warunek nierealny",
      "steps": [
        {
          "label": "gdyby + osoba",
          "text": "Gdybym"
        },
        {
          "label": "czas przeszły",
          "text": "miał czas,"
        },
        {
          "label": "forma z by",
          "text": "pojechałbym"
        }
      ],
      "result": "[[Gdybym]] miał czas, [[pojechałbym]] do outletu.",
      "note": "Po „gdyby” stoi forma przeszła, nigdy czas przyszły."
    },
    {
      "id": "s10",
      "part": 2,
      "section": "teoria",
      "kind": "compare",
      "title": "Jeśli czy gdyby?",
      "left": {
        "head": "jeśli — realne",
        "rule": "czas przyszły",
        "examples": [
          "[[Jeśli]] będzie promocja, kupię."
        ]
      },
      "right": {
        "head": "gdyby — nierealne",
        "rule": "tryb przypuszczający",
        "examples": [
          "[[Gdyby]] była promocja, kupiłbym."
        ]
      },
      "note": "Mów „gdybym”, nie „jeślibym”."
    },
    {
      "id": "s11",
      "part": 2,
      "section": "teoria",
      "kind": "examples",
      "title": "Jedna forma, dwa czasy",
      "items": [
        {
          "tag": "wczoraj",
          "pl": "Gdybym wiedział, [[nie kupiłbym]] tego.",
          "uk": "Якби я знав, не купив би цього (учора)."
        },
        {
          "tag": "dziś",
          "pl": "Gdybym wiedział, [[nie kupiłbym]] tego.",
          "uk": "Якби я знав, не купив би цього (зараз)."
        },
        {
          "tag": "kontekst",
          "pl": "[[Wtedy]] / [[teraz]] pokazuje czas.",
          "uk": "Час показують слова «тоді» або «тепер»."
        }
      ],
      "note": "W mowie ta sama forma działa dla teraźniejszości i przeszłości."
    },
    {
      "id": "s12",
      "part": 2,
      "section": "teoria",
      "kind": "compare",
      "title": "Żeby czy żebym?",
      "left": {
        "head": "ten sam podmiot",
        "rule": "żeby + bezokolicznik",
        "examples": [
          "Poszedłem tam, [[żeby kupić]] prezent."
        ]
      },
      "right": {
        "head": "inny podmiot",
        "rule": "żeby + osoba + forma przeszła",
        "examples": [
          "Chcę, [[żebyś]] sprawdził skład."
        ]
      },
      "note": "Dwa różne podmioty — żebym, żebyś, nigdy samo „żeby ty”."
    },
    {
      "id": "s13",
      "part": 2,
      "section": "teoria",
      "kind": "table",
      "reveal": "row",
      "title": "Razem czy osobno?",
