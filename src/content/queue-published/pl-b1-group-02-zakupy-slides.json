        "gdzie stoi by",
        "pisownia",
        "przykład"
      ],
      "rows": [
        [
          "z czasownikiem",
          "razem",
          "[[zapłaciłbym]]"
        ],
        [
          "ze spójnikiem",
          "razem",
          "[[gdyby]], [[żeby]], aby"
        ],
        [
          "po innym słowie",
          "osobno",
          "kto [[by]], może [[byś]]"
        ]
      ],
      "note": "Chyba by przyszedł. Może byś zadzwonił."
    },
    {
      "id": "s14",
      "part": 2,
      "section": "teoria",
      "kind": "examples",
      "title": "Przeczenie",
      "items": [
        {
          "tag": "zwykle",
