      "kind": "title",
      "title": "Tryb przypuszczający",
      "subtitle": "Kupię czy kupiłbym?",
      "goal": "Po tej lekcji poprosisz grzecznie w sklepie i powiesz, co zrobiłbyś w innej sytuacji."
    },
    {
      "id": "s2",
      "part": 1,
      "section": "teoria",
      "kind": "compare",
      "title": "Fakt czy możliwość?",
      "left": {
        "head": "decyzja",
        "rule": "tryb oznajmujący",
        "examples": [
          "[[Kupię]] ten płaszcz."
        ]
      },
      "right": {
        "head": "chęć, plan, marzenie",
        "rule": "tryb przypuszczający",
        "examples": [
          "[[Kupiłbym]] ten płaszcz."
        ]
      },
      "note": "Cztery zastosowania: grzeczność, warunek, rada, hipoteza."
    },
    {
      "id": "s3",
      "part": 1,
      "section": "teoria",
      "kind": "steps",
      "title": "Wzór",
      "steps": [
