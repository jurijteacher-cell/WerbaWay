{
  "lesson_id": "pl-a2-59-kiedy-zanim-po-tym-jak",
  "exercise_type": "fill-in-blank",
  "title": "Praca domowa: najpierw, zanim, po tym, jak",
  "instruction": "Trzy bloki ćwiczeń. Potem opisz jeden dzień — zadanie jest na stronie lekcji.",
  "estimated_minutes": 20,
  "blocks": [
    {
      "block_id": "h1",
      "exercise_type": "fill-in-blank",
      "title": "1. Wpisz słowo",
      "instruction": "Wpisz po polsku słowo z nawiasu.",
      "items": [
        {
          "id": "h1-1",
          "text": "___ wezmę prysznic, zrobię sobie kawę. (перш ніж)",
          "answer": "Zanim",
          "grammar_point": "zdania-czasowe",
          "explanation": "Перш ніж — zanim."
        },
        {
          "id": "h1-2",
          "text": "___ filmu cała sala się śmiała. (під час)",
          "answer": "Podczas",
          "grammar_point": "zdania-czasowe",
          "explanation": "Під час — podczas (jedno słowo) + dopełniacz."
        },
        {
          "id": "h1-3",
          "text": "___ skończył się mecz, kibice śpiewali na ulicach. (після того як)",
          "answer": "Po tym, jak",
          "accept": [
            "Po tym jak"
          ],
          "grammar_point": "zdania-czasowe",
          "explanation": "Після того як — po tym, jak."
        },
        {
          "id": "h1-4",
          "text": "___ byłam w Rzymie, codziennie jadłam lody. (коли)",
          "answer": "Kiedy",
          "accept": [
            "Gdy"
          ],
          "grammar_point": "zdania-czasowe",
          "explanation": "Коли — kiedy albo gdy."
        },
        {
          "id": "h1-5",
          "text": "Najpierw posprzątamy, ___ przyjdą goście. (потім)",
          "answer": "potem",
          "grammar_point": "zdania-czasowe",
          "explanation": "Потім — potem."
        },
        {
          "id": "h1-6",
          "text": "Przyjdę do ciebie ___ pracy. (після)",
          "answer": "po",
          "grammar_point": "przyimki-czasu",
          "explanation": "Po + miejscownik: po pracy."
        }
      ]
    },
    {
      "block_id": "h2",
      "exercise_type": "fill-in-blank",
      "title": "2. Jaki czas?",
      "instruction": "Wpisz czasownik z nawiasu w dobrym czasie.",
      "items": [
        {
          "id": "h2-1",
          "text": "Kiedy ___ pensję, kupię nowy telefon. (dostać, ja)",
          "answer": "dostanę",
          "grammar_point": "czas-przyszly-dk",
          "explanation": "Przyszłość w obu częściach: dostanę, kupię."
        },
        {
          "id": "h2-2",
          "text": "Zanim ___ do Polski, uczyłam się polskiego przez rok. (przyjechać, ja – kobieta)",
          "answer": "przyjechałam",
          "grammar_point": "zdania-czasowe",
          "explanation": "Przeszłość: zanim przyjechałam."
        },
        {
          "id": "h2-3",
          "text": "Kiedy córka ___ osiemnaście lat, zrobi prawo jazdy. (skończyć)",
          "answer": "skończy",
          "grammar_point": "czas-przyszly-dk",
          "explanation": "Przyszłość: skończy, zrobi."
        },
        {
          "id": "h2-4",
          "text": "Gdy ___ dzieckiem, bałem się psów. (być, ja – mężczyzna)",
          "answer": "byłem",
          "grammar_point": "zdania-czasowe",
          "explanation": "Przeszłość: gdy byłem."
        },
        {
          "id": "h2-5",
          "text": "Po tym, jak ___ obiad, odpoczniemy. (zjeść, my)",
          "answer": "zjemy",
          "grammar_point": "czas-przyszly-dk",
          "explanation": "Przyszłość: zjemy, odpoczniemy."
        },
        {
          "id": "h2-6",
          "text": "Kiedy ___ zimno, piję herbatę z imbirem. (być)",
          "answer": "jest",
          "grammar_point": "zdania-czasowe",
          "explanation": "Regularnie — czas teraźniejszy."
        }
      ]
    },
    {
      "block_id": "h3",
      "exercise_type": "sentence-building",
      "title": "3. Popraw błąd",
