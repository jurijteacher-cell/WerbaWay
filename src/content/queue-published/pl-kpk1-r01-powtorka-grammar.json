  "blocks": [
    {
      "block_id": "g1",
      "exercise_type": "fill-in-blank",
      "title": "1. Być: jestem, jesteś, jest…",
      "instruction": "Co pasuje? Wybierz formę.",
      "part": 1,
      "items": [
        {
          "id": "g1-1",
          "text": "Przepraszam, gdzie ___ toaleta?",
          "options": [
            "jestem",
            "jesteś",
            "jest",
            "jesteśmy",
            "jesteście",
            "są"
          ],
          "answer": "jest",
          "grammar_point": "byc"
        },
        {
          "id": "g1-2",
          "text": "(Ja) ___ z Ukrainy, a ty?",
          "options": [
            "jestem",
            "jesteś",
            "jest",
            "jesteśmy",
            "jesteście",
            "są"
          ],
          "answer": "jestem",
          "grammar_point": "byc"
        },
        {
          "id": "g1-3",
          "text": "Skąd ___, Kasia?",
          "options": [
            "jestem",
            "jesteś",
            "jest",
            "jesteśmy",
            "jesteście",
            "są"
          ],
          "answer": "jesteś",
          "grammar_point": "byc"
        },
        {
          "id": "g1-4",
          "text": "Pan Nowak i pani Nowak ___ w domu.",
          "options": [
            "jestem",
            "jesteś",
            "jest",
            "jesteśmy",
            "jesteście",
            "są"
          ],
          "answer": "są",
          "grammar_point": "byc"
        },
        {
          "id": "g1-5",
          "text": "My ___ w szkole, a wy?",
          "options": [
            "jestem",
            "jesteś",
            "jest",
            "jesteśmy",
            "jesteście",
            "są"
          ],
          "answer": "jesteśmy",
          "grammar_point": "byc"
        },
        {
          "id": "g1-6",
          "text": "Wy też ___ z Polski?",
          "options": [
            "jestem",
            "jesteś",
            "jest",
            "jesteśmy",
            "jesteście",
            "są"
          ],
          "answer": "jesteście",
          "grammar_point": "byc"
        },
        {
          "id": "g1-7",
          "text": "Skąd pani ___?",
          "options": [
            "jestem",
            "jesteś",
            "jest",
            "jesteśmy",
            "jesteście",
            "są"
          ],
          "answer": "jest",
          "grammar_point": "pan-pani",
          "explanation": "Pani = ona, pan = on → jest. Ukraińskie «ви» do jednej osoby to po polsku pan / pani."
        },
        {
          "id": "g1-8",
          "text": "Skąd ___ państwo?",
          "options": [
            "jestem",
            "jesteś",
            "jest",
            "jesteśmy",
            "jesteście",
            "są"
          ],
          "answer": "są",
          "grammar_point": "pan-pani",
          "explanation": "Państwo = oni → są."
        }
      ]
    },
    {
      "block_id": "g2",
      "exercise_type": "fill-in-blank",
      "title": "2. Koniugacja -m, -sz",
      "instruction": "Proszę uzupełnić. Wpisz czasownik z nawiasu w dobrej formie.",
      "instruction_uk": "я → -m, ти → -sz, він / вона / pan / pani → без закінчення.",
      "part": 1,
      "items": [
        {
          "id": "g2-1",
          "text": "(Ja) ___ w Krakowie. (mieszkać)",
          "answer": "mieszkam",
          "grammar_point": "koniugacja-m-sz"
        },
        {
          "id": "g2-2",
          "text": "Jak ___ ta pani? (nazywać się)",
          "answer": "się nazywa",
          "accept": [
            "nazywa się"
          ],
          "grammar_point": "koniugacja-m-sz"
        },
        {
          "id": "g2-3",
          "text": "Ty ___ po polsku? (rozumieć)",
          "answer": "rozumiesz",
          "grammar_point": "koniugacja-m-sz"
        },
        {
          "id": "g2-4",
          "text": "Oni ___ w tenisa, a my nie. (grać)",
          "answer": "grają",
          "grammar_point": "koniugacja-m-sz"
        },
        {
          "id": "g2-5",
          "text": "(My) ___ nowy słownik. (mieć)",
          "answer": "mamy",
          "grammar_point": "koniugacja-m-sz"
        },
        {
          "id": "g2-6",
          "text": "Gdzie ___ państwo Kowalscy? (mieszkać)",
          "answer": "mieszkają",
          "grammar_point": "koniugacja-m-sz"
        },
        {
          "id": "g2-7",
          "text": "Wy ___ długopis? (mieć)",
          "answer": "macie",
          "grammar_point": "koniugacja-m-sz"
        },
        {
          "id": "g2-8",
          "text": "Przepraszam, pan ___? (rozumieć)",
          "answer": "rozumie",
          "grammar_point": "pan-pani"
        },
        {
          "id": "g2-9",
          "text": "Ty ___ na gitarze? (grać)",
          "answer": "grasz",
          "grammar_point": "koniugacja-m-sz"
        }
      ]
    },
    {
      "block_id": "g3",
      "exercise_type": "fill-in-blank",
      "title": "3. Ten, ta, to",
      "instruction": "Co pasuje? Ten (on), ta (ona) czy to (ono)?",
      "part": 1,
      "items": [
        {
          "id": "g3-1",
          "text": "___ długopis jest czarny.",
          "options": [
            "Ten",
            "Ta",
            "To"
          ],
          "answer": "Ten",
          "grammar_point": "rodzaj",
          "explanation": "Długopis to on (ручка — ale po polsku rodzaj męski)."
        },
        {
          "id": "g3-2",
          "text": "___ krzesło jest stare.",
          "options": [
            "Ten",
            "Ta",
            "To"
          ],
          "answer": "To",
          "grammar_point": "rodzaj",
          "explanation": "Krzesło kończy się na -o → ono."
        },
        {
          "id": "g3-3",
          "text": "___ kubek jest biały.",
          "options": [
            "Ten",
            "Ta",
            "To"
          ],
          "answer": "Ten",
          "grammar_point": "rodzaj",
          "explanation": "Kubek kończy się na spółgłoskę → on."
        },
        {
          "id": "g3-4",
          "text": "___ komórka jest nowa.",
          "options": [
            "Ten",
            "Ta",
            "To"
          ],
          "answer": "Ta",
          "grammar_point": "rodzaj"
        },
        {
          "id": "g3-5",
          "text": "___ okno jest duże.",
          "options": [
            "Ten",
            "Ta",
            "To"
          ],
          "answer": "To",
          "grammar_point": "rodzaj"
        },
        {
          "id": "g3-6",
          "text": "___ noc jest czarna.",
          "options": [
            "Ten",
            "Ta",
            "To"
          ],
          "answer": "Ta",
          "grammar_point": "rodzaj",
          "explanation": "Wyjątek: noc to ona."
        },
        {
          "id": "g3-7",
          "text": "___ kolega jest miły.",
          "options": [
            "Ten",
            "Ta",
            "To"
          ],
          "answer": "Ten",
          "grammar_point": "rodzaj",
          "explanation": "Kolega ma -a, ale to mężczyzna → on."
        },
        {
          "id": "g3-8",
          "text": "___ imię jest fajne.",
          "options": [
            "Ten",
            "Ta",
            "To"
          ],
          "answer": "To",
          "grammar_point": "rodzaj",
          "explanation": "Imię (-ę) to ono."
        },
        {
          "id": "g3-9",
          "text": "___ pani jest sympatyczna.",
          "options": [
            "Ten",
            "Ta",
            "To"
          ],
          "answer": "Ta",
          "grammar_point": "rodzaj",
          "explanation": "Pani (-i) to ona."
        }
      ]
    },
