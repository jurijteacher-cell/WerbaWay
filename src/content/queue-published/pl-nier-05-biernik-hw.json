          "grammar_point": "slownictwo",
          "options": [
            "kupuje",
            "sprzedaje",
            "wynajmuje"
          ]
        },
        {
          "id": "h1-5",
          "text": "Biuro ___ klientów na prezentację w poniedziałek.",
          "answer": "zaprasza",
          "grammar_point": "slownictwo",
          "options": [
            "kupuje",
            "pokazuje",
            "zaprasza"
          ]
        },
        {
          "id": "h1-6",
          "text": "Marek ___ stary dom w Puszczykowie, ale jeszcze go nie kupuje.",
          "answer": "ogląda",
          "grammar_point": "slownictwo",
          "options": [
            "sprzedaje",
            "ogląda",
            "podpisuje"
          ]
        }
      ]
    },
    {
      "block_id": "h2",
      "exercise_type": "fill-in-blank",
      "title": "2. Biernik: żeńskie rzeczowniki",
      "instruction": "Wpisz biernik. W podpowiedzi jest mianownik.",
      "items": [
        {
          "id": "h2-1",
          "text": "Pan Wiktor sprzedaje ___ w Puszczykowie. (działka)",
          "answer": "działkę",
          "grammar_point": "biernik-rzeczownik"
        },
        {
          "id": "h2-2",
          "text": "Natalia sprawdza ___ w ogłoszeniu. (cena)",
          "answer": "cenę",
          "grammar_point": "biernik-rzeczownik"
        },
        {
          "id": "h2-3",
          "text": "Klientka chce zobaczyć ___. (łazienka)",
          "answer": "łazienkę",
          "grammar_point": "biernik-rzeczownik"
        },
        {
          "id": "h2-4",
          "text": "Marek lubi ___ w tym domu. (garderoba)",
          "answer": "garderobę",
          "grammar_point": "biernik-rzeczownik"
        },
        {
          "id": "h2-5",
          "text": "Natalia czyta ___ od pana Wiktora. (wiadomość)",
          "answer": "wiadomość",
          "grammar_point": "biernik-rzeczownik",
          "explanation": "Żeński na spółgłoskę: bez zmian."
        },
        {
          "id": "h2-6",
          "text": "Pani Elżbieta zna dobrze ___ w Puszczykowie. (ulica)",
          "answer": "ulicę",
          "grammar_point": "biernik-rzeczownik"
        }
      ]
    },
    {
      "block_id": "h3",
      "exercise_type": "fill-in-blank",
      "title": "3. Biernik: ludzie, rzeczy i liczba mnoga",
      "instruction": "Wpisz biernik. W podpowiedzi jest mianownik.",
