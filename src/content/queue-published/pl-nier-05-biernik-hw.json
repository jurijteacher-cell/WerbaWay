        {
          "id": "h3-1",
          "text": "Pan Wiktor ma ___. (syn)",
          "answer": "syna",
          "grammar_point": "biernik-osobowy"
        },
        {
          "id": "h3-2",
          "text": "Natalia zna ___ od roku. (pan Wiktor)",
          "answer": "pana Wiktora",
          "grammar_point": "biernik-osobowy"
        },
        {
          "id": "h3-3",
          "text": "Klienci oglądają ___ w ogrodzie. (drzewo)",
          "answer": "drzewo",
          "grammar_point": "biernik-rzeczownik",
          "explanation": "Rodzaj nijaki: bez zmian."
        },
        {
          "id": "h3-4",
          "text": "Natalia sprawdza wszystkie ___. (faktura)",
          "answer": "faktury",
          "grammar_point": "biernik-rzeczownik"
        },
        {
          "id": "h3-5",
          "text": "Klienci chcą zobaczyć wszystkie ___. (pokój)",
          "answer": "pokoje",
          "grammar_point": "biernik-rzeczownik"
        },
        {
          "id": "h3-6",
          "text": "Pan Wiktor zaprasza ___ na obiad. (lekarz)",
          "answer": "lekarzy",
          "grammar_point": "biernik-osobowy"
        },
        {
          "id": "h3-7",
          "text": "Natalia zna wszystkich ___ w tym domu. (ludzie)",
          "answer": "ludzi",
          "grammar_point": "rzecz-nieregularne"
        }
      ]
    },
    {
      "block_id": "h4",
      "exercise_type": "fill-in-blank",
      "title": "4. Biernik: przymiotnik i zaimek",
      "instruction": "Wybierz albo wpisz formę biernika.",
      "items": [
        {
          "id": "h4-1",
          "text": "Pan Wiktor sprzedaje ___ dom. (stary)",
          "answer": "stary",
          "grammar_point": "biernik-przymiotnik",
          "options": [
            "starą",
            "stary",
            "starego"
          ],
          "explanation": "Dom to rzecz męska: bez zmian."
        },
        {
          "id": "h4-2",
          "text": "Natalia zna ___ klienta z Gdańska. (miły)",
          "answer": "miłego",
          "grammar_point": "biernik-przymiotnik",
          "options": [
            "miłą",
            "miłego",
            "miły"
          ],
          "explanation": "Człowiek: miłego."
        },
        {
          "id": "h4-3",
          "text": "Klientka lubi ___ kuchnię. (jasny)",
          "answer": "jasną",
          "grammar_point": "biernik-przymiotnik",
          "options": [
            "jasne",
            "jasny",
            "jasną"
          ],
          "explanation": "Żeński: jasną."
        },
        {
          "id": "h4-4",
          "text": "Pan Wiktor chce sprzedać ___ meble. (ten)",
          "answer": "te",
          "grammar_point": "zaimki-wskazujace",
          "options": [
            "tę",
            "te",
            "tych"
          ],
          "explanation": "Rzeczy w mnogiej: te meble."
        },
        {
          "id": "h4-5",
          "text": "— Zna Pani pana Wiktora? — Tak, znam ___. (on)",
          "answer": "go",
          "grammar_point": "zaimki-osobowe-przypadki",
          "options": [
            "go",
            "mu",
            "on"
          ],
          "explanation": "On → go."
        },
        {
          "id": "h4-6",
          "text": "— Zna Pan moją żonę? — Tak, znam ___. (ona)",
          "answer": "ją",
          "grammar_point": "zaimki-osobowe-przypadki",
          "options": [
            "ona",
            "jej",
            "ją"
          ],
          "explanation": "Ona → ją."
        }
      ]
    },
    {
      "block_id": "h5",
      "exercise_type": "sentence-building",
      "title": "5. Popraw błąd",
