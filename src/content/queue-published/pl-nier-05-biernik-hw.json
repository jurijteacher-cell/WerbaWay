      "exercise_type": "fill-in-blank",
      "title": "1. Które słowo pasuje?",
      "instruction": "Wybierz słowo, które pasuje do zdania.",
      "items": [
        {
          "id": "h1-1",
          "text": "Pani Elżbieta ___ kawalerkę studentom.",
          "answer": "wynajmuje",
          "grammar_point": "slownictwo",
          "options": [
            "kupuje",
            "wynajmuje",
            "podpisuje"
          ]
        },
        {
          "id": "h1-2",
          "text": "Natalia ___ klientowi dom w Puszczykowie.",
          "answer": "pokazuje",
          "grammar_point": "slownictwo",
          "options": [
            "pokazuje",
            "sprzedaje",
            "podpisuje"
          ]
        },
        {
          "id": "h1-3",
          "text": "Klienci ___ akt notarialny u notariusza.",
          "answer": "podpisują",
          "grammar_point": "slownictwo",
          "options": [
            "zapraszają",
            "oglądają",
            "podpisują"
          ]
        },
        {
          "id": "h1-4",
          "text": "Pan Wiktor ___ działkę, bo przeprowadza się do Gdańska.",
