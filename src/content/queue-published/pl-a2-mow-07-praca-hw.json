{
  "lesson_id": "pl-a2-mow-07-praca",
  "exercise_type": "fill-in-blank",
  "title": "Praca domowa: zawody, formy i e-mail",
  "instruction": "Trzy bloki: zawody i miejsca pracy, formy i jeden e-mail.",
  "estimated_minutes": 20,
  "blocks": [
    {
      "block_id": "h1",
      "exercise_type": "fill-in-blank",
      "title": "1. Kim jest? Gdzie pracuje?",
      "instruction": "Wybierz poprawną formę.",
      "items": [
        {
          "id": "h1-1",
          "text": "Mój dziadek przez czterdzieści lat był ___.",
          "answer": "rolnikiem",
          "options": [
            "rolnikiem",
            "rolnik",
            "rolnika"
          ],
          "grammar_point": "zawod-narzednik",
          "explanation": "Był kim? → narzędnik: rolnikiem."
        },
        {
          "id": "h1-2",
          "text": "Hotel szuka osoby do pracy jako ___.",
          "answer": "recepcjonista",
          "options": [
            "recepcjonista",
            "recepcjonistą",
            "recepcjonistę"
          ],
          "grammar_point": "zawod-narzednik",
          "explanation": "Jako + mianownik: jako recepcjonista."
        },
        {
          "id": "h1-3",
          "text": "Mój sąsiad pracuje ___ i wraca do domu cały w pyle.",
          "answer": "na budowie",
          "options": [
            "na budowie",
            "w budowie",
            "na budowę"
          ],
          "grammar_point": "gdzie-dokad-uslugi",
          "explanation": "Gdzie? → na budowie (na + miejscownik). Na budowę — dokąd idę."
        },
        {
          "id": "h1-4",
          "text": "Ciocia jest ___ i zna wszystkie książki w mieście.",
          "answer": "bibliotekarką",
          "options": [
            "bibliotekarką",
            "bibliotekarka",
            "bibliotekarkę"
          ],
          "grammar_point": "zawod-narzednik",
          "explanation": "Jest kim? → narzędnik: bibliotekarką."
        },
        {
          "id": "h1-5",
          "text": "Brat zajmuje się ___ w dużej firmie transportowej.",
          "answer": "logistyką",
          "options": [
            "logistyką",
            "logistyka",
            "logistykę"
          ],
          "grammar_point": "zawod-narzednik",
          "explanation": "Zajmować się + narzędnik: logistyką."
        },
        {
          "id": "h1-6",
          "text": "Moja koleżanka pracuje ___ i uczy studentów historii.",
          "answer": "na uczelni",
          "options": [
            "na uczelni",
            "w uczelni",
            "na uczelnię"
          ],
          "grammar_point": "gdzie-dokad-uslugi",
          "explanation": "Uczelnia, podobnie jak poczta, łączy się z „na”: na uczelni, na uniwersytecie."
        }
      ]
    },
    {
      "block_id": "h2",
      "exercise_type": "fill-in-blank",
      "title": "2. Wpisz formę",
      "instruction": "Wpisz słowo z nawiasu w poprawnej formie.",
      "items": [
        {
          "id": "h2-1",
          "text": "Tomek ___ się dziś do pracy, bo autobus nie przyjechał. (spóźnić, czas przeszły)",
          "answer": "spóźnił",
          "grammar_point": "czas-przeszly-rodzaj",
          "explanation": "Tomek — on → spóźnił się."
        },
        {
          "id": "h2-2",
          "text": "Aniu, ___ więcej spać — wyglądasz na zmęczoną. (powinien — powiedz do kobiety)",
          "answer": "powinnaś",
          "grammar_point": "rada-powinien",
          "explanation": "Do kobiety na „ty” → powinnaś."
        },
        {
          "id": "h2-3",
          "text": "— Na twoim miejscu ___ do lekarza — mówi Michał. (pójść, tryb przypuszczający)",
          "answer": "poszedłbym",
          "grammar_point": "na-twoim-miejscu",
          "explanation": "Mówi Michał → poszedł + bym = poszedłbym."
        },
        {
          "id": "h2-4",
          "text": "Mam dość ___ w poniedziałki. (długie zebrania)",
          "answer": "długich zebrań",
          "grammar_point": "mam-dosc",
          "explanation": "Mam dość + dopełniacz liczby mnogiej: długich zebrań."
        },
        {
          "id": "h2-5",
          "text": "Przepraszam za ___, źle zapisałam numer telefonu. (ta pomyłka)",
          "answer": "tę pomyłkę",
          "grammar_point": "przeprosiny",
          "explanation": "Przepraszam za + biernik: za tę pomyłkę."
        },
        {
          "id": "h2-6",
          "text": "Moja żona jest ___ w przedszkolu. (nauczycielka)",
          "answer": "nauczycielką",
          "grammar_point": "zawod-narzednik",
          "explanation": "Jest kim? → narzędnik: nauczycielką."
        }
      ]
    },
    {
      "block_id": "h3",
      "exercise_type": "drag-and-drop",
      "title": "3. E-mail z odpowiedzią na ogłoszenie",
      "instruction": "Przeciągnij słowa w luki. Cztery słowa są niepotrzebne.",
      "bank": [
        "ogłoszenia",
        "ogłoszenie",
        "pracuję",
        "pracowałam",
        "doświadczenie",
        "doświadczenia",
        "CV",
        "urlop",
        "chciałabym",
        "chciałbym"
      ],
      "items": [
        {
          "id": "h3-1",
          "text": "Szanowna Pani, piszę w sprawie ___ na stanowisko recepcjonistki.",
          "answer": "ogłoszenia",
          "grammar_point": "slownictwo"
        },
        {
          "id": "h3-2",
          "text": "Od trzech lat ___ jako recepcjonistka w małym hotelu w Lublinie.",
          "answer": "pracuję",
          "grammar_point": "przyimki-czasu"
        },
        {
          "id": "h3-3",
          "text": "Wcześniej przez rok ___ w biurze podróży.",
          "answer": "pracowałam",
          "grammar_point": "przyimki-czasu"
        },
        {
          "id": "h3-4",
          "text": "Mam ___ w obsłudze klientów i znam dwa języki obce.",
          "answer": "doświadczenie",
          "grammar_point": "slownictwo"
        },
        {
          "id": "h3-5",
          "text": "W załączniku przesyłam moje ___ ze zdjęciem.",
          "answer": "CV",
          "grammar_point": "slownictwo"
        },
        {
          "id": "h3-6",
          "text": "Bardzo ___ spotkać się z Panią na rozmowie. Z poważaniem, Iryna Tkaczuk",
          "answer": "chciałabym",
          "grammar_point": "prosba-grzeczna"
        }
      ]
    }
  ]
}
