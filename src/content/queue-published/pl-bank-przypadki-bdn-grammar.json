{
  "lesson_id": "pl-bank-przypadki-bdn",
  "exercise_type": "fill-in-blank",
  "title": "Biernik, dopełniacz, narzędnik i liczba mnoga",
  "instruction": "Po każdym wyjaśnieniu — ćwiczenia. Zanim wpiszesz formę, zadaj pytanie: kogo? co? / kogo? czego? / kim? czym?",
  "estimated_minutes": 50,
  "blocks": [
    {
      "block_id": "g1",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "1. Biernik: kogo? co?",
      "instruction": "Wpisz rzeczownik w bierniku.",
      "items": [
        {
          "id": "g1-1",
          "text": "Rano zawsze piję ___. (kawa)",
          "answer": "kawę",
          "grammar_point": "biernik",
          "explanation": "ona: -a → -ę"
        },
        {
          "id": "g1-2",
          "text": "Codziennie czytam ___. (gazeta)",
          "answer": "gazetę",
          "grammar_point": "biernik",
          "explanation": "ona: -a → -ę"
        },
        {
          "id": "g1-3",
          "text": "Kocham moją ___. (mama)",
          "answer": "mamę",
          "grammar_point": "biernik",
          "explanation": "ona: -a → -ę"
        },
        {
          "id": "g1-4",
          "text": "Znasz ___? (Tomek)",
          "answer": "Tomka",
          "grammar_point": "biernik",
          "explanation": "Osoba (on) → -a; e znika: Tomek → Tomka"
        },
        {
          "id": "g1-5",
          "text": "W domu mamy ___. (kot)",
          "answer": "kota",
          "grammar_point": "biernik",
          "explanation": "Zwierzę (on) → -a"
        },
        {
          "id": "g1-6",
          "text": "Poproszę ___. (herbata)",
          "answer": "herbatę",
          "grammar_point": "biernik",
          "explanation": "poproszę + biernik"
        },
        {
          "id": "g1-7",
          "text": "W piątek odwiedzam ___. (kolega)",
          "answer": "kolegę",
          "grammar_point": "biernik",
          "explanation": "Kolega to on, ale kończy się na -a → odmienia się jak ona: kolegę"
        },
        {
          "id": "g1-8",
          "text": "Pytam ___ o drogę. (pan)",
          "answer": "pana",
          "grammar_point": "biernik",
          "explanation": "Osoba (on) → -a"
        },
        {
          "id": "g1-9",
          "text": "Kupuję ___ na prezent. (książka)",
          "answer": "książkę",
          "grammar_point": "biernik",
          "explanation": "ona: -a → -ę"
        }
      ]
    },
    {
      "block_id": "g2",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "2. Osoba, zwierzę czy rzecz?",
