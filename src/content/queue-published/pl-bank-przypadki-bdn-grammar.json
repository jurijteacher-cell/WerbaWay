          "explanation": "Film to rzecz → bez zmian"
        },
        {
          "id": "g2-5",
          "text": "Dziecko pije ___.",
          "answer": "mleko",
          "grammar_point": "biernik",
          "options": [
            "mleko",
            "mlekę"
          ],
          "explanation": "ono → bez zmian"
        },
        {
          "id": "g2-6",
          "text": "Znam dobrego ___.",
          "answer": "lekarza",
          "grammar_point": "biernik",
          "options": [
            "lekarza",
            "lekarz"
          ],
          "explanation": "Lekarz to osoba → lekarza"
        },
        {
          "id": "g2-7",
          "text": "Proszę ___!",
          "answer": "rachunek",
          "grammar_point": "biernik",
          "options": [
            "rachunek",
            "rachunka"
          ],
          "explanation": "Rachunek to rzecz → bez zmian"
        }
      ]
    },
    {
