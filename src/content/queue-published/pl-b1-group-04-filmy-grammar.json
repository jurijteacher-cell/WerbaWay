     "text": "Ten film jest ___ niż poprzedni.",
     "options": [
      "ciekawszy",
      "najciekawszy"
     ],
     "answer": "ciekawszy",
     "explanation": "Porównujemy dwa filmy — stopień wyższy.",
     "grammar_point": "stopniowanie-formy"
    },
    {
     "id": "g1-2",
     "text": "To ___ komedia, jaką widziałem w tym roku.",
