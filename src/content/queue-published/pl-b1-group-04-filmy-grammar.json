     "answer": "najdłuższy",
     "explanation": "Wybieramy jeden z trzech — stopień najwyższy.",
     "grammar_point": "stopniowanie-formy"
    },
    {
     "id": "g1-5",
     "text": "Drugi sezon był ___ od pierwszego.",
     "options": [
      "nudniejszy",
