     ],
     "answer": "najzabawniejsza",
     "explanation": "Najlepsza z całego roku — stopień najwyższy.",
     "grammar_point": "stopniowanie-formy"
    },
    {
     "id": "g1-3",
     "text": "Bilet w środę jest ___ niż w sobotę.",
     "options": [
