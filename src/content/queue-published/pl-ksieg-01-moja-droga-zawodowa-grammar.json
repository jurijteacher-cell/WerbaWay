        {"id": "g4-4", "prompt": "być / główna księgowa / w / hurtownia", "answer": "Byłam główną księgową w hurtowni.", "accept": ["W hurtowni byłam główną księgową."], "grammar_point": "rekcja"},
        {"id": "g4-5", "prompt": "(teraz) mieć / doświadczenie / w / kadry i płace", "answer": "Mam doświadczenie w kadrach i płacach.", "grammar_point": "rekcja"}
      ]
    },
