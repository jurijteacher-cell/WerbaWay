      "exercise_type": "fill-in-blank",
      "title": "3. Proces czy rezultat?",
      "instruction": "Wybierz właściwą formę.",
      "items": [
        {"id": "g3-1", "text": "Przez osiem lat ___ dokumenty klientów.", "options": ["sprawdzałam", "sprawdziłam"], "answer": "sprawdzałam", "explanation": "Przez + czas trwania: proces → niedokonany.", "grammar_point": "aspekt-uzycie"},
        {"id": "g3-2", "text": "Wczoraj w końcu ___ błąd w raporcie.", "options": ["znajdowałam", "znalazłam"], "answer": "znalazłam", "explanation": "W końcu: jest gotowy rezultat → dokonany.", "grammar_point": "aspekt-uzycie"},
        {"id": "g3-3", "text": "Co miesiąc ___ listę płac dla dyrektora.", "options": ["drukowałam", "wydrukowałam"], "answer": "drukowałam", "explanation": "Co miesiąc: czynność się powtarza → niedokonany.", "grammar_point": "aspekt-uzycie"},
        {"id": "g3-4", "text": "W ciągu dwóch dni ___ cały bilans.", "options": ["przygotowywałam", "przygotowałam"], "answer": "przygotowałam", "explanation": "W ciągu + czas: w tym czasie praca została skończona → dokonany.", "grammar_point": "aspekt-uzycie"},
        {"id": "g3-5", "text": "Kiedy ___ fakturę, wyłączył się prąd.", "options": ["księgowałam", "zaksięgowałam"], "answer": "księgowałam", "explanation": "Tło, które przerwało zdarzenie → niedokonany.", "grammar_point": "aspekt-uzycie"},
        {"id": "g3-6", "text": "___ dokumenty i od razu wysłałam je do banku.", "options": ["Skanowałam", "Zeskanowałam"], "answer": "Zeskanowałam", "explanation": "Kolejne kroki, każdy skończony → dokonany.", "grammar_point": "aspekt-uzycie"}
      ]
    },
