      "title": "5. Pułapki z ukraińskiego",
      "instruction": "Wybierz formę, którą powie Polak.",
      "items": [
        {"id": "g5-1", "text": "Na Ukrainie byłam ___.", "options": ["buchalterką", "księgową"], "answer": "księgową", "explanation": "Zawód to księgowa; być + narzędnik.", "grammar_point": "kalki-uk"},
        {"id": "g5-2", "text": "W firmie odpowiadałam za ___ finansową.", "options": ["raportowość", "sprawozdawczość"], "answer": "sprawozdawczość", "explanation": "Sprawozdawczość finansowa; „raportowość” nie istnieje.", "grammar_point": "kalki-uk"},
        {"id": "g5-3", "text": "Program sam ___ wynagrodzenia.", "options": ["narachowuje", "nalicza"], "answer": "nalicza", "explanation": "Нараховувати = naliczać.", "grammar_point": "kalki-uk"},
        {"id": "g5-4", "text": "Wczoraj przyszło pismo z ___.", "options": ["podatkowej", "urzędu skarbowego"], "answer": "urzędu skarbowego", "explanation": "Instytucja to urząd skarbowy.", "grammar_point": "kalki-uk"},
        {"id": "g5-5", "text": "___ sześć lat pracowałam w banku.", "options": ["W przeciągu", "Przez"], "answer": "Przez", "explanation": "Czas trwania: przez + biernik.", "grammar_point": "kalki-uk"},
        {"id": "g5-6", "text": "W piątek ___ deklarację za klienta.", "options": ["składałam", "złożyłam"], "answer": "złożyłam", "explanation": "Jedna deklaracja, gotowy rezultat → dokonany.", "grammar_point": "kalki-uk"}
