        },
        {
          "id": "g0-4",
          "statement": "Ania gniewała się na niego, bo zapomniał pogratulować jej awansu.",
          "answer": true,
          "explanation": "Gratulować komu? czego? — jej awansu.",
          "grammar_point": "rekcja"
        },
        {
          "id": "g0-5",
          "statement": "Mama narratora w ogóle się o niego nie martwiła.",
          "answer": false,
          "explanation": "„Mama martwiła się o mnie”. Martwić się o + biernik.",
          "grammar_point": "rekcja"
        },
        {
          "id": "g0-6",
          "statement": "Na lotnisku to Ania czekała na narratora.",
          "answer": false,
          "explanation": "To on czekał na Anię z kwiatami. Czekać na + biernik.",
          "grammar_point": "rekcja"
        }
      ]
    },
