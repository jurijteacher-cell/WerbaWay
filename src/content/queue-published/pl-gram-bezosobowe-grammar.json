    {
      "block_id": "g0",
      "part": 1,
      "exercise_type": "true-false",
      "title": "0. Na start: co wiemy z tekstu?",
      "instruction": "Prawda czy fałsz? Uważaj: tekst często nie mówi, kto coś zrobił.",
      "items": [
        {
          "id": "g0-1",
          "statement": "Tekst mówi, kto zaprosił narratora na imieniny.",
          "answer": false,
          "explanation": "„Zaproszono mnie” — forma na -no nie mówi, kto to zrobił.",
          "grammar_point": "bezosobowe-no-to"
        },
        {
          "id": "g0-2",
          "statement": "Kolega radził przynieść kwiaty albo coś słodkiego.",
          "answer": true,
          "explanation": "„Kwiaty albo coś słodkiego. Z pustymi rękami nie wypada przyjść.”",
          "grammar_point": "bezosobowe-sie"
        },
        {
          "id": "g0-3",
          "statement": "Kiedy narrator przyszedł, w kuchni nikt już nie gotował.",
          "answer": false,
          "explanation": "„W kuchni wciąż coś gotowano.”",
          "grammar_point": "bezosobowe-no-to"
        },
        {
          "id": "g0-4",
          "statement": "Według narratora gości w Polsce pyta się, czy są głodni.",
          "answer": false,
          "explanation": "„Tu się nie pyta, czy jesteś głodny, tu się po prostu nakłada.”",
          "grammar_point": "bezosobowe-sie"
        },
        {
          "id": "g0-5",
          "statement": "„Sto lat” śpiewa się nie tylko na imieninach.",
          "answer": true,
          "explanation": "„Śpiewa się tę piosenkę prawie przy każdej okazji.”",
          "grammar_point": "bezosobowe-sie"
        },
        {
          "id": "g0-6",
          "statement": "Narrator wyszedł wcześnie, bo był zmęczony.",
          "answer": false,
          "explanation": "„Nie dało się wyjść wcześniej” — ciągle ktoś dolewał herbaty.",
          "grammar_point": "modalne"
        }
      ]
    },
    {
      "block_id": "g1",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "1. Forma na -no / -to",
