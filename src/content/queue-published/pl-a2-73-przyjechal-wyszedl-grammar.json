{
  "lesson_id": "pl-a2-73-przyjechal-wyszedl",
  "exercise_type": "fill-in-blank",
  "title": "Przedrostki: przyjść, wyjść, dojechać",
  "instruction": "Pięć krótkich bloków. Na lekcji robimy bloki 1–3, bloki 4 i 5 — jeśli zostanie czas albo w domu.",
  "estimated_minutes": 20,
  "blocks": [
    {
      "block_id": "g1",
      "part": 1,
      "exercise_type": "matching",
      "title": "1. Połącz słowo z opisem",
      "instruction": "Kliknij słowo po lewej, a potem jego opis po prawej.",
      "items": [
        {
          "id": "g1-1",
          "left": "peron",
          "right": "miejsce, gdzie czekamy na pociąg",
          "grammar_point": "slownictwo"
        },
        {
          "id": "g1-2",
          "left": "odjazd",
          "right": "moment, kiedy pociąg rusza",
          "grammar_point": "slownictwo"
        },
        {
          "id": "g1-3",
          "left": "opóźnienie",
          "right": "pociąg jest później, niż powinien",
          "grammar_point": "slownictwo"
        },
        {
          "id": "g1-4",
          "left": "przesiadka",
          "right": "zmiana pociągu albo autobusu",
          "grammar_point": "slownictwo"
        },
        {
          "id": "g1-5",
          "left": "zgubić się",
          "right": "nie wiedzieć, gdzie się jest",
          "grammar_point": "slownictwo"
        },
        {
          "id": "g1-6",
          "left": "zawrócić",
          "right": "pojechać w drugą stronę",
          "grammar_point": "slownictwo"
        },
        {
          "id": "g1-7",
          "left": "szczyt",
          "right": "najwyższe miejsce góry",
          "grammar_point": "slownictwo"
        },
        {
          "id": "g1-8",
          "left": "pieszo",
          "right": "na nogach, bez samochodu",
          "grammar_point": "slownictwo"
        }
      ]
    },
    {
      "block_id": "g2",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "2. Który przedrostek?",
      "instruction": "Wybierz czasownik, który pasuje do zdania.",
      "items": [
        {
          "id": "g2-1",
          "text": "Tomek ___ do pociągu minutę przed odjazdem.",
          "answer": "wsiadł",
          "options": [
            "wsiadł",
            "wysiadł",
            "wyszedł"
          ],
          "grammar_point": "isc-jechac-przedrostki",
          "explanation": "Wsiąść do pociągu — wejść do środka. Wysiąść z pociągu — wyjść."
        },
        {
          "id": "g2-2",
          "text": "Proszę ___ przez ulicę na zielonym świetle.",
          "answer": "przejść",
          "options": [
            "przejść",
            "wejść",
            "zejść"
          ],
          "grammar_point": "isc-jechac-przedrostki",
          "explanation": "Prze- + przez: przejść przez ulicę — na drugą stronę."
        },
        {
          "id": "g2-3",
          "text": "Kiedy ___ do pokoju, zobaczyłam piękny widok.",
          "answer": "weszłam",
          "options": [
            "weszłam",
            "wyszłam",
            "zeszłam"
          ],
          "grammar_point": "isc-jechac-przedrostki",
          "explanation": "W- + do: wejść do pokoju — do środka."
        },
        {
          "id": "g2-4",
          "text": "Z Kasprowego Wierchu ___ pieszo, bo kolejka nie jeździła.",
          "answer": "zeszliśmy",
          "options": [
            "zeszliśmy",
            "weszliśmy",
            "przeszliśmy"
          ],
          "grammar_point": "isc-jechac-przedrostki",
          "explanation": "Z- + z: zejść z góry — w dół."
        },
        {
          "id": "g2-5",
          "text": "Jutro po obiedzie ___ z Zakopanego.",
          "answer": "wyjedziemy",
          "options": [
            "wyjedziemy",
            "wjedziemy",
            "dojedziemy"
          ],
          "grammar_point": "isc-jechac-przedrostki",
          "explanation": "Wy- + z: wyjechać z miasta — zostawić je."
        },
        {
          "id": "g2-6",
          "text": "Do szczytu ___ dopiero po trzech godzinach.",
          "answer": "doszliśmy",
          "options": [
            "doszliśmy",
            "odeszliśmy",
            "przeszliśmy"
          ],
          "grammar_point": "isc-jechac-przedrostki",
          "explanation": "Do- + do: dojść do celu — na koniec drogi."
        },
        {
          "id": "g2-7",
          "text": "Autobus ___ z przystanku, zanim do niego dobiegłam.",
          "answer": "odjechał",
          "options": [
            "odjechał",
            "przyjechał",
            "wjechał"
          ],
          "grammar_point": "isc-jechac-przedrostki",
          "explanation": "Od-: odjechać z przystanku — zostawić to miejsce."
        }
      ]
    },
    {
      "block_id": "g3",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "3. Wpisz formę",
      "instruction": "Wpisz czasownik z nawiasu w czasie przeszłym albo przyszłym.",
      "items": [
        {
          "id": "g3-1",
          "text": "Wczoraj Olena ___ z biura o pierwszej. (wyjść)",
          "answer": "wyszła",
          "grammar_point": "aspekt-przeszly",
          "explanation": "Iść → szedł / szła: wyszła (ona)."
        },
        {
          "id": "g3-2",
          "text": "Pan Piotr ___ samochodem o wpół do ósmej. (przyjechać)",
          "answer": "przyjechał",
          "grammar_point": "aspekt-przeszly",
          "explanation": "Jechać → jechał: przyjechał."
        },
        {
          "id": "g3-3",
          "text": "Ja (kobieta) ___ na dworzec za późno! (przyjść)",
          "answer": "przyszłam",
          "grammar_point": "aspekt-przeszly",
          "explanation": "Kobieta: przyszłam (nie „przyszedłam”)."
        },
        {
          "id": "g3-4",
          "text": "Ty (mężczyzna) ___ już z pracy? (wyjść)",
          "answer": "wyszedłeś",
          "grammar_point": "aspekt-przeszly",
          "explanation": "Mężczyzna: wyszedłem, wyszedłeś, wyszedł."
        },
        {
          "id": "g3-5",
          "text": "Kasia ___ do nas jutro wieczorem. (przyjść)",
          "answer": "przyjdzie",
          "grammar_point": "czas-przyszly-dk",
          "explanation": "Przyszłość dk: przyjdę, przyjdziesz, przyjdzie."
        },
        {
          "id": "g3-6",
          "text": "Za godzinę ___ do Nowego Targu. (dojechać, my)",
          "answer": "dojedziemy",
          "grammar_point": "czas-przyszly-dk",
          "explanation": "Przyszłość dk: dojadę, dojedziesz, dojedziemy."
        },
        {
          "id": "g3-7",
          "text": "Kiedy ___ do pensjonatu, na stole stała herbata. (wejść, my)",
          "answer": "weszliśmy",
          "grammar_point": "aspekt-przeszly",
          "explanation": "Wejść → wszedł / weszła / weszliśmy."
        },
        {
          "id": "g3-8",
          "text": "Mama ___ do Lwowa w sobotę rano. (wyjechać)",
          "answer": "wyjechała",
          "grammar_point": "aspekt-przeszly",
          "explanation": "Jechać → jechała: wyjechała."
        }
      ]
    },
    {
      "block_id": "g4",
      "part": 2,
      "exercise_type": "fill-in-blank",
      "title": "4. Raz czy zwykle?",
      "instruction": "Wybierz formę dokonaną albo niedokonaną.",
      "items": [
        {
          "id": "g4-1",
          "text": "Zwykle ___ z domu o siódmej.",
          "answer": "wychodzę",
          "options": [
            "wychodzę",
            "wyjdę"
          ],
          "grammar_point": "isc-jechac-przedrostki",
          "explanation": "Zwykle, codziennie → niedokonany: wychodzić."
        },
        {
          "id": "g4-2",
          "text": "Wczoraj wyjątkowo ___ o szóstej.",
          "answer": "wyszłam",
          "options": [
            "wyszłam",
            "wychodziłam"
          ],
          "grammar_point": "aspekt-przeszly",
          "explanation": "Jeden raz, wynik → dokonany: wyszłam."
        },
        {
          "id": "g4-3",
          "text": "Pociągi z Krakowa często ___ z opóźnieniem.",
          "answer": "przyjeżdżają",
          "options": [
            "przyjeżdżają",
            "przyjadą"
          ],
          "grammar_point": "isc-jechac-przedrostki",
          "explanation": "Często → niedokonany: przyjeżdżać."
        },
        {
          "id": "g4-4",
          "text": "Jak tylko ___ do hotelu, zadzwonię do ciebie.",
          "answer": "dojadę",
          "options": [
            "dojadę",
            "dojeżdżam"
          ],
          "grammar_point": "czas-przyszly-dk",
          "explanation": "Jedna czynność w przyszłości → dokonany: dojadę."
        },
        {
          "id": "g4-5",
          "text": "Codziennie ___ obok tego kościoła w drodze do pracy.",
          "answer": "przejeżdżam",
          "options": [
            "przejeżdżam",
            "przejadę"
          ],
          "grammar_point": "isc-jechac-przedrostki",
          "explanation": "Codziennie → niedokonany: przejeżdżać."
        },
        {
          "id": "g4-6",
          "text": "Kasia ___ z przyjęcia o północy i wróciła taksówką.",
          "answer": "wyszła",
          "options": [
            "wyszła",
            "wychodziła"
          ],
          "grammar_point": "aspekt-przeszly",
          "explanation": "Jedna czynność, potem następna → dokonany: wyszła."
        }
      ]
    },
    {
      "block_id": "g5",
      "part": 2,
      "exercise_type": "sentence-building",
      "title": "5. Popraw błąd",
      "instruction": "W każdym zdaniu jest jeden błąd. Napisz całe zdanie poprawnie.",
      "items": [
        {
          "id": "g5-1",
          "prompt": "Przyjechaliśmy w Zakopane wieczorem.",
          "answer": "Przyjechaliśmy do Zakopanego wieczorem.",
          "accept": [
            "Wieczorem przyjechaliśmy do Zakopanego."
          ],
          "grammar_point": "przyimki-kierunku",
          "explanation": "Przyjechać do + dopełniacz: do Zakopanego."
        },
        {
          "id": "g5-2",
          "prompt": "Wsiadłam w autobus numer 5.",
          "answer": "Wsiadłam do autobusu numer 5.",
          "grammar_point": "isc-jechac-przedrostki",
          "explanation": "Wsiąść do + dopełniacz: do autobusu."
        },
        {
          "id": "g5-3",
          "prompt": "Przeszliśmy ulicę na czerwonym świetle.",
          "answer": "Przeszliśmy przez ulicę na czerwonym świetle.",
          "grammar_point": "isc-jechac-przedrostki",
          "explanation": "Przejść przez + biernik: przez ulicę."
        },
        {
          "id": "g5-4",
          "prompt": "Kasia wyszedła z biura o piątej.",
          "answer": "Kasia wyszła z biura o piątej.",
          "grammar_point": "aspekt-przeszly",
          "explanation": "Ona: wyszła. On: wyszedł."
        },
        {
          "id": "g5-5",
          "prompt": "Wejdź w pokój i usiądź.",
          "answer": "Wejdź do pokoju i usiądź.",
          "grammar_point": "isc-jechac-przedrostki",
          "explanation": "Wejść do + dopełniacz: do pokoju."
        },
        {
          "id": "g5-6",
          "prompt": "Pan Piotr dojechał na pensjonat o wpół do ósmej.",
          "answer": "Pan Piotr dojechał do pensjonatu o wpół do ósmej.",
          "grammar_point": "kalki-uk",
          "explanation": "Dojechać do + dopełniacz: do pensjonatu."
        }
      ]
    }
  ]
}
