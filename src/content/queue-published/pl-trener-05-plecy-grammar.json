        {
          "id": "g1-3",
          "left": "chwyt neutralny",
          "right": "dłonie patrzą na siebie",
          "grammar_point": "slownictwo"
        },
        {
          "id": "g1-4",
          "left": "odcinek lędźwiowy",
          "right": "dolna część kręgosłupa",
          "grammar_point": "slownictwo"
