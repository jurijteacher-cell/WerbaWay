        {
          "id": "g1-5",
          "left": "mięsień czworoboczny",
          "right": "„kaptur” między szyją a barkami",
          "grammar_point": "slownictwo"
        },
        {
          "id": "g1-6",
          "left": "prostownik grzbietu",
          "right": "trzyma plecy prosto wzdłuż kręgosłupa",
          "grammar_point": "slownictwo"
        },
        {
          "id": "g1-7",
          "left": "„ptak-pies”",
          "right": "na czworakach: ręka do przodu, noga do tyłu",
          "grammar_point": "slownictwo"
        },
        {
          "id": "g1-8",
          "left": "martwy ciąg",
          "right": "podnosisz sztangę z podłogi",
          "grammar_point": "slownictwo"
        }
      ]
    },
    {
      "block_id": "g2",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "2. Trochę szerzej!",
      "instruction": "Wpisz przysłówek z nawiasu w stopniu wyższym.",
      "items": [
        {
          "id": "g2-1",
          "text": "Rozstaw ręce trochę ___ (szeroko).",
