          "grammar_point": "stopien-wyzszy-przyslowek",
          "explanation": "szeroko → szerzej (zmienia się spółgłoska)."
        },
        {
          "id": "g2-2",
          "text": "Opuszczaj ciężar ___ (wolno).",
          "answer": "wolniej",
          "grammar_point": "stopien-wyzszy-przyslowek"
        },
        {
          "id": "g2-3",
          "text": "Chwyć drążek ___ (wąsko).",
          "answer": "węziej",
          "grammar_point": "stopien-wyzszy-przyslowek",
          "accept": [
            "wężej"
          ]
        },
        {
          "id": "g2-4",
          "text": "Ściągnij łopatki ___ (mocno).",
          "answer": "mocniej",
          "grammar_point": "stopien-wyzszy-przyslowek"
        },
        {
          "id": "g2-5",
          "text": "Łokieć prowadź ___ (blisko) ciała.",
          "answer": "bliżej",
          "grammar_point": "stopien-wyzszy-nieregularny"
        },
        {
          "id": "g2-6",
          "text": "Teraz jest dużo ___ (dobrze)!",
          "answer": "lepiej",
          "grammar_point": "stopien-wyzszy-nieregularny"
        },
        {
          "id": "g2-7",
          "text": "Nie unoś nogi ___ (wysoko) niż biodro.",
          "answer": "wyżej",
          "grammar_point": "stopien-wyzszy-nieregularny"
        },
        {
          "id": "g2-8",
          "text": "Zejdź trochę ___ (nisko).",
          "answer": "niżej",
          "grammar_point": "stopien-wyzszy-nieregularny"
        }
      ]
    },
    {
