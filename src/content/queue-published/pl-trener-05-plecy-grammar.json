          "grammar_point": "jesli-warunek",
          "accept": [
            "Jeżeli",
            "Kiedy",
            "Gdy"
          ]
        },
        {
          "id": "g6-7",
          "text": "Rozgrzej się, ___ weźmiesz sztangę. (przed czynnością)",
          "answer": "zanim",
          "grammar_point": "zanim"
        }
