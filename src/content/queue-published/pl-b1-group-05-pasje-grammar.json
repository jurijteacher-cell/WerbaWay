   "exercise_type": "fill-in-blank",
   "title": "1. Proces czy wynik?",
   "instruction": "Mówimy o czynności w trakcie czy o wyniku? Wybierz formę.",
   "covers_slides": [
    "s2",
    "s3"
   ],
   "items": [
    {
     "id": "g1-1",
     "text": "Wczoraj cały wieczór ___ wazon, ale go nie skończyłam.",
     "options": [
      "lepiłam",
      "ulepiłam"
     ],
     "answer": "lepiłam",
     "explanation": "Czynność trwała i nie ma wyniku — niedokonany.",
     "grammar_point": "aspekt-znaczenie"
    },
    {
     "id": "g1-2",
     "text": "Wreszcie ___ pierwszy kubek! Możesz z niego pić.",
     "options": [
      "zrobiłam",
      "robiłam"
     ],
     "answer": "zrobiłam",
     "explanation": "Jest gotowy kubek — wynik, dokonany.",
     "grammar_point": "aspekt-znaczenie"
    },
    {
     "id": "g1-3",
     "text": "Tomasz ___ strój przez pół roku.",
     "options": [
      "szył",
      "uszył"
     ],
     "answer": "szył",
     "explanation": "„Przez pół roku” — proces, niedokonany.",
     "grammar_point": "aspekt-znaczenie"
    },
    {
     "id": "g1-4",
     "text": "W marcu ___ kurs i dostałem certyfikat.",
     "options": [
      "skończyłem",
      "kończyłem"
     ],
     "answer": "skończyłem",
     "explanation": "Kurs jest skończony, jest certyfikat — dokonany.",
     "grammar_point": "aspekt-znaczenie"
    },
    {
     "id": "g1-5",
     "text": "Co ___ wczoraj wieczorem? — Oglądałam serial.",
     "options": [
      "robiłaś",
      "zrobiłaś"
     ],
     "answer": "robiłaś",
     "explanation": "Pytamy o zajęcie, nie o wynik — niedokonany.",
     "grammar_point": "aspekt-znaczenie"
    },
    {
     "id": "g1-6",
     "text": "Kto ___ tę piękną miskę?",
     "options": [
      "zrobił",
      "robił"
     ],
     "answer": "zrobił",
     "explanation": "Miska jest gotowa — pytamy o autora wyniku.",
     "grammar_point": "aspekt-znaczenie"
    }
   ]
  },
