      "exercise_type": "fill-in-blank",
      "title": "1. Wpisz właściwą formę",
      "instruction": "Wpisz słowo z nawiasu w odpowiedniej formie po przyimku.",
      "items": [
        {
          "id": "h1-1",
          "text": "Z powodu ___ (gorączka) córka została w domu.",
          "answer": "gorączki",
          "grammar_point": "z-powodu-dopelniacz"
        },
        {
          "id": "h1-2",
          "text": "Dzięki ___ (ta aplikacja) wiem, kiedy przyjedzie tramwaj.",
          "answer": "tej aplikacji",
          "grammar_point": "dzieki-celownik"
        },
        {
          "id": "h1-3",
          "text": "Przez ___ (głośna muzyka) nie słyszałem telefonu.",
          "answer": "głośną muzykę",
          "grammar_point": "przez-biernik"
        },
        {
          "id": "h1-4",
          "text": "Kawiarnia jest dziś zamknięta z powodu ___ (urlop) właściciela.",
          "answer": "urlopu",
          "grammar_point": "z-powodu-dopelniacz"
        },
        {
          "id": "h1-5",
          "text": "Dzięki ___ (mój dziadek) nauczyłem się łowić ryby.",
          "answer": "mojemu dziadkowi",
          "grammar_point": "dzieki-celownik"
        },
        {
          "id": "h1-6",
          "text": "Przez ___ (te schody) sąsiad z czwartego piętra prawie nie wychodzi z domu.",
          "answer": "te schody",
          "grammar_point": "przez-biernik"
        },
        {
          "id": "h1-7",
          "text": "Dzięki ___ (koleżanki) z pracy nie czułam się samotna.",
          "answer": "koleżankom",
          "grammar_point": "dzieki-celownik"
        },
        {
          "id": "h1-8",
          "text": "Z powodu ___ (duże zainteresowanie) muzeum przedłużyło wystawę.",
          "answer": "dużego zainteresowania",
          "grammar_point": "z-powodu-dopelniacz"
        }
      ]
    },
    {
