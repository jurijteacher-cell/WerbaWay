    {
      "block_id": "h3",
      "exercise_type": "sentence-building",
      "title": "3. Popraw błąd",
      "instruction": "W każdym zdaniu jest jeden błąd. Napisz całe zdanie poprawnie.",
      "items": [
        {
          "id": "h3-1",
          "prompt": "Bo zaspałam, spóźniłam się do pracy.",
          "answer": "Ponieważ zaspałam, spóźniłam się do pracy.",
          "grammar_point": "bo-ponieważ",
          "accept": [
            "Spóźniłam się do pracy, bo zaspałam.",
            "Spóźniłam się do pracy, ponieważ zaspałam."
          ],
          "explanation": "Na początku zdania — ponieważ; „bo” przesuń do środka."
        },
        {
          "id": "h3-2",
          "prompt": "Dzięki burzy nie mieliśmy prądu całą noc.",
          "answer": "Przez burzę nie mieliśmy prądu całą noc.",
          "grammar_point": "dzieki-przez-z-powodu",
          "accept": [
            "Z powodu burzy nie mieliśmy prądu całą noc."
          ],
          "explanation": "Zła przyczyna → przez burzę albo z powodu burzy."
        },
        {
          "id": "h3-3",
          "prompt": "Dzięki mojej mamy mam dom na wsi.",
          "answer": "Dzięki mojej mamie mam dom na wsi.",
          "grammar_point": "dzieki-celownik",
          "explanation": "Dzięki + celownik: mojej mamie.",
          "accept": [
            "Mam dom na wsi dzięki mojej mamie."
          ]
        },
        {
          "id": "h3-4",
          "prompt": "Wyjechał zza braku pracy.",
          "answer": "Wyjechał z powodu braku pracy.",
          "grammar_point": "kalki-uk",
          "accept": [
            "Wyjechał przez brak pracy."
          ],
          "explanation": "„Zza” = з-за (miejsce). Przyczyna → z powodu."
        },
        {
          "id": "h3-5",
          "prompt": "Gdybym miał więcej pieniędzy, kupiłem dom na wsi.",
          "answer": "Gdybym miał więcej pieniędzy, kupiłbym dom na wsi.",
          "grammar_point": "tryb-przypuszczajacy",
          "explanation": "Gdyby… → kupiłbym (tryb przypuszczający).",
          "accept": [
            "Gdybym miał więcej pieniędzy, to kupiłbym dom na wsi."
          ]
        },
        {
          "id": "h3-6",
          "prompt": "Zadzwoniłam do sołtysa, że pomógł mi z formularzem.",
          "answer": "Zadzwoniłam do sołtysa, żeby pomógł mi z formularzem.",
          "grammar_point": "zeby-cel",
          "explanation": "Prośba, cel telefonu → żeby.",
          "accept": [
            "Zadzwoniłam do sołtysa, żeby mi pomógł z formularzem."
          ]
        }
      ]
    }
