{
  "lesson_id": "pl-a2-79-powiedzial-ze",
  "exercise_type": "fill-in-blank",
  "title": "Praca domowa: co powiedział, o co zapytał",
  "instruction": "Trzy bloki ćwiczeń. Potem napisz o ważnej rozmowie — zadanie jest na stronie lekcji.",
  "estimated_minutes": 20,
  "blocks": [
    {
      "block_id": "h1",
      "exercise_type": "fill-in-blank",
      "title": "1. Zmień osobę",
      "instruction": "Wpisz czasownik w dobrej osobie.",
      "items": [
        {
          "id": "h1-1",
          "text": "„Jestem w domu.” → Mama napisała, że ___ w domu.",
          "answer": "jest",
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Ja → ona: jest."
        },
        {
          "id": "h1-2",
          "text": "„Czy przyjdziesz?” (Kasia do mnie) → Kasia zapytała, czy ___.",
          "answer": "przyjdę",
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Ty → ja: przyjdę."
        },
        {
          "id": "h1-3",
          "text": "„Ile kosztuje bilet?” → Turysta zapytał, ile ___ bilet.",
          "answer": "kosztuje",
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Bez zmiany: kosztuje."
        },
        {
          "id": "h1-4",
          "text": "„Wrócę o ósmej.” → Tomek powiedział, że ___ o ósmej.",
          "answer": "wróci",
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Ja → on: wróci."
        },
        {
          "id": "h1-5",
          "text": "„Gdzie jest dworzec?” → Pani zapytała, gdzie ___ dworzec.",
          "answer": "jest",
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Bez zmiany: jest."
        },
        {
          "id": "h1-6",
          "text": "„Mam nową pracę.” (ja) → Napisałam mamie, że ___ nową pracę.",
          "answer": "mam",
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Ja → ja: mam."
        }
      ]
    },
    {
      "block_id": "h2",
      "exercise_type": "fill-in-blank",
      "title": "2. Wybierz formę",
      "instruction": "Wybierz dobrą formę.",
      "items": [
        {
          "id": "h2-1",
          "text": "Zapytałam, ___ sklep jest otwarty w niedzielę.",
          "answer": "czy",
          "options": [
            "co",
            "że",
            "czy"
          ],
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Tak / nie → czy."
        },
        {
          "id": "h2-2",
          "text": "Lekarz powiedział, ___ to nic poważnego.",
          "answer": "że",
          "options": [
            "czy",
            "że",
            "żeby"
          ],
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Informacja → że."
        },
        {
          "id": "h2-3",
          "text": "Szef ___ nam przyjść wcześniej.",
          "answer": "kazał",
          "options": [
            "zapytał",
            "kazał",
            "odpowiedział"
          ],
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Kazać + bezokolicznik."
        },
        {
          "id": "h2-4",
          "text": "Sąsiadka zapytała ___, gdzie pracuję.",
          "answer": "mnie",
          "options": [
            "mnie",
            "mi",
            "u mnie"
          ],
          "grammar_point": "kalki-uk",
          "explanation": "Zapytać kogo? — mnie."
        },
        {
          "id": "h2-5",
          "text": "Kasia ___, że pomoże mi z przeprowadzką.",
          "answer": "obiecała",
          "options": [
            "zapytała",
            "kazała",
            "obiecała"
          ],
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Obiecać, że…"
        },
        {
          "id": "h2-6",
          "text": "„Zadzwonię do ciebie.” → Powiedział, że zadzwoni do ___.",
          "answer": "mnie",
          "options": [
            "ciebie",
            "mnie",
            "niego"
          ],
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Ciebie (do mnie) → mnie."
        }
      ]
    },
    {
      "block_id": "h3",
      "exercise_type": "sentence-building",
      "title": "3. Popraw błąd",
      "instruction": "W każdym zdaniu jest jeden błąd. Napisz całe zdanie poprawnie.",
      "items": [
        {
          "id": "h3-1",
          "prompt": "Zapytała, że lubię kawę.",
          "answer": "Zapytała, czy lubię kawę.",
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Tak / nie → czy."
        },
        {
          "id": "h3-2",
          "prompt": "Mama zapytała u mnie o pracę.",
          "answer": "Mama zapytała mnie o pracę.",
          "grammar_point": "kalki-uk",
          "explanation": "Zapytać kogo? o co?"
        },
        {
          "id": "h3-3",
          "prompt": "Szef kazał, że przyjdziemy o ósmej.",
          "answer": "Szef kazał nam przyjść o ósmej.",
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Kazać komu + bezokolicznik."
        },
        {
          "id": "h3-4",
          "prompt": "Nie wiem, że sklep jest otwarty.",
          "answer": "Nie wiem, czy sklep jest otwarty.",
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Nie wiem + pytanie → czy."
        },
        {
          "id": "h3-5",
          "prompt": "Poprosiłam na pomoc.",
          "answer": "Poprosiłam o pomoc.",
          "grammar_point": "mowa-zalezna-podstawy",
          "explanation": "Poprosić o."
        }
      ]
    }
  ]
}
