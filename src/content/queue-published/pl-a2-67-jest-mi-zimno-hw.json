{
  "lesson_id": "pl-a2-67-jest-mi-zimno",
  "exercise_type": "fill-in-blank",
  "title": "Praca domowa: komu? jak się czujesz?",
  "instruction": "Trzy bloki ćwiczeń. Potem napisz wiadomość do koleżanki — zadanie jest na stronie lekcji.",
  "estimated_minutes": 20,
  "blocks": [
    {
      "block_id": "h1",
      "exercise_type": "fill-in-blank",
      "title": "1. Komu?",
      "instruction": "Wpisz słowa z nawiasu w celowniku.",
      "items": [
        {
          "id": "h1-1",
          "text": "Na urodziny dałam ___ kwiaty. (moja babcia)",
          "answer": "mojej babci",
          "grammar_point": "celownik-osoby",
          "explanation": "Rodzaj żeński: mojej babci."
        },
        {
          "id": "h1-2",
          "text": "Pokaż ___ nasze biuro! (nowy kolega)",
          "answer": "nowemu koledze",
          "grammar_point": "celownik-osoby",
          "explanation": "Kolega → koledze (g → dz, jak mama → mamie), przymiotnik -emu: nowemu."
        },
        {
          "id": "h1-3",
          "text": "Lekarz przepisał ___ antybiotyk. (mój tata)",
          "answer": "mojemu tacie",
          "grammar_point": "celownik-osoby",
          "explanation": "Tata → tacie (jak żeński), ale przymiotnik męski: mojemu tacie."
        },
        {
          "id": "h1-4",
          "text": "Wysłałem ___ raport. (pani Agnieszka)",
          "answer": "pani Agnieszce",
          "grammar_point": "celownik-osoby",
          "explanation": "Pani → pani, Agnieszka → Agnieszce (k → c)."
        },
        {
          "id": "h1-5",
          "text": "Nie przeszkadzaj ___, on pracuje! (ojciec)",
          "answer": "ojcu",
          "grammar_point": "celownik-osoby",
          "explanation": "Ojciec to wyjątek: ojcu."
        },
        {
          "id": "h1-6",
          "text": "Pożycz ___ parasol, pada deszcz. (twoja siostra)",
          "answer": "twojej siostrze",
          "grammar_point": "celownik-osoby",
          "explanation": "Siostra → siostrze (r → rz), przymiotnik: twojej."
        }
      ]
    },
    {
      "block_id": "h2",
      "exercise_type": "fill-in-blank",
      "title": "2. Wybierz formę",
      "instruction": "Wybierz dobrą formę.",
      "items": [
        {
          "id": "h2-1",
          "text": "Kasiu, czy jest ___ zimno?",
          "answer": "ci",
          "options": [
            "cię",
            "tobą",
            "ci"
          ],
          "grammar_point": "celownik-bezosobowe",
          "explanation": "Jest komu zimno? — ci."
        },
        {
          "id": "h2-2",
          "text": "Dzieci są głodne, chce ___ się jeść.",
          "answer": "im",
          "options": [
            "im",
            "nim",
            "ich"
          ],
          "grammar_point": "celownik-bezosobowe",
          "explanation": "Chce się komu? — im."
        },
        {
          "id": "h2-3",
          "text": "Pan Piotr miał problem z komputerem. Wczoraj ___ pomogłam.",
          "answer": "mu",
          "options": [
            "jego",
            "mu",
            "niego"
          ],
          "grammar_point": "celownik-osoby",
          "explanation": "Pomóc komu? — mu."
        },
        {
          "id": "h2-4",
          "text": "Bardzo ___ się podoba Kraków!",
          "answer": "mi",
          "options": [
            "mnie",
            "mną",
            "mi"
          ],
          "grammar_point": "celownik-bezosobowe",
          "explanation": "Podoba się komu? — mi (krótka forma w środku zdania)."
        },
        {
          "id": "h2-5",
          "text": "Sernik bardzo smakował ___ mamie.",
          "answer": "mojej",
          "options": [
            "mojej",
            "moją",
            "moja"
          ],
          "grammar_point": "celownik-osoby",
          "explanation": "Smakować komu? — mojej mamie."
        },
        {
          "id": "h2-6",
          "text": "Słyszałam, że jest Pan chory. Życzę ___ zdrowia!",
          "answer": "Panu",
          "options": [
            "Panu",
            "Pana",
            "Pan"
          ],
          "grammar_point": "celownik-osoby",
          "explanation": "Życzyć komu? — Panu."
        }
      ]
    },
    {
      "block_id": "h3",
      "exercise_type": "sentence-building",
      "title": "3. Popraw błąd",
      "instruction": "W każdym zdaniu jest jeden błąd. Napisz całe zdanie poprawnie.",
      "items": [
        {
          "id": "h3-1",
          "prompt": "Mamie jest zimna.",
          "answer": "Mamie jest zimno.",
          "grammar_point": "celownik-bezosobowe",
          "explanation": "Jest komu jak? — przysłówek: zimno, gorąco, słabo."
        },
        {
          "id": "h3-2",
          "prompt": "Ja nie chce się iść do pracy.",
          "answer": "Nie chce mi się iść do pracy.",
          "accept": [
            "Mnie się nie chce iść do pracy."
          ],
          "grammar_point": "celownik-bezosobowe",
          "explanation": "Chce się komu? — mi. Bez „ja”."
        },
        {
          "id": "h3-3",
          "prompt": "Daj kanapkę dziecko.",
          "answer": "Daj kanapkę dziecku.",
          "accept": [
            "Daj dziecku kanapkę."
          ],
          "grammar_point": "celownik-osoby",
          "explanation": "Dać komu? — dziecku."
        },
        {
          "id": "h3-4",
          "prompt": "Powiedziałam o tym mój szef.",
          "answer": "Powiedziałam o tym mojemu szefowi.",
          "accept": [
            "Powiedziałam mojemu szefowi o tym.",
            "Powiedziałem o tym mojemu szefowi."
          ],
          "grammar_point": "celownik-osoby",
          "explanation": "Powiedzieć komu? — mojemu szefowi."
        },
        {
          "id": "h3-5",
          "prompt": "Bolą mnie głowa.",
          "answer": "Boli mnie głowa.",
          "accept": [
            "Głowa mnie boli."
          ],
          "grammar_point": "celownik-bezosobowe",
          "explanation": "Głowa — liczba pojedyncza: boli. Bolą — kiedy boli więcej rzeczy: bolą mnie nogi."
        }
      ]
    }
  ]
}
