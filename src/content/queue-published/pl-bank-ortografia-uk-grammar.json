          "text": "Ten telefon jest ___ od tamtego.",
          "answer": "lepszy",
          "grammar_point": "rz-wyjatki",
          "options": [
            "lepszy",
            "leprzy"
          ],
          "explanation": "stopień wyższy: -szy (lepszy, łatwiejszy)"
        },
        {
          "id": "g3-3",
          "text": "Samochód stoi w ___.",
          "answer": "garażu",
          "grammar_point": "rz-wyjatki",
          "options": [
            "garażu",
            "gararzu"
          ],
          "explanation": "-aż z francuskiego: garaż, bagaż"
        },
        {
          "id": "g3-4",
          "text": "W sierpniu leżę na ___.",
          "answer": "plaży",
          "grammar_point": "rz-wyjatki",
          "options": [
            "plaży",
            "plarzy"
          ],
          "explanation": "plaża — z francuskiego, ż"
        },
        {
          "id": "g3-5",
          "text": "Ten stół ma ciekawy ___.",
          "answer": "kształt",
          "grammar_point": "rz-wyjatki",
          "options": [
            "kształt",
            "krztałt"
          ],
          "explanation": "wyjątek: po k → sz (kształt)"
        },
        {
          "id": "g3-6",
          "text": "Po treningu idę na ___.",
          "answer": "masaż",
          "grammar_point": "rz-wyjatki",
          "options": [
            "masaż",
            "masarz"
          ],
          "explanation": "-aż z francuskiego: masaż"
        }
      ]
    },
