        },
        {
          "id": "g4-2",
          "text": "Bardzo lubię Krak___w.",
          "answer": "ó",
          "grammar_point": "o-u",
          "explanation": "końcówka -ów → ó"
        },
        {
          "id": "g4-3",
          "text": "Ona często kup___je owoce.",
          "answer": "u",
          "grammar_point": "o-u",
          "explanation": "-uje → u · укр. купує"
        },
        {
          "id": "g4-4",
          "text": "Mieszkam przy ___licy Długiej.",
          "answer": "u",
          "grammar_point": "o-u",
          "explanation": "na początku słowa → u"
        },
        {
          "id": "g4-5",
          "text": "Jutro wr___cę późno.",
          "answer": "ó",
          "grammar_point": "o-u",
          "explanation": "wrócić ← wracać (a)"
        },
        {
          "id": "g4-6",
          "text": "Proszę, oto rach___nek.",
          "answer": "u",
          "grammar_point": "o-u",
          "explanation": "-unek → u"
        },
        {
          "id": "g4-7",
          "text": "Zimą na g___rach leży śnieg.",
          "answer": "ó",
          "grammar_point": "o-u",
          "explanation": "góra — do zapamiętania"
        },
        {
          "id": "g4-8",
          "text": "To jest m___j brat.",
          "answer": "ó",
          "grammar_point": "o-u",
          "explanation": "mój ← moja (o) · укр. мій — моя"
        }
      ]
    },
