      "block_id": "h1",
      "exercise_type": "fill-in-blank",
      "title": "1. Gdzie to jest?",
      "instruction": "Wpisz słowa z nawiasu w miejscowniku.",
      "items": [
        {
          "id": "h1-1",
          "text": "Zapasowe koło jest w ___ (bagażnik).",
          "answer": "bagażniku",
          "grammar_point": "miejscownik-miejsce"
        },
        {
          "id": "h1-2",
          "text": "Stare zabawki trzymamy na ___ (strych).",
          "answer": "strychu",
          "grammar_point": "miejscownik-miejsce",
          "explanation": "Po ch → -u: na strychu, na dachu."
        },
        {
          "id": "h1-3",
          "text": "Mleko jest w ___ (lodówka), na dole.",
          "answer": "lodówce",
          "grammar_point": "miejscownik-miejsce"
        },
        {
          "id": "h1-4",
          "text": "Spotkamy się na ___ (rynek) o szóstej.",
          "answer": "rynku",
          "grammar_point": "miejscownik-miejsce"
        },
        {
          "id": "h1-5",
          "text": "Zostawiłam parasol w ___ (samochód).",
          "answer": "samochodzie",
          "grammar_point": "miejscownik-miejsce",
          "explanation": "ó → o, d → dz: w samochodzie."
        },
        {
          "id": "h1-6",
          "text": "Od marca pracuję w ___ (nowe biuro).",
          "answer": "nowym biurze",
          "grammar_point": "przymiotnik-miejscownik",
          "explanation": "Biuro → w biurze (r → rz), nowe → w nowym."
        },
        {
          "id": "h1-7",
          "text": "Nasza córka śpi na ___ (górne łóżko).",
          "answer": "górnym łóżku",
          "grammar_point": "przymiotnik-miejscownik"
        },
        {
          "id": "h1-8",
          "text": "Mapa jest na ___ (ostatnia strona).",
          "answer": "ostatniej stronie",
          "grammar_point": "przymiotnik-miejscownik"
        }
      ]
    },
    {
      "block_id": "h2",
      "exercise_type": "sentence-building",
      "title": "2. Ułóż zdania",
