    {
      "block_id": "h3",
      "exercise_type": "drag-and-drop",
      "title": "3. Wiadomość od Oli",
      "instruction": "Przeciągnij słowa w luki. Cztery słowa są niepotrzebne.",
      "bank": [
        "winda",
        "przy",
        "piętro",
        "kanapę",
        "obok",
        "windy",
        "balkonie",
        "dywan",
        "piętrze",
        "przed"
      ],
      "items": [
        {
          "id": "h3-1",
          "text": "Cześć! Od tygodnia mieszkam w nowym mieszkaniu na trzecim ___.",
          "answer": "piętrze",
          "grammar_point": "przymiotnik-miejscownik"
        },
        {
          "id": "h3-2",
          "text": "Niestety w bloku nie ma ___, więc codziennie chodzę po schodach.",
          "answer": "windy",
          "grammar_point": "przeczenie-dopelniacz"
        },
        {
          "id": "h3-3",
          "text": "W salonie mam wygodną ___ — jest idealna na wieczory z serialem.",
          "answer": "kanapę",
          "grammar_point": "kalki-uk",
          "explanation": "Dywan to килим. Диван po polsku to kanapa albo sofa."
        },
        {
          "id": "h3-4",
          "text": "Rano piję kawę na ___ i patrzę na park.",
          "answer": "balkonie",
          "grammar_point": "miejscownik-miejsce"
        },
        {
          "id": "h3-5",
          "text": "Tuż ___ blokiem jest mała piekarnia z pysznymi bułkami.",
          "answer": "przed",
          "grammar_point": "przyimki-narzednik-miejsce",
          "explanation": "Blokiem to narzędnik, więc przed blokiem. Obok i przy potrzebują innego przypadku: obok bloku, przy bloku."
        },
        {
          "id": "h3-6",
          "text": "Przyjedź w sobotę! Mieszkam ___ ulicy Polnej 5.",
          "answer": "przy",
          "grammar_point": "miejscownik-miejsce"
        }
      ]
    }
