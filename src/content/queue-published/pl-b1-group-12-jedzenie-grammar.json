    {
      "block_id": "g2",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "2. Komu? Zaimki",
      "instruction": "Wpisz zaimek z nawiasu w celowniku. Na początku zdania, w kontraście i po przyimku — forma długa.",
      "items": [
        {
          "id": "g2-1",
          "text": "Mamo, pomóż ___ (ja) nakryć do stołu!",
          "answer": "mi",
          "grammar_point": "celownik-zaimki",
          "explanation": "Zwykła pozycja w środku zdania → krótka forma: mi."
        },
        {
          "id": "g2-2",
          "text": "___ (ja) ten rosół nie smakuje, ale Maksymowi bardzo.",
          "answer": "Mnie",
          "grammar_point": "celownik-zaimki",
          "explanation": "Początek zdania i kontrast (ja — Maksym) → długa forma: mnie."
        },
        {
          "id": "g2-3",
          "text": "Na urodziny kupiłam ___ (on) nowy garnek.",
          "answer": "mu",
          "grammar_point": "celownik-zaimki",
          "explanation": "Bez akcentu → mu."
        },
        {
          "id": "g2-4",
          "text": "Dzięki ___ (ona) nauczyłam się piec chleb.",
          "answer": "niej",
          "grammar_point": "celownik-zaimki",
          "explanation": "Po przyimku (dzięki) → forma z n-: niej."
        },
        {
          "id": "g2-5",
          "text": "Babcia ugotowała ___ (my) pierogi z jagodami.",
          "answer": "nam",
          "grammar_point": "celownik-zaimki"
        },
        {
          "id": "g2-6",
          "text": "Czy mogę ___ (wy) zaproponować deser?",
          "answer": "wam",
          "grammar_point": "celownik-zaimki"
        },
        {
          "id": "g2-7",
          "text": "Zapach czosnku w ogóle ___ (oni) nie przeszkadza.",
          "answer": "im",
          "grammar_point": "celownik-zaimki"
        },
        {
          "id": "g2-8",
          "text": "Mnie zupa smakuje. A ___ (ty)?",
          "answer": "tobie",
          "grammar_point": "celownik-zaimki",
          "explanation": "Kontrast (mnie — a tobie?) → długa forma: tobie."
        },
        {
          "id": "g2-9",
          "text": "Wbrew ___ (on) zamówiliśmy pizzę, a nie sushi.",
          "answer": "niemu",
          "grammar_point": "celownik-zaimki",
          "explanation": "Po przyimku (wbrew) → niemu."
        }
      ]
    },
    {
