      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "2. Pan i pani: zawody",
      "instruction": "Wpisz formę żeńską zawodu.",
      "items": [
        {
          "id": "g2-1",
          "text": "pan kelner → pani ___",
          "answer": "kelnerka",
          "grammar_point": "zawody-forma-zenska"
        },
        {
          "id": "g2-2",
          "text": "pan dziennikarz → pani ___",
          "answer": "dziennikarka",
          "explanation": "-arz → -arka: dziennikarz → dziennikarka.",
          "grammar_point": "zawody-forma-zenska"
        },
        {
          "id": "g2-3",
          "text": "pan kucharz → pani ___",
          "answer": "kucharka",
          "grammar_point": "zawody-forma-zenska"
        },
        {
          "id": "g2-4",
          "text": "pan tancerz → pani ___",
          "answer": "tancerka",
          "explanation": "-erz → -erka: tancerz → tancerka.",
          "grammar_point": "zawody-forma-zenska"
        },
        {
          "id": "g2-5",
          "text": "pan nauczyciel → pani ___",
          "answer": "nauczycielka",
          "grammar_point": "zawody-forma-zenska"
        },
        {
          "id": "g2-6",
          "text": "pan dentysta → pani ___",
          "answer": "dentystka",
          "explanation": "Zawód na -a: -a → -ka, jak artysta → artystka.",
          "grammar_point": "zawody-forma-zenska"
        },
        {
          "id": "g2-7",
          "text": "pan emeryt → pani ___",
          "answer": "emerytka",
          "grammar_point": "zawody-forma-zenska"
        },
        {
          "id": "g2-8",
          "text": "pan policjant → pani ___",
          "answer": "policjantka",
          "grammar_point": "zawody-forma-zenska"
        }
      ]
    },
    {
      "block_id": "g3",
