        },
        {
          "id": "g3-3",
          "text": "Moja żona świetnie ___ tango. (tańczyć)",
          "answer": "tańczy",
          "explanation": "Po cz, sz, rz, ż — -y: tańczysz, tańczy.",
          "grammar_point": "koniugacja-e-ysz"
        },
        {
          "id": "g3-4",
          "text": "Wy ___ czytać książki? (lubić)",
          "answer": "lubicie",
          "grammar_point": "koniugacja-e-isz"
        },
        {
