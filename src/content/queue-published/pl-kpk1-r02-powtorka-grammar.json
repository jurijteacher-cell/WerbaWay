    {
      "block_id": "g4",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "4. To jest lekarz czy jest lekarzem?",
      "instruction": "Wybierz dobrą formę: mianownik (kto? co?) czy narzędnik (kim? czym?).",
      "items": [
        {
          "id": "g4-1",
          "text": "Mój mąż jest ___.",
          "options": [
            "lekarz",
            "lekarzem"
          ],
          "answer": "lekarzem",
          "explanation": "Jest + kim? → narzędnik: lekarzem.",
          "grammar_point": "narzednik-mianownik"
        },
        {
          "id": "g4-2",
          "text": "Kto to jest? — To jest ___.",
          "options": [
            "nowy nauczyciel",
            "nowym nauczycielem"
          ],
          "answer": "nowy nauczyciel",
          "explanation": "To jest + kto? → mianownik, forma bez zmian.",
          "grammar_point": "narzednik-mianownik"
        },
        {
          "id": "g4-3",
          "text": "Moja żona jest ___.",
          "options": [
            "nauczycielka",
            "nauczycielką"
          ],
          "answer": "nauczycielką",
          "explanation": "Ona: -a → -ą.",
          "grammar_point": "narzednik-mianownik"
        },
        {
          "id": "g4-4",
          "text": "Kim pan jest z zawodu? — Jestem ___.",
          "options": [
            "inżynier",
            "inżynierem"
          ],
          "answer": "inżynierem",
          "explanation": "Jestem + kim? → narzędnik: inżynierem.",
          "grammar_point": "narzednik-mianownik"
        },
        {
          "id": "g4-5",
          "text": "Marek to ___.",
          "options": [
            "dobry kucharz",
            "dobrym kucharzem"
          ],
          "answer": "dobry kucharz",
          "explanation": "To (bez „jest”) + mianownik: Marek to dobry kucharz.",
          "grammar_point": "narzednik-mianownik"
        },
        {
          "id": "g4-6",
          "text": "Ola jest ___.",
          "options": [
            "zdolna studentka",
            "zdolną studentką",
            "zdolną studentka"
          ],
          "answer": "zdolną studentką",
          "explanation": "Przymiotnik i rzeczownik razem w narzędniku: -ą … -ą.",
          "grammar_point": "narzednik-mianownik"
        },
        {
          "id": "g4-7",
          "text": "Interesuję się ___.",
          "options": [
            "muzyka",
            "muzyką"
          ],
          "answer": "muzyką",
          "explanation": "Interesować się + czym? → narzędnik.",
          "grammar_point": "narzednik-mianownik"
        },
        {
          "id": "g4-8",
          "text": "Czym się interesujesz? — ___ fotografią.",
          "options": [
            "Interesuję się",
            "Interesuję",
            "Lubię"
          ],
          "answer": "Interesuję się",
          "explanation": "Bez „się” to błąd. „Lubię” idzie z bezokolicznikiem: lubię robić zdjęcia.",
          "grammar_point": "narzednik-mianownik"
        }
      ]
    },
