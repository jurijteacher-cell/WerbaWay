          "grammar_point": "koniugacja-e-isz"
        },
        {
          "id": "g3-2",
          "text": "Oni nie ___ — i bardzo dobrze! (palić)",
          "answer": "palą",
          "explanation": "oni → -ą: palą, mówią, lubią.",
