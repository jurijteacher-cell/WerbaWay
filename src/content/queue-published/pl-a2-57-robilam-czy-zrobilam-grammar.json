          "grammar_point": "aspekt-przeszly",
          "explanation": "„Przez trzy dni” — proces: niedokonany."
        },
        {
          "id": "g2-4",
          "text": "Nagle ___ za oknem sarnę.",
          "answer": "zobaczyliśmy",
          "options": [
            "zobaczyliśmy",
            "widzieliśmy"
          ],
          "grammar_point": "aspekt-przeszly",
          "explanation": "„Nagle” — jedno zdarzenie: zobaczyć."
