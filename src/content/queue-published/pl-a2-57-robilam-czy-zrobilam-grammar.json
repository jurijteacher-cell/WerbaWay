            "dzwoniłam",
            "zadzwoniłam"
          ],
          "grammar_point": "aspekt-przeszly",
          "explanation": "„Zwykle” — regularnie: niedokonany."
        },
        {
          "id": "g2-2",
          "text": "W środę wreszcie ___ list z urzędu.",
          "answer": "dostałem",
          "options": [
            "dostałem",
            "dostawałem"
          ],
          "grammar_point": "aspekt-przeszly",
          "explanation": "„Wreszcie” — wynik: dokonany."
        },
        {
          "id": "g2-3",
          "text": "Przez trzy dni ___ do egzaminu.",
          "answer": "uczyłam się",
          "options": [
            "uczyłam się",
            "nauczyłam się"
