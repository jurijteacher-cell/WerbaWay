        {
          "id": "g3-6",
          "text": "Od ___ do piętnastego stycznia codziennie pracowałam do późna, ale w sobotę wreszcie odpoczęłam. (11.01)",
          "answer": "jedenastego",
          "grammar_point": "data-pelna",
          "explanation": "Od kiedy? — dopełniacz: od jedenastego."
        },
        {
          "id": "g3-7",
          "text": "Zwykle przygotowywała obiad sama, ale na urodziny ___ go z mężem.",
          "answer": "przygotowała",
          "grammar_point": "aspekt-przeszly",
          "explanation": "przygotowywać → przygotować; ona: przygotowała."
        }
      ]
