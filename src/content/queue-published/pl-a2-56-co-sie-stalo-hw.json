{
  "lesson_id": "pl-a2-56-co-sie-stalo",
  "exercise_type": "fill-in-blank",
  "title": "Praca domowa: proces czy wynik w domu",
  "instruction": "Trzy bloki ćwiczeń. Potem napisz wiadomość do przyjaciela — zadanie jest na stronie lekcji.",
  "estimated_minutes": 20,
  "blocks": [
    {
      "block_id": "h1",
      "exercise_type": "fill-in-blank",
      "title": "1. Proces czy wynik?",
      "instruction": "Wybierz poprawną formę.",
      "items": [
        {
          "id": "h1-1",
          "text": "W sobotę cały ranek ___ mieszkanie.",
          "answer": "sprzątałam",
          "options": [
            "sprzątałam",
            "posprzątałam"
          ],
          "grammar_point": "aspekt-podstawy",
          "explanation": "„Cały ranek” — proces: sprzątałam."
        },
        {
          "id": "h1-2",
          "text": "Już ___ rachunek za prąd, nie martw się.",
          "answer": "zapłaciłem",
          "options": [
            "zapłaciłem",
            "płaciłem"
          ],
          "grammar_point": "aspekt-podstawy",
          "explanation": "„Już” — wynik: zapłaciłem."
        },
        {
          "id": "h1-3",
          "text": "Kiedy mama ___ naczynia, tata czytał gazetę.",
          "answer": "myła",
          "options": [
            "myła",
            "umyła"
          ],
          "grammar_point": "aspekt-podstawy",
          "explanation": "Dwie rzeczy w tym samym czasie — niedokonany: myła."
        },
        {
          "id": "h1-4",
          "text": "Babcia ___ zupę i zawołała nas na obiad.",
          "answer": "ugotowała",
          "options": [
            "ugotowała",
            "gotowała"
          ],
          "grammar_point": "aspekt-podstawy",
          "explanation": "Zupa jest gotowa, potem następna akcja — dokonany: ugotowała."
        },
        {
          "id": "h1-5",
          "text": "Przez dwa lata ___ się grać na gitarze.",
          "answer": "uczyłem",
          "options": [
            "uczyłem",
            "nauczyłem"
          ],
          "grammar_point": "aspekt-podstawy",
          "explanation": "„Przez dwa lata” — proces: uczyłem się."
        },
        {
          "id": "h1-6",
          "text": "Dziś rano ___ się o piątej, bo pies szczekał.",
          "answer": "obudziłam",
          "options": [
            "obudziłam",
            "budziłam"
          ],
          "grammar_point": "aspekt-podstawy",
          "explanation": "Jedno zdarzenie o piątej — dokonany: obudziłam się."
        },
        {
          "id": "h1-7",
          "text": "Co robiliście w niedzielę? — ___ pokój córki.",
          "answer": "Malowaliśmy",
          "options": [
            "Malowaliśmy",
            "Pomalowaliśmy"
          ],
          "grammar_point": "aspekt-podstawy",
          "explanation": "„Co robiliście?” pyta o zajęcie — niedokonany."
        }
      ]
    },
    {
      "block_id": "h2",
      "exercise_type": "fill-in-blank",
      "title": "2. Wpisz formę",
      "instruction": "Wpisz czasownik z nawiasu w czasie przeszłym.",
      "items": [
        {
          "id": "h2-1",
          "text": "Wczoraj Kasia ___ do lekarza. (pójść)",
          "answer": "poszła",
          "grammar_point": "czas-przeszly-nieregularny",
          "explanation": "Ona: poszła — bez -e-."
        },
        {
          "id": "h2-2",
          "text": "Nie ___ zadzwonić, bo nie miałem telefonu. (móc, ja – mężczyzna)",
          "answer": "mogłem",
          "grammar_point": "czas-przeszly-nieregularny",
          "explanation": "Ó jest tylko w formie on (mógł). Ja: mogłem."
        },
        {
          "id": "h2-3",
          "text": "Tata nie ___ wczoraj spać, bo sąsiedzi mieli imprezę. (móc)",
          "answer": "mógł",
          "grammar_point": "czas-przeszly-nieregularny",
          "explanation": "On: mógł — z ó."
        },
        {
          "id": "h2-4",
          "text": "Dzieci ___ wszystkie cukierki! (zjeść)",
          "answer": "zjadły",
          "grammar_point": "czas-przeszly-nieregularny",
          "explanation": "Dzieci to nie „oni-mężczyźni”, tylko „one”: zjadły."
        },
        {
          "id": "h2-5",
          "text": "Kiedy ___ do domu, było już ciemno. (przyjść, my)",
          "answer": "przyszliśmy",
          "accept": [
            "przyszłyśmy"
          ],
          "grammar_point": "czas-przeszly-nieregularny",
          "explanation": "My: przyszliśmy (same kobiety: przyszłyśmy)."
        },
        {
          "id": "h2-6",
          "text": "Wujek ___ dziś do pracy pieszo, bo samochód się zepsuł. (pójść)",
          "answer": "poszedł",
          "grammar_point": "czas-przeszly-nieregularny",
          "explanation": "On: poszedł; ona: poszła."
        },
        {
          "id": "h2-7",
          "text": "Wczoraj nasi goście ___ wszystkie pierogi. (zjeść)",
          "answer": "zjedli",
          "grammar_point": "czas-przeszly-nieregularny",
          "explanation": "Oni (goście): zjedli — z -e-."
        }
      ]
    },
    {
      "block_id": "h3",
      "exercise_type": "sentence-building",
      "title": "3. Popraw błąd",
      "instruction": "W każdym zdaniu jest jeden błąd. Napisz całe zdanie poprawnie.",
      "items": [
        {
          "id": "h3-1",
          "prompt": "Przez cały wieczór ugotowałam obiad.",
          "answer": "Przez cały wieczór gotowałam obiad.",
          "accept": [
            "Cały wieczór gotowałam obiad."
          ],
          "grammar_point": "aspekt-podstawy",
          "explanation": "„Przez cały wieczór” — proces: gotowałam."
        },
        {
          "id": "h3-2",
          "prompt": "Wczoraj wreszcie płaciłem za mieszkanie i teraz mam spokój.",
          "answer": "Wczoraj wreszcie zapłaciłem za mieszkanie i teraz mam spokój.",
          "grammar_point": "aspekt-podstawy",
          "explanation": "„Wreszcie” i efekt (mam spokój) — dokonany: zapłaciłem."
        },
        {
          "id": "h3-3",
          "prompt": "Moja siostra przyszedła późno do domu.",
          "answer": "Moja siostra przyszła późno do domu.",
          "accept": [
            "Moja siostra późno przyszła do domu.",
            "Moja siostra przyszła do domu późno."
          ],
          "grammar_point": "czas-przeszly-nieregularny",
          "explanation": "Ona: przyszła."
        },
        {
          "id": "h3-4",
          "prompt": "Mój dziadek nie mogł znaleźć okularów.",
          "answer": "Mój dziadek nie mógł znaleźć okularów.",
          "grammar_point": "czas-przeszly-nieregularny",
          "explanation": "On: mógł — z ó."
        },
        {
          "id": "h3-5",
          "prompt": "Nagle budził się mój mały syn.",
          "answer": "Nagle obudził się mój mały syn.",
          "accept": [
            "Nagle mój mały syn się obudził.",
            "Nagle mój mały syn obudził się."
          ],
          "grammar_point": "aspekt-podstawy",
          "explanation": "„Nagle” — jedno zdarzenie: obudził się."
        }
      ]
    }
  ]
}
