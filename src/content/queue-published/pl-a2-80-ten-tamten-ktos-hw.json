    {
      "block_id": "h4",
      "exercise_type": "sentence-building",
      "title": "4. Popraw błąd",
      "instruction": "W każdym zdaniu jest jeden błąd. Napisz całe zdanie poprawnie.",
      "items": [
        {
          "id": "h4-1",
          "prompt": "Ci książki leżą tu od piątku.",
          "answer": "Te książki leżą tu od piątku.",
