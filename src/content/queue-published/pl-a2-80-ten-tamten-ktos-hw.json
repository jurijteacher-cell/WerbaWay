          "grammar_point": "czytanie"
        },
        {
          "id": "h2-2",
          "prompt": "W pociągu przeczytała umowę z klientem i trochę spała.",
          "grammar_point": "czytanie"
        },
        {
          "id": "h2-3",
          "prompt": "Na dworcu w Krakowie czekała na nią Olena z kartką „Witamy!”.",
          "grammar_point": "czytanie"
        },
        {
          "id": "h2-4",
          "prompt": "Razem pojechały tramwajem na Zabłocie.",
          "grammar_point": "czytanie"
        },
        {
          "id": "h2-5",
          "prompt": "W biurze Kasia pokazała jej, które biurko jest jej.",
          "grammar_point": "czytanie"
        },
        {
          "id": "h2-6",
          "prompt": "Wieczorem pani Ewa napisała do męża, że ci ludzie z Krakowa są bardzo mili.",
          "grammar_point": "czytanie"
        }
      ]
    },
    {
      "block_id": "h3",
