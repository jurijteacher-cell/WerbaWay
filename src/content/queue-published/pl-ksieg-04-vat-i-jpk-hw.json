{
  "lesson_id": "pl-ksieg-04-vat-i-jpk",
  "exercise_type": "fill-in-blank",
  "title": "Praca domowa: liczby, kwoty i zmiany w nowych zdaniach",
  "instruction": "Trzy ćwiczenia. Zrób je przed napisaniem e-maila. Każde zdanie przeczytaj potem na głos.",
  "estimated_minutes": 15,
  "blocks": [
    {
      "block_id": "h1",
      "exercise_type": "fill-in-blank",
      "title": "1. Wpisz właściwą formę",
      "instruction": "Wpisz słowo albo liczbę z nawiasu w dobrej formie. Liczby pisz słownie.",
      "items": [
        {
          "id": "h1-1",
          "text": "Bilet do kina kosztuje 24 ___ (złoty).",
          "answer": "złote",
          "grammar_point": "liczebnik-zloty"
        },
        {
          "id": "h1-2",
          "text": "Nasze mieszkanie ma 55 ___ (metr) kwadratowych.",
          "answer": "metrów",
          "grammar_point": "liczebnik-dopelniacz"
        },
        {
          "id": "h1-3",
          "text": "Podróż autobusem trwa około ___ (3) godzin.",
          "answer": "trzech",
          "grammar_point": "liczebnik-dopelniacz-przyimek"
        },
        {
          "id": "h1-4",
          "text": "Parking kosztuje 7 złotych i 50 ___ (grosz).",
          "answer": "groszy",
          "grammar_point": "liczebnik-grosz"
        },
        {
          "id": "h1-5",
          "text": "Na koncert przyszło ponad ___ (2 000) osób.",
          "answer": "dwa tysiące",
          "grammar_point": "ponad-biernik",
          "explanation": "Ponad + biernik: liczebnik się nie zmienia."
        },
        {
          "id": "h1-6",
          "text": "W tym roku przeczytałam 12 ___ (książka).",
          "answer": "książek",
          "grammar_point": "liczebnik-dopelniacz"
        }
      ]
    },
    {
      "block_id": "h2",
      "exercise_type": "fill-in-blank",
      "title": "2. Wybierz",
      "instruction": "Kliknij poprawną odpowiedź.",
      "items": [
        {
          "id": "h2-1",
          "text": "Moja pensja wzrosła ___ 300 złotych.",
          "answer": "o",
          "grammar_point": "zmiana-o",
          "options": [
            "o",
            "na"
          ]
        },
        {
          "id": "h2-2",
          "text": "Bilety zdrożały z 4 ___ 5 złotych.",
          "answer": "do",
          "grammar_point": "zmiana-z-do",
          "options": [
            "do",
            "po"
          ]
        },
        {
          "id": "h2-3",
          "text": "Temperatura w nocy ___ minus pięć stopni.",
          "answer": "wynosi",
          "grammar_point": "wynosic",
          "options": [
            "wynosi",
            "stanowi"
          ]
        },
        {
          "id": "h2-4",
          "text": "Kredyt ma oprocentowanie ___ 7 procent.",
          "answer": "w wysokości",
          "grammar_point": "w-wysokosci",
          "options": [
            "w wysokości",
            "w rozmiarze"
          ]
        },
        {
          "id": "h2-5",
          "text": "Nowy telefon kosztuje ___ tysiące złotych.",
          "answer": "trzy",
          "grammar_point": "liczebnik-tysiac",
          "options": [
            "trzy",
            "trzech"
          ]
        }
      ]
    },
    {
      "block_id": "h3",
      "exercise_type": "sentence-building",
      "title": "3. Ułóż zdania",
      "instruction": "Klikaj słowa w dobrej kolejności. Potem przeczytaj zdanie na głos.",
      "items": [
        {
          "id": "h3-1",
          "words": [
            "rower",
            "kosztuje",
            "dwa tysiące",
            "trzysta",
            "złotych."
