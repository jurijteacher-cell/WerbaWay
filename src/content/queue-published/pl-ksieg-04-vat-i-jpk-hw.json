          ]
        },
        {
          "id": "h3-4",
          "words": [
            "podróż",
            "kosztowała",
            "nas",
            "łącznie",
            "tysiąc dwieście",
            "złotych."
          ],
          "answer": "Podróż kosztowała nas łącznie tysiąc dwieście złotych.",
          "grammar_point": "kwota-na-glos",
          "accept": [
