          "grammar_point": "slownictwo",
          "options": [
            "trener",
            "nauczyciel",
            "wykładowca"
          ],
          "explanation": "trener = sport."
        },
        {
          "id": "h1-6",
          "text": "Przed każdym ćwiczeniem stosujemy podstawowe ___ bezpieczeństwa.",
