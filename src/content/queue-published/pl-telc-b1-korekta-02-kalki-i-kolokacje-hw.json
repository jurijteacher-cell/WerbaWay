      "items": [
        {
          "id": "h1-1",
          "text": "Nasza firma ma kilka ___ w różnych miastach Polski.",
          "answer": "oddziałów",
          "grammar_point": "slownictwo",
          "options": [
            "oddziałów",
            "działów",
            "środków"
          ],
          "explanation": "oddział = filia w innym mieście; dział = część jednej firmy."
        },
        {
          "id": "h1-2",
          "text": "___ osób pracuje w Twoim dziale?",
          "answer": "Ile",
          "grammar_point": "slownictwo",
          "options": [
            "Ile",
            "Kilka",
            "Wiele"
          ],
          "explanation": "ile = сколько? tylko w pytaniu."
        },
        {
          "id": "h1-3",
          "text": "Dziękuję za ___ przy wypełnianiu formularza.",
          "answer": "pomoc",
          "grammar_point": "slownictwo",
          "options": [
            "pomoc",
            "pomóc",
            "pomysł"
          ],
          "explanation": "pomoc = rzeczownik: dziękuję za + biernik."
        },
        {
          "id": "h1-4",
          "text": "Sędzia musi być ___ od polityków.",
          "answer": "niezależny",
          "grammar_point": "slownictwo",
          "options": [
            "niezależny",
            "niepodległy",
            "samotny"
          ],
          "explanation": "niezależny od + dopełniacz."
        },
        {
          "id": "h1-5",
          "text": "Na siłowni nasz ___ pokazuje, jak poprawnie robić przysiad.",
