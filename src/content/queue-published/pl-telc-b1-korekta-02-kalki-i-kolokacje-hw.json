        {
          "id": "h1-8",
          "text": "Klient nie jest zadowolony — musimy jeszcze dziś ___ ten problem.",
          "answer": "rozwiązać",
          "grammar_point": "slownictwo",
          "options": [
            "rozwiązać",
            "wzmocnić",
            "wymienić"
          ],
          "explanation": "problem się rozwiązuje."
        }
      ]
