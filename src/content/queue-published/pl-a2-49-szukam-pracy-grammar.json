{
  "lesson_id": "pl-a2-49-szukam-pracy",
  "exercise_type": "fill-in-blank",
  "title": "Szukam pracy: dopełniacz po przyimkach i czasownikach",
  "instruction": "Pięć krótkich bloków. Na lekcji robimy bloki 1–3, bloki 4 i 5 — jeśli zostanie czas albo w domu.",
  "estimated_minutes": 15,
  "blocks": [
    {
      "block_id": "g1",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "1. Do, od, z, u, dla, obok",
      "instruction": "Wybierz poprawną formę.",
      "items": [
        {
          "id": "g1-1",
          "text": "Codziennie jeżdżę do ___ tramwajem.",
          "answer": "biura",
          "options": [
            "biuro",
            "biura",
            "biurze"
          ],
          "grammar_point": "dopelniacz-przyimki",
          "explanation": "Do + dopełniacz. Biuro (rodzaj nijaki) → biura."
        },
        {
          "id": "g1-2",
          "text": "Ten prezent jest dla ___.",
          "answer": "Marka",
          "options": [
            "Marka",
            "Marek",
            "Markiem"
          ],
          "grammar_point": "dopelniacz-przyimki",
          "explanation": "Dla + dopełniacz. Marek → Marka: e znika."
        },
        {
          "id": "g1-3",
          "text": "Kasia wraca z ___ o osiemnastej.",
          "answer": "pracy",
          "options": [
            "pracą",
            "praca",
            "pracy"
          ],
          "grammar_point": "dopelniacz-przyimki",
          "explanation": "Z + dopełniacz. Praca → pracy."
        },
        {
          "id": "g1-4",
          "text": "Mieszkamy obok ___.",
          "answer": "parku",
          "options": [
            "parka",
            "parku",
            "park"
          ],
          "grammar_point": "dopelniacz-przyimki",
          "explanation": "Park w dopełniaczu ma -u: obok parku."
        },
        {
          "id": "g1-5",
          "text": "Wczoraj dostałam list od ___.",
          "answer": "mamy",
          "options": [
            "mamy",
            "mamie",
            "mama"
          ],
          "grammar_point": "dopelniacz-przyimki",
          "explanation": "Od + dopełniacz. Mama → mamy."
        },
        {
          "id": "g1-6",
          "text": "Wieczorem byliśmy u ___ na kolacji.",
          "answer": "Ani",
          "options": [
            "Anię",
            "Ani",
            "Ania"
          ],
          "grammar_point": "dopelniacz-przyimki",
          "explanation": "U + dopełniacz. Ania → Ani: po miękkiej spółgłosce -i."
        }
      ]
    },
    {
      "block_id": "g2",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "2. Przymiotnik i rzeczownik",
      "instruction": "Wpisz słowa z nawiasu w poprawnej formie.",
      "items": [
        {
          "id": "g2-1",
          "text": "Dzwonię w sprawie ___ (nowa oferta).",
          "answer": "nowej oferty",
          "grammar_point": "dopelniacz-przyimki",
          "explanation": "Rodzaj żeński: -ej i -y → nowej oferty."
        },
        {
          "id": "g2-2",
          "text": "Szukamy osoby do ___ (duży zespół).",
          "answer": "dużego zespołu",
          "grammar_point": "dopelniacz-przyimki",
          "explanation": "Rodzaj męski: -ego; zespół ma -u → dużego zespołu."
        },
        {
          "id": "g2-3",
          "text": "Pracuję w tej firmie od ___ (zeszły rok).",
          "answer": "zeszłego roku",
          "grammar_point": "dopelniacz-przyimki",
          "explanation": "Od + dopełniacz: zeszłego roku."
        },
        {
          "id": "g2-4",
          "text": "Nasza kawiarnia jest obok ___ (stary uniwersytet).",
          "answer": "starego uniwersytetu",
          "grammar_point": "dopelniacz-przyimki",
          "explanation": "Uniwersytet ma -u: starego uniwersytetu."
        },
        {
          "id": "g2-5",
          "text": "Wysłałam CV do ___ (polska firma).",
          "answer": "polskiej firmy",
          "grammar_point": "dopelniacz-przyimki",
          "explanation": "Rodzaj żeński: polskiej firmy."
        },
        {
          "id": "g2-6",
          "text": "To wiadomość od ___ (mój szef).",
          "answer": "mojego szefa",
          "grammar_point": "dopelniacz-przyimki",
          "explanation": "Osoba, rodzaj męski: mojego szefa."
        }
      ]
    },
    {
      "block_id": "g3",
      "part": 1,
      "exercise_type": "fill-in-blank",
      "title": "3. Szukam czy znalazłam? Od czy z?",
      "instruction": "Wybierz poprawną odpowiedź.",
      "items": [
        {
          "id": "g3-1",
          "text": "Od tygodnia szukam ___ na pół etatu.",
          "answer": "pracy",
          "options": [
            "pracy",
            "pracę"
          ],
          "grammar_point": "dopelniacz-przyimki",
          "explanation": "Szukać łączy się z dopełniaczem: szukam pracy. Po ukraińsku jest „шукаю роботу”, ale po polsku nie ma tu biernika."
        },
        {
          "id": "g3-2",
          "text": "Hura! Znalazłam ___ blisko domu!",
          "answer": "pracę",
          "options": [
            "pracy",
            "pracę"
          ],
          "grammar_point": "dopelniacz-przyimki",
          "explanation": "Znaleźć łączy się z biernikiem: znalazłam pracę. Dopełniacz jest po szukać, nie po znaleźć."
        },
        {
          "id": "g3-3",
          "text": "Do tej pracy potrzebuję ___ jazdy.",
          "answer": "prawa",
          "options": [
            "prawa",
            "prawo"
          ],
          "grammar_point": "dopelniacz-przyimki",
          "explanation": "Potrzebować + dopełniacz: potrzebuję prawa jazdy."
        },
        {
          "id": "g3-4",
          "text": "Mam wykształcenie, ale nie mam ___ w zawodzie.",
          "answer": "doświadczenia",
          "options": [
            "doświadczenie",
            "doświadczenia"
          ],
          "grammar_point": "dopelniacz-przyimki",
          "explanation": "Po nie biernik zmienia się w dopełniacz: nie mam doświadczenia."
        },
        {
          "id": "g3-5",
          "text": "W sobotę jadę ___ na rozmowę.",
          "answer": "do Krakowa",
          "options": [
            "w Kraków",
            "na Kraków",
            "do Krakowa"
          ],
          "grammar_point": "dopelniacz-przyimki",
          "explanation": "Dokąd? Do miasta: do + dopełniacz. Po ukraińsku „в Краків”, po polsku do Krakowa."
        },
        {
          "id": "g3-6",
          "text": "Mam e-mail ___ pani Agnieszki.",
          "answer": "od",
          "options": [
            "od",
            "z"
          ],
          "grammar_point": "dopelniacz-przyimki",
          "explanation": "Od osoby — od pani Agnieszki. Z miejsca — z biura."
        },
        {
          "id": "g3-7",
          "text": "Jestem teraz ___ Tomka, oddzwonię później.",
          "answer": "u",
          "options": [
            "w",
            "u",
            "do"
          ],
          "grammar_point": "dopelniacz-przyimki",
          "explanation": "Gdzie? U osoby: u Tomka. Do Tomka — dokąd idę."
        },
        {
          "id": "g3-8",
          "text": "Mam urlop ___ poniedziałku do środy.",
          "answer": "od",
          "options": [
            "od",
            "z"
          ],
          "grammar_point": "dopelniacz-przyimki",
          "explanation": "Czas: od … do … Po ukraińsku „з понеділка”, po polsku od poniedziałku."
        }
      ]
    },
