      "exercise_type": "fill-in-blank",
      "title": "1. Wpisz formę liczby mnogiej",
      "instruction": "Wpisz słowo z nawiasu w dobrej formie.",
      "items": [
        {
          "id": "h1-1",
          "text": "W ___ zimą często pada śnieg. (Tatry)",
          "answer": "Tatrach",
          "grammar_point": "mnoga-przypadki",
          "explanation": "W + miejscownik: w Tatrach."
        },
        {
          "id": "h1-2",
          "text": "Dzieci bawią się w ogrodzie z ___. (psy)",
          "answer": "psami",
          "grammar_point": "mnoga-przypadki",
          "explanation": "Z + narzędnik: z psami."
        },
        {
          "id": "h1-3",
          "text": "W naszym biurze jest sześć ___. (biurka)",
          "answer": "biurek",
          "grammar_point": "mnoga-przypadki",
          "explanation": "6 + dopełniacz: biurek (-e- się pojawia)."
        },
        {
          "id": "h1-4",
          "text": "Kupiłam prezenty dla ___. (wszystkie koleżanki)",
