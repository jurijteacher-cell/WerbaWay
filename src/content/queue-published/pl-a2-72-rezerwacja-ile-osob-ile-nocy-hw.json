        {
          "id": "h1-5",
          "text": "Przewodnik opowiadał ___ o historii miasta. (turyści)",
          "answer": "turystom",
          "grammar_point": "mnoga-przypadki",
          "explanation": "Opowiadać komu? — turystom (-om)."
